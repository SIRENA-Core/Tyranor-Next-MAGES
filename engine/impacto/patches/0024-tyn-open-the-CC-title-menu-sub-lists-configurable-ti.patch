 -- main entries: START, LOAD, EXTRA, CONFIG at x=1922 / 2123 (rows y=1, 50, 100, 149); HELP at x=2324 / 2525 (y=1)
diff --git a/src/games/cc/titlemenu.cpp b/src/games/cc/titlemenu.cpp
index 838f28f9767cf5315a39db31c022ecb274fbc481..b0032e3e40792f602590fb3b45f2bf897fcc8019 100644
--- a/src/games/cc/titlemenu.cpp
+++ b/src/games/cc/titlemenu.cpp
@@ -37,19 +37,45 @@ void TitleMenu::MenuButtonOnClick(Widgets::Button* target) {
   target->Hovered = false;
   ScrWork[SW_TITLECUR1] = target->Id;
   SetFlag(SF_TITLEEND, 1);
+  CloseSubMenu();
+  AllowsScriptInput = true;
+}
+
+void TitleMenu::OpenSubMenu(Widgets::Group* subMenu, Widgets::Button* opener) {
+  CloseSubMenu();
+  CurrentSubMenu = subMenu;
+  SubMenuOpener = opener;
+  MainItems->HasFocus = false;
+  subMenu->Show();
+  if (Widget* first = subMenu->GetFirstFocusableChild()) {
+    CurrentlyFocusedElement = first;
+    first->HasFocus = true;
+  }
+  AllowsScriptInput = false;
+}
+
+void TitleMenu::CloseSubMenu() {
+  if (!CurrentSubMenu) return;
+  if (CurrentSubMenu->VisibilityState != Hidden) CurrentSubMenu->Hide();
+  CurrentSubMenu = nullptr;
+  if (MainItems->VisibilityState != Hidden) {
+    MainItems->HasFocus = true;
+    if (CurrentlyFocusedElement) CurrentlyFocusedElement->HasFocus = false;
+    CurrentlyFocusedElement = SubMenuOpener;
+    if (SubMenuOpener) SubMenuOpener->HasFocus = true;
+  }
+  SubMenuOpener = nullptr;
   AllowsScriptInput = true;
 }
 
 void TitleMenu::ContinueButtonOnClick(Widgets::Button* target) {
   target->Hovered = false;
-  CurrentSubMenu = ContinueItems;
-  AllowsScriptInput = false;
+  OpenSubMenu(ContinueItems, target);
 }
 
 void TitleMenu::ExtraButtonOnClick(Widgets::Button* target) {
   target->Hovered = false;
-  CurrentSubMenu = ExtraItems;
-  AllowsScriptInput = false;
+  OpenSubMenu(ExtraItems, target);
 }
 
