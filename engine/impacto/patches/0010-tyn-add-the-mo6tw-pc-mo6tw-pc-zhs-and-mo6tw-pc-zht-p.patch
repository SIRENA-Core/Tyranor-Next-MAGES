diff --git a/profiles/mo6tw-pc/hud/titlemenu.lua b/profiles/mo6tw-pc/hud/titlemenu.lua
new file mode 100644
index 0000000000000000000000000000000000000000..44417eaedbe2f3c394247bc8bcb39b6eedd0c517
--- /dev/null
+++ b/profiles/mo6tw-pc/hud/titlemenu.lua
@@ -0,0 +1,90 @@
+-- Title menu of the PC release. The PC scripts drive the MO8-generation state machine
+-- (SW_TITLEMODE / SF_TITLEEND), so this uses TitleMenuType.MO8.
+-- The "Title" sheet (system.cpk title / title_ht / title_kt) holds the menu entry labels in
+-- four columns; the logo and copyright are part of the background (title_bg1).
+-- Entry rectangles are fixed-size cells centred on the measured alpha bounds of each label
+-- (measured with tools/impacto/mo6tw-pc/seg.py in yuukana1/Tyranor-Next-Impacto: alpha
+-- connected-component scan of the sheets).
+local function cell(cx, y0, w)
+    return { X = cx - w / 2, Y = y0 - 5, Width = w, Height = 68 };
+end
+
+local entries = {
+    [0]  = cell(1092, 275, 400), -- Warning theater (3rd column, 4th row)
+    [1]  = cell(1581, 185, 540), -- DLC / extra story label (4th column)
+    [2]  = cell(654, 281, 400),  -- Music
+    [3]  = cell(654, 191, 400),  -- Album
+    [4]  = cell(653, 370, 400),  -- Clear List
+    [5]  = cell(654, 11, 400),   -- Load
+    [6]  = cell(216, 281, 400),  -- Memories (gallery)
+    [7]  = cell(1092, 13, 400),  -- Shortcut (unused)
+    [8]  = cell(215, 190, 400),  -- Option
+    [9]  = cell(216, 100, 400),  -- Continue
+    [10] = cell(216, 10, 400),   -- New Game
+    [12] = cell(653, 100, 400),  -- Quick Load
+};
+
+root.TitleMenu = {
+    Type = TitleMenuType.MO8,
+    DrawType = DrawComponentType.SystemMenu,
+    PressToStartPos = { X = 750, Y = 800 },
+    LogoX = 0,
+    LogoY = 0,
+    MenuEntriesNum = 13,
+    MenuEntriesSprites = {},
+    MenuEntriesHighlightedSprites = {},
+    MenuEntriesX = 760,
+    MenuEntriesFirstY = 586,
+    MenuEntriesGalleryFirstY = 546,
+    MenuEntriesYPadding = 80,
+    NewGameSpriteIndex = 10,
+    ContinueSpriteIndex = 9,
+    OptionSpriteIndex = 8,
+    GallerySpriteIndex = 6,
+    AlbumSpriteIndex = 3,
+    MusicSpriteIndex = 2,
+    ClearListSpriteIndex = 4,
+    WarningSpriteIndex = 0,
+    AdditionalSpriteIndex = 8,
+    DLCSpriteIndex = 1,
+    LoadSpriteIndex = 5,
+    QuickLoadSpriteIndex = 12,
+    HasAdditional = false,
+    PressToStartAnimated = false,
+    PressToStartAnimDurationIn = 0,
+    PressToStartAnimDurationOut = 0,
+    PrimaryFadeAnimDuration = 0.5,
+    ItemFadeAnimDuration = 0.3,
+    PressToStartSprite = "TitleMenuPressToStart",
+    BackgroundSprite = "TitleMenuBackground",
+    LogoSprite = "TitleMenuLogo",
+};
+
+for i = 0, 12 do
+    local b = entries[i];
+    if i == 11 then
+        -- Highlight glow bar (drawn behind the focused entry)
+        b = { X = 29, Y = 391, Width = 376, Height = 24 };
+    elseif b == nil then
+        b = entries[7];
+    end
+    root.Sprites["MenuEntry" .. i] = { Sheet = "Title", Bounds = b };
+    root.TitleMenu.MenuEntriesSprites[#root.TitleMenu.MenuEntriesSprites + 1] = "MenuEntry" .. i;
+    root.TitleMenu.MenuEntriesHighlightedSprites[#root.TitleMenu.MenuEntriesHighlightedSprites + 1] = "MenuEntry" .. i;
+end
+
+root.Sprites["TitleMenuBackground"] = {
+    Sheet = "Titlebg",
+    Bounds = { X = 0, Y = 0, Width = 1920, Height = 1080 },
+};
+
+root.Sprites["TitleMenuPressToStart"] = {
+    Sheet = "Title",
+    Bounds = cell(1581, 10, 420),
+};
+
+-- The logo is part of title_bg1; the menu class still needs a sprite, use an empty area
+root.Sprites["TitleMenuLogo"] = {
+    Sheet = "Title",
+    Bounds = { X = 1900, Y = 300, Width = 2, Height = 2 },
+};
