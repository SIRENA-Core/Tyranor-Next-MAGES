+local numWidth = 60;
+local num1Width = 18;
+local numHeight = 42;
+
+local weekFirstX = 2678;
+local weekFirstY = 95;
+local weekSecondX = 2288;
+local weekSecondY = 128;
+local weekWidth = 110;
+local weekFriWidth = 84;
+local weekHeight = 30;
+
