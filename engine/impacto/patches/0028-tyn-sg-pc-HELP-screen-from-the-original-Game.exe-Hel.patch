+void Configure() {
+  Pages = EnsureGetMember<std::vector<Sprite>>("Pages");
+  PageNumberSprites = EnsureGetMember<std::vector<Sprite>>("PageNumberSprites");
+  PageNumberPosition = EnsureGetMember<glm::vec2>("PageNumberPosition");
+  PageCountSprite = EnsureGetMember<Sprite>("PageCountSprite");
+  PageCountPosition = EnsureGetMember<glm::vec2>("PageCountPosition");
+  TabSprite = EnsureGetMember<Sprite>("TabSprite");
+  TabHoverSprite = EnsureGetMember<Sprite>("TabHoverSprite");
+  TabCurrentSprite = EnsureGetMember<Sprite>("TabCurrentSprite");
+  TabPositions = EnsureGetMember<std::vector<glm::vec2>>("TabPositions");
+  TabHitAreas = EnsureGetMember<std::vector<RectF>>("TabHitAreas");
+  GuideSprite = EnsureGetMember<Sprite>("GuideSprite");
+  GuidePosition = EnsureGetMember<glm::vec2>("GuidePosition");
+  TryGetMember<float>("EnterDistance", EnterDistance);
+  TryGetMember<float>("PageSlideFrames", PageSlideFrames);
+  TryGetMember<float>("PageSlideStep", PageSlideStep);
+  TryGetMember<float>("BlinkFrames", BlinkFrames);
+
+  auto drawType = EnsureGetMember<Game::DrawComponentType>("DrawType");
+  UI::HelpMenuPtr = new UI::SGHD::HelpMenu();
+  UI::Menus[drawType].push_back(UI::HelpMenuPtr);
