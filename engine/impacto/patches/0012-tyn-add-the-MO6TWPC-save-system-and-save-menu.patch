+
+constexpr uint32_t FileVersion = 1;
+constexpr char FileMagic[4] = {'M', 'O', '6', 'S'};
+
+uint32_t Crc32(const uint8_t* data, size_t size) {
+  static const std::array<uint32_t, 256> table = [] {
+    std::array<uint32_t, 256> t{};
+    for (uint32_t i = 0; i < 256; i++) {
+      uint32_t c = i;
+      for (int k = 0; k < 8; k++) c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+      t[i] = c;
+    }
+    return t;
+  }();
+  uint32_t crc = 0xFFFFFFFFu;
+  for (size_t i = 0; i < size; i++) {
+    crc = table[(crc ^ data[i]) & 0xFF] ^ (crc >> 8);
+  }
+  return crc ^ 0xFFFFFFFFu;
+}
+
+class Writer {
+ public:
+  std::vector<uint8_t> Buf;
+  void Raw(const void* p, size_t n) {
+    const auto* b = static_cast<const uint8_t*>(p);
+    Buf.insert(Buf.end(), b, b + n);
+  }
+  template <typename T>
+  void Put(T v) {
+    static_assert(std::is_trivially_copyable_v<T>);
+    Raw(&v, sizeof(T));
+  }
+};
+
+class Reader {
+ public:
+  Reader(const uint8_t* d, size_t n) : Data(d), Size(n) {}
+  bool Ok = true;
+  void Raw(void* p, size_t n) {
+    if (!Ok || n > Size - Pos) {
+      Ok = false;
+      std::memset(p, 0, n);
+      return;
+    }
+    std::memcpy(p, Data + Pos, n);
+    Pos += n;
+  }
+  template <typename T>
+  T Get() {
+    T v{};
+    Raw(&v, sizeof(T));
+    return v;
+  }
+  size_t Remaining() const { return Size - Pos; }
+
+ private:
+  const uint8_t* Data;
+  size_t Size;
+  size_t Pos = 0;
+};
+
+void WriteEntry(Writer& w, const SaveFileEntry& e) {
+  w.Put<uint8_t>(e.Status);
+  w.Put<uint8_t>(e.Flags);
+  w.Put<uint32_t>(e.SaveType);
+  w.Put<int32_t>(e.SaveDate.tm_year);
+  w.Put<int32_t>(e.SaveDate.tm_mon);
+  w.Put<int32_t>(e.SaveDate.tm_mday);
+  w.Put<int32_t>(e.SaveDate.tm_hour);
+  w.Put<int32_t>(e.SaveDate.tm_min);
+  w.Put<int32_t>(e.SaveDate.tm_sec);
+  w.Put<uint32_t>(e.PlayTime);
+  w.Put<uint32_t>(e.SwTitle);
+  w.Raw(e.FlagWorkScript1.data(), e.FlagWorkScript1.size());
+  w.Raw(e.FlagWorkScript2.data(), e.FlagWorkScript2.size());
+  w.Raw(e.ScrWorkScript1.data(), e.ScrWorkScript1.size() * sizeof(int));
+  w.Raw(e.ScrWorkScript2.data(), e.ScrWorkScript2.size() * sizeof(int));
+  w.Put<uint32_t>(e.MainThreadExecPriority);
+  w.Put<uint32_t>(e.MainThreadGroupId);
+  w.Put<uint32_t>(e.MainThreadWaitCounter);
+  w.Put<uint32_t>(e.MainThreadScriptParam);
+  w.Put<uint32_t>(e.MainThreadIp);
+  w.Put<uint32_t>(e.MainThreadCallStackDepth);
+  for (int i = 0; i < 8; i++) w.Put<uint32_t>(e.MainThreadReturnIds[i]);
+  for (int i = 0; i < 8; i++) w.Put<uint32_t>(e.MainThreadReturnBufIds[i]);
+  w.Put<uint32_t>(e.MainThreadScriptBufferId);
+  for (int i = 0; i < 16; i++) w.Put<int32_t>(e.MainThreadVariables[i]);
+  w.Put<uint32_t>(e.MainThreadDialoguePageId);
+  w.Raw(e.ThumbnailData.data(), e.ThumbnailData.size());
+}
+
+void ReadEntry(Reader& r, SaveFileEntry& e) {
+  e.Status = 1;
+  e.Flags = r.Get<uint8_t>();
+  e.SaveType = r.Get<uint32_t>();
+  e.SaveDate = {};
+  e.SaveDate.tm_year = r.Get<int32_t>();
+  e.SaveDate.tm_mon = r.Get<int32_t>();
+  e.SaveDate.tm_mday = r.Get<int32_t>();
+  e.SaveDate.tm_hour = r.Get<int32_t>();
+  e.SaveDate.tm_min = r.Get<int32_t>();
+  e.SaveDate.tm_sec = r.Get<int32_t>();
+  e.PlayTime = r.Get<uint32_t>();
+  e.SwTitle = r.Get<uint32_t>();
+  r.Raw(e.FlagWorkScript1.data(), e.FlagWorkScript1.size());
+  r.Raw(e.FlagWorkScript2.data(), e.FlagWorkScript2.size());
+  r.Raw(e.ScrWorkScript1.data(), e.ScrWorkScript1.size() * sizeof(int));
+  r.Raw(e.ScrWorkScript2.data(), e.ScrWorkScript2.size() * sizeof(int));
+  e.MainThreadExecPriority = r.Get<uint32_t>();
+  e.MainThreadGroupId = r.Get<uint32_t>();
+  e.MainThreadWaitCounter = r.Get<uint32_t>();
+  e.MainThreadScriptParam = r.Get<uint32_t>();
+  e.MainThreadIp = r.Get<uint32_t>();
+  e.MainThreadCallStackDepth = r.Get<uint32_t>();
+  for (int i = 0; i < 8; i++) e.MainThreadReturnIds[i] = r.Get<uint32_t>();
+  for (int i = 0; i < 8; i++) e.MainThreadReturnBufIds[i] = r.Get<uint32_t>();
+  e.MainThreadScriptBufferId = r.Get<uint32_t>();
+  for (int i = 0; i < 16; i++) e.MainThreadVariables[i] = r.Get<int32_t>();
+  e.MainThreadDialoguePageId = r.Get<uint32_t>();
+  r.Raw(e.ThumbnailData.data(), e.ThumbnailData.size());
+  e.HasThumbnailData = true;
+}
+
+// SaveFilePath is UTF-8 (it comes from the profile). Building the path from
+// UTF-8 explicitly keeps non-ASCII directories working on Windows, where the
+// narrow std::string constructor would decode it with the ANSI code page.
+std::filesystem::path SavePath() {
+  return std::filesystem::path(std::u8string(
+      reinterpret_cast<const char8_t*>(SaveFilePath.data()),
+      SaveFilePath.size()));
+}
+
+bool ReadWholeFile(const std::filesystem::path& path,
+                   std::vector<uint8_t>& out) {
+  std::ifstream f(path, std::ios::binary);
+  if (!f) return false;
+  f.seekg(0, std::ios::end);
+  const std::streamoff size = f.tellg();
+  if (size < 0) return false;
+  f.seekg(0, std::ios::beg);
+  out.resize(static_cast<size_t>(size));
+  if (size > 0) f.read(reinterpret_cast<char*>(out.data()), size);
+  return static_cast<bool>(f);
+}
+
+// Write to <path>.tmp, flush it to disk and rename it over <path>: a kill
+// mid-write leaves the previous file intact.
+bool WriteFileAtomic(const std::filesystem::path& target,
+                     const std::vector<uint8_t>& data) {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  if (target.has_parent_path()) {
+    fs::create_directories(target.parent_path(), ec);
+  }
+  fs::path tmp = target;
+  tmp += ".tmp";
+
+  // path::c_str() is the native encoding (wide on Windows), so nothing is
+  // lost in a narrow conversion
+#ifdef _WIN32
+  FILE* f = _wfopen(tmp.c_str(), L"wb");
+#else
+  FILE* f = std::fopen(tmp.c_str(), "wb");
+#endif
+  if (!f) return false;
+  bool ok = std::fwrite(data.data(), 1, data.size(), f) == data.size();
+  ok = (std::fflush(f) == 0) && ok;
+#ifndef _WIN32
+  if (ok) ok = (fsync(fileno(f)) == 0);
+#endif
+  ok = (std::fclose(f) == 0) && ok;
+  if (!ok) {
+    fs::remove(tmp, ec);
+    return false;
+  }
+  fs::rename(tmp, target, ec);
+  if (ec) {
+    fs::remove(tmp, ec);
+    return false;
+  }
+  return true;
+}
+
+uint16_t Rgb565(uint8_t r, uint8_t g, uint8_t b) {
+  return static_cast<uint16_t>(((r & 0xF8) << 8) | ((g & 0xFC) << 3) |
+                               (b >> 3));
+}
+
+}  // namespace
+
+void SaveSystem::InitSaveSlots() {
+  for (auto* arr : {FullSaveEntries, QuickSaveEntries}) {
+    for (int i = 0; i < MaxSaveEntries; i++) {
+      delete static_cast<SaveFileEntry*>(arr[i]);
+      arr[i] = new SaveFileEntry();
+    }
+  }
+  WorkingSaveEntry = std::make_unique<SaveFileEntry>();
+  LockedQuickSaveCount = 0;
+  QuickSavedOnCurrentLine = false;
+}
+
+void SaveSystem::InitializeSystemData() {
+  InitSaveSlots();
+
+  const RectF viewport = Window->GetViewport();
+  WorkingSaveThumbnail.Sheet = SpriteSheet(viewport.Width, viewport.Height);
+  WorkingSaveThumbnail.Bounds.SetSize(viewport.GetSize());
+
+  Texture workingSaveTexture = Texture();
+  workingSaveTexture.LoadSolidColor(
+      static_cast<int>(WorkingSaveThumbnail.Bounds.Width),
+      static_cast<int>(WorkingSaveThumbnail.Bounds.Height), 0x000000);
+  WorkingSaveThumbnail.Sheet.Texture = workingSaveTexture.Submit();
+
+  SaveSystemData();
+}
+
+void SaveSystem::SaveSystemData() {
+  Writer w;
+  w.Raw(&FlagWork[SysFlagWorkSrc1], SysFlagWorkLen1);
+  w.Raw(&FlagWork[SysFlagWorkSrc2], SysFlagWorkLen2);
+  w.Raw(&ScrWork[SysScrWorkSrc], SysScrWorkLen * sizeof(int));
+
+  // Settings (floats rather than CC's scaled bytes: no clipping of values)
+  w.Put<float>(Cfg::TextSpeed);
+  w.Put<float>(Cfg::AutoSpeed);
+  w.Put<uint8_t>(Cfg::SkipRead);
+  w.Put<uint8_t>(Cfg::SyncVoice);
+  w.Put<uint8_t>(Cfg::SkipVoice);
+  w.Put<uint8_t>(Cfg::ShowTipsNotification);
+  w.Put<uint8_t>(Cfg::AutoQuickSave);
+  w.Put<uint8_t>(Cfg::AdvanceTextOnDirectionalInput);
+  w.Put<uint8_t>(Cfg::DirectionalInputForTrigger);
+  w.Put<uint8_t>(Cfg::TriggerStopSkip);
+  w.Put<uint32_t>(static_cast<uint32_t>(Audio::GroupVolumes.size()));
+  for (float v : Audio::GroupVolumes) w.Put<float>(v);
+  for (bool v : Cfg::VoiceMuted) w.Put<uint8_t>(v);
+  for (float v : Cfg::VoiceVolume) w.Put<float>(v);
+
+  w.Raw(QuickSaveRecentSortedId.data(), QuickSaveRecentSortedId.size());
+  for (bool v : EVFlags) w.Put<uint8_t>(v);
+  w.Raw(BGMFlags.data(), BGMFlags.size());
+  w.Raw(GameExtraData.data(), GameExtraData.size());
+
+  std::vector<uint32_t> lines(ReadLines.begin(), ReadLines.end());
+  std::ranges::sort(lines);
+  w.Put<uint32_t>(static_cast<uint32_t>(lines.size()));
+  w.Raw(lines.data(), lines.size() * sizeof(uint32_t));
+
+  SystemData = std::move(w.Buf);
+}
+
+SaveError SaveSystem::LoadSystemData() {
+  if (SystemData.empty()) return SaveError::OK;
+  Reader r(SystemData.data(), SystemData.size());
+
+  // Everything is parsed into locals and applied only once the whole blob has
+  // been read and checked: a truncated or corrupt blob must not leave part of
+  // the game state replaced.
+  std::array<uint8_t, SysFlagWorkLen1> flags1;
+  std::array<uint8_t, SysFlagWorkLen2> flags2;
+  std::array<int, SysScrWorkLen> scrWork;
+  r.Raw(flags1.data(), flags1.size());
+  r.Raw(flags2.data(), flags2.size());
+  r.Raw(scrWork.data(), scrWork.size() * sizeof(int));
+
+  const float textSpeed = r.Get<float>();
+  const float autoSpeed = r.Get<float>();
+  const bool skipRead = r.Get<uint8_t>();
+  const bool syncVoice = r.Get<uint8_t>();
+  const bool skipVoice = r.Get<uint8_t>();
+  const bool showTips = r.Get<uint8_t>();
+  const uint8_t autoQuick = r.Get<uint8_t>();
+  const bool advDir = r.Get<uint8_t>();
+  const bool dirTrig = r.Get<uint8_t>();
+  const bool trigStop = r.Get<uint8_t>();
+  const uint32_t groupCount = r.Get<uint32_t>();
+  std::array<float, Audio::ACG_Count> groupVolumes = Audio::GroupVolumes;
+  for (uint32_t i = 0; i < groupCount && r.Ok; i++) {
+    float v = r.Get<float>();
+    if (i < groupVolumes.size()) groupVolumes[i] = v;
+  }
+  std::array<bool, Cfg::VoiceCount> muted = Cfg::VoiceMuted;
+  std::array<float, Cfg::VoiceCount> volume = Cfg::VoiceVolume;
+  for (auto& v : muted) v = r.Get<uint8_t>();
+  for (auto& v : volume) v = r.Get<float>();
+
+  std::array<uint8_t, MaxSaveEntries> quickIds = QuickSaveRecentSortedId;
+  r.Raw(quickIds.data(), quickIds.size());
+  std::array<bool, 1200> evFlags{};
+  for (auto& v : evFlags) v = r.Get<uint8_t>() != 0;
+  std::array<uint8_t, 200> bgmFlags{};
+  r.Raw(bgmFlags.data(), bgmFlags.size());
+  std::array<uint8_t, 1024> extraData{};
+  r.Raw(extraData.data(), extraData.size());
+
+  const uint32_t lineCount = r.Get<uint32_t>();
+  std::unordered_set<uint32_t> readLines;
+  if (r.Ok && lineCount <= r.Remaining() / sizeof(uint32_t)) {
+    readLines.reserve(lineCount);
+    for (uint32_t i = 0; i < lineCount; i++)
+      readLines.insert(r.Get<uint32_t>());
+  } else {
+    r.Ok = false;
+  }
+
+  if (!r.Ok) return SaveError::Corrupted;
+
+  // A corrupt permutation would break the quick slot lookup
+  std::array<bool, MaxSaveEntries> seen{};
+  bool validIds = true;
+  for (uint8_t id : quickIds) {
+    if (id >= MaxSaveEntries || seen[id]) {
+      validIds = false;
+    } else {
+      seen[id] = true;
+    }
+  }
+  if (!validIds) {
+    std::iota(quickIds.begin(), quickIds.end(), uint8_t{0});
+  }
+
+  // The whole blob parsed: apply it
+  std::ranges::copy(flags1, FlagWork.begin() + SysFlagWorkSrc1);
+  std::ranges::copy(flags2, FlagWork.begin() + SysFlagWorkSrc2);
+  std::ranges::copy(scrWork, ScrWork.begin() + SysScrWorkSrc);
+  QuickSaveRecentSortedId = quickIds;
+  EVFlags = evFlags;
+  BGMFlags = bgmFlags;
+  GameExtraData = extraData;
+  ReadLines = std::move(readLines);
+  Cfg::TextSpeed = textSpeed;
+  Cfg::AutoSpeed = autoSpeed;
+  Cfg::SkipRead = skipRead;
+  Cfg::SyncVoice = syncVoice;
+  Cfg::SkipVoice = skipVoice;
+  Cfg::ShowTipsNotification = showTips;
+  Cfg::AutoQuickSave = autoQuick;
+  Cfg::AdvanceTextOnDirectionalInput = advDir;
+  Cfg::DirectionalInputForTrigger = dirTrig;
+  Cfg::TriggerStopSkip = trigStop;
+  Audio::GroupVolumes = groupVolumes;
+  Cfg::VoiceMuted = muted;
+  Cfg::VoiceVolume = volume;
+  return SaveError::OK;
+}
+
+SaveError SaveSystem::CheckSaveFile() const {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  const fs::path p = SavePath();
+  const bool exists = fs::exists(p, ec);
+  if (ec) return SaveError::Failed;
+  if (!exists) return SaveError::NotFound;
+  const auto size = fs::file_size(p, ec);
+  if (ec) return SaveError::Failed;
+  if (size < 16) return SaveError::Corrupted;
+  std::ifstream f(p, std::ios::binary);
+  if (!f) return SaveError::WrongUser;
+  char magic[4];
+  f.read(magic, 4);
+  if (!f || std::memcmp(magic, FileMagic, 4) != 0) return SaveError::Corrupted;
+  return SaveError::OK;
+}
+
+SaveError SaveSystem::MountSaveFile(std::vector<QueuedTexture>& textures) {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  if (!fs::exists(SavePath(), ec)) return SaveError::NotFound;
+
+  std::vector<uint8_t> data;
+  if (!ReadWholeFile(SavePath(), data)) return SaveError::Failed;
+  if (data.size() < 16 || std::memcmp(data.data(), FileMagic, 4) != 0) {
+    return SaveError::Corrupted;
+  }
+  uint32_t storedCrc;
+  std::memcpy(&storedCrc, data.data() + data.size() - 4, 4);
+  if (Crc32(data.data(), data.size() - 4) != storedCrc) {
+    ImpLog(LogLevel::Error, LogChannel::IO,
+           "Save file checksum mismatch, treating it as corrupted\n");
+    return SaveError::Corrupted;
+  }
+
+  Reader r(data.data(), data.size() - 4);
+  char magic[4];
+  r.Raw(magic, 4);
+  const uint32_t version = r.Get<uint32_t>();
+  if (version != FileVersion) return SaveError::Corrupted;
+  const uint32_t systemSize = r.Get<uint32_t>();
+  if (systemSize > r.Remaining()) return SaveError::Corrupted;
+  std::vector<uint8_t> system(systemSize);
+  r.Raw(system.data(), systemSize);
+  const uint32_t fullCount = r.Get<uint32_t>();
+  const uint32_t quickCount = r.Get<uint32_t>();
+  if (!r.Ok || fullCount != MaxSaveEntries || quickCount != MaxSaveEntries) {
+    return SaveError::Corrupted;
+  }
+
+  std::vector<std::unique_ptr<SaveFileEntry>> parsed;
+  parsed.reserve(fullCount + quickCount);
+  for (uint32_t i = 0; i < fullCount + quickCount; i++) {
+    auto entry = std::make_unique<SaveFileEntry>();
+    const uint8_t status = r.Get<uint8_t>();
+    if (status != 0) ReadEntry(r, *entry);
+    if (!r.Ok) return SaveError::Corrupted;
+    parsed.push_back(std::move(entry));
+  }
+
+  // Parsed completely: now replace the in-memory state. The entry objects
+  // stay in place (the queued textures reference their sprites).
+  SystemData = std::move(system);
+  int locked = 0;
+  for (uint32_t i = 0; i < parsed.size(); i++) {
+    const bool quick = i >= fullCount;
+    auto* slot = static_cast<SaveFileEntry*>(
+        quick ? QuickSaveEntries[i - fullCount] : FullSaveEntries[i]);
+    *slot = std::move(*parsed[i]);
+    if (quick && (slot->Flags & WriteProtect)) locked++;
+    if (slot->Status == 0) continue;
+
+    const float w = ThumbnailWidth, h = ThumbnailHeight;
+    slot->SaveThumbnail.Sheet = SpriteSheet(w, h);
+    slot->SaveThumbnail.Bounds = RectF(0.0f, 0.0f, w, h);
+    QueuedTexture tex{.Id = std::ref(slot->SaveThumbnail.Sheet.Texture)};
+    tex.Tex.Init(TexFmt_RGB, ThumbnailWidth, ThumbnailHeight);
+    for (size_t p = 0; p < ThumbnailBytes / 2; p++) {
+      const uint16_t px = static_cast<uint16_t>(
+          slot->ThumbnailData[p * 2] | (slot->ThumbnailData[p * 2 + 1] << 8));
+      tex.Tex.Buffer[3 * p] = (px & 0xF800) >> 8;
+      tex.Tex.Buffer[3 * p + 1] = (px & 0x07E0) >> 3;
+      tex.Tex.Buffer[3 * p + 2] = (px & 0x001F) << 3;
+    }
+    textures.push_back(std::move(tex));
+  }
+  LockedQuickSaveCount = locked;
+  return SaveError::OK;
+}
+
+// Runs on the main thread, when no other save file task is running. The slots
+// are serialised here so that the worker thread never reads them while the
+// game keeps flushing entries into them.
+void SaveSystem::PrepareSaveFileWrite() {
+  Writer w;
+  w.Raw(FileMagic, 4);
+  w.Put<uint32_t>(FileVersion);
+  w.Put<uint32_t>(static_cast<uint32_t>(SystemData.size()));
+  w.Raw(SystemData.data(), SystemData.size());
+  w.Put<uint32_t>(MaxSaveEntries);
+  w.Put<uint32_t>(MaxSaveEntries);
+  for (auto* arr : {FullSaveEntries, QuickSaveEntries}) {
+    for (int i = 0; i < MaxSaveEntries; i++) {
+      const auto* e = static_cast<const SaveFileEntry*>(arr[i]);
+      if (e == nullptr || e->Status == 0) {
+        w.Put<uint8_t>(0);
+      } else {
+        WriteEntry(w, *e);
+      }
+    }
+  }
+  w.Put<uint32_t>(Crc32(w.Buf.data(), w.Buf.size()));
+  PendingFile = std::move(w.Buf);
+}
+
+// Runs on a worker thread and only touches PendingFile
+SaveError SaveSystem::WriteSaveFile() {
+  const bool ok =
+      !PendingFile.empty() && WriteFileAtomic(SavePath(), PendingFile);
+  std::vector<uint8_t>().swap(PendingFile);  // up to several MB, not kept
+  if (!ok) {
+    ImpLog(LogLevel::Error, LogChannel::IO, "Failed to write save file {:s}\n",
+           SaveFilePath);
+    return SaveError::Failed;
+  }
+  return SaveError::OK;
+}
+
+void SaveSystem::FlushWorkingSaveEntry(SaveType type, int id,
+                                       int autoSaveType) {
+  auto* entry = GetSaveEntry<SaveFileEntry>(type, id);
+  if (entry == nullptr || (entry->Flags & WriteProtect)) return;
+
+  Renderer->FreeTexture(entry->SaveThumbnail.Sheet.Texture);
+  const uint8_t savedFlags = entry->Flags;
+  *entry = *WorkingSaveEntry;
+  entry->Flags = savedFlags;
+  if (type == SaveType::Quick) {
+    entry->SaveType = autoSaveType;
+    UpdateQuickSaveRecentSortedId(id);
+  }
+  entry->SaveDate = CurrentDateTime();
+  entry->Status = 1;
+
+  // Thumbnail: the frame captured at the end of the last render
+  const float w = ThumbnailWidth, h = ThumbnailHeight;
+  auto captureBuffer =
+      Renderer->GetSpriteSheetImage(WorkingSaveThumbnail.Sheet);
+  Texture tex;
+  tex.Init(TexFmt_RGBA, ThumbnailWidth, ThumbnailHeight);
+  entry->SaveThumbnail.Sheet = SpriteSheet(w, h);
+  entry->SaveThumbnail.Bounds = RectF(0.0f, 0.0f, w, h);
+  if (ResizeImage(WorkingSaveThumbnail.Bounds, entry->SaveThumbnail.Bounds,
+                  captureBuffer, tex.Buffer) < 0) {
+    ImpLog(LogLevel::Error, LogChannel::General,
+           "Failed to resize save thumbnail\n");
+  }
+  for (size_t p = 0; p < ThumbnailBytes / 2; p++) {
+    const uint16_t px =
+        Rgb565(tex.Buffer[4 * p], tex.Buffer[4 * p + 1], tex.Buffer[4 * p + 2]);
+    entry->ThumbnailData[p * 2] = px & 0xFF;
+    entry->ThumbnailData[p * 2 + 1] = px >> 8;
+  }
+  entry->HasThumbnailData = true;
+  entry->SaveThumbnail.Sheet.Texture = tex.Submit();
+}
+
+void SaveSystem::SaveMemory() {
+  if (!WorkingSaveEntry) return;
+  WorkingSaveEntry->Status = 1;
+  WorkingSaveEntry->SaveDate = CurrentDateTime();
+  WorkingSaveEntry->PlayTime = ScrWork[SW_PLAYTIME];
+  WorkingSaveEntry->SwTitle = ScrWork[SW_TITLE];
+
+  std::copy_n(FlagWork.begin() + FlagWorkScript1Src, FlagWorkScript1Len,
+              WorkingSaveEntry->FlagWorkScript1.begin());
+  std::copy_n(FlagWork.begin() + FlagWorkScript2Src, FlagWorkScript2Len,
+              WorkingSaveEntry->FlagWorkScript2.begin());
+  std::copy_n(ScrWork.begin() + ScrWorkScript1Src, ScrWorkScript1Len,
+              WorkingSaveEntry->ScrWorkScript1.begin());
+  std::copy_n(ScrWork.begin() + ScrWorkScript2Src, ScrWorkScript2Len,
+              WorkingSaveEntry->ScrWorkScript2.begin());
+
+  const int threadId = ScrWork[SW_MAINTHDP];
+  Sc3VmThread* thd = &ThreadPool[threadId & 0x7FFFFFFF];
+  if (thd->GroupId - 5 < 3) {
+    WorkingSaveEntry->MainThreadExecPriority = thd->ExecPriority;
+    WorkingSaveEntry->MainThreadWaitCounter = thd->WaitCounter;
+    WorkingSaveEntry->MainThreadScriptParam = thd->ScriptParam;
+    WorkingSaveEntry->MainThreadGroupId = thd->GroupId;
+    WorkingSaveEntry->MainThreadScriptBufferId = thd->ScriptBufferId;
+    // The checkpoint id (MainThreadIp) is set by AutoSave(10) through
+    // SetCheckpointId
+    const size_t depth = std::min<size_t>(thd->CallStackDepth, 8);
+    WorkingSaveEntry->MainThreadCallStackDepth = static_cast<uint32_t>(depth);
+    for (size_t i = 0; i < depth; i++) {
+      WorkingSaveEntry->MainThreadReturnBufIds[i] =
+          thd->ReturnScriptBufferIds[i];
+      WorkingSaveEntry->MainThreadReturnIds[i] = thd->ReturnIds[i];
+    }
+    std::memcpy(WorkingSaveEntry->MainThreadVariables.data(), thd->Variables,
+                16 * sizeof(int));
+    WorkingSaveEntry->MainThreadDialoguePageId = thd->DialoguePageId;
+  }
+}
+
+void SaveSystem::SetCheckpointId(int id) {
+  if (WorkingSaveEntry) WorkingSaveEntry->MainThreadIp = id;
+}
+
+void SaveSystem::LoadEntry(SaveType type, int id) {
+  if (!WorkingSaveEntry) {
+    ImpLog(LogLevel::Error, LogChannel::IO,
+           "Failed to load save entry: no working save\n");
+    return;
+  }
+  if (id < 0 || id >= MaxSaveEntries) {
+    ImpLog(LogLevel::Error, LogChannel::IO, "Save slot {:d} out of range\n",
+           id);
+    return;
+  }
+  const auto* entry = GetSaveEntry<SaveFileEntry>(type, id);
+  if (entry == nullptr || entry->Status == 0) {
+    ImpLog(LogLevel::Error, LogChannel::IO, "Failed to load empty save slot\n");
+    return;
+  }
+  // The sprite is only a view of a GPU texture owned by the slot
+  Sprite thumb = WorkingSaveEntry->SaveThumbnail;
+  *WorkingSaveEntry = *entry;
+  WorkingSaveEntry->SaveThumbnail = thumb;
+}
+
+void SaveSystem::LoadMemoryNew(LoadProcess load) {
+  if (!WorkingSaveEntry || WorkingSaveEntry->Status == 0) {
+    ImpLog(LogLevel::Error, LogChannel::IO,
+           "Failed to load entry: save is empty\n");
+    return;
+  }
+  if (load == LoadProcess::Vars) {
+    ScrWork[SW_PLAYTIME] = WorkingSaveEntry->PlayTime;
+    ScrWork[SW_TITLE] = WorkingSaveEntry->SwTitle;
+    ScrWork[SW_AUTOSAVERESTART] = WorkingSaveEntry->SaveType;
+
+    std::ranges::copy(WorkingSaveEntry->FlagWorkScript1,
+                      FlagWork.begin() + FlagWorkScript1Src);
+    std::ranges::copy(WorkingSaveEntry->FlagWorkScript2,
+                      FlagWork.begin() + FlagWorkScript2Src);
+    std::ranges::copy(WorkingSaveEntry->ScrWorkScript1,
+                      ScrWork.begin() + ScrWorkScript1Src);
+    std::ranges::copy(WorkingSaveEntry->ScrWorkScript2,
+                      ScrWork.begin() + ScrWorkScript2Src);
+    LoadScrWork();
+  } else if (load == LoadProcess::Thread && ScrWork[SW_MAINTHDP] != 0) {
+    const int threadId = ScrWork[SW_MAINTHDP];
+    Sc3VmThread* thd = &ThreadPool[threadId & 0x7FFFFFFF];
+    if (thd->GroupId - 5 < 3) {
+      thd->ExecPriority = WorkingSaveEntry->MainThreadExecPriority;
+      thd->WaitCounter = WorkingSaveEntry->MainThreadWaitCounter;
+      thd->ScriptParam = WorkingSaveEntry->MainThreadScriptParam;
+      thd->GroupId = WorkingSaveEntry->MainThreadGroupId;
+      thd->ScriptBufferId = WorkingSaveEntry->MainThreadScriptBufferId;
+      thd->IpOffset =
+          ScriptGetRetAddress(WorkingSaveEntry->MainThreadScriptBufferId,
+                              WorkingSaveEntry->MainThreadIp);
+      thd->CallStackDepth =
+          std::min<uint32_t>(WorkingSaveEntry->MainThreadCallStackDepth, 8);
+      for (size_t i = 0; i < thd->CallStackDepth; i++) {
+        thd->ReturnScriptBufferIds[i] =
+            WorkingSaveEntry->MainThreadReturnBufIds[i];
+        thd->ReturnIds[i] = (uint16_t)WorkingSaveEntry->MainThreadReturnIds[i];
+      }
+      std::memcpy(thd->Variables, WorkingSaveEntry->MainThreadVariables.data(),
+                  16 * sizeof(int));
+      thd->DialoguePageId = WorkingSaveEntry->MainThreadDialoguePageId;
+    }
+  }
+}
+
+// The script restores sound, scripts, BGs and characters from the SV
+// variables (SW_SVSENO 3601, SW_SVBGMNO 3605, SW_SVSCRNO1 3606, SW_SVBGNO1
+// 3610 x8, SW_SVCHANO1 3618 x16, SW_SVBGM2NO 3634; see _startup.scx labels
+// 242-270), which mirror the live ScrWork of the saved state.
+void SaveSystem::LoadScrWork() {
+  ScrWork[SW_SVSENO] = ScrWork[SW_SEREQNO];
+  ScrWork[SW_SVSENO + 1] = ScrWork[SW_SEREQNO + 1];
+  ScrWork[SW_SVSENO + 2] = ScrWork[SW_SEREQNO + 2];
+  ScrWork[SW_SVBGMNO] = ScrWork[SW_BGMREQNO];
+  ScrWork[SW_SVBGM2NO] = ScrWork[SW_BGMREQNO2];
+  ScrWork[SW_SVSCRNO1] = ScrWork[SW_SCRIPTNO2];
+  ScrWork[SW_SVSCRNO2] = ScrWork[SW_SCRIPTNO3];
+  ScrWork[SW_SVSCRNO3] = ScrWork[SW_SCRIPTNO4];
+  ScrWork[SW_SVSCRNO4] = ScrWork[SW_SCRIPTNO5];
+  for (int i = 0; i < 8; i++) {
+    ScrWork[SW_SVBGNO1 + i] = ScrWork[SW_BG1NO + i * ScrWorkBgStructSize];
+  }
+  for (int i = 0; i < 16; i++) {
+    ScrWork[SW_SVCHANO1 + i] = ScrWork[SW_CHA1NO + i * ScrWorkChaStructSize];
+  }
+}
+
+uint32_t SaveSystem::GetSavePlayTime(SaveType type, int id) const {
+  return GetSaveEntry<SaveFileEntry>(type, id)->PlayTime;
+}
