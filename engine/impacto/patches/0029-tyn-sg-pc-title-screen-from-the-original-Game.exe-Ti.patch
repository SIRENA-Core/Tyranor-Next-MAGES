@@ -0,0 +1,77 @@
+#include "titlemenu.h"
+#include "../../profile_internal.h"
+#include "../../../ui/ui.h"
+#include "../../../game.h"
+#include "../../../games/sghd/titlemenu.h"
+
+namespace Impacto {
+namespace Profile {
+namespace SGHD {
+namespace TitleMenu {
+
+void Configure() {
+  BackgroundSprite = EnsureGetMember<Sprite>("BackgroundSprite");
+  GuideSprite = EnsureGetMember<Sprite>("GuideSprite");
+  GuidePosition = EnsureGetMember<glm::vec2>("GuidePosition");
+  TryGetMember<float>("PressToStartBlinkFrames", PressToStartBlinkFrames);
+  MenuPosition = EnsureGetMember<glm::vec2>("MenuPosition");
+  MenuSpacing = EnsureGetMember<float>("MenuSpacing");
+  TryGetMember<float>("MenuSlideDistance", MenuSlideDistance);
+  MenuHitAreas = EnsureGetMember<std::vector<RectF>>("MenuHitAreas");
+  MenuEntryIds = EnsureGetMember<std::vector<int>>("MenuEntryIds");
+  TryGetMember<float>("SubOpenFrames", SubOpenFrames);
+  TryGetMember<float>("SubSlideDistance", SubSlideDistance);
+  TryGetMember<float>("DecideFrames", DecideFrames);
+  TryGetMember<int>("DecideBlinkFrames", DecideBlinkFrames);
+
+  FlickerItems.clear();
+  if (TryPushMember("FlickerItems")) {
+    ForEachProfileArray([&](uint32_t) {
+      FlickerItem item;
+      item.Sprite_ = EnsureGetMember<Sprite>("Sprite");
+      item.Position = EnsureGetMember<glm::vec2>("Position");
+      TryGetMember<bool>("Random", item.Random);
+      FlickerItems.push_back(item);
+    });
+    Pop();
+  }
+  if (TryPushMember("FlickerBar")) {
+    FlickerBarSprite = EnsureGetMember<Sprite>("Sprite");
+    FlickerBarPosition = EnsureGetMember<glm::vec2>("Position");
+    FlickerBarWidths = EnsureGetMember<std::vector<float>>("Widths");
+    Pop();
+  }
+
+  SubLists.clear();
+  EnsurePushMemberOfType("SubLists", LUA_TTABLE);
+  ForEachProfileArray([&](uint32_t) {
+    SubList list;
+    list.Entry = EnsureGetMember<int>("Entry");
+    TryGetMember<int>("IfFlag", list.IfFlag);
+    TryGetMember<int>("IfNotFlag", list.IfNotFlag);
+    list.Bracket = EnsureGetMember<Sprite>("BracketSprite");
+    list.BracketPosition = EnsureGetMember<glm::vec2>("BracketPosition");
+    EnsurePushMemberOfType("Items", LUA_TTABLE);
+    ForEachProfileArray([&](uint32_t) {
+      SubItem item;
+      item.Normal = EnsureGetMember<Sprite>("Sprite");
+      item.Highlighted = EnsureGetMember<Sprite>("HighlightedSprite");
+      item.Position = EnsureGetMember<glm::vec2>("Position");
+      item.HitArea = EnsureGetMember<RectF>("HitArea");
+      item.Id = EnsureGetMember<int>("Id");
+      list.Items.push_back(item);
+    });
+    Pop();
+    SubLists.push_back(std::move(list));
+  });
+  Pop();
+
+  auto drawType = EnsureGetMember<Game::DrawComponentType>("DrawType");
+  UI::TitleMenuPtr = new UI::SGHD::TitleMenu();
+  UI::Menus[drawType].push_back(UI::TitleMenuPtr);
+}
+
+}  // namespace TitleMenu
+}  // namespace SGHD
+}  // namespace Profile
+}  // namespace Impacto
