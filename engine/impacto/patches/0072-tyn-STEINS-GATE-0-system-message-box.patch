+// clear it, 2 sets the title, 3 adds a line, 4 a choice, 5 waits for the choice (ScrWork 0x2140), 6 / 7 fade it in
+// / out (alpha ScrWork 0x3430). Mode 1 opens a message over another one (0x457dc0 keeps and restores the first).
+// The original repeats the instruction (0x2ed13a0) while it waits or fades.
+bool SystemMesInstruction(Vm::Sc3VmThread* thread) {
+  auto I32 = [](uint32_t a) -> int32_t& { return *reinterpret_cast<int32_t*>(Sg0Emu::At(a)); };
+  int32_t& active = I32(0x02ee6fc0);
+  int32_t& closing = I32(0x02ee6fc4);
+  int32_t& state = I32(0x02ee6fc8);
+  int& alpha = *reinterpret_cast<int*>(DAT_02ee7660 + 0x3430);
+  const uint32_t start = thread->IpOffset;
+  const uint8_t* ip = thread->GetIp();
+  uint8_t type = ip[2];
+  const uint8_t mode = ip[3];
+  thread->IpOffset += 4;
+  auto again = [&] {
+    thread->IpOffset = start;
+    return true;
+  };
+  if (mode == 0) {
+    active = 1;
+    if (type > 7) return false;
+  } else if (mode != 1 || active == 0) {
+    if (type > 7) return false;
+  } else {
+    const int kept = FUN_00457dc0(1);
+    state = kept == 0x100 ? 5 : 0;
+    type = 7;
+  }
+  switch (type) {
+    case 0:
+    case 1:
+      FUN_00458780(type);
+      return false;
+    case 2:
+      FUN_00458670(Vm::ExpressionEval(thread));
+      return false;
+    case 3:
+    case 4: {
+      const uint8_t* p = thread->GetIp();
+      const uint32_t str = FUN_0047f1f0(thread->ScriptBufferId, (uint32_t)(p[0] | (p[1] << 8)));
+      thread->IpOffset += 2;
+      if (type == 3)
+        FUN_004589b0(str);
+      else
+        FUN_004589f0(str);
+      return false;
+    }
+    case 5: {
+      I32(0x02ee6fbc) = 1;
+      BridgeInput();
+      const bool chosen = FUN_004587c0() != 0;
+      Vm::Interface::PADinputButtonWentDown = *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x01979f10));
+      ClearMouse();
+      if (chosen || FUN_004919d0(0x70d) == 1) return false;
+      return again();
+    }
+    case 6:
+      if ((uint32_t)alpha > 0xff) return false;
+      alpha += 0x10;
+      break;
+    case 7:
+      if (alpha != 0 && state != 4) {
+        alpha -= 0x10;
+        return again();
+      }
+      if (closing == 0) {
+        if (mode != 1 || active == 0) return false;
+        active = 0;
+        closing = 1;
+        return again();
+      }
+      if (state != 4) FUN_00457dc0(0);
+      if (state == 5) {
+        alpha = 0;
+        state = 4;
+      } else if (state != 4) {
+        closing = 0;
+        state = 0;
+        return false;
+      }
+      if ((uint32_t)alpha > 0xff) {
+        closing = 0;
+        state = 0;
+        return false;
+      }
+      alpha += 0x10;
+      break;
+  }
+  if (alpha > 0x100) alpha = 0x100;
+  return again();
+}
+
+void RenderSystemMessage() {
+  const int alpha = *reinterpret_cast<int*>(DAT_02ee7660 + 0x3430);
+  if (alpha != 0) FUN_00458200(alpha);
+}
