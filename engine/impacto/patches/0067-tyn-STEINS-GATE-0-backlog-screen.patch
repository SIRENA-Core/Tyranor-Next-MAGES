+        w += Rd(0x5c9b58)[code] * sz >> 5;
+      else if (code >= 0x1ec0)
+        w += Rd(0x5c9b59)[0] * sz >> 5;
+      else
+        w += sz;
+      n++;
+      s.Offset += 2;
+    } else if (*p == 4) {
+      TagValue(s);
+    } else {
+      s.Offset++;
+    }
+  }
+  return (int)w;
+}
