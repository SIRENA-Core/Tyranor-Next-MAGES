+// 0x454b20 mode 13: settings menu (wallpaper, ringtone, ...)
+void ModeSettings() {
+  if (Cancel()) {
+    SW(0x6a70) = 3;
+    SetMode(0x14);
+    return;
+  }
+  S.Hover = 0;
+  if (MouseMode()) {
+    SW(0x6aec) = 0xff;
+    for (int i = 0; i < 3; i++)
+      if (Hit(i + 5, 1)) S.Hover = 1, SW(0x6aec) = i;
+    for (int i = 0; i < 3; i++)
+      if (Hit(i + 5, 8)) ClickDecide();
+  }
+  if (!Decide()) {
+    if (Up()) SW(0x6aec) = SW(0x6aec) == 0xff ? 0 : (SW(0x6aec) == 0 ? 2 : SW(0x6aec) - 1);
+    if (Down()) {
+      const uint32_t v = SW(0x6aec);
+      SW(0x6aec) = (v == 0xff || v > 1) ? 0 : v + 1;
+    }
+    return;
+  }
+  switch (SW(0x6aec)) {
+    case 0: {  // wallpapers
+      uint32_t i = 0;
+      for (; i < S.WallpaperListCount; i++)
+        if ((uint32_t)SW(0x1f68) == S.WallpaperList[i]) break;
+      if (i == S.WallpaperListCount) i = S.WpSel;
+      S.WpPages = (S.WallpaperListCount + 5) / 6;
+      S.WpPage = i / 6;
+      S.WpSel = i % 6;
+      SetMode(0xe);
+      if (MouseMode()) S.WpSel = 0xff;
+      S.WpPrev = SW(0x1f68);
+      return;
+    }
+    case 1:
+    case 2: {  // ringtones for calls (1) and mails (2)
+      const int var = SW(0x6aec) == 1 ? 0x1f6c : 0x1f74;
+      SW(0x6af0) = 0;
+      if (SW(var) != 0xffff)
+        for (uint32_t i = 0; i < S.RingtoneListCount; i++)
+          if ((uint32_t)SW(var) == S.Ringtones[S.RingtoneList[i]][SW(0x6aec) == 1 ? 0 : 1]) {
+            SW(0x6af0) = i + 1;
+            break;
+          }
+      SW(0x6af4) = S.RingtoneListCount + 1;
+      SetMode(SW(0x6aec) == 1 ? 0xf : 0x10);
+      break;
+    }
+    case 3:
+      SW(0x6af0) = SW(0x1f70) == 0xffff ? 0 : SW(0x1f70) + 1;
+      SetMode(0x11);
+      break;
+    case 4:
+      SW(0x6af0) = SW(0x1f78) == 0xffff ? 0 : SW(0x1f78) + 1;
+      SetMode(0x12);
+      break;
+    default:
+      return;
+  }
+  if (MouseMode()) SW(0x6af0) = 0xff;
+}
+
+void WpPrevPage() { S.WpPage = (S.WpPage == 0 ? S.WpPages : S.WpPage) - 1; }
+void WpNextPage() { S.WpPage = S.WpPage < S.WpPages - 1 ? S.WpPage + 1 : 0; }
+
+// 0x454e90 mode 14: wallpapers
+void ModeWallpapers() {
+  if (Cancel()) {
+    SetMode(0xd);
+    SW(0x2eec) = SW(0x1f68);
+    if (MouseMode()) SW(0x6aec) = 0xff;
+    return;
+  }
+  S.Hover = 0;
+  if (MouseMode()) {
+    S.WpSel = 0xff;
+    S.ArrowHover = 0;
+    if (Hit(0, 0x200)) WpPrevPage();
+    if (Hit(0, 0x400)) WpNextPage();
+    if (Hit(0x18, 1)) S.Hover = 1, S.ArrowHover = 1;
+    if (Hit(0x19, 1)) S.Hover = 1, S.ArrowHover = 2;
+    if (Hit(0x18, 8)) WpPrevPage();
+    if (Hit(0x19, 8)) WpNextPage();
+    for (uint32_t i = 0; i < 6; i++)
+      if (Hit(i + 0x1c, 1) && S.WpPage * 6 + 1 + i <= S.WallpaperListCount) S.Hover = 1, S.WpSel = i;
+    for (uint32_t i = 0; i < 6; i++)
+      if (Hit(i + 0x1c, 8) && S.WpPage * 6 + 1 + i <= S.WallpaperListCount) ClickDecide();
+  }
+  if (Decide() && S.WpSel != 0xff) {
+    SW(0x6af8) = MouseMode() ? 0xff : 0;
+    SetMode(0x23);
+  }
+  if (Up()) {
+    if (S.WpSel == 0xff) {
+      S.WpSel = 0;
+    } else if (S.WpSel == 0) {
+      if (S.WpPage != 0) {
+        S.WpPage--;
+        S.WpSel = 5;
+      } else {
+        S.WpPage = S.WpPages - 1;
+        S.WpSel = S.WallpaperListCount - S.WpPage * 6 - 1;
+      }
+    } else {
+      S.WpSel--;
+    }
+  }
+  if (Down()) {
+    if (S.WpSel == 0xff) {
+      S.WpSel = 0;
+    } else if (S.WpPage * 6 + 1 + S.WpSel == S.WallpaperListCount) {
+      S.WpPage = 0;
+      S.WpSel = 0;
+    } else if (S.WpSel < 5) {
+      S.WpSel++;
+    } else {
+      S.WpPage++;
+      S.WpSel = 0;
+    }
+  }
+  if (Left()) {
+    S.WpSel = 0;
+    WpPrevPage();
+  }
+  if (Right()) {
+    S.WpSel = 0;
+    WpNextPage();
+  }
+}
