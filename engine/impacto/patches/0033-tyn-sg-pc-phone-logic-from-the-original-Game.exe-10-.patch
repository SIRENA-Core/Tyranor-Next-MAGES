+// 0x455470 mode 19: answer / open attachment menu of a mail
+void ModeMailActions() {
+  const int mail = SW(0x6a5c);
+  bool canReply = false;
+  uint32_t entries = 0;
+  if (GetFlag(0xa29) && MailBit(mail, 2) && !MailBit(mail, 4) && S.Mails[mail][MailReply] != 999) {
+    canReply = true;
+    entries = 1;
+  }
+  if (S.Mails[mail][MailAttach] != 999) entries++;
+  if (Cancel()) {
+    SetMode(5 - (SW(0x6a4c) != 0));
+    return;
+  }
+  S.Hover = 0;
+  if (MouseMode()) {
+    SW(0x6a80) = 0xff;
+    if (Hit(10, 1)) S.Hover = 1, SW(0x6a80) = 0;
+    if (entries > 1 && Hit(0xb, 1)) S.Hover = 1, SW(0x6a80) = 1;
+    if (Hit(10, 8)) ClickDecide();
+    if (entries > 1 && Hit(0xb, 8)) ClickDecide();
+  }
+  const uint32_t sel = SW(0x6a80);
+  if (sel == 0xff || !Decide()) {
+    if (Up()) {
+      if (sel == 0xff)
+        SW(0x6a80) = 0;
+      else if (entries > 1)
+        SW(0x6a80) = sel ^ 1;
+    }
+    if (Down()) {
+      if ((uint32_t)SW(0x6a80) == 0xff)
+        SW(0x6a80) = 0;
+      else if (entries > 1)
+        SW(0x6a80) ^= 1;
+    }
+    return;
+  }
+  if (canReply && sel == 0) {
+    if (MailBit(mail, 3)) Finished();
+    StartReply(mail, S.Mails[mail][MailReply], 5);
+    return;
+  }
+  S.AttachIdx = S.Mails[mail][MailAttach];
+  OpenAttachment(5);
+  Achievement(3);
+}
+
+// 0x456550 mode 20: main menu (mail / address book / settings)
+void ModeMainMenu() {
+  if (Cancel()) {
+    SetMode(0);
+    SW(0x6a70) = 0xff;
+    return;
+  }
+  S.Hover = 0;
+  if (MouseMode()) {
+    SW(0x6a70) = 0xff;
+    for (int i = 0; i < 3; i++)
+      if (Hit(i + 2, 1)) S.Hover = 1, SW(0x6a70) = i == 2 ? 3 : i;
+    for (int i = 0; i < 3; i++)
+      if (Hit(i + 2, 8)) ClickDecide();
+  }
+  if (!Decide()) {
+    const uint32_t v = SW(0x6a70);
+    if (InDown & (BtnLeft | BtnRight)) SW(0x6a70) = v == 0xff ? 0 : (v < 2 ? v ^ 1 : v);
+    if (InDown & (BtnUp | BtnDown)) SW(0x6a70) = (uint32_t)SW(0x6a70) == 0xff ? 0 : ((uint32_t)SW(0x6a70) < 2 ? 3 : 1);
+    return;
+  }
+  switch (SW(0x6a70)) {
+    case 0:
+      SW(0x6a4c) = MouseMode() ? 0xff : 0;
+      SetMode(1);
+      break;
+    case 1:
+      SW(0x6a94) = MouseMode() ? 0xff : 0;
+      SetMode(6);
+      break;
+    case 3:
+      SW(0x6aec) = MouseMode() ? 0xff : 0;
+      SetMode(0xd);
+      BuildUnlocked();
+      break;
+  }
+}
+
+// 0x4567d0 mode 21: the main menu entry chosen by the script
+void ModeMainMenuScripted() {
+  switch (SW(0x6a70)) {
+    case 0xff:
+      SetMode(0);
+      break;
+    case 0:
+      SW(0x6a4c) = MouseMode() ? 0xff : 0;
+      SetMode(1);
+      break;
+    case 2:
+      SW(0x6a94) = MouseMode() ? 0xff : 0;
+      SetMode(6);
+      break;
+    case 3:
+      SW(0x6aec) = MouseMode() ? 0xff : 0;
+      SetMode(0xd);
+      break;
+  }
+}
