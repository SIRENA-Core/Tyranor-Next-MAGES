+#pragma once
+
+#include <vector>
+
+#include "../../data/tipssystem.h"
+
+namespace Impacto {
+namespace SGHD {
+
+// TIPS data of the STEINS;GATE (Steam) engine generation, read as the original Game.exe does (0x43e100):
+// - records (first label): u16 content count (0xff ends), u16 base string, three more u16, the content string
+//   numbers; strings base + 0 .. base + 3 are a label, the name, a second line and the reading; base + 4 + i is
+//   content string i;
+// - tables (second label): u16 letters string (two bytes per letter), u16 sort string, a list mapping sort
+//   characters to letters and a list mapping letters to categories (both ending with 0xffff).
+// Tips are numbered in the order of their readings (sort string order, shorter first); every category lists its
+// tips in that order with a letter header (10000 + letter) before the first tip of each letter.
+class TipsSystem : public Impacto::TipsSystem::TipsSystemBase {
+ public:
+  explicit TipsSystem(size_t maxTipsCount) : TipsSystemBase(maxTipsCount), MaxCount(maxTipsCount) {}
+
+  void DataInit(uint32_t scriptBufferId, uint32_t tipsDataAdr, uint32_t tipsDataSize) override;
+  void UpdateTipRecords() override;
+  void SetTipLockedState(size_t id, bool state) override;
+  void SetTipUnreadState(size_t id, bool state) override;
+  void SetTipNewState(size_t id, bool state) override;
+  bool GetTipLockedState(size_t id) override;
+
+  static constexpr int LetterHeader = 10000;
+
+  std::vector<int> Number;                 // per tip: 1-based number (position in reading order)
+  std::vector<std::vector<int>> Lists;     // per category: tip ids and letter headers
+  uint32_t LettersStringAdr = 0;           // string with one two byte character per letter
+
+ private:
+  size_t MaxCount;
+};
+
+}  // namespace SGHD
+}  // namespace Impacto
