diff --git a/src/games/sg0/phoneemu.cpp b/src/games/sg0/phoneemu.cpp
new file mode 100755
index 0000000000000000000000000000000000000000..0eb38277c7e8ef03a0d161d77b745e6a13908a39
--- /dev/null
+++ b/src/games/sg0/phoneemu.cpp
@@ -0,0 +1,60 @@
+// Emulated memory of the translated STEINS;GATE 0 phone (see phoneemu.h).
+#include "phoneemu.h"
+
+#include <vector>
+
+#include "../../log.h"
+#include "../../inputsystem.h"
+#include "../../vm/interface/input.h"
+
+namespace Impacto {
+namespace SG0 {
+namespace Sg0Emu {
+
+namespace {
+
+struct Region {
+  uint32_t Begin, End;
+  std::vector<uint8_t> Bytes;
+};
+
+// read only data and .data of Game.exe, the phone and input globals (.bss), the save / system areas, the mouse
+Region Regions[] = {
+    {0x00401000, 0x00600000, {}},
+    {0x00dc0000, 0x00e50000, {}},
+    {0x01970000, 0x019b0000, {}},
+    {0x02ed0000, 0x02ef0000, {}},
+    {0x032f0000, 0x03300000, {}},
+};
+uint8_t Fallback[16];
+
+void Init() {
+  for (Region& r : Regions)
+    if (r.Bytes.empty()) r.Bytes.assign(r.End - r.Begin, 0);
+  Region& rdata = Regions[0];
+  for (size_t i = 0; i < PhoneCode::RdataChunkCount; i++) {
+    const RdataChunk& c = PhoneCode::RdataChunks[i];
+    std::memcpy(rdata.Bytes.data() + (c.Address - rdata.Begin), c.Bytes, sizeof(c.Bytes));
+  }
+}
+
+}  // namespace
+
+uint8_t* At(uint32_t address) {
+  if (Regions[0].Bytes.empty()) Init();
+  for (Region& r : Regions)
+    if (r.Begin <= address && address < r.End) return r.Bytes.data() + (address - r.Begin);
+  ImpLog(LogLevel::Error, LogChannel::General, "SG0 phone: no emulated memory at {:08x}\n", address);
+  std::memset(Fallback, 0, sizeof(Fallback));
+  return Fallback;
+}
+
+void Reset() {
+  for (size_t i = 1; i < std::size(Regions); i++) Regions[i].Bytes.clear();
+  Regions[0].Bytes.clear();
+  Init();
+}
+
+}  // namespace Sg0Emu
+}  // namespace SG0
+}  // namespace Impacto
