+bool Enabled() {
+  return UserConfig::CommonSettings.DebugMode || (+Profile::Game::GameFeatures & +GameFeature::DebugMenu);
+}
+
+bool OpenRequested() {
+  const bool r = OpenRequest;
+  OpenRequest = false;
+  return r;
+}
+
+// is a point (window pixels) on a shown debug window that takes input
+static bool OnDebugWindow(float x, float y) {
+#ifndef IMPACTO_DISABLE_IMGUI
+  ImGuiContext* g = ImGui::GetCurrentContext();
+  if (!g) return false;
+  for (ImGuiWindow* w : g->Windows) {
+    if (!w->WasActive || w->Hidden || (w->Flags & ImGuiWindowFlags_NoInputs)) continue;
+    if (w->Rect().Contains(ImVec2(x, y))) return true;
+  }
+#endif
+  return false;
+}
+
+// fingers that went down on a debug window: the game sees none of their events
+static std::set<SDL_FingerID> CapturedFingers;
+// fingers the game saw go down, and those of them that are part of the three finger gesture
+static std::set<SDL_FingerID> GameFingers, GestureFingers;
+
+bool HandleEvent(SDL_Event& e) {
+  if (!Enabled()) return false;
+  switch (e.type) {
+    case SDL_EVENT_FINGER_DOWN: {
+      if (++Fingers == 3) {
+        OpenRequest = true;
+        GestureFingers.insert(GameFingers.begin(), GameFingers.end());
+        CapturedFingers.insert(e.tfinger.fingerID);
+        return true;
+      }
+#ifndef IMPACTO_DISABLE_IMGUI
+      const ImVec2 size = ImGui::GetIO().DisplaySize;
+      if (OnDebugWindow(e.tfinger.x * size.x, e.tfinger.y * size.y)) {
+        CapturedFingers.insert(e.tfinger.fingerID);
+        return true;
+      }
+#endif
+      GameFingers.insert(e.tfinger.fingerID);
+      return false;
+    }
+    case SDL_EVENT_FINGER_MOTION:
+      return CapturedFingers.count(e.tfinger.fingerID) != 0;
+    case SDL_EVENT_FINGER_UP:
+    case SDL_EVENT_FINGER_CANCELED:
+      Fingers = std::max(0, Fingers - 1);
+      GameFingers.erase(e.tfinger.fingerID);
+      if (GestureFingers.erase(e.tfinger.fingerID) != 0) e.type = SDL_EVENT_FINGER_CANCELED;
+      return CapturedFingers.erase(e.tfinger.fingerID) != 0;
+    default:
+      return false;
+  }
+}
+
+int TicksThisFrame() {
+  if (!Enabled()) return 1;
+  if (Paused) {
+    if (StepRequests > 0) {
+      StepRequests--;
+      return 1;
+    }
+    return 0;
+  }
+  return Speed;
+}
+
+void BeforeExtraTick() {
+  using namespace Vm::Interface;
+  PADinputButtonWentDown = 0;
+  PADinputMouseWentDown = 0;
+  PADinputButtonRepeatDown = 0;
+  // the menus read the raw input: a press of the frame must not count again in its later ticks
+  std::fill(std::begin(Input::MouseButtonWentDown), std::end(Input::MouseButtonWentDown), false);
+  std::fill(std::begin(Input::ControllerButtonWentDown), std::end(Input::ControllerButtonWentDown), false);
+  std::fill(std::begin(Input::ControllerAxisWentDownLight), std::end(Input::ControllerAxisWentDownLight), false);
+  std::fill(std::begin(Input::ControllerAxisWentDownHeavy), std::end(Input::ControllerAxisWentDownHeavy), false);
+  std::fill(std::begin(Input::KeyboardButtonWentDown), std::end(Input::KeyboardButtonWentDown), false);
+  Input::MouseWheelDeltaX = Input::MouseWheelDeltaY = 0;
+  Input::TouchTapCount = 0;
+  Input::TouchFlickLeft = Input::TouchFlickRight = Input::TouchFlickDown = Input::TouchFlickUp = false;
+  Input::TouchPinchIn = false;
+}
+
+void BeforeVmUpdate() {
+  if (!Enabled() || !ForceSkip) return;
+  // also where ChkMesSkip has no message window to skip (movies, effects): the scripts skip what they see flagged
+  SetFlag(SF_MESSKIP, true);
+  SetFlag(SF_MESALLSKIP, true);
+  SkipMovies(true);
+}
+
+void AfterTick() {
+  if (!Enabled()) return;
+  if (ForceSkip) {
+    // the engine skip mode (ChkMesSkip turns it into SF_MESSKIP / SF_MESALLSKIP every tick)
+    SkipModeEnabled = true;
+    Profile::ConfigSystem::SkipRead = false;  // unread text too
+  }
+  if (PendingRestore) {
+    Restore(*PendingRestore);
+    PendingRestore.reset();
+  }
+  if (PendingJump) {
+    Jump(*PendingJump);
+    PendingJump.reset();
+  }
+}
+
+float ScaleFrameTime(float dt) {
+  if (!Enabled()) return dt;
+  if (Paused) return StepRequests > 0 ? dt : 0.0f;
+  return dt * (float)Speed;
+}
+
+void OnCheckpoint(int id) {
+  if (!Enabled()) return;
+  LastCheckpoint = id;
+  if (AutoSnapshots) SnapshotPending = true;
+}
+
+void TakePendingSnapshot(int thread, uint32_t instructionStart) {
+  SnapshotPending = false;
+  Snapshot s = Capture("");
+  if (thread >= 0 && thread < (int)s.Vm.Pool.size()) s.Vm.Pool[thread].Data.IpOffset = instructionStart;
+  // the checkpoint instruction runs again after a restore: that is the line already kept
+  if (!History.empty() && History.back().ScriptId == s.ScriptId && History.back().Line == s.Line) History.pop_back();
+  History.push_back(std::move(s));
+  while (History.size() > MaxHistory) History.pop_front();
+}
+
+// ---------------------------------------------------------------- UI
+
+void ShowStatus() {
+#ifndef IMPACTO_DISABLE_IMGUI
+  if (!Enabled()) return;
+  ImGui::SetNextWindowPos(ImVec2(4, 4), ImGuiCond_Always);
+  ImGui::SetNextWindowBgAlpha(0.45f);
+  const ImGuiWindowFlags flags = ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize |
+                                 ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing |
+                                 ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoInputs;
+  if (ImGui::Begin("##DebugStatus", nullptr, flags)) {
+    const int main = MainThreadIndex();
+    const std::string script = main >= 0 ? ScriptName((int)Vm::ThreadPool[main].ScriptBufferId) : "-";
+    const std::string line =
+        LastCheckpoint >= 0 && LastCheckpoint != 0xffff ? " #" + std::to_string(LastCheckpoint) : std::string();
+    ImGui::Text("%s x%d%s%s  %s%s  %s %zu", Paused ? L("PAUSED", "暂停") : L("RUN", "运行"), Speed,
+                ForceSkip ? L(" SKIP", " 快进") : "", AutoSnapshots ? "" : L(" (no snapshots)", "（不快照）"),
+                script.c_str(), line.c_str(), L("rewind", "可回退"), History.size());
+  }
+  ImGui::End();
+#endif
+}
+
+const char* PortingTitle() { return Chinese ? "适配工具###Porting" : "Porting###Porting"; }
+const char* PortingWindowTitle() {
+  return Chinese ? "适配工具###PortingToolsWindow" : "Porting###PortingToolsWindow";
+}
+
+void ShowTab() {
+#ifndef IMPACTO_DISABLE_IMGUI
+  if (!SavedLoaded) ReadStates();
+
+  if (ImGui::RadioButton("中文", Chinese)) Chinese = true;
+  ImGui::SameLine();
+  if (ImGui::RadioButton("English", !Chinese)) Chinese = false;
+  // the result of the last action, where it is always in view
+  if (!LastMessage.empty()) ImGui::TextWrapped("%s", LastMessage.c_str());
+
+  // ---- time
+  ImGui::SeparatorText(L("Speed", "速度"));
+  for (int s : Speeds) {
+    ImGui::SameLine();
+    char label[16];
+    std::snprintf(label, sizeof(label), "x%d", s);
+    if (ImGui::RadioButton(label, Speed == s)) Speed = s;
+  }
+  if (ImGui::Button(Paused ? L("Resume", "继续") : L("Pause", "暂停"))) Paused = !Paused;
+  ImGui::SameLine();
+  ImGui::BeginDisabled(!Paused);
+  if (ImGui::Button(L("Step 1 frame", "单步 1 帧"))) StepRequests += 1;
+  ImGui::SameLine();
+  if (ImGui::Button(L("Step 60 frames", "单步 60 帧"))) StepRequests += 60;
+  ImGui::EndDisabled();
+  if (ImGui::Button(L("Skip movie", "跳过当前视频"))) SkipMovies();
+  if (ImGui::Checkbox(L("Skip everything (unread text too)", "强制快进（未读文字也跳过）"), &ForceSkip)) {
+    if (ForceSkip) {
+      SkipReadBefore = Profile::ConfigSystem::SkipRead;
+    } else {
+      SkipModeEnabled = false;
+      Profile::ConfigSystem::SkipRead = SkipReadBefore;
+    }
+  }
+
+  // ---- rewind
+  ImGui::SeparatorText(L("Rewind", "回退"));
+  ImGui::Checkbox(L("Snapshot every line", "每句自动快照"), &AutoSnapshots);
+  ImGui::SameLine();
+  int max = (int)MaxHistory;
+  ImGui::SetNextItemWidth(ImGui::GetFontSize() * 8);
+  if (ImGui::InputInt(L("kept", "保留句数"), &max, 50)) MaxHistory = (size_t)std::clamp(max, 10, 5000);
+  if (ImGui::Button(L("Back 1 line", "退 1 句")) && History.size() >= 2) {
+    History.pop_back();
+    PendingRestore = History.back();
+  }
+  ImGui::SameLine();
+  if (ImGui::Button(L("Back 10 lines", "退 10 句")) && History.size() >= 2) {
+    for (int i = 0; i < 10 && History.size() > 1; i++) History.pop_back();
+    PendingRestore = History.back();
+  }
+  if (ImGui::BeginListBox("##history", ImVec2(-FLT_MIN, 8 * ImGui::GetTextLineHeightWithSpacing()))) {
+    for (int i = (int)History.size() - 1; i >= 0; i--) {
+      ImGui::PushID(i);
+      if (ImGui::Selectable(History[i].Label.c_str(), false)) {
+        PendingRestore = History[i];
+        History.erase(History.begin() + i + 1, History.end());
+      }
+      ImGui::PopID();
+    }
+    ImGui::EndListBox();
+  }
+
+  // ---- states
+  ImGui::SeparatorText(L("Saved states", "保存的状态"));
+  static char name[64] = "";
+  ImGui::SetNextItemWidth(ImGui::GetFontSize() * 10);
+  ImGui::InputTextWithHint("##statename", L("name", "名称"), name, sizeof(name));
+  ImGui::SameLine();
+  if (ImGui::Button(L("Save state", "保存当前状态"))) {
+    // the snapshot of the line on screen, taken before it showed: a restore shows the line again. One taken in the
+    // middle of a line would wait for a line the restore cannot show.
+    Snapshot s = History.empty() ? Capture("") : History.back();
+    if (name[0]) s.Label = name;
+    Saved.push_back(std::move(s));
+    name[0] = 0;
+    WriteStates();
+  }
+  for (size_t i = 0; i < Saved.size(); i++) {
+    ImGui::PushID((int)i);
+    if (ImGui::Button(L("Load", "读取"))) PendingRestore = Saved[i];
+    ImGui::SameLine();
+    if (ImGui::Button(L("Delete", "删除"))) {
+      Saved.erase(Saved.begin() + (ptrdiff_t)i);
+      WriteStates();
+      ImGui::PopID();
+      break;
+    }
+    ImGui::SameLine();
+    const std::string where = Saved[i].Script + " #" + std::to_string(Saved[i].Line);
+    if (Saved[i].Label == where || Saved[i].Label == Saved[i].Script)
+      ImGui::TextUnformatted(Saved[i].Label.c_str());
+    else
+      ImGui::Text("%s  (%s)", Saved[i].Label.c_str(), where.c_str());
+    ImGui::PopID();
+  }
+
+  // ---- jump
+  ImGui::SeparatorText(L("Jump", "跳转"));
+  static int thread = -1, buffer = 3, scriptId = 0, label = 0;
+  static bool clearStack = false;
+  const int main = MainThreadIndex();
+  ImGui::Text(L("main thread %d: %s, buffer %u, ip 0x%X, call depth %u",
+                "主线程 %d：%s，缓冲区 %u，ip 0x%X，调用深度 %u"),
+              main,
+              main >= 0 ? ScriptName((int)Vm::ThreadPool[main].ScriptBufferId).c_str() : "-",
+              main >= 0 ? Vm::ThreadPool[main].ScriptBufferId : 0, main >= 0 ? Vm::ThreadPool[main].IpOffset : 0,
+              main >= 0 ? Vm::ThreadPool[main].CallStackDepth : 0);
+  // until a script is picked, the jump targets the script the main thread is in
+  static bool scriptPicked = false;
+  if (!scriptPicked && main >= 0) {
+    buffer = (int)Vm::ThreadPool[main].ScriptBufferId;
+    scriptId = Vm::ScriptBuffers[buffer].empty() ? 0 : (int)Vm::LoadedScriptMetas[buffer].Id;
+  }
+  static std::map<uint32_t, std::string> files;
+  if (files.empty()) Io::VfsListFiles("script", files);
+  ImGui::SetNextItemWidth(ImGui::GetFontSize() * 12);
+  const auto it = files.find((uint32_t)scriptId);
+  if (ImGui::BeginCombo(L("script", "剧本"), it != files.end() ? it->second.c_str() : "?")) {
+    for (const auto& [id, file] : files) {
+      char item[160];
+      std::snprintf(item, sizeof(item), "%u  %s", id, file.c_str());
+      if (ImGui::Selectable(item, (int)id == scriptId)) {
+        scriptId = (int)id;
+        scriptPicked = true;
+      }
+    }
+    ImGui::EndCombo();
+  }
+  ImGui::SetNextItemWidth(ImGui::GetFontSize() * 7);
+  ImGui::InputInt(L("label", "标签"), &label);
+  label = std::max(0, label);
+  ImGui::SameLine();
+  ImGui::SetNextItemWidth(ImGui::GetFontSize() * 7);
+  if (ImGui::InputInt(L("buffer", "缓冲区"), &buffer)) scriptPicked = true;
+  buffer = std::clamp(buffer, 0, Vm::MaxLoadedScripts - 1);
+  ImGui::SetNextItemWidth(ImGui::GetFontSize() * 7);
+  ImGui::InputInt(L("thread (-1 main)", "线程（-1 = 主线程）"), &thread);
+  thread = std::clamp(thread, -1, Vm::MaxThreads - 1);
+  ImGui::SameLine();
+  ImGui::Checkbox(L("clear call stack", "清空调用栈"), &clearStack);
+  if ((int)Vm::LoadedScriptMetas[buffer].Id == scriptId && !Vm::ScriptBuffers[buffer].empty())
+    ImGui::Text(L("%d labels in this script", "本剧本共 %d 个标签"), LabelCount(buffer));
+  if (ImGui::Button(L("Jump", "跳转"))) {
+    PendingJump = JumpRequest{thread, buffer, scriptId, label, clearStack};
+  }
+  ImGui::SameLine();
+  if (ImGui::Button(L("Restart current script", "从头重开当前剧本"))) {
+    if (main >= 0) {
+      const int b = (int)Vm::ThreadPool[main].ScriptBufferId;
+      PendingJump = JumpRequest{main, b, (int)Vm::LoadedScriptMetas[b].Id, 0, false};
+    }
+  }
+
+  // ---- progress
+  ImGui::SeparatorText(L("Progress", "进度"));
+  if (ImGui::Button(L("Unlock CG, music, tips", "解锁 CG、音乐、TIPS"))) UnlockAll();
+  ImGui::SameLine();
+  if (ImGui::Button(L("Write save data", "立即写入存档"))) {
+    SaveSystem::SaveSystemData();
+    SaveSystem::WriteSaveFile();
+    LastMessage = L("save file written", "存档已写入");
+  }
+
+#endif
+}
+
+}  // namespace DebugTools
+}  // namespace Impacto
