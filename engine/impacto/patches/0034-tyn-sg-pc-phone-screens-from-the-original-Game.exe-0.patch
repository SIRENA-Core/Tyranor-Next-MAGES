diff --git a/src/games/sghd/phonescreens.cpp b/src/games/sghd/phonescreens.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a2a11ed23299092af1dcd8b72b97a8224aa5028d
--- /dev/null
+++ b/src/games/sghd/phonescreens.cpp
@@ -0,0 +1,180 @@
+// The phone screens not drawn in phonerender.cpp, translated from the original draw routines (addresses in the
+// comments). Destinations are in the original's 1280x720 units, texture sources in texture pixels.
+#include "phonerender.h"
+#include "phonestate.h"
+
+#include "../../mem.h"
+
+namespace Impacto {
+namespace SGHD {
+namespace Phone {
+
+namespace {
+constexpr float Scale = 1.5f;
+
+// scroll arrows of a text screen (hover from the mouse, 0xffee88)
+void DrawScrollArrows(int x, int y, int top, int count, int alpha) {
+  if (count <= 0xc) return;
+  const int surf = PhoneSurface();
+  if (top != 0) Spr(surf, 2239.5f, 943.5f, 414, 13.5f, x, y + 0x1d, alpha, S.ScrollHover == 1 ? 0xffee88 : 0xffffff);
+  if (top + 0xc < count)
+    Spr(surf, 2239.5f, 960, 414, 13.5f, x, y + 0x134, alpha, S.ScrollHover == 2 ? 0xffee88 : 0xffffff);
+}
+
+// A mail: 0x452be0 (received), 0x452440 (sent), 0x44fe80 (the answer). Rows scroll by `top`; the first rows are the
+// date (not for the answer), the subject, the address block (text + 0) and a separator, then the text (text + 2).
+void DrawMail(int titleBar, int mail, int top, int count, float subjectIcon, bool answer, int x, int y, int alpha,
+              bool links = false, int linkSel = 0xff) {
+  const int surf = PhoneSurface();
+  DrawTitleBar(titleBar, x, y, alpha);
+  const int areaY = y + 0x1d;
+  Rect(x * Scale, areaY * Scale, 414, 432, 0xffffff, alpha);
+  const auto& m = S.Mails[mail];
+  const int dateRows = answer ? 0 : 1;  // rows before the subject
+  int iconY = areaY;
+  if (!answer) {
+    if (top == 0) {
+      Spr(surf, 2239.5f, 1012.5f, 36, 36, x, areaY, alpha);
+      if (m[MailAttach] != 999) Spr(surf, 2395.5f, 1012.5f, 36, 36, x + 0xfc, areaY, alpha);
+      iconY = y + 0x35;
+    }
+  }
+  if (top < dateRows + 1) {
+    Spr(surf, subjectIcon, 1012.5f, 36, 36, x, iconY, alpha);
+    iconY += 0x18;
+  }
+  int addrLines = LineCountOf(Str(m[MailText]), 0xfe, 0x18);
+  if (addrLines == 0) addrLines = 1;
+  const int headRows = addrLines + dateRows + 1;
+  if (top <= headRows) {
+    int shown;
+    if (top < dateRows + 2) {
+      Spr(surf, 2356.5f, 1012.5f, 36, 36, x, iconY, alpha);
+      shown = addrLines;
+    } else {
+      shown = addrLines - top + dateRows + 1;
+    }
+    iconY = shown * 0x18 - 1 + iconY;
+    Rect(x * Scale, iconY * Scale, 414, 1.5f, 0, alpha);
+  }
+  int rowsLeft = 0xc, ty = areaY;
+  if (!answer && top == 0) {
+    const uint32_t d = m[MailDateHi], t = m[MailDateLo];
+    std::string s = Num2(d / 100) + "/" + Num2(d % 100) + " " + Num2(t / 100) + ":" + Num2(t % 100);
+    if (s[9] == ' ') s[9] = '0';
+    TextAscii(x + 0x18, areaY, s, 0, 0x18, alpha);
+    ty = y + 0x35;
+    rowsLeft = 0xb;
+  }
+  if (top < dateRows + 1) {
+    Text(x + 0x18, ty, answer ? 0xfe : 0xfc, Str(m[MailText] + 1), 0, 1, 0, 0x18, alpha);
+    ty += 0x18;
+    rowsLeft--;
+  }
+  if (top <= headRows) {
+    const int shown = top > dateRows + 1 ? addrLines - top + dateRows + 1 : addrLines;
+    Text(x + 0x18, ty, 0xfe, Str(m[MailText]), addrLines - shown, shown, 0, 0x18, alpha);
+    rowsLeft -= shown;
+    ty += shown * 0x18;
+  }
+  const int bodySkip = top < headRows ? 0 : top - addrLines - dateRows - 1;
+  if (links)
+    TextLinks(x, ty, 0x114, Str(m[MailText] + 2), bodySkip, rowsLeft, 0x18, alpha, linkSel);
+  else
+    Text(x, ty, answer ? 0x116 : 0x114, Str(m[MailText] + 2), bodySkip, rowsLeft, 0, 0x18, alpha);
+  DrawScrollArrows(x, y, top, count, alpha);
+  Spr(surf, 2239.5f, 465, 414, 432, x, areaY, alpha);
+}
+
+void DrawReadInbox(int x, int y, int alpha) {  // mode 5
+  DrawMail(2, SW(0x6a5c), SW(0x6a74), SW(0x6a78), 2278.5f, false, x, y, alpha);
+}
+void DrawReadSent(int x, int y, int alpha) {  // mode 4
+  DrawMail(3, SW(0x6a5c), SW(0x6a74), SW(0x6a78), 2317.5f, false, x, y, alpha);
+}
+void DrawAnswer(int x, int y, int alpha) {  // mode 22
+  DrawMail(10, SW(0x6a84), SW(0x6a88), SW(0x6a8c), 2317.5f, true, x, y, alpha);
+}
+
+// 0x44f4c0 mode 19: the mail with the answer / attachment choice
+void DrawMailActions(int x, int y, int alpha) {
+  if (SW(0x6a4c) == 0)
+    DrawReadInbox(x, y, alpha);
+  else
+    DrawReadSent(x, y, alpha);
+  const int mail = SW(0x6a5c);
+  const bool canAnswer = GetFlag(0xa29) && MailBit(mail, 2) && !MailBit(mail, 4) && S.Mails[mail][MailReply] != 999;
+  const bool attach = S.Mails[mail][MailAttach] != 999;
+  if (!canAnswer && !attach) return;
+  if (canAnswer && attach)
+    DrawChoice(10, 0xb, SW(0x6a80), x, y + 0x1d, alpha);
+  else if (!canAnswer)
+    DrawChoice(0xb, 9999, SW(0x6a80), x, y + 0x1d, alpha);
+  else
+    DrawChoice(10, 9999, SW(0x6a80), x, y + 0x1d, alpha);
+}
+
+// 0x453380 mode 6: address book
+void DrawAddressBook(int x, int y, int alpha) {
+  DrawTitleBar(4, x, y, alpha);
+  const int top = y + 0x1d;
+  Rect(x * Scale, top * Scale, 414, 424.5f, 0xffffff, alpha);
+  if (SW(0x6a94) != 0xff) Rect(x * Scale, (top + SW(0x6a94) * 0x18) * Scale, 414, 36, 0xffba95, alpha);
+  for (uint32_t i = 0; i < S.ContactCount; i++)
+    Text(x + 0xc, top + i * 0x18, 0x116, Str(S.StrBaseB + S.Contacts[i] * 2 + 1), 0, 1, 0, 0x18, alpha);
+  Spr(PhoneSurface(), 2239.5f, 465, 414, 432, x, top, alpha);
+}
+
+// 0x453530 mode 7: call / mail the contact
+void DrawContact(int x, int y, int alpha) {
+  const uint32_t c = S.Contacts[SW(0x6a94)];
+  const bool canMail = GetFlag(0xa2a) && S.CanMail[c];
+  const bool canCall = GetFlag(0xa2b) && S.CanCall[c];
+  DrawAddressBook(x, y, alpha);
+  if (canMail && canCall)
+    DrawChoice(0x10, 0x11, SW(0x6b04), x, y + 0x1d, alpha);
+  else if (!canMail)
+    DrawChoice(0x10, 9999, SW(0x6b04), x, y + 0x1d, alpha);
+  else
+    DrawChoice(0x11, 9999, SW(0x6b04), x, y + 0x1d, alpha);
+}
+
+// a box over the screen with a blinking mail mark and a centred red text (0x453640 sending, 0x450530 sent)
+void DrawMailNotice(int strOffset, int x, int y, int alpha) {
+  Spr(PhoneSurface(), 2239.5f, 1.5f, 414, 247.5f, x, y + 0x4c, alpha);
+  DrawMark(1, x + 0x69, y + 0x50, alpha);
+  const uint8_t* s = Str(S.StrBaseA + strOffset);
+  const int w = std::min(TextWidth(s, 0x18), 0xfe);
+  Text(x - (w >> 1) + 0x8a, y + 0x96, 0xfe, s, 0, 2, Red, 0x18, alpha);
+}
+
+}  // namespace
+
+void DrawMailWithLinks(int titleBar, int mail, int top, int count, float subjectIcon, bool links, int linkSel, int x,
+                       int y, int alpha) {
+  DrawMail(titleBar, mail, top, count, subjectIcon, false, x, y, alpha, links, linkSel);
+}
+
+void DrawMoreScreens(int mode, int x, int y, int alpha) {
+  switch (mode) {
+    case 4: DrawReadSent(x, y, alpha); break;
+    case 5: DrawReadInbox(x, y, alpha); break;
+    case 6: DrawAddressBook(x, y, alpha); break;
+    case 7: DrawContact(x, y, alpha); break;
+    case 9:  // 0x453640: sending
+      DrawAnswer(x, y, alpha);
+      DrawMailNotice(0xe, x, y, alpha);
+      break;
+    case 0x13: DrawMailActions(x, y, alpha); break;
+    case 0x16: DrawAnswer(x, y, alpha); break;
+    case 0x18:  // 0x450530: sent
+      DrawAnswer(x, y, alpha);
+      DrawMailNotice(0xc, x, y, alpha);
+      break;
+    default: DrawRemainingScreens(mode, x, y, alpha); break;
+  }
+}
+
+}  // namespace Phone
+}  // namespace SGHD
+}  // namespace Impacto
diff --git a/src/games/sghd/phonescreens2.cpp b/src/games/sghd/phonescreens2.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4613009a8569a4e93cefea599ee563dc57118f43
--- /dev/null
+++ b/src/games/sghd/phonescreens2.cpp
@@ -0,0 +1,229 @@
+// Phone screens, part 2: calls, settings, wallpapers, ringtones (original draw routines in the comments).
+#include "phonerender.h"
+#include "phonestate.h"
+
+#include "../../mem.h"
+
+namespace Impacto {
+namespace SGHD {
+namespace Phone {
+
+namespace {
+constexpr float Scale = 1.5f;
+uint32_t DotClock = 0, DotPhase = 0;  // DAT_018ec74c / 750
+
+// 0x454130 / 0x453e60: the moving dotted frame around the caller (w x h dots from (x, y))
+void DrawDots(int x, int y, int across, int down, int alpha) {
+  if (++DotClock > 4) {
+    DotPhase = (DotPhase + 1) & 7;
+    DotClock = 0;
+  }
+  const int surf = PhoneSurface();
+  uint32_t phase = DotPhase;
+  auto dot = [&](int dx, int dy) {
+    Spr(surf, (float)(int)(phase * 0xb + 0x14f) * Scale, 1350, 13.5f, 13.5f, dx, dy, alpha);
+    phase = (phase + 1) & 7;
+  };
+  int px = x, py = y;
+  for (int i = 0; i < across; i++, px += 0xc) dot(px, py);
+  px -= 0xc;
+  for (int i = 0; i < down; i++) dot(px, py += 0xc);
+  for (int i = 0; i < across - 1; i++) dot(px -= 0xc, py);
+  for (int i = 0; i < down - 1; i++) dot(px, py -= 0xc);
+}
+
+}  // namespace
+
+void DrawDotsRing(int x, int y, int alpha) {  // 0x453e60
+  DrawDots(x + 0x12, y + 0x3e, 0x14, 5, alpha);
+}
+
+namespace {
+
+void Black(int x, int y, int alpha) { Rect(x * Scale, y * Scale, 414, 468, 0, alpha); }
+
+// number of a contact with the large digit sprites (0x44dd30)
+void DrawNumber(int caller, int x, int y, int alpha) {
+  const uint8_t* digits = Str(S.StrBaseB);
+  const uint8_t* number = Str(S.StrBaseB + caller * 2 + 2);
+  int dx = x;
+  for (; *number != 0xff; number += 2) {
+    int i = 0;
+    const uint8_t* d = digits;
+    for (; *d != 0xff; d += 2, i++)
+      if (((number[0] & 0x7f) << 8 | number[1]) == ((d[0] & 0x7f) << 8 | d[1])) break;
+    if (*d != 0xff) Spr(PhoneSurface(), (float)(i * 0x18 + 0x14f) * Scale, 1366.5f, 33, 45, dx, y, alpha);
+    dx += 0x18;
+  }
+}
+
+void CentredWhite(int strOffset, int x, int y, int alpha) {
+  const uint8_t* s = Str(S.StrBaseA + strOffset);
+  const int w = std::min(TextWidth(s, 0x18), 0xc0);
+  Text(x - (w >> 1) + 0x8a, y + 0x40, 0xc0, s, 0, 2, 0xffffff, 0x18, alpha);
+}
+
+// 0x44dd30 mode 10: calling someone / being called (number, name, "calling")
+void DrawCall(int x, int y, int alpha) {
+  const int caller = SW(0x6a6c);
+  Black(x, y, alpha);
+  DrawDots(x + 0x42, y + 0x2a, 0xc, 5, alpha);
+  DrawNumber(caller, x + 6, y + 0xd4, alpha);
+  Text(x + 0x12, y + 0xb0, 0x108, Str(S.StrBaseB + caller * 2 + 1), 0, 2, 0xffffff, 0x18, alpha);
+  CentredWhite(0xf, x, y, alpha);
+}
+
+// 0x44dfb0 mode 11: dial screen
+void DrawDial(int x, int y, int alpha) {
+  Black(x, y, alpha);
+  Spr(PhoneSurface(), 502.5f, 1293, 276, 54, x + 0x2e, y + 0x88, alpha);
+}
+
+// 0x44e090 mode 12: the camera (the original shows the scene through the phone; the frame only here)
+void DrawCamera(int x, int y, int alpha) { Spr(PhoneSurface(), 616.5f, 109.5f, 414, 468, x, y, alpha); }
+
+// 0x450310 mode 23: dialling with the key pad
+void DrawDialPad(int x, int y, int alpha) {
+  const int surf = PhoneSurface();
+  DrawDial(x, y, alpha);
+  int dx = x - SW(0x6ac0) * 0x18 + 0x10e;
+  for (int i = 0; i < SW(0x6ac0) && i < 4; i++, dx += 0x18)
+    Spr(surf, (float)(S.Dial[i] * 0x18 + 0x14f) * Scale, 1366.5f, 33, 45, dx, y + 0xd4, alpha);
+  // the key pad over the screen, fading with GlobalVars[6815] (screen pixels in the original: 708, 342)
+  Spr(surf, 1033.5f, 367.5f, 502.5f, 369, 708 / Scale, 342 / Scale, SW(0x6a7c));
+  const uint32_t key = SW(0x6abc);
+  if (key != 0xff && SW(0x6a7c) > 0xfe) {
+    const int row = (key / 3) * 0x2f, col = (key % 3) * 0x4d;
+    Spr(surf, (float)(col + 0x2e6) * Scale, (float)(row + 0x21c) * Scale, 112.5f, 67.5f, col + 0x20d, row + 0x114,
+        SW(0x6a7c));
+  }
+}
+
+// 0x4506f0 mode 25: connecting
+void DrawConnecting(int x, int y, int alpha) {
+  Black(x, y, alpha);
+  DrawDots(x + 0x42, y + 0x2a, 0xc, 5, alpha);
+  Spr(PhoneSurface(), 418.5f, 1120.5f, 132, 73.5f, x + 0x5e, y + 0xc1, alpha);
+  CentredWhite(0x12, x, y, alpha);
+}
+
+// 0x450830 mode 26: a mail arrives during a call
+void DrawConnectingMail(int x, int y, int alpha) {
+  DotClock = 0;
+  DrawConnecting(x, y, alpha);
+  Spr(PhoneSurface(), 1.5f, 1120.5f, 393, 270, x + 7, y + 0x46, alpha);
+  Spr(PhoneSurface(), 418.5f, 1120.5f, 132, 73.5f, x + 0x5e, y + 0x5d, alpha);
+  Text(x + 0x2a, y + 0x98, 0xc0, Str(S.StrBaseA + 9), 0, 2, 0, 0x18, alpha);
+}
+
+// 0x44e130 mode 13: settings menu
+void DrawSettings(int x, int y, int alpha) {
+  const int surf = PhoneSurface(), sel = SW(0x6aec);
+  Spr(surf, 2656.5f, 1060.5f, 414, 75, x, y, alpha);
+  Spr(surf, 2656.5f, 838.5f, 414, 219, x, y + 0x32, alpha);
+  Spr(surf, 2656.5f, 579, 414, 181.5f, x, y + 0xc4, alpha);
+  if (sel != 0xff) Spr(surf, 2434.5f, 1012.5f, 21, 36, x + 0x10, sel * 0x18 - 1 + y + 0x3e, alpha);
+  for (int i = 0; i < 3; i++)
+    Text(x + 0x24, y + 0x3e + i * 0x18, 0x116, Str(S.StrBaseA + 4 + i), 0, 1, sel == i ? Red : 0, 0x14, alpha);
+  if (sel != 0xff) Text(x + 0x12, y + 0xe0, 0xf0, Str(S.StrBaseA + 0x2d + sel), 0, 2, 0xffffff, 0x14, alpha);
+}
+
+void ListArea(int titleBar, int sel, int x, int y, int alpha) {
+  DrawTitleBar(titleBar, x, y, alpha);
+  const int top = y + 0x1d;
+  Rect(x * Scale, top * Scale, 414, 432, 0xffffff, alpha);
+  if (sel != 0xff) Rect(x * Scale, (top + sel * 0x18) * Scale, 414, 36, 0xffba95, alpha);
+}
+
+// 0x44e430 mode 14: wallpapers (6 per page, thumbnails)
+void DrawWallpapers(int x, int y, int alpha) {
+  DrawTitleBar(5, x, y, alpha);
+  const int top = y + 0x1d;
+  Rect(x * Scale, top * Scale, 414, 432, 0xffffff, alpha);
+  if (S.WpSel != 0xff) Rect(x * Scale, (S.WpSel * 0x30 + top) * Scale, 414, 72, 0xffba95, alpha);
+  for (uint32_t i = 0; i < 6; i++) {
+    const uint32_t n = i + S.WpPage * 6;
+    if (n > S.WallpaperListCount - 1 || S.WallpaperListCount == 0) break;
+    const int w = S.WallpaperList[n];
+    Rect(x * Scale, (y + 0x4c + i * 0x30) * Scale - 0.3f, 414, 2.1f, 0x808080, alpha);
+    const int ry = top + i * 0x30;
+    Spr(0xad, (float)((w % 0xc) * 0x2a + 1) * Scale, (float)((w / 0xc) * 0x30 + 1) * Scale, 61.5f, 70.5f, x + 9, ry,
+        alpha);
+    if (SW(0x1f68) == w) Spr(PhoneSurface(), 2562, 1425, 61.5f, 70.5f, x + 9, ry, alpha);
+  }
+  TextAscii(0x470, 0x9a, Num2(S.WpPage + 1) + "/" + Num2(S.WpPages), S.ArrowHover ? 0xffee88 : 0xffffff, 0x10, alpha);
+  for (uint32_t i = 0; i < 6; i++) {
+    const uint32_t n = i + S.WpPage * 6;
+    if (n > S.WallpaperListCount - 1 || S.WallpaperListCount == 0) break;
+    Text(x + 0x3c, top + i * 0x30, 0xd8, Str(S.StrBaseA + S.Wallpapers[S.WallpaperList[n]][1]), 0, 2, 0, 0x18,
+         alpha);
+  }
+  Spr(PhoneSurface(), 2239.5f, 465, 414, 432, x, top, alpha);
+}
+
+// 0x44e860 / 0x44eb60 modes 15 / 16: ringtones for calls / mails (first row: none)
+void DrawRingtones(bool mail, int x, int y, int alpha) {
+  const int surf = PhoneSurface(), var = mail ? 0x1f74 : 0x1f6c;
+  ListArea(mail ? 7 : 6, SW(0x6af0), x, y, alpha);
+  const int top = y + 0x1d;
+  if (SW(var) == 0xffff) {
+    Spr(surf, 2491.5f, 1012.5f, 27, 36, x, top, alpha);
+  } else {
+    for (uint32_t i = 0; i < S.RingtoneListCount; i++)
+      if ((uint32_t)SW(var) == S.Ringtones[S.RingtoneList[i]][mail ? 1 : 0]) {
+        Spr(surf, 2461.5f, 1012.5f, 27, 36, x, top + (i + 1) * 0x18, alpha);
+        break;
+      }
+  }
+  Text(x + 0x14, top, mail ? 0x116 : 0xfe, Str(S.StrBaseA + 0x17), 0, 1, 0, 0x18, alpha);
+  int ry = y + 0x35;
+  for (uint32_t i = 0; i < S.RingtoneListCount; i++, ry += 0x18) {
+    const uint8_t* name = Str(S.Ringtones[S.RingtoneList[i]][2] + S.StrBaseA);
+    if (!mail || TextWidth(name, 0x18) < 0xff) {
+      Text(x + 0x14, ry, 0xfe, name, 0, 1, 0, 0x18, alpha);
+    } else {  // too long: cut and an ellipsis
+      Text(x + 0x14, ry, 0xf2, name, 0, 1, 0, 0x18, alpha);
+      static const uint8_t ellipsis[] = {0xff, 0x80, 0xff};
+      Text(x + 0x106, ry, 0xf2, ellipsis + 1, 0, 1, 0, 0x18, alpha);
+    }
+  }
+  Spr(surf, 2239.5f, 465, 414, 432, x, top, alpha);
+}
+
+// 0x44ef00 / 0x44f1e0 modes 17 / 18: four entry lists (none + 3)
+void DrawFour(bool second, int x, int y, int alpha) {
+  const int surf = PhoneSurface(), var = second ? 0x1f78 : 0x1f70;
+  ListArea(second ? 9 : 8, SW(0x6af0), x, y, alpha);
+  const int top = y + 0x1d;
+  if (SW(var) == 0xffff)
+    Spr(surf, 2491.5f, 1012.5f, 27, 36, x, top, alpha);
+  else
+    Spr(surf, 2461.5f, 1012.5f, 27, 36, x, top + (SW(var) * 3 + 3) * 8, alpha);
+  for (int i = 0; i < 4; i++)
+    Text(x + 0x14, i == 0 ? top : y + 0x35 + (i - 1) * 0x18, 0x116, Str(S.StrBaseA + 0x17 + i), 0, 1, 0, 0x18, alpha);
+  Spr(surf, 2239.5f, 465, 414, 432, x, top, alpha);
+}
+
+}  // namespace
+
+void DrawRemainingScreens(int mode, int x, int y, int alpha) {
+  switch (mode) {
+    case 10: DrawCall(x, y, alpha); break;
+    case 11: DrawDial(x, y, alpha); break;
+    case 12: DrawCamera(x, y, alpha); break;
+    case 0xd: DrawSettings(x, y, alpha); break;
+    case 0xe: DrawWallpapers(x, y, alpha); break;
+    case 0xf: DrawRingtones(false, x, y, alpha); break;
+    case 0x10: DrawRingtones(true, x, y, alpha); break;
+    case 0x11: DrawFour(false, x, y, alpha); break;
+    case 0x12: DrawFour(true, x, y, alpha); break;
+    case 0x17: DrawDialPad(x, y, alpha); break;
+    case 0x19: DrawConnecting(x, y, alpha); break;
+    case 0x1a: DrawConnectingMail(x, y, alpha); break;
+    default: DrawLastScreens(mode, x, y, alpha); break;
+  }
+}
