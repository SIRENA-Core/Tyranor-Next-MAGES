+
+void ModeStoryIn() {  // 202: pictures with text, page by page
+  if (S.AttachToggle == 0) {
+    SetFlag(0x647, 0);
+    if ((uint32_t)SW(0x6b10) < 0x100) {
+      SW(0x6b10) += 0x10;
+      return;
+    }
+  } else {
+    SetFlag(0x647, 1);
+  }
+  if (Cancel()) {
+    SetMode(0xcb);
+    return;
+  }
+  if (MouseMode() && Hit(0, 8)) ClickDecide();
+  if (!Decide()) return;
+  auto& a = S.Attach[S.AttachIdx];
+  const uint32_t pic = a[S.AttachPos];
+  if (pic == 0xff) {
+    S.AttachPos++;
+    SetMode(0xcb);
+    return;
+  }
+  const uint32_t w = a[S.AttachPos + 1];
+  S.AttachPos += 2;
+  if (w != 999 && w < S.WallpaperCount && S.Wallpapers[w][2] != 0) SetFlag(S.Wallpapers[w][2], 1);
+  Achievement(3);
+  S.AttachToggle ^= 1;
+  if (S.AttachToggle) {
+    SetFlag(0x646, 1);
+    SW(0x6b1c) = pic;
+  } else {
+    SetFlag(0x645, 1);
+    SW(0x6b14) = pic;
+  }
+}
