diff --git a/src/vm/opcodetables_sghd.h b/src/vm/opcodetables_sghd.h
new file mode 100644
index 0000000000000000000000000000000000000000..5033ef397459a88198d6ce6dcbfcd980db70463b
--- /dev/null
+++ b/src/vm/opcodetables_sghd.h
@@ -0,0 +1,30 @@
+#pragma once
+// STEINS;GATE (Steam, 2016) runs the Chaos;Child PC dialect of the SC3 virtual machine, with a few opcodes whose
+// operands or meaning differ. The tables start as copies of the CC ones; Configure_SGHD() applies the overrides.
+// vm.cpp includes this after opcodetables_cc.h (which has no include guard).
+#include "inst_sghd.h"
+
+namespace Impacto {
+
+namespace Vm {
+
+inline InstructionProc OpcodeTableSystem_SGHD[256];
+inline InstructionProc OpcodeTableGraph_SGHD[256];
+inline InstructionProc OpcodeTableUser1_SGHD[256];
+
+inline void Configure_SGHD() {
+  for (int i = 0; i < 256; i++) {
+    OpcodeTableSystem_SGHD[i] = OpcodeTableSystem_CC[i];
+    OpcodeTableGraph_SGHD[i] = OpcodeTableGraph_CC[i];
+    OpcodeTableUser1_SGHD[i] = OpcodeTableUser1_CC[i];
+  }
+  OpcodeTableSystem_SGHD[0x4c] = InstSghdUnk004C;  // type byte, an expression when the type is 0 (CC: Dummy)
+  OpcodeTableUser1_SGHD[0x1b] = InstSghdSkipByte;  // one byte, no known effect (CC: Dummy)
+  OpcodeTableUser1_SGHD[0x37] = InstSghdGroup1037;  // phone / mail group (CC: MapSystem)
+  OpcodeTableUser1_SGHD[0x38] = InstSghdGroup1038;  // type byte, a label when the type is 0 (CC: Mtrg)
+  OpcodeTableUser1_SGHD[0x3f] = InstSghdSkipByte;  // one byte, no known effect (CC: Dummy, which hangs the thread)
+}
+
+}  // namespace Vm
+
+}  // namespace Impacto
