--- a/src/games/mo6twpc/savesystem.h
+++ b/src/games/mo6twpc/savesystem.h
@@ -63,6 +63,7 @@ class SaveSystem final : public SaveSystemBase {
   SaveError MountSaveFile(std::vector<QueuedTexture>& textures) override;
 
   SaveError LoadSystemData() override;
+  bool SystemDataApplied() const override { return Applied; }
   void SaveSystemData() override;
   void InitializeSystemData() override;
 
@@ -121,6 +122,7 @@ class SaveSystem final : public SaveSystemBase {
   std::unordered_set<uint32_t> ReadLines;
