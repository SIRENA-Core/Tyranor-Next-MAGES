Subject: [PATCH] tyn: MO6TWPC save system: CG flag bytes accessor

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/games/mo6twpc/savesystem.h b/src/games/mo6twpc/savesystem.h
index d3a064cabd5d2603b6e07edbe0ad2e626ced25a4..e01029e1b79ec18b189ba31343790462ecdd28e9 100644
--- a/src/games/mo6twpc/savesystem.h
+++ b/src/games/mo6twpc/savesystem.h
@@ -105,6 +105,8 @@ class SaveSystem final : public SaveSystemBase {
   Sprite& GetSaveThumbnail(SaveType type, int id) override;
   // the TIPS bits (3 per tip, GetTipStatus) for code that reads them like the original (STEINS;GATE 0)
   uint8_t* TipsBits() { return GameExtraData.data(); }
+  // the CG flags (one byte each) for code that reads them like the original
+  uint8_t* EvBytes() { return reinterpret_cast<uint8_t*>(EVFlags.data()); }
 
  private:
   void LoadScrWork();
