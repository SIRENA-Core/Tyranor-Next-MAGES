+#include "../../vm/interface/input.h"
+#include "../../audio/audiosystem.h"
+
+namespace Impacto {
+namespace UI {
+namespace SGHD {
+
+using namespace Impacto::Profile::SGHD::TitleMenu;
+using namespace Impacto::Profile::ScriptVars;
+using namespace Impacto::Vm::Interface;
+namespace Common = Impacto::Profile::TitleMenu;
+
+namespace {
+void PlaySe(int id) { Audio::PlayInGroup(Audio::ACG_SE, "sysse", id, false, 0.0f); }
+bool UseMouse() {
+  return Input::CurrentInputDevice == Input::Device::Mouse || Input::CurrentInputDevice == Input::Device::Touch;
+}
+}  // namespace
+
+TitleMenu::TitleMenu() {
+  SubCursor.assign(std::max(Common::MenuEntriesNum, 1), 0);
+  FlickerTimers.assign(FlickerItems.size(), 0.0f);
+  FlickerOn.assign(FlickerItems.size(), false);
+}
+
+const TitleMenu::SubList* TitleMenu::SubListOf(int entry) const {
+  for (const SubList& list : SubLists) {
+    if (list.Entry != entry) continue;
+    if (list.IfFlag >= 0 && !GetFlag(list.IfFlag)) continue;
+    if (list.IfNotFlag >= 0 && GetFlag(list.IfNotFlag)) continue;
+    return &list;
+  }
+  return nullptr;
+}
+
+void TitleMenu::Show() {
+  if (State == Shown) return;
+  State = Shown;
+  Reset();
+  if (UI::FocusedMenu != nullptr && UI::FocusedMenu != this) {
+    LastFocusedMenu = UI::FocusedMenu;
+    LastFocusedMenu->IsFocused = false;
+  }
+  IsFocused = true;
+  UI::FocusedMenu = this;
+}
+
+void TitleMenu::Hide() {
+  if (State == Hidden) return;
+  State = Hidden;
+  AllowsScriptInput = true;
+  if (UI::FocusedMenu == this) UI::FocusedMenu = LastFocusedMenu;
+  if (UI::FocusedMenu != nullptr) UI::FocusedMenu->IsFocused = true;
+  LastFocusedMenu = nullptr;
+  IsFocused = false;
+}
+
+// As the original title init: first entry (none in mouse mode), sub lists closed.
+void TitleMenu::Reset() {
+  Cursor = UseMouse() ? -1 : 0;
+  std::fill(SubCursor.begin(), SubCursor.end(), 0);
+  SubCounter = 0.0f;
+  SubDirection = 0;
+  DecideCounter = 0.0f;
+  Decided = false;
+}
+
+void TitleMenu::UpdateFlicker(float frames) {
+  std::uniform_int_distribution<int> timer(10, 39), half(0, 1), third(0, 2);
+  for (size_t i = 0; i < FlickerItems.size(); i++) {
+    if (!FlickerItems[i].Random) continue;
+    FlickerTimers[i] -= frames;
+    if (FlickerTimers[i] <= 0.0f) {
+      FlickerTimers[i] = (float)timer(Rng);
+      FlickerOn[i] = half(Rng) != 0;
+    }
+  }
+  BarTimer -= frames;
+  if (BarTimer <= 0.0f) {
+    BarTimer = (float)timer(Rng);
+    BarChoice = third(Rng);
+  }
+}
+
+void TitleMenu::Update(float dt) {
+  const bool title = GetFlag(SF_TITLEMODE) != 0;
+  if (title && State == Hidden) Show();
+  if (!title && State != Hidden) Hide();
+  if (State != Shown) return;
+
+  const float frames = dt * 60.0f;
+  const int mode = ScrWork[SW_TITLEMODE];
+  if (mode <= 2 && LastMode > 2) Reset();  // back to "press start": the menu starts afresh
+  LastMode = mode;
+  FrameClock += frames;
+  StartBlink = std::fmod(StartBlink + frames, PressToStartBlinkFrames);
+  UpdateFlicker(frames);
+
+  if (SubDirection != 0) {
+    SubCounter += SubDirection * frames;
+    if (SubCounter >= SubOpenFrames) {
+      SubCounter = SubOpenFrames;
+      SubDirection = 0;
+    } else if (SubCounter <= 0.0f) {
+      SubCounter = 0.0f;
+      SubDirection = 0;
+    }
+  }
+  if (DecideCounter > 0.0f) {
+    DecideCounter += frames;
+    if (DecideCounter >= DecideFrames) {
+      DecideCounter = 0.0f;
+      const SubList* sub = Cursor >= 0 ? SubListOf(Cursor) : nullptr;
+      int id = Cursor >= 0 && Cursor < (int)MenuEntryIds.size() ? MenuEntryIds[Cursor] : 0;
+      if (sub != nullptr && SubCounter > 0.0f) {
+        const int s = SubCursor[Cursor];
+        if (s >= 0 && s < (int)sub->Items.size()) id = sub->Items[s].Id;
+      }
+      ScrWork[SW_TITLECUR1] = id;
+      SetFlag(SF_TITLEEND, true);
+      Decided = true;
+    }
+  }
+  if (Decided && !GetFlag(SF_TITLEEND)) Decided = false;
+  AllowsScriptInput = Decided || (DecideCounter == 0.0f && SubDirection == 0 && SubCounter == 0.0f);
+
+  const bool focused = UI::FocusedMenu == nullptr || UI::FocusedMenu == this;
+  if (mode == 3 && ScrWork[SW_TITLEDISPCT] >= 32 && DecideCounter == 0.0f && !Decided && SubDirection == 0 &&
+      focused)
+    UpdateInput(dt);
+}
+
+void TitleMenu::StartDecide() {
+  PlaySe(2);
+  DecideCounter = 1.0f;
+}
+
+void TitleMenu::UpdateInput(float dt) {
+  const int n = std::min(Common::MenuEntriesNum, (int)MenuHitAreas.size());
+  if (n <= 0) return;
+  const bool mouse = UseMouse();
+  const glm::vec2 pos = Input::CurMousePos;
+  const bool click = (PADinputMouseWentDown & PAD1A) != 0;
+  const bool up = (PADinputButtonRepeatDown & PAD1UP) != 0;
+  const bool down = (PADinputButtonRepeatDown & PAD1DOWN) != 0;
+  const bool back = ((PADinputButtonWentDown | PADinputMouseWentDown) & PAD1B) != 0;
+  const bool ok = (PADinputButtonWentDown & PAD1A) != 0;
+
+  const SubList* sub = Cursor >= 0 ? SubListOf(Cursor) : nullptr;
+  if (sub != nullptr && SubCounter >= SubOpenFrames) {
+    int& s = SubCursor[Cursor];
+    const int count = (int)sub->Items.size();
+    bool decide = false;
+    if (mouse) {
+      s = -1;
+      for (int i = 0; i < count; i++)
+        if (sub->Items[i].HitArea.ContainsPoint(pos)) {
+          s = i;
+          decide = click;
+        }
+    }
+    if (up) {
+      PlaySe(1);
+      s = s < 0 ? 0 : (s == 0 ? count - 1 : s - 1);
+    } else if (down) {
+      PlaySe(1);
+      s = s < 0 || s + 1 >= count ? 0 : s + 1;
+    } else if (back) {
+      PlaySe(3);
+      SubDirection = -1;  // close; the script does not see this press
+      PADinputButtonWentDown &= ~PAD1B;
+      PADinputMouseWentDown &= ~PAD1B;
+    } else if ((ok || decide) && s >= 0) {
+      StartDecide();
+    }
+    if (ok || decide) {
+      PADinputButtonWentDown &= ~PAD1A;
+      PADinputMouseWentDown &= ~PAD1A;
+    }
+    return;
+  }
+
+  bool decide = false;
+  if (mouse) {
+    Cursor = -1;
+    for (int i = 0; i < n; i++)
+      if (MenuHitAreas[i].ContainsPoint(pos)) {
+        Cursor = i;
+        decide = click;
+      }
+  }
+  if (up) {
+    PlaySe(1);
+    Cursor = Cursor < 0 ? 0 : (Cursor == 0 ? n - 1 : Cursor - 1);
+  } else if (down) {
+    PlaySe(1);
+    Cursor = Cursor < 0 || Cursor + 1 >= n ? 0 : Cursor + 1;
+  } else if ((ok || decide) && Cursor >= 0) {
+    if (SubListOf(Cursor) != nullptr) {
+      PlaySe(2);
+      SubDirection = 1;
+      SubCounter = std::max(SubCounter, 1.0f);
+      if (mouse) SubCursor[Cursor] = -1;
+    } else {
+      StartDecide();
+    }
+    PADinputButtonWentDown &= ~PAD1A;
+    PADinputMouseWentDown &= ~PAD1A;
+  }
+}
+
+void TitleMenu::RenderFlicker(float alpha) {
+  if (((int)FrameClock & 1) != 0) return;  // the original draws these every other frame
+  const glm::vec4 col(glm::vec3(1.0f), alpha);
+  for (size_t i = 0; i < FlickerItems.size(); i++)
+    if (!FlickerItems[i].Random || FlickerOn[i])
+      Renderer->DrawSprite(FlickerItems[i].Sprite_, FlickerItems[i].Position, col);
+  if (!FlickerBarWidths.empty()) {
+    Sprite bar = FlickerBarSprite;
+    bar.Bounds.Width = FlickerBarWidths[std::clamp(BarChoice, 0, (int)FlickerBarWidths.size() - 1)];
+    Renderer->DrawSprite(bar, FlickerBarPosition, col);
+  }
+}
+
+void TitleMenu::RenderMenu(int alpha) {
+  const float a = alpha / 256.0f;
+  const bool hideChosen = DecideCounter > 0.0f && ((int)DecideCounter & DecideBlinkFrames) == 0;
+
+  const SubList* sub = Cursor >= 0 ? SubListOf(Cursor) : nullptr;
+  if (sub != nullptr && SubCounter > 0.0f) {
+    const float c = SubCounter;
+    const glm::vec2 off(SubSlideDistance * (SubOpenFrames - c) / SubOpenFrames, 0.0f);
+    const glm::vec4 col(glm::vec3(1.0f), c / SubOpenFrames);
+    Renderer->DrawSprite(sub->Bracket, sub->BracketPosition + off, col);
+    for (int i = 0; i < (int)sub->Items.size(); i++) {
+      const bool chosen = SubCursor[Cursor] == i;
+      if (chosen && hideChosen) continue;
+      Renderer->DrawSprite(chosen ? sub->Items[i].Highlighted : sub->Items[i].Normal, sub->Items[i].Position + off,
+                           col);
+    }
+  }
+
+  // the entries come in from the right in steps of alpha / 8, as the original
+  const float x = MenuPosition.x + MenuSlideDistance * (32 - (alpha >> 3)) / 32.0f;
+  const glm::vec4 col(glm::vec3(1.0f), a);
+  for (int i = 0; i < Common::MenuEntriesNum; i++) {
+    const bool chosen = i == Cursor;
+    if (chosen && hideChosen) continue;
+    Renderer->DrawSprite(chosen ? Common::MenuEntriesHSprites[i] : Common::MenuEntriesSprites[i],
+                         glm::vec2(x, MenuPosition.y + i * MenuSpacing), col);
+  }
+}
+
+void TitleMenu::Render() {
+  if (State != Shown || !GetFlag(SF_TITLEMODE)) return;
+  const int mode = ScrWork[SW_TITLEMODE];
+  const int ct = std::clamp(ScrWork[SW_TITLEDISPCT], 0, 32);
+  const glm::vec4 white(1.0f);
+  switch (mode) {
+    case 0:
+    case 1:
+    case 2: {
+      Renderer->DrawSprite(BackgroundSprite, glm::vec2(0.0f), white);
+      RenderFlicker(1.0f);
+      float blink = -1.0f;
+      if (mode == 2) {
+        const int c = ScrWork[SW_TITLEDISPCT] & 15;
+        blink = (c < 8 ? c * 32 : 256 - (c - 8) * 32) / 256.0f;
+      } else if (mode == 1 || ct == 32) {
+        const float half = PressToStartBlinkFrames / 2.0f;
+        blink = (StartBlink < half ? StartBlink : PressToStartBlinkFrames - StartBlink) / half;
+      }
+      if (blink >= 0.0f)
+        Renderer->DrawSprite(Common::PressToStartSprite, Common::PressToStartPos, glm::vec4(glm::vec3(1.0f), blink));
+      if (mode == 0)
+        Renderer->DrawQuad(RectF(0.0f, 0.0f, Profile::Game::DesignWidth, Profile::Game::DesignHeight),
+                           glm::vec4(0.0f, 0.0f, 0.0f, (32 - ct) / 32.0f));
+    } break;
+    case 3:
+    case 5: {
+      const int alpha = ct * 8;
+      Renderer->DrawSprite(BackgroundSprite, glm::vec2(0.0f), white);
+      Renderer->DrawSprite(GuideSprite, GuidePosition, glm::vec4(glm::vec3(1.0f), alpha / 256.0f));
+      RenderFlicker(1.0f);
+      RenderMenu(alpha);
+    } break;
+    case 4: {
+      const int alpha = (32 - ct) * 8;
+      const glm::vec4 col(glm::vec3(1.0f), alpha / 256.0f);
+      Renderer->DrawSprite(BackgroundSprite, glm::vec2(0.0f), col);
+      Renderer->DrawSprite(GuideSprite, GuidePosition, col);
+      RenderFlicker(alpha / 256.0f);
+      RenderMenu(alpha);
+    } break;
+    default:
+      break;
+  }
+}
+
+}  // namespace SGHD
+}  // namespace UI
+}  // namespace Impacto
