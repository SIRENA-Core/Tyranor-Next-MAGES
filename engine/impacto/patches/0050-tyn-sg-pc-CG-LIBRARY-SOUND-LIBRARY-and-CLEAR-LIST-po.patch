diff --git a/src/games/sghd/cglibrary.cpp b/src/games/sghd/cglibrary.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7de60e738d92fc3563c491e6dcea75878f955295
--- /dev/null
+++ b/src/games/sghd/cglibrary.cpp
@@ -0,0 +1,407 @@
+// CG LIBRARY of STEINS;GATE (Steam): 10:1F type 0 (0x415e90) / type 1 (0x4168f0, viewer 0x417060), drawn by
+// 0x415dc0 / 0x4161b0 / 0x416e90 while GlobalVars[2148] is 8. The picture itself is loaded by the script
+// (flag 1341: LoadBackground(GlobalVars[2307], GlobalVars[2306]), then flag 1342).
+
+#include "cglibrary.h"
+
+#include <algorithm>
+#include <array>
+
+#include "album.h"
+#include "phonerender.h"
+#include "../../background2d.h"
+#include "../../inputsystem.h"
+#include "../../mem.h"
+#include "../../profile/scriptvars.h"
+#include "../../profile/sprites.h"
+#include "../../renderer/renderer.h"
+#include "../../util.h"
+#include "../../vm/interface/input.h"
+
+namespace Impacto {
+namespace SGHD {
+namespace CgLibrary {
+
+using namespace Impacto::Vm::Interface;
+using namespace Impacto::Profile::ScriptVars;
+
+namespace {
+
+constexpr int Surface = 0x97, Thumbs = 0x98;  // ALBUM / ALBUM_THUM, loaded by the script
+constexpr float K = 1.5f;
+constexpr float W = 1920, H = 1080;
+
+int Page = 0;          // DAT_00d4b904
+int Cursor = 0xff;     // DAT_00d4b4d4
+int HoverTab = 0xff;   // DAT_00d4e50c
+int Blink = 0;         // DAT_00d4e51c
+std::array<int, Album::Pages * Album::GroupsPerPage> Total{}, Seen{};
+std::array<std::array<int, Album::MaxPictures>, Album::Pages * Album::GroupsPerPage> SeenList{};
+
+int State = 0;      // DAT_00d4cfc4: 0 grid, 1 opening, 2 viewing, 3 closing
+int Fade = 0;       // DAT_00d4e46c (0..32)
+int Picture = 0;    // DAT_00d4e478, index into the seen pictures of the group
+int Pictures = 0;   // DAT_00d4e47c
+bool Guide = true;  // DAT_00d4e504
+bool Dragging = false, Moved = false;
+glm::vec2 DragStart{}, PanStart{};
+
+// the two picture layers of the viewer (current, next): script buffer, zoom, smallest zoom, size, centre, alpha
+struct Layer {
+  int Buffer = 1;
+  float Zoom = 1, MinZoom = 1, Width = W, Height = H, Cx = W / 2, Cy = H / 2;
+  int Alpha = 0;  // 0..16
+  bool Ready = false;
+};
+std::array<Layer, 2> Layers{};
+int Shown = 0;     // DAT_00d4e480 (0..16): the current picture faded in
+bool Loading = false;
+
+const Background2D* Bg(int buffer) {
+  auto it = Backgrounds2D.find(ScrWork[SW_BG1SURF + GetBufferId(buffer)]);
+  if (it == Backgrounds2D.end() || !it->second || it->second->Status != LoadStatus::Loaded) return nullptr;
+  return it->second;
+}
+
+bool MouseMode() {
+  return Input::CurrentInputDevice == Input::Device::Mouse || Input::CurrentInputDevice == Input::Device::Touch;
+}
+bool Inside(glm::vec2 p, float x, float y, float w, float h) {
+  return p.x >= x && p.x < x + w && p.y >= y && p.y < y + h;
+}
+
+// 0x417620: keep the centre inside the picture
+void Clamp(Layer& l) {
+  const float vw = W / l.Zoom, vh = H / l.Zoom;
+  if (vw < l.Width) {
+    l.Cx = std::clamp(l.Cx, vw / 2, l.Width - vw / 2);
+  } else {
+    l.Cx = l.Width / 2;
+  }
+  if (vh < l.Height) {
+    l.Cy = std::clamp(l.Cy, vh / 2, l.Height - vh / 2);
+  } else {
+    l.Cy = l.Height / 2;
+  }
+}
+
+// 0x416df0: size of a freshly loaded picture and the zoom that shows all of it
+void Measure(Layer& l) {
+  if (const Background2D* bg = Bg(l.Buffer)) {
+    l.Width = bg->BgSprite.Bounds.Width;
+    l.Height = bg->BgSprite.Bounds.Height;
+  }
+  l.MinZoom = 1.0f;
+  if (W < l.Width) {
+    l.MinZoom = W / l.Width;
+  } else if (H < l.Height) {
+    l.MinZoom = H / l.Height;
+  }
+  l.Zoom = l.MinZoom;
+  l.Cx = l.Width / 2;
+  l.Cy = l.Height / 2;
+}
+
+// 0x417720: ask the script for the next picture of the group, into the other layer's buffer
+void LoadPicture() {
+  const int g = Cursor + Page * Album::GroupsPerPage;
+  const int entry = SeenList[g][Picture];
+  Layers[1].Buffer = Layers[0].Buffer == 1 ? 2 : 1;
+  ScrWork[2306] = Album::Groups[g].Pictures[entry][1];
+  ScrWork[2307] = Layers[1].Buffer;
+  SetFlag(1341, true);
+  SetFlag(1342, false);
+  Loading = true;
+}
+
+void Zoom(Layer& l, float delta) {  // the zoom steps of 0x417060, snapping to 1:1 on the way
+  const float z = l.Zoom;
+  if (delta > 0) {
+    if (z < 1.0f && z + std::abs(delta) >= 1.0f) {
+      l.Zoom = 1.0f;
+    } else {
+      l.Zoom = std::min(z + delta, 2.0f);
+    }
+  } else {
+    if (z > 1.0f && z + delta <= 1.0f) {
+      l.Zoom = 1.0f;
+    } else {
+      l.Zoom = std::max(z + delta, l.MinZoom);
+    }
+  }
+  Clamp(l);
+}
+
+void UpdateViewer() {
+  // the script has loaded the next picture: measure it and fade it in over the current one
+  if (Loading) {
+    if (!(GetFlag(1341) && GetFlag(1342))) return;
+    SetFlag(1341, false);
+    SetFlag(1342, false);
+    Loading = false;
+    Measure(Layers[1]);
+    Layers[1].Alpha = 1;
+    Layers[1].Ready = true;
+  }
+  if (State == 3) {  // closing
+    if (Shown > 0) {
+      Shown--;
+      Layers[0].Alpha = Shown;
+    }
+    return;
+  }
+  if (Layers[1].Ready) {
+    if (++Layers[1].Alpha >= 16) {
+      Layers[0] = Layers[1];
+      Layers[0].Alpha = 16;
+      Layers[1] = Layer{};
+      Layers[1].Buffer = Layers[0].Buffer == 1 ? 2 : 1;
+      Shown = 16;
+    }
+    return;
+  }
+  Layer& l = Layers[0];
+  const glm::vec2 p = Input::CurMousePos;
+  bool decide = (PADinputButtonWentDown & PAD1A) != 0;
+  if (MouseMode()) {
+    if (Input::MouseWheelDeltaY > 0) Zoom(l, 0.05f);
+    if (Input::MouseWheelDeltaY < 0) Zoom(l, -0.05f);
+    if (Input::TouchPinchIn) Zoom(l, -0.05f);
+    // drag pans the picture; a click without a drag goes on to the next picture
+    if (PADinputMouseWentDown & PAD1A) {
+      Dragging = true;
+      Moved = false;
+      DragStart = p;
+      PanStart = {l.Cx, l.Cy};
+    }
+    if (Dragging) {
+      const glm::vec2 d = p - DragStart;
+      if (d.x * d.x + d.y * d.y > 999) Moved = true;
+      if (Moved) {
+        l.Cx = PanStart.x - d.x / l.Zoom;
+        l.Cy = PanStart.y - d.y / l.Zoom;
+        Clamp(l);
+      }
+      if (!(PADinputMouseIsDown & PAD1A)) {
+        Dragging = false;
+        if (!Moved) decide = true;
+      }
+    }
+  }
+  if (PADinputButtonWentDown & PAD1Y) Guide = !Guide;
+  if (decide) {
+    if (Picture + 1 == Pictures) {
+      State = 3;
+    } else {
+      Picture++;
+      LoadPicture();
+    }
+    return;
+  }
+  if (((PADinputButtonWentDown | PADinputMouseWentDown) & PAD1B) != 0) {
+    PADinputButtonWentDown &= ~PAD1B;
+    PADinputMouseWentDown &= ~PAD1B;
+    State = 3;
+    return;
+  }
+  if (PADinputButtonRepeatDown & PAD1R1) Zoom(l, 0.02f);
+  if (PADinputButtonRepeatDown & PAD1L1) Zoom(l, -0.02f);
+  if (PADinputButtonIsDown & PAD1UP) l.Cy -= 40, Clamp(l);
+  if (PADinputButtonIsDown & PAD1DOWN) l.Cy += 40, Clamp(l);
+  if (PADinputButtonIsDown & PAD1LEFT) l.Cx -= 40, Clamp(l);
+  if (PADinputButtonIsDown & PAD1RIGHT) l.Cx += 40, Clamp(l);
+}
+
+// 0x4177b0 + 0x416e90: the visible part of a picture stretched over the screen, black where it does not reach
+void DrawLayer(const Layer& l, int alpha) {
+  const Background2D* bg = Bg(l.Buffer);
+  if (!bg || alpha <= 0) return;
+  float sx, sw, dx0, dx1, sy, sh, dy0, dy1;
+  if (W / l.Zoom < l.Width) {
+    sw = W / l.Zoom, sx = l.Cx - sw / 2, dx0 = 0, dx1 = W;
+  } else {
+    sx = 0, sw = l.Width, dx0 = (W - l.Width * l.Zoom) / 2, dx1 = W - dx0;
+  }
+  if (H / l.Zoom < l.Height) {
+    sh = H / l.Zoom, sy = l.Cy - sh / 2, dy0 = 0, dy1 = H;
+  } else {
+    sy = 0, sh = l.Height, dy0 = (H - l.Height * l.Zoom) / 2, dy1 = H - dy0;
+  }
+  const glm::vec4 tint(1, 1, 1, std::min(alpha, 256) / 256.0f);
+  Sprite part(bg->BgSprite.Sheet, sx, sy, sw, sh);
+  Renderer->DrawSprite(part, RectF(dx0, dy0, dx1 - dx0, dy1 - dy0), tint);
+  const glm::vec4 black(0, 0, 0, tint.a);
+  if (dx0 > 0) Renderer->DrawQuad(RectF(0, 0, dx0, H), black);
+  if (dx1 < W) Renderer->DrawQuad(RectF(dx1, 0, W - dx1, H), black);
+  if (dy0 > 0) Renderer->DrawQuad(RectF(0, 0, W, dy0), black);
+  if (dy1 < H) Renderer->DrawQuad(RectF(0, dy1, W, H - dy1), black);
+}
+
+void DrawGuide(int which, int a) {  // 0x436030
+  auto it = Profile::SpriteSheets.find("Data");
+  if (it == Profile::SpriteSheets.end()) return;
+  Sprite guide(it->second, (which % 2) * 0x600 + 1.0f, (which / 2) * 0x2a + 0x600 + 1.0f, 1534, 40);
+  Renderer->DrawSprite(guide, RectF(1, 995, 1534, 40), glm::vec4(1, 1, 1, std::min(a, 256) / 256.0f));
+}
+
+// 0x4161b0: the twelve groups of the page, the page number and the page tabs
+void DrawGrid(int a) {
+  using namespace Phone;
+  Blink = (Blink + 1) & 0x1f;
+  const int tabAlpha = (int)((((Blink > 0xf ? 0x20 - Blink : Blink) * a) & 0xfffffff) >> 4);
+  int thumbRow = Page * 3 * 0x89, thumbCol = 0;
+  for (int r = 0; r < 3; r++) {
+    const int y = 100 + 0xa1 * r;
+    for (int c = 0; c < 4; c++) {
+      const int slot = r * 4 + c, g = Page * Album::GroupsPerPage + slot;
+      const int x = 0x147 + 0x10e * c;
+      const float cellX = (x - 0xd5) * K, cellY = y * K, picX = (x - 0xd4) * K, picY = (y + 1) * K;
+      const float digitsY = (y + 0x6f) * K;
+      auto digit = [&](float srcX, float dx) { Spr(Surface, srcX, 517.5f, 21, 33, dx / K, digitsY / K, a); };
+      if (Total[g] == 0) {
+        Spr(Surface, 1921.5f, 553.5f, 363, 205.5f, cellX / K, cellY / K, a);
+      } else {
+        Spr(Surface, 2287.5f, 553.5f, 363, 205.5f, cellX / K, cellY / K, a);
+        if (Seen[g] == 0) {
+          Spr(Surface, slot == Cursor ? 1921.5f : 2284.5f, 1.5f, 360, 202.5f, picX / K, picY / K, a);
+          digit(2185.5f, (x - 0x20) * K);
+        } else {
+          Spr(Thumbs, (slot == Cursor ? thumbCol + 1 : thumbCol + 0x3c9) * K, (thumbRow + 1) * K, 360, 202.5f,
+              picX / K, picY / K, a);
+          digit((Seen[g] * 0x10 + 0x501) * K, (x - 0x20) * K);
+        }
+        digit(2161.5f, (x - 0x10) * K);
+        digit((Total[g] * 0x10 + 0x501) * K, x * K);
+      }
+      Spr(Surface, 1921.5f, 312, 360, 202.5f, picX / K, picY / K, a);
+      if (slot == Cursor) Spr(Surface, 2284.5f, 312, 360, 202.5f, picX / K, picY / K, a);
+      thumbCol += 0xf2;
+      if (thumbCol == 0x3c8) thumbRow += 0x89, thumbCol = 0;
+    }
+  }
+  Spr(Surface, (Page * 0x20 + 0x521) * K, 216, 45, 57, 1704 / K, 868.5f / K, a);
+  if (auto it = Profile::SpriteSheets.find("Data"); it != Profile::SpriteSheets.end()) {
+    Sprite slash(it->second, 259.5f, 280.5f, 48, 36);
+    Renderer->DrawSprite(slash, RectF(1749, 888, 48, 36), glm::vec4(1, 1, 1, std::min(a, 256) / 256.0f));
+  }
+  for (int i = 0; i < Album::Pages; i++) {
+    const float x = (0x39f + 0x28 * i) * K / K;
+    Spr(Surface, HoverTab == i ? 2095.5f : 2008.5f, 276, 84, 33, x, 942 / K, a);
+    if (i == Page) Spr(Surface, 1921.5f, 276, 84, 33, x, 942 / K, tabAlpha);
+  }
+}
+
+}  // namespace
+
+void Init() {
+  for (int f : {0x51e, 0x51f, 0x53d, 0x53e, 0x53f}) SetFlag(f, false);
+  State = 0;
+  Fade = 0;
+  Shown = 0;
+  Loading = false;
+  Layers = {};
+  Layers[0].Buffer = 1;
+  Layers[1].Buffer = 2;
+  Cursor = 0xff;
+  for (int g = 0; g < Album::Pages * Album::GroupsPerPage; g++) {
+    Total[g] = Album::Groups[g].Count();
+    Seen[g] = 0;
+    for (int i = 0; i < Total[g]; i++)
+      if (Album::Seen(Album::Groups[g].Pictures[i][0])) SeenList[g][Seen[g]++] = i;
+    if (Seen[g] != 0 && g / Album::GroupsPerPage == Page && Cursor == 0xff) Cursor = g % Album::GroupsPerPage;
+  }
+  if (MouseMode()) Cursor = 0xff;
+}
+
+void Update() {
+  if (State == 2 || Shown != 0 || State == 3) {
+    if (State == 3 && Shown == 0 && !Layers[1].Ready) {
+      if (--Fade <= 0) {
+        Fade = 0;
+        State = 0;
+      }
+      return;
+    }
+    UpdateViewer();
+    return;
+  }
+  if (State == 1) {
+    if (++Fade >= 0x20) State = 2;
+    UpdateViewer();
+    return;
+  }
+  const bool mouse = MouseMode();
+  const glm::vec2 p = Input::CurMousePos;
+  bool decide = (PADinputButtonWentDown & PAD1A) != 0;
+  HoverTab = 0xff;
+  if (mouse) {
+    Cursor = 0xff;
+    if (Input::MouseWheelDeltaY > 0) Page = Page == 0 ? 6 : Page - 1;
+    if (Input::MouseWheelDeltaY < 0) Page = Page < 6 ? Page + 1 : 0;
+    const bool click = (PADinputMouseWentDown & PAD1A) != 0;
+    for (int i = 0; i < Album::Pages; i++)
+      if (Inside(p, 1389 + 60.0f * i, 940, 87, 36)) {
+        HoverTab = i;
+        if (click) Page = i;
+      }
+    for (int s = 0; s < Album::GroupsPerPage; s++)
+      if (Inside(p, 171 + 405.0f * (s % 4), 150 + 241.5f * (s / 4), 366, 208)) {
+        Cursor = s;
+        if (click) decide = true;
+      }
+  }
+  if (!mouse && Cursor == 0xff &&
+      (PADinputButtonRepeatDown & (PAD1UP | PAD1DOWN | PAD1LEFT | PAD1RIGHT)) != 0) {
+    for (int s = 0; s < Album::GroupsPerPage; s++)
+      if (Seen[Page * Album::GroupsPerPage + s] != 0) Cursor = s;
+    return;
+  }
+  if (PADinputButtonWentDown & PAD1L1) Page = Page == 0 ? 6 : Page - 1;
+  if (PADinputButtonWentDown & PAD1R1) Page = Page < 6 ? Page + 1 : 0;
+  if (((PADinputButtonWentDown | PADinputMouseWentDown) & PAD1B) != 0) {
+    SetFlag(0x51f, true);  // the script leaves
+    return;
+  }
+  if (decide) {
+    const int g = Cursor + Page * Album::GroupsPerPage;
+    if (Cursor != 0xff && Seen[g] != 0) {
+      PADinputButtonWentDown &= ~PAD1A;
+      PADinputMouseWentDown &= ~PAD1A;
+      Pictures = Seen[g];
+      Picture = 0;
+      Guide = true;
+      Shown = 0;
+      State = 1;
+      Fade = 0;
+      Layers[0] = Layer{};
+      Layers[0].Buffer = 2;  // the first load goes to buffer 1
+      LoadPicture();
+    }
+    return;
+  }
+  if (Cursor == 0xff) return;
+  if (PADinputButtonRepeatDown & PAD1UP) Cursor = Cursor < 4 ? Cursor + 8 : Cursor - 4;
+  if (PADinputButtonRepeatDown & PAD1DOWN) Cursor = Cursor < 8 ? Cursor + 4 : Cursor - 8;
+  if (PADinputButtonRepeatDown & PAD1LEFT) Cursor = (Cursor & 3) == 0 ? Cursor + 3 : Cursor - 1;
+  if (PADinputButtonRepeatDown & PAD1RIGHT) Cursor = (Cursor & 3) == 3 ? Cursor - 3 : Cursor + 1;
+}
+
+void Render() {
+  if (ScrWork[2148] != 8 || ScrWork[2147] == 0) return;
+  using namespace Phone;
+  const int a = ScrWork[2147] << 3;
+  Spr(Surface, 0, 0, 1920, 1080, 0, 0, a);
+  DrawGuide(3, a);
+  DrawGrid(a);
+  if (State != 0) {
+    // the viewer covers the grid while it opens and closes (32 frames)
+    Renderer->DrawQuad(RectF(0, 0, W, H), glm::vec4(0, 0, 0, std::min(Fade, 32) / 32.0f));
+    DrawLayer(Layers[0], Layers[0].Alpha << 4);
+    if (Layers[1].Ready) DrawLayer(Layers[1], Layers[1].Alpha << 4);
+    if (Shown != 0 && Guide) DrawGuide(4, a);
+  }
+}
+
+}  // namespace CgLibrary
+}  // namespace SGHD
+}  // namespace Impacto
