diff --git a/src/games/sg0/phone.cpp b/src/games/sg0/phone.cpp
new file mode 100755
index 0000000000000000000000000000000000000000..2a94f03914424c8bcce8c9995978d8021cbf8df5
--- /dev/null
+++ b/src/games/sg0/phone.cpp
@@ -0,0 +1,139 @@
+// Entry points of the STEINS;GATE 0 phone (phone.h) into the translated functions.
+#include "phone.h"
+
+#include <algorithm>
+
+#include "phoneglobals.h"
+#include "../../inputsystem.h"
+#include "../../log.h"
+#include "../../debugtools.h"
+#include "../../game.h"
+#include "../../mem.h"
+#include "../../profile/scriptvars.h"
+#include "../../renderer/renderer.h"
+#include "../../vm/interface/input.h"
+
+namespace Impacto {
+namespace SG0 {
+namespace Phone {
+
+using namespace PhoneCode;
+using Game::DrawComponentType;
+
+namespace {
+int Sw(int offset) { return *reinterpret_cast<int*>(DAT_02ee7660 + offset); }
+}  // namespace
+
+void Update(float dt) {}
+
+bool InputTaken() { return LoopFrames > 0; }
+
+// The message window's phone button (hit area 6 / 10 of 0x475860; 0x489d40 of the original's message window input):
+// a click on it or the middle button presses the phone button (PADcustom[22]) for the scripts.
+void UpdateInput() {
+  BeginFrame();
+  CaptureInput();
+  if (InputTaken()) {  // the phone's clicks and wheel are not the scene's
+    LoopFrames--;
+    ClearMouse();
+    Input::MouseWheelDeltaY = 0;
+    return;
+  }
+  *reinterpret_cast<uint8_t*>(Sg0Emu::At(0x02edac92)) = 0;
+  if (Sw(0x217c) != 0 || (Sw(0x2104) & 4) != 0 || Sw(0x2104) == 0 || GetFlag(0x4c7)) return;
+  if (GetFlag(0xa2f) || (GetFlag(0xa28) && !GetFlag(0xa2d))) return;
+  using namespace Impacto::Vm::Interface;
+  if (PADcustom.size() <= 22) return;
+  const bool over = FUN_00446ef0(6, 10, 0);
+  if (over) *reinterpret_cast<uint8_t*>(Sg0Emu::At(0x02edac92)) = 1;
+  const uint32_t mouse = MouseBits();
+  if ((over && (mouse & 1)) || (mouse & 4)) {
+    PADinputButtonWentDown |= PADcustom[22];
+    ClearMouse();
+  }
+}
+
+void RenderEarly() {
+  FUN_004709d0();
+  FUN_0046b870();
+}
+
+namespace {
+
+// 0x43f1b0: the phone on the layers ScrWork[6603] / ScrWork[6610]
+void DrawOnLayer(int layer) {
+  if (layer == Sw(0x672c)) {
+    if (Sw(0x6810) == 0)
+      FUN_0046bc00();
+    else
+      FUN_0046b9c0(0);
+  }
+  if (layer == Sw(0x6748)) {
+    if (Sw(0x681c) == 0)
+      FUN_0046bc00();
+    else
+      FUN_0046b9c0(1);
+  }
+}
+
+// The message window is a layer of the original too (ScrWork[6011], 0x43f1b0 -> 0x441330); the engine draws it
+// after all layers, so what the original draws above it comes after it here (RenderAfterText).
+bool TextDrawn() {
+  for (DrawComponentType c : Game::DrawComponents) {
+    if (c == DrawComponentType::None) break;
+    if (c == DrawComponentType::Text) return true;
+  }
+  return false;
+}
+bool AboveText(int layer) { return layer > Sw(0x5dec) && TextDrawn(); }
+
+// 0x475860, after the layers: the phone mark of the message window
+void DrawMark() {
+  // DAT_02ee565c: the message window is hidden (0x489d40)
+  *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x02ee565c)) = GetFlag(Profile::ScriptVars::SF_UIHIDDEN) ? 1 : 0;
+  FUN_00475860();
+}
+
+}  // namespace
+
+void RenderLayer(int layer) {
+  if (!AboveText(layer)) DrawOnLayer(layer);
+}
+
+void RenderAfterText() {
+  const int a = Sw(0x672c), b = Sw(0x6748);
+  const int lo = std::min(a, b), hi = std::max(a, b);
+  if (AboveText(lo)) DrawOnLayer(lo);
+  if (hi != lo && AboveText(hi)) DrawOnLayer(hi);
+  DrawMark();
+}
+
+void RenderMain() {
+  static int ct = 0;
+  if (DebugTools::Enabled() && ++ct % 15 == 0)  // for the porting tools (work scripts of the porting tools)
+    ImpLog(LogLevel::Debug, LogChannel::General,
+           "SG0 phone: 2608 {} 1611 {} 2600 {} alpha {} surf74 {} 6602 {} ab4 {} ab7 {} 6655 {:x} 6656 {} rine {:x} pri {} {} mes {}\n",
+           GetFlag(0xa30), GetFlag(1611), GetFlag(2600), *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x0198a360)),
+           Renderer->SurfToId.contains(0x4a), Sw(0x6728), GetFlag(0xab4), GetFlag(0xab7), Sw(0x67fc), Sw(0x6800),
+           *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x0198a2f8)), Sw(0x672c), Sw(0x6748), Sw(0x5dec));
+  if (!TextDrawn()) DrawMark();
+}
+
+void Reset() {
+  Sg0Emu::Reset();
+  FUN_00475ea0();
+}
+
+void Save(uint8_t* data) {
+  undefined4 size = 0;
+  FUN_00475ed0(data, &size);
+}
+
+void Load(const uint8_t* data) {
+  undefined4 size = 0;
+  FUN_00470620(const_cast<uint8_t*>(data), &size);
+}
+
+}  // namespace Phone
+}  // namespace SG0
+}  // namespace Impacto
diff --git a/src/games/sg0/phone.h b/src/games/sg0/phone.h
new file mode 100755
index 0000000000000000000000000000000000000000..ffda7371dc1d5cc8cb8cb5463c220e47e5232643
--- /dev/null
+++ b/src/games/sg0/phone.h
@@ -0,0 +1,60 @@
+#pragma once
+// The phone of STEINS;GATE 0 (Steam): home screen, RINE messenger (conversations whose replies the player picks),
+// Amadeus calls, address book, settings, wallpapers and ringtones. The functions of the original are translated from
+// the Ghidra decompile of Game.exe (phonecode.cpp, generated by tools/impacto/sg0/translate_phone.py; phonerine.cpp and
+// phoneshim.cpp by hand). The scripts drive it through instruction 10:37 and the script variables 6600..6700.
+#include <cstddef>
+#include <cstdint>
+
+namespace Impacto {
+namespace Vm {
+struct Sc3VmThread;
+}
+
+namespace SG0 {
+namespace PhoneCode {
+void BeginFrame();
+void ConsumeInput();
+void BridgeAudio();
+// frames left in which the player drives the phone (10:37 02 ran; the scripted phone scenes do not take input)
+inline int LoopFrames = 0;
+uint32_t MouseBits();
+void CaptureInput();
+void ClearMouse();
+}  // namespace PhoneCode
+
+namespace Phone {
+
+// language of the data (0 JP, 1 EN, 2 ZHC, 3 ZHT; the argument of launcher.exe), profile GameSpecific.Sg0Language
+inline int Language = 0;
+
+// Instruction 10:37 (0x482df0).
+void Instruction(Vm::Sc3VmThread* thread);
+
+// Once per frame before the scripts: the hit areas of the last frame.
+void Update(float dt);
+// Right after the input is read: the hit areas of the last frame, the phone button of the message window.
+void UpdateInput();
+// The phone owns the input while the player drives it (the phone loop of _system runs 10:37 02 every frame).
+bool InputTaken();
+
+// Before the layers (0x43f790): the phone into render target 9 when it zooms.
+void RenderEarly();
+// On every layer (0x43f1b0).
+void RenderLayer(int layer);
+// After the layers (0x475860): the phone mark of the message window, when the message window is not drawn.
+void RenderMain();
+// After the message window: the phone layers above it, the phone mark.
+void RenderAfterText();
+
+// New game (0x483240 -> 0x475ea0).
+void Reset();
+
+// The phone keeps 0x3ee0 bytes in every save (0x475ed0 / 0x470620).
+constexpr size_t SaveDataSize = 0x3ee0;
+void Save(uint8_t* data);
+void Load(const uint8_t* data);
+
+}  // namespace Phone
+}  // namespace SG0
+}  // namespace Impacto
