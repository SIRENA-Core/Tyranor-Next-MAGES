--- /dev/null
+++ b/src/games/mo6twpc/savesystem.cpp
@@ -0,0 +1,848 @@
+#include "savesystem.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <numeric>
+#include <ranges>
+
+#ifndef _WIN32
+#include <unistd.h>
+#endif
+
+#include "../../mem.h"
+#include "../../util.h"
+#include "../../vm/vm.h"
+#include "../../profile/data/savesystem.h"
+#include "../../profile/scriptvars.h"
+#include "../../profile/vm.h"
+#include "../../profile/configsystem.h"
+#include "../../audio/audiosystem.h"
+#include "../../renderer/renderer.h"
+
+// Save system of the PC release of Memories Off 6 T-Wave.
+//
+// Derivation of the persisted ranges. All 196 PC scripts were disassembled and
+// every ScrWork/flag index they touch was collected. The usage follows the CC
+// (PS4) layout, which is what this implementation is modelled on
+// (CCLCC::SaveSystem):
+//  * flags 400-799 (bytes 50-99) and 2400-3199 (bytes 300-399): story flags
+//    and the BG/CHA display flags (SF_BG1DISP = 2400, ...) -> saved per entry;
+//  * flags 800-1199 (bytes 100-149; SF_CLR_* 800-814, unlocks 840-910) and
+//    bytes 460-499 -> system data. Flags 1200-2399 (menu/engine run time flags
+//    such as 1370, 1805, 1883, 2354-2366) are scratch and are never saved;
+//  * ScrWork 0-1599 (story variables: 600-631 are the per-heroine counters
+//    that macrosys.scx copies around, 1000-1029/1400-1411/1500-1503 are
+//    script variables, 1-420 are script temporaries) -> saved per entry;
+//  * ScrWork 1600-2099 (1600, SW_TOTALPLAYTIME 2001, 2003) -> system data;
+//  * ScrWork 2100-4299 (menus, SW_MAINTHDP 3304, SW_SAVEERRORCODE 3333,
+//    SW_MENUCT 3503, SW_FILEALPHA 3505, SW_SV* 3601-3634, ...) are run time
+//    state of the engine and the save menu and are never saved;
+//  * ScrWork 4300-7299 (SW_TITLE 4300, SW_PLAYTIME 4304, BG/CHA/mask/effect
+//    structs with stride 40, movie 6330+) -> saved per entry.
+// The SV variables 3601-3634 are not saved: LoadScrWork() recreates them from
+// the restored BG/CHA/BGM/SE/script numbers exactly like CCLCC does, and the
+// script reloads the scene from them after LoadData(0).
+//
+// Slot counts: 48 full and 48 quick slots (MaxSaveEntries, the same as CC and
+// the PS3 release); the save menu shows six per page, i.e. eight pages
+// (the PC savemenu sheet has one entry sprite size and PREV/NEXT buttons).
+//
+// File format (little endian, own format, written atomically via temp file +
+// rename):
+//   "MO6S" u32 version(1)
+//   u32 systemSize, system blob (see SaveSystemData)
+//   u32 fullCount (48), u32 quickCount (48)
+//   per slot (full then quick, physical order): u8 status; if status != 0 the
+//   entry fields, see WriteEntry
+//   u32 CRC32 of all preceding bytes
+
+namespace Impacto {
+namespace MO6TWPC {
+
+using namespace Impacto::Vm;
+using namespace Impacto::Profile::SaveSystem;
+using namespace Impacto::Profile::ScriptVars;
+using namespace Impacto::Profile::Vm;
+namespace Cfg = Impacto::Profile::ConfigSystem;
