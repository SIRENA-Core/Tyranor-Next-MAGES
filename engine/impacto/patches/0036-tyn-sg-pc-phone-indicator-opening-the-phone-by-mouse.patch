 }
 
+namespace {
+bool SceneMouse = true;  // on in the game (10:3F 13 also runs only on a new start, not after a load)
+
+// 0x434d40, the phone part: in the mouse mode a click on the small phone at the top left (or the middle button) asks
+// the scripts to open the phone (flag 2363, polled by the main loop of _STARTUP_WIN); not while flag 2612 is set.
+}  // namespace
+
+static int OpenRequest = 0;  // frames the request stays up: the main loop of the scripts does not look at it every frame
+void UpdateSceneMouse() {
+  if (OpenRequest > 0 && --OpenRequest == 0) SetFlag(0x93b, 0);
+  SetIndicatorHover(false);
+  if (!SceneMouse || !MouseMode()) return;
+  if (GetFlag(0xa28) && GetFlag(0xa32)) return;
+  if (GetFlag(0xa34)) return;
+  if (Inside(99, 58, 360, 90)) {
+    SetIndicatorHover(true);
+    if (Input::MouseButtonWentDown[SDL_BUTTON_LEFT] || Input::TouchTapCount == 1) {
+      SetFlag(0x93b, 1);
+      OpenRequest = 10;
+      PADinputMouseWentDown = 0;  // the click / tap is not also the dialogue's (OK is a custom pad bit)
+    }
+  }
+  if (Input::MouseButtonWentDown[SDL_BUTTON_MIDDLE]) {
+    SetFlag(0x93b, 1);
+    OpenRequest = 10;
+  }
+}
+
+void SetSceneMouse(bool on) { SceneMouse = on; }
+
+void RenderMain() { RenderIndicator(); }
+
 void Update(float /*dt*/) {
   CheckUnread();  // 0x44d850
   uint32_t ct = SW(0x6a44);
@@ -1829,8 +1868,89 @@ void Instruction(Sc3VmThread* thread) {
 
 // 0x428790: the phone and the attachment screens are drawn on the layer GlobalVars[6842]
 void RenderLayer(int layer) {
-  if (layer != SW(0x6ae8)) return;
-  if ((uint32_t)SW(0x6b0c) < 0xff && (uint32_t)SW(0x6b10) < 0xff) RenderPhone();
+  if (layer == SW(0x6ae8)) {
+    if ((uint32_t)SW(0x6b0c) < 0xff && (uint32_t)SW(0x6b10) < 0xff) RenderPhone();
+    if (SW(0x6b0c) != 0) RenderPicture();
+    if (SW(0x6b10) != 0) RenderPictureStory();
+  }
+  if (layer == SW(0x6acc)) RenderTextPage();
+}
+
+// 10:38 (0x4683e0): text pages of attachments and the mouse for script driven scrolling
+void Instruction1038(Sc3VmThread* thread) {
+  thread->IpOffset += 2;
+  const uint8_t type = *thread->GetIp();
+  thread->IpOffset += 1;
+  ReadInput();
+  switch (type) {
+    case 0: {  // page table
+      const uint16_t label = *(uint16_t*)thread->GetIp();
+      thread->IpOffset += 2;
+      S.TextPageBuffer = thread->ScriptBufferId;
+      S.TextPageTable = ScriptGetLabelAddress(thread->ScriptBufferId, label);
+      break;
+    }
+    case 1:  // 0x44d6a0 / 0x459ac0: start (flags 1620 / 1621, 1622 / 1623 are scroll requests)
+    case 4:
+      SetFlag(type == 1 ? 0x654 : 0x656, 0);
+      SetFlag(type == 1 ? 0x655 : 0x657, 0);
+      SetFlag(0xbba, 1);
+      break;
+    case 2: {  // 0x44d6f0: one frame of a text page
+      S.ScrollHover = 0;
+      SetFlag(0x654, 0);
+      SetFlag(0x655, 0);
+      S.Hover = 0;
+      if (!MouseMode()) break;
+      if (Hit(0, 0x200)) SetFlag(0x654, 1);
+      if (Hit(0, 0x400)) SetFlag(0x655, 1);
+      if (Hit(0x1a, 1)) S.Hover = 1, S.ScrollHover = 1;
+      if (Hit(0x1b, 1)) S.Hover = 1, S.ScrollHover = 2;
+      if (Hit(0x1a, 8)) {
+        SetFlag(0x654, 1);
+        break;
+      }
+      if (Hit(0x1b, 8)) {
+        SetFlag(0x655, 1);
+        break;
+      }
+      if (Hit(0, 8)) PADinputButtonWentDown |= PAD1A;
+      break;
+    }
+    case 5: {  // 0x459b10: one frame of a mail scrolled by the script
+      S.ScrollHover = 0;
+      SetFlag(0x656, 0);
+      SetFlag(0x657, 0);
+      S.Hover = 0;
+      if (!MouseMode()) break;
+      if (Hit(0, 0x200)) SetFlag(0x656, 1);
+      if (Hit(0, 0x400)) SetFlag(0x657, 1);
+      bool free = true;
+      const bool canUp = (uint32_t)SW(0x6a78) > 0xc && SW(0x6a74) != 0;
+      const bool canDown = (uint32_t)SW(0x6a74) + 0xc < (uint32_t)SW(0x6a78);
+      if (Hit(0x2e, 1)) {
+        if (canUp) S.Hover = 1, S.ScrollHover = 1;
+        free = false;
+      }
+      if (Hit(0x2f, 1)) {
+        if (canDown) S.Hover = 1, S.ScrollHover = 2;
+        free = false;
+      }
+      if (canUp && Hit(0x2e, 8)) SetFlag(0x656, 1);
+      if (canDown && Hit(0x2f, 8)) SetFlag(0x657, 1);
+      if (free && Hit(0, 8)) PADinputButtonWentDown |= PAD1A;
+      break;
+    }
+    case 3:  // 0x44d650 / 0x459a70: end
+    case 6:
+      S.Hover = 0;
+      SetFlag(type == 3 ? 0x654 : 0x656, 0);
+      SetFlag(type == 3 ? 0x655 : 0x657, 0);
+      SetFlag(0xbba, 0);
+      break;
+    default:
+      break;
+  }
 }
 
 }  // namespace Phone
