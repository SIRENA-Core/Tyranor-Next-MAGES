+-- Generated from profiles/mo6tw/hud/datedisplay.lua by tools/impacto/mo6tw-pc/gen_hud.py in yuukana1/Tyranor-Next-Impacto: coordinates x1.5
+-- (PC system.cpk data01 is the PS3 Data sheet scaled by exactly 1.5).
+local sheet = "Data";
+local name = "Date";
+
+local yearNumFirstX = 2288;
+local yearNumFirstY = 95;
+local yearNumWidth = 38;
+local yearNum1Width = 12;
+local yearNumHeight = 30;
+
+local numFirstX = 2286;
