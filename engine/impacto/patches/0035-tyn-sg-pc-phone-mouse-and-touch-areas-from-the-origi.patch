-// Mouse mode of the original: no keyboard cursor, the entries follow the pointer. The phone hit areas are not
-// implemented yet, so the phone is always driven like with a pad (the host's on-screen keys provide the buttons).
-bool MouseMode() { return false; }
-bool Hit(int /*id*/, int /*kind*/) { return false; }
+// Mouse mode of the original (DAT_0052e6b0): no keyboard cursor, the entries follow the pointer; touch counts as the
+// mouse. Hit areas of the phone (table 0x52ea58, group 0x14): id, parent (1 = relative to the phone screen), x, y, w,
+// h in screen pixels; the underlined words of the phone trigger get theirs from the text layout (ids 48 + 20 * word).
+bool MouseMode() {
+  return Input::CurrentInputDevice == Input::Device::Mouse || Input::CurrentInputDevice == Input::Device::Touch;
+}
+
+namespace {
+struct HitArea {
+  int Id, Parent, X, Y, W, H;
+};
+constexpr HitArea HitAreas[] = {
+    {0, 0xffff, 0, 0, 1920, 1080},  {1, 0xffff, 1360, 217, 414, 476}, {2, 1, 85, 71, 88, 88},
+    {3, 1, 241, 71, 88, 88},        {4, 1, 241, 199, 88, 88},          {5, 1, 0, 90, 414, 36},
+    {6, 1, 0, 126, 414, 36},        {7, 1, 0, 162, 414, 36},           {8, 1, 0, 198, 414, 36},
+    {9, 1, 0, 234, 414, 36},        {10, 1, 30, 179, 353, 36},         {11, 1, 30, 215, 353, 36},
+    {12, 1, 0, 43, 414, 36},        {13, 1, 0, 79, 414, 36},           {14, 1, 0, 115, 414, 36},
+    {15, 1, 0, 151, 414, 36},       {16, 1, 0, 187, 414, 36},          {17, 1, 0, 223, 414, 36},
+    {18, 1, 0, 259, 414, 36},       {19, 1, 0, 295, 414, 36},          {20, 1, 0, 331, 414, 36},
+    {21, 1, 0, 367, 414, 36},       {22, 1, 0, 403, 414, 36},          {23, 1, 0, 439, 414, 36},
+    {24, 1, 0, 0, 207, 43},         {25, 1, 207, 0, 207, 43},          {26, 0xffff, 546, 66, 828, 32},
+    {27, 0xffff, 546, 986, 828, 32}, {28, 1, 0, 43, 414, 72},          {29, 1, 0, 115, 414, 72},
+    {30, 1, 0, 187, 414, 72},       {31, 1, 0, 259, 414, 72},          {32, 1, 0, 331, 414, 72},
+    {33, 1, 0, 403, 414, 72},       {34, 0xffff, 775, 414, 124, 70},   {35, 0xffff, 900, 414, 118, 70},
+    {36, 0xffff, 1018, 414, 124, 70}, {37, 0xffff, 775, 484, 124, 70}, {38, 0xffff, 900, 484, 118, 70},
+    {39, 0xffff, 1018, 484, 124, 70}, {40, 0xffff, 775, 555, 124, 70}, {41, 0xffff, 900, 555, 118, 70},
+    {42, 0xffff, 1018, 555, 124, 70}, {43, 0xffff, 775, 625, 124, 70}, {44, 0xffff, 900, 625, 118, 70},
+    {45, 0xffff, 1018, 625, 124, 70}, {46, 1, 0, 39, 414, 28},         {47, 1, 0, 452, 414, 28},
+};
+
+bool Inside(float x, float y, float w, float h) {
+  const glm::vec2 p = Input::CurMousePos;
+  return p.x >= x && p.x < x + w && p.y >= y && p.y < y + h;
+}
+}  // namespace
+
+// 0x433040: kind 1 = the pointer is over the area, 8 = clicked / tapped in it, 0x200 / 0x400 = wheel up / down
+bool Hit(int id, int kind) {
+  if (!MouseMode()) return false;
+  if (kind == 0x200) return id == 0 && Input::MouseWheelDeltaY > 0;
+  if (kind == 0x400) return id == 0 && Input::MouseWheelDeltaY < 0;
+  const bool click = (PADinputMouseWentDown & PAD1A) != 0;
+  if (kind == 8 && !click) return false;
+  if (id >= 48) {  // a word of the phone trigger
+    const int word = (id - 48) / 20;
+    for (const auto& r : S.LinkAreas)
+      if (r.Word == word && Inside(r.X, r.Y, r.W, r.H)) return true;
+    return false;
+  }
+  for (const HitArea& a : HitAreas) {
+    if (a.Id != id) continue;
+    float x = a.X, y = a.Y;
+    if (a.Parent == 1) x += 1360, y += 217;
+    return Inside(x, y, a.W, a.H);
+  }
+  return false;
+}
 
 void PlaySe(int id) { Audio::PlayInGroup(Audio::ACG_SE, "se", id, false, 0.0f); }
 
@@ -249,7 +303,7 @@ void CheckUnread() {
     }
 }
 
-void ClearLinkHitAreas() { S.LinkAreaCount = 0; }  // 0x45a950
+void ClearLinkHitAreas() { S.LinkAreas.clear(); }  // 0x45a950
 
 // ------------------------------------------------------------------------------------------------ modes
 
