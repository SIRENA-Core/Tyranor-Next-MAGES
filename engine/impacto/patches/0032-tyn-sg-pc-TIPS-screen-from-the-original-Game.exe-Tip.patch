+#include "tipsmenu.h"
+
+#include <algorithm>
+#include <string>
+
+#include "../../profile/games/sghd/tipsmenu.h"
+#include "../../profile/ui/tipsmenu.h"
+#include "../../profile/dialogue.h"
+#include "../../profile/scriptvars.h"
+#include "../../renderer/renderer.h"
+#include "../../text/text.h"
+#include "../../ui/ui.h"
+#include "../../mem.h"
+#include "../../inputsystem.h"
+#include "../../vm/vm.h"
+#include "../../vm/thread.h"
+#include "../../vm/interface/input.h"
+#include "../../audio/audiosystem.h"
+
+namespace Impacto {
+namespace UI {
+namespace SGHD {
+
+using namespace Impacto::Profile::SGHD::TipsMenu;
+using namespace Impacto::Profile::ScriptVars;
+using namespace Impacto::Vm::Interface;
+
+namespace {
+constexpr int SubMenuTips = 2;
+constexpr int ExtraHeader = 20000;  // + 0 NEW, + 1 UNREAD
+
+void PlaySe(int id) { Audio::PlayInGroup(Audio::ACG_SE, "sysse", id, false, 0.0f); }
+bool UseMouse() {
+  return Input::CurrentInputDevice == Input::Device::Mouse || Input::CurrentInputDevice == Input::Device::Touch;
+}
+}  // namespace
+
+Impacto::SGHD::TipsSystem* TipsMenu::Data() const {
+  return dynamic_cast<Impacto::SGHD::TipsSystem*>(Impacto::TipsSystem::Implementation.get());
+}
+
+// The original draws with SW_SYSSUBMENUCT * SW_SYSSUBMENUALPHA / 16 (0..256, saturating).
+float TipsMenu::Alpha() const {
+  if (ScrWork[SW_SYSSUBMENUNO] != SubMenuTips) return 0.0f;
+  const float a = ScrWork[SW_SYSSUBMENUCT] * (float)ScrWork[SW_SYSSUBMENUALPHA] / (16.0f * 256.0f);
+  return std::clamp(a, 0.0f, 1.0f);
+}
+
+int TipsMenu::Count(int category) const {
+  auto* data = Data();
+  if (!data || category < 0 || category >= (int)data->Lists.size()) return 0;
+  return (int)data->Lists[category].size();
+}
+
+int TipsMenu::Entry(int category, int index) const {
+  if (index < 0 || index >= Count(category)) return -1;
+  return Data()->Lists[category][index];
+}
+
+// TipsInit (0x43f050): the NEW and UNREAD lists, the NEW marks and the tip to show.
+void TipsMenu::Init() {
+  auto* data = Data();
+  if (!data) return;
+  const int tips = (int)data->TipEntryCount;
+  const int categories = (int)data->Lists.size() - 2;
+  if (categories < 1) return;
+  auto& records = data->Records;
+  auto unlocked = [&](int t) { return t >= 0 && t < tips && !records[t].IsLocked; };
+
+  NewAtOpen.assign(tips, false);
+  for (int t = 0; t < tips; t++) NewAtOpen[t] = unlocked(t) && records[t].IsNew;
+
+  // NEW: the tips found last first, then the other new ones by number
+  std::vector<int>& fresh = data->Lists[categories];
+  fresh.clear();
+  auto& history = data->NewTipsIndices;
+  for (auto it = history.rbegin(); it != history.rend(); ++it)
+    if (*it < tips && NewAtOpen[*it] && std::find(fresh.begin(), fresh.end(), (int)*it) == fresh.end()) fresh.push_back(*it);
+  std::vector<int> byNumber(tips);
+  for (int t = 0; t < tips; t++) byNumber[t] = t;
+  std::sort(byNumber.begin(), byNumber.end(), [&](int a, int b) { return data->Number[a] < data->Number[b]; });
+  for (int t : byNumber)
+    if (NewAtOpen[t] && std::find(fresh.begin(), fresh.end(), t) == fresh.end()) fresh.push_back(t);
+  if (!fresh.empty()) fresh.insert(fresh.begin(), ExtraHeader);
+
+  // UNREAD: found but not read yet, by number
+  std::vector<int>& unread = data->Lists[categories + 1];
+  unread.clear();
+  for (int t : byNumber)
+    if (unlocked(t) && records[t].IsUnread) unread.push_back(t);
+  if (!unread.empty()) unread.insert(unread.begin(), ExtraHeader + 1);
+
+  CategoryNew.assign(data->Lists.size(), false);
+  for (size_t c = 0; c < data->Lists.size(); c++)
+    for (int e : data->Lists[c])
+      if (IsTip(e) && NewAtOpen[e]) CategoryNew[c] = true;
+
+  // open on the last shown tip (or the newest) in its category; ScrWork[OpenModeVar] opens the tips list
+  InTips = ScrWork[OpenModeVar] != 0;
+  ScrWork[OpenModeVar] = 0;
+  int tip = ScrWork[ShownTipVar];
+  if ((tip < 0 || tip >= tips) && !history.empty()) tip = history.back();
+  Category = -1;
+  Row = -1;
+  Scroll = 0;
+  for (int c = 0; c < categories && Category < 0; c++)
+    for (int i = 0; i < Count(c); i++)
+      if (Entry(c, i) == tip) {
+        Category = c;
+        Row = i;
+      }
+  if (Category < 0) {
+    for (int c = 0; c < categories && Category < 0; c++)
+      if (Count(c) > 0) Category = c;
+    Row = -1;
+  }
+  KeepRowVisible();
+  ShownTip = -1;
+  Pages.clear();
+  ContentHeight = ContentScroll = 0.0f;
+  if (unlocked(tip)) ShowTip(tip);
+  if (UseMouse()) {  // as the original in mouse mode: no cursor
+    if (InTips) Row = -1;
+    else Category = -1;
+  }
+}
+
+void TipsMenu::Show() {
+  if (State == Shown) return;
+  State = Shown;
+  if (UI::FocusedMenu != nullptr && UI::FocusedMenu != this) {
+    LastFocusedMenu = UI::FocusedMenu;
+    LastFocusedMenu->IsFocused = false;
+  }
+  IsFocused = true;
+  UI::FocusedMenu = this;
+}
+
+void TipsMenu::Hide() {
+  if (State == Hidden) return;
+  State = Hidden;
+  if (UI::FocusedMenu == this) UI::FocusedMenu = LastFocusedMenu;
+  if (UI::FocusedMenu != nullptr) UI::FocusedMenu->IsFocused = true;
+  LastFocusedMenu = nullptr;
+  IsFocused = false;
+}
+
+void TipsMenu::Update(float dt) {
+  const float alpha = Alpha();
+  if (alpha > 0.0f && State == Hidden) Show();
+  if (alpha <= 0.0f && State != Hidden) Hide();
+  if (State != Shown) return;
+  if (UI::FocusedMenu != this) {
+    if (UI::FocusedMenu != nullptr) {
+      LastFocusedMenu = UI::FocusedMenu;
+      LastFocusedMenu->IsFocused = false;
+    }
+    UI::FocusedMenu = this;
+    IsFocused = true;
+  }
+  if (alpha >= 1.0f && !GetFlag(SF_SUBMENUEXIT)) UpdateInput(dt);
+}
+
+void TipsMenu::OpenCategory(int category) {
+  InTips = true;
+  Category = category;
+  Scroll = 0;
+  Row = -1;
+  if (!UseMouse())
+    for (int i = 0; i < Count(category) && Row < 0; i++)
+      if (IsTip(Entry(category, i))) Row = i;
+}
+
+void TipsMenu::KeepRowVisible() {
+  const int count = Count(Category);
+  if (Row >= 0) {
+    if (Row < Scroll) Scroll = Row;
+    if (Row >= Scroll + VisibleRows) Scroll = Row - VisibleRows + 1;
+  }
+  Scroll = std::clamp(Scroll, 0, std::max(0, count - VisibleRows));
+}
+
+void TipsMenu::MoveRow(int direction) {
+  const int count = Count(Category);
+  int r = Row < 0 ? (direction > 0 ? -1 : count) : Row;
+  for (r += direction; r >= 0 && r < count; r += direction)
+    if (IsTip(Entry(Category, r))) {
+      Row = r;
+      PlaySe(1);
+      KeepRowVisible();
+      return;
+    }
+}
+
+void TipsMenu::ShowTip(int tip) {
+  auto* data = Data();
+  ShownTip = tip;
+  ScrWork[ShownTipVar] = tip;
+  const auto& record = data->Records[tip];
+  Pages.clear();
+  Pages.resize(record.NumberOfContentStrings);
+  ContentHeight = 0.0f;
+  for (size_t i = 0; i < Pages.size(); i++) {
+    Pages[i].Glyphs.reserve(Profile::Dialogue::MaxPageSize);
+    Pages[i].Clear();
+    Vm::Sc3VmThread dummy;
+    dummy.ScriptBufferId = data->ScriptBufferId;
+    dummy.IpOffset = record.StringAdr[4 + i];
+    Pages[i].AddString(&dummy);
+    ContentHeight += Pages[i].Bounds.Height + ContentGap;
+  }
+  ContentScroll = 0.0f;
+  data->SetTipUnreadState(tip, false);
+}
+
+void TipsMenu::ScrollContent(float delta) {
+  const float max = std::max(0.0f, ContentHeight - ContentPageHeight);
+  ContentScroll = std::clamp(ContentScroll + delta, 0.0f, max);
+}
+
+int TipsMenu::RowAt(glm::vec2 pos) const {
+  if (pos.x < RowArea.X || pos.x >= RowArea.X + RowArea.Width) return -1;
+  const float top = RowY + RowArea.Y + (RowArea.Height - RowHeight) / 2.0f;
+  if (pos.y < top) return -1;
+  const int i = (int)((pos.y - top) / RowHeight);
+  return i < VisibleRows ? i : -1;
+}
+
+void TipsMenu::UpdateInput(float dt) {
+  auto* data = Data();
+  if (!data) return;
+  const int categories = (int)data->Lists.size();
+  const bool mouse = UseMouse();
+  const glm::vec2 pos = Input::CurMousePos;
+  const bool pointerMoved = pos != LastPointer;
+  LastPointer = pos;
+  const bool click = (PADinputMouseWentDown & PAD1A) != 0;
+  bool decide = (PADinputButtonWentDown & PAD1A) != 0;
+
+  // content: L1 / R1 by pages, the wheel over the content
+  if (ShownTip >= 0) {
+    if (PADinputButtonWentDown & PAD1L1) {
+      if (ContentScroll > 0.0f) PlaySe(1);
+      ScrollContent(-ContentPageHeight);
+    }
+    if (PADinputButtonWentDown & PAD1R1) {
+      if (ContentScroll < ContentHeight - ContentPageHeight) PlaySe(1);
+      ScrollContent(ContentPageHeight);
+    }
+    if (pos.x >= ContentClip.X && Input::MouseWheelDeltaY != 0)
+      ScrollContent(-Input::MouseWheelDeltaY * ContentScrollStep * 8.0f);
+  }
+
+  if (!InTips) {
+    if (mouse && (pointerMoved || click)) {
+      const int r = RowAt(pos);
+      Category = r >= 0 && r < categories ? r : -1;
+      decide = decide || (click && Category >= 0);
+    }
+    if (PADinputButtonRepeatDown & PAD1DOWN) {
+      Category = Category < 0 ? 0 : (Category + 1) % categories;
+      PlaySe(1);
+    } else if (PADinputButtonRepeatDown & PAD1UP) {
+      Category = Category <= 0 ? categories - 1 : Category - 1;
+      PlaySe(1);
+    }
+    if (decide && Category >= 0 && Count(Category) > 0) {
+      PlaySe(2);
+      OpenCategory(Category);
+    } else if ((PADinputButtonWentDown | PADinputMouseWentDown) & PAD1B) {
+      PlaySe(3);  // the script closes the screen on this press
+    }
+    PADinputButtonWentDown &= ~PAD1A;
+    PADinputMouseWentDown &= ~PAD1A;
+    return;
+  }
+
+  // tips list
+  if (mouse && Input::MouseWheelDeltaY != 0 && pos.x < ContentClip.X) {
+    Scroll -= (int)(Input::MouseWheelDeltaY * 4);
+    KeepRowVisible();
+  }
+  if (mouse && (pointerMoved || click)) {
+    const int r = RowAt(pos);
+    const int index = r >= 0 ? Scroll + r : -1;
+    Row = index >= 0 && index < Count(Category) && IsTip(Entry(Category, index)) ? index : -1;
+    decide = decide || (click && Row >= 0);
+  }
+  if (PADinputButtonRepeatDown & PAD1DOWN) MoveRow(1);
+  else if (PADinputButtonRepeatDown & PAD1UP) MoveRow(-1);
+
+  if (decide && Row >= 0) {
+    const int tip = Entry(Category, Row);
+    if (IsTip(tip) && !data->Records[tip].IsLocked) {
+      if (tip != ShownTip) {
+        PlaySe(2);
+        ShowTip(tip);
+      }
+    } else {
+      PlaySe(4);
+    }
+  } else if ((PADinputButtonWentDown | PADinputMouseWentDown) & PAD1B) {
+    // back to the categories; the script does not see this press
+    PlaySe(3);
+    InTips = false;
+    Row = -1;
+    if (mouse) Category = -1;
+    PADinputButtonWentDown &= ~PAD1B;
+    PADinputMouseWentDown &= ~PAD1B;
+  }
+  PADinputButtonWentDown &= ~PAD1A;
+  PADinputMouseWentDown &= ~PAD1A;
+}
+
+// ---------------------------------------------------------------- text
+
+std::vector<ProcessedTextGlyph> TipsMenu::Layout(const uint8_t* str, float size, uint32_t color,
+                                                 glm::vec2 pos) const {
+  Vm::Sc3Stream stream(const_cast<uint8_t*>(str));
+  return TextLayoutPlainLine(stream, std::nullopt, *Profile::Dialogue::DialogueFont, size,
+                             DialogueColorPair{color, 0}, 1.0f, pos, TextAlignment::Left);
+}
+
+std::vector<ProcessedTextGlyph> TipsMenu::TableString(int index, float size, uint32_t color, glm::vec2 pos,
+                                                      int skipChars) const {
+  auto ctx = Vm::ScriptGetTextTableStrAddress(TextTableId, index);
+  return Layout(&ctx.Buffers[ctx.BufferId][ctx.IpOffset + 2 * skipChars], size, color, pos);
+}
+
+std::vector<ProcessedTextGlyph> TipsMenu::TipString(int tip, int index, float size, uint32_t color,
+                                                    glm::vec2 pos) const {
+  auto* data = Data();
+  return Layout(&Vm::ScriptBuffers[data->ScriptBufferId][data->Records[tip].StringAdr[index]], size, color, pos);
+}
+
+std::vector<ProcessedTextGlyph> TipsMenu::Number(int value, float size, uint32_t color, glm::vec2 pos) const {
+  return TextLayoutPlainString(std::to_string(value), *Profile::Dialogue::DialogueFont, size,
+                               DialogueColorPair{color, 0}, 1.0f, pos, TextAlignment::Left);
+}
+
+void TipsMenu::DrawLine(const std::vector<ProcessedTextGlyph>& glyphs, float alpha) const {
+  if (glyphs.empty()) return;
+  if (ShadowOffset != 0.0f) {
+    std::vector<ProcessedTextGlyph> shadow = glyphs;
+    for (ProcessedTextGlyph& g : shadow) {
+      g.Colors.TextColor = 0x000000;
+      g.Move(glm::vec2(ShadowOffset));
+    }
+    Profile::Dialogue::DialogueFont->DrawProcessedText(shadow, alpha, RendererOutlineMode::None);
+  }
+  Profile::Dialogue::DialogueFont->DrawProcessedText(glyphs, alpha, RendererOutlineMode::None);
+}
+
+namespace {
+void AlignRight(std::vector<ProcessedTextGlyph>& glyphs, float right) {
+  const float w = GetTextWidth(glyphs);
+  for (ProcessedTextGlyph& g : glyphs) g.Move(glm::vec2(right - w, 0.0f));
+}
+}  // namespace
+
+// ---------------------------------------------------------------- drawing
+
+void TipsMenu::Render() {
+  if (State != Shown) return;
+  auto* data = Data();
+  const float alpha = Alpha();
+  if (!data || alpha <= 0.0f) return;
+  const glm::vec4 col(glm::vec3(1.0f), alpha);
+  Renderer->DrawSprite(Impacto::Profile::TipsMenu::BackgroundSprite, glm::vec2(0.0f), col);
+
+  const int categories = (int)data->Lists.size();
+  const int cursor = InTips ? (Row >= 0 ? Row - Scroll : -1) : Category;
+  if (cursor >= 0 && cursor < VisibleRows)
+    Renderer->DrawSprite(Highlight,
+                         RectF(RowArea.X, RowY + cursor * RowHeight + RowArea.Y, RowArea.Width, RowArea.Height), col);
+
+  // list scrollbar
+  float knobY = ListKnobPosition.y;
+  const int count = Count(Category);
+  if (InTips && count > VisibleRows) knobY += ListKnobRange * Scroll / (count - VisibleRows);
+  Renderer->DrawSprite(Knob, glm::vec2(ListKnobPosition.x, knobY), col);
+  Renderer->DrawSprite(Guide, GuidePosition, col);
+
+  if (!InTips) {
+    for (int c = 0; c < categories && c < VisibleRows; c++) {
+      const float y = RowY + c * RowHeight;
+      DrawLine(TableString(CategoryNameString + c, FontSize, Count(c) > 0 ? TextColor : EmptyCategoryColor,
+                           glm::vec2(CategoryX, y)),
+               alpha);
+      if (CategoryNew[c]) Renderer->DrawSprite(NewMark, glm::vec2(NewMarkX, y), col);
+    }
+  } else {
+    for (int i = 0; i < VisibleRows && Scroll + i < count; i++) {
+      const float y = RowY + i * RowHeight;
+      const int e = Entry(Category, Scroll + i);
+      if (!IsTip(e)) {
+        Renderer->DrawSprite(HeaderBar, glm::vec2(0.0f, y) + HeaderBarOffset, col);
+        if (e >= ExtraHeader) {
+          // 【NEW】 / 【UNREAD】
+          auto ctx = Vm::ScriptGetTextTableStrAddress(TextTableId, ExtraHeaderString + e - ExtraHeader);
+          std::vector<uint8_t> str = {0x80, 0xE0};
+          for (const uint8_t* p = &ctx.Buffers[ctx.BufferId][ctx.IpOffset]; *p != 0xff; p++) str.push_back(*p);
+          str.insert(str.end(), {0x80, 0xE1, 0xFF});
+          DrawLine(Layout(str.data(), FontSize, TextColor, glm::vec2(HeaderX, y)), alpha);
+        } else {
+          // 【letter】: the letter is the (e - 10000)th two byte character of the letters string
+          const uint8_t* letter =
+              &Vm::ScriptBuffers[data->ScriptBufferId][data->LettersStringAdr + 2 * (e - Impacto::SGHD::TipsSystem::LetterHeader)];
+          const uint8_t str[] = {0x80, 0xE0, letter[0], letter[1], 0x80, 0xE1, 0xFF};
+          DrawLine(Layout(str, FontSize, TextColor, glm::vec2(HeaderX, y)), alpha);
+        }
+        continue;
+      }
+      auto number = Number(data->Number[e], FontSize, TextColor, glm::vec2(0.0f, y));
+      AlignRight(number, NumberRightX);
+      DrawLine(number, alpha);
+      DrawLine(TableString(NumberString, FontSize, TextColor, glm::vec2(NumberRightX, y), 2), alpha);
+      const auto& record = data->Records[e];
+      std::vector<ProcessedTextGlyph> name =
+          record.IsLocked ? TableString(LockedString, FontSize, LockedColor, glm::vec2(NameX, y))
+                          : TipString(e, 1, FontSize, record.IsUnread ? UnreadColor : TextColor, glm::vec2(NameX, y));
+      if (GetTextWidth(name) > NameMaxWidth) SquishText(name, NameMaxWidth, NameX);
+      DrawLine(name, alpha);
+      if (!record.IsLocked && NewAtOpen[e]) {
+        Renderer->DrawSprite(NewMark, glm::vec2(NewMarkX, y), col);
+        if (record.IsNew) data->SetTipNewState(e, false);  // seen in the list (the mark stays this time)
+      }
+    }
+  }
+
+  // the shown tip
+  if (ShownTip < 0) return;
+  DrawLine(TableString(NumberString, NumberFontSize, TextColor, NumberLabelPosition), alpha);
+  DrawLine(Number(data->Number[ShownTip], NumberFontSize, TextColor, NumberPosition), alpha);
+  auto subtitle = TipString(ShownTip, 2, SubtitleFontSize, SubtitleColor, glm::vec2(0.0f, SubtitleY));
+  AlignRight(subtitle, TitleRightX);
+  DrawLine(subtitle, alpha);
+  auto title = TipString(ShownTip, 1, TitleFontSize, TextColor, glm::vec2(0.0f, TitleY));
+  AlignRight(title, TitleRightX);
+  DrawLine(title, alpha);
+  auto label = TipString(ShownTip, 0, LabelFontSize, LabelColor, LabelPosition);
+  if (GetTextWidth(label) > LabelMaxWidth) SquishText(label, LabelMaxWidth, LabelPosition.x);
+  DrawLine(label, alpha);
+
+  Renderer->EnableScissor();
+  Renderer->SetScissorRect(ContentClip);
+  float y = ContentPosition.y - ContentScroll;
+  for (TipsPage& page : Pages) {
+    page.MoveTo(glm::vec2(ContentPosition.x, y));
+    page.Render(alpha, RendererOutlineMode::Full);
+    y += page.Bounds.Height + ContentGap;
+  }
+  Renderer->DisableScissor();
+
+  float contentKnobY = ContentKnobPosition.y;
+  if (ContentHeight > ContentPageHeight)
+    contentKnobY += ContentKnobRange * ContentScroll / (ContentHeight - ContentPageHeight);
+  Renderer->DrawSprite(Knob, glm::vec2(ContentKnobPosition.x, contentKnobY), col);
+}
+
+}  // namespace SGHD
+}  // namespace UI
+}  // namespace Impacto
