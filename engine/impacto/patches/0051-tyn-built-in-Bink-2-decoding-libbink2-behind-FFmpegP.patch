diff --git a/vendor/libbink2/src/bink2_bits.c b/vendor/libbink2/src/bink2_bits.c
new file mode 100644
index 0000000000000000000000000000000000000000..818a9d3fd41208d931d7957553a7dceb1a5a9060
--- /dev/null
+++ b/vendor/libbink2/src/bink2_bits.c
@@ -0,0 +1,284 @@
+#include "bink2_bits.h"
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+void bink2_bits_init(Bink2Bits *bits, const unsigned char *data, size_t size)
+{
+    bits->data = data;
+    bits->size = size;
+    bits->bitpos = 0;
+}
+
+int bink2_bits_left(const Bink2Bits *bits)
+{
+    size_t total = bits->size * 8;
+
+    if (bits->bitpos >= total)
+        return 0;
+    return (int)(total - bits->bitpos);
+}
+
+int bink2_bits_failed(const Bink2Bits *bits)
+{
+    return bits->bitpos > bits->size * 8;
+}
+
+static int host_is_little_endian(void)
+{
+    const uint16_t one = 1;
+    unsigned char first;
+
+    memcpy(&first, &one, 1);
+    return first == 1;
+}
+
+/* The next count (1..32) bits, LSB-first, without consuming them. The
+ * caller guarantees they are inside the buffer; no byte past the buffer is
+ * read. */
+static uint32_t peek_bits(const Bink2Bits *bits, int count)
+{
+    size_t byte = bits->bitpos >> 3;
+    const unsigned char *p = bits->data + byte;
+    int shift = (int)(bits->bitpos & 7);
+    uint64_t window = 0;
+
+    if (byte + 8 <= bits->size && host_is_little_endian()) {
+        memcpy(&window, p, 8);
+    } else {
+        int nbytes = (shift + count + 7) >> 3;
+        int i;
+
+        for (i = 0; i < nbytes; i++)
+            window |= (uint64_t)p[i] << (8 * i);
+    }
+    return (uint32_t)((window >> shift) & (((uint64_t)1 << count) - 1));
+}
+
+int bink2_bits_read(Bink2Bits *bits, int count)
+{
+    uint32_t value;
+    size_t total;
+
+    if (count < 0 || count > 32)
+        return -1;
+    total = bits->size * 8;
+    if (bits->bitpos > total || (size_t)count > total - bits->bitpos)
+        return -1;
+    if (count == 0)
+        return 0;
+    value = peek_bits(bits, count);
+    bits->bitpos += (size_t)count;
+    return (int)value;
+}
+
+int bink2_bits_read1(Bink2Bits *bits)
+{
+    size_t pos = bits->bitpos;
+
+    if (pos >= bits->size * 8)
+        return -1;
+    bits->bitpos = pos + 1;
+    return (bits->data[pos >> 3] >> (pos & 7)) & 1;
+}
+
+int bink2_bits_read_unary(Bink2Bits *bits, int stop, int max)
+{
+    size_t total = bits->size * 8;
+    int done = 0;
+
+    if (max < 0)
+        return -1;
+    while (done < max) {
+        size_t avail;
+        uint32_t window, hit;
+        int n, k;
+
+        if (bits->bitpos >= total)
+            return -1;
+        avail = total - bits->bitpos;
+        n = max - done < 24 ? max - done : 24;
+        if ((size_t)n > avail)
+            n = (int)avail;
+        window = peek_bits(bits, n);
+        hit = stop == 1 ? window : stop == 0 ? ~window : 0;
+        hit &= ((uint32_t)1 << n) - 1;
+        if (hit != 0) {
+            for (k = 0; !(hit & 1u); k++)
+                hit >>= 1;
+            bits->bitpos += (size_t)k + 1;
+            return done + k;
+        }
+        bits->bitpos += (size_t)n;
+        done += n;
+    }
+    return max;
+}
+
+int bink2_bits_read_vlc(Bink2Bits *bits, const uint16_t *codes,
+                        const uint8_t *lengths, int count)
+{
+    size_t total = bits->size * 8;
+    uint32_t window;
+    int n, i, best = -1, best_len = 13;
+
+    if (bits->bitpos >= total)
+        return -1;
+    n = total - bits->bitpos < 12 ? (int)(total - bits->bitpos) : 12;
+    window = peek_bits(bits, n);
+    /* The shortest matching code wins, then the lowest index: the order a
+     * bit-at-a-time search finds them in. */
+    for (i = 0; i < count; i++) {
+        int len = lengths[i];
+
+        if (len >= 1 && len <= n && len < best_len &&
+            (window & (((uint32_t)1 << len) - 1)) == codes[i]) {
+            best = i;
+            best_len = len;
+        }
+    }
+    if (best < 0) {
+        /* The search read every bit it could before giving up. */
+        bits->bitpos += (size_t)n;
+        return -1;
+    }
+    bits->bitpos += (size_t)best_len;
+    return best;
+}
+
+void bink2_bits_skip(Bink2Bits *bits, int count)
+{
+    size_t total = bits->size * 8;
+    size_t next;
+
+    /* A failed reader (bitpos past the end) stays failed; adding to it
+     * could wrap it back to a readable position. */
+    if (count < 0 || bits->bitpos > total)
+        return;
+    next = bits->bitpos + (size_t)count;
+    bits->bitpos = (next > total) ? total : next;
+}
+
+void bink2_bits_align32(Bink2Bits *bits)
+{
+    size_t total = bits->size * 8;
+    size_t next;
+
+    if (bits->bitpos > total)
+        return;
+    next = (bits->bitpos + 31) & ~(size_t)31;
+    bits->bitpos = (next > total) ? total : next;
+}
+
+void bink2_bw_init(Bink2BitWriter *bw)
+{
+    bw->data = NULL;
+    bw->capacity = 0;
+    bw->bitpos = 0;
+    bw->failed = 0;
+}
+
+void bink2_bw_free(Bink2BitWriter *bw)
+{
+    if (bw == NULL)
+        return;
+    free(bw->data);
+    bw->data = NULL;
+    bw->capacity = 0;
+    bw->bitpos = 0;
+    bw->failed = 0;
+}
+
+void bink2_bw_reset(Bink2BitWriter *bw)
+{
+    bw->bitpos = 0;
+    bw->failed = 0;
+    if (bw->data != NULL && bw->capacity > 0)
+        memset(bw->data, 0, bw->capacity);
+}
+
+static int bink2_bw_ensure(Bink2BitWriter *bw, size_t bitpos)
+{
+    size_t need = (bitpos + 7) / 8;
+    size_t cap;
+    unsigned char *grown;
+
+    if (need <= bw->capacity)
+        return 0;
+    cap = bw->capacity != 0 ? bw->capacity : 256;
+    while (cap < need) {
+        if (cap > (size_t)-1 / 2)
+            return -1;
+        cap *= 2;
+    }
+    grown = (unsigned char *)realloc(bw->data, cap);
+    if (grown == NULL)
+        return -1;
+    memset(grown + bw->capacity, 0, cap - bw->capacity);
+    bw->data = grown;
+    bw->capacity = cap;
+    return 0;
+}
+
+int bink2_bw_put(Bink2BitWriter *bw, unsigned value, int count)
+{
+    int i;
+
+    if (bw == NULL || bw->failed)
+        return -1;
+    if (count < 0 || count > 32) {
+        bw->failed = 1;
+        return -1;
+    }
+    if (count == 0)
+        return 0;
+    if (bink2_bw_ensure(bw, bw->bitpos + (size_t)count) != 0) {
+        bw->failed = 1;
+        return -1;
+    }
+    for (i = 0; i < count; i++) {
+        size_t pos = bw->bitpos + (size_t)i;
+
+        if ((value >> i) & 1u)
+            bw->data[pos >> 3] =
+                (unsigned char)(bw->data[pos >> 3] | (1u << (pos & 7)));
+    }
+    bw->bitpos += (size_t)count;
+    return 0;
+}
+
+int bink2_bw_align32(Bink2BitWriter *bw)
+{
+    size_t next;
+
+    if (bw == NULL || bw->failed)
+        return -1;
+    next = (bw->bitpos + 31) & ~(size_t)31;
+    if (bink2_bw_ensure(bw, next) != 0) {
+        bw->failed = 1;
+        return -1;
+    }
+    bw->bitpos = next;
+    return 0;
+}
+
+int bink2_bw_failed(const Bink2BitWriter *bw)
+{
+    return bw == NULL || bw->failed;
+}
+
+size_t bink2_bw_bitpos(const Bink2BitWriter *bw)
+{
+    return bw->bitpos;
+}
+
+size_t bink2_bw_bytes(const Bink2BitWriter *bw)
+{
+    return (bw->bitpos + 7) / 8;
+}
+
+const unsigned char *bink2_bw_data(const Bink2BitWriter *bw)
+{
+    return bw->data;
+}
diff --git a/vendor/libbink2/src/bink2_bits.h b/vendor/libbink2/src/bink2_bits.h
new file mode 100644
index 0000000000000000000000000000000000000000..8b37865f1b99ea941a734a8eb1825bf05b2d7826
--- /dev/null
+++ b/vendor/libbink2/src/bink2_bits.h
@@ -0,0 +1,64 @@
+#ifndef LIBBINK2_BITS_H
+#define LIBBINK2_BITS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/** LSB-first bit reader over a byte buffer. */
+typedef struct {
+    const unsigned char *data;
+    size_t size;
+    size_t bitpos;
+} Bink2Bits;
+
+void bink2_bits_init(Bink2Bits *bits, const unsigned char *data, size_t size);
+/** Read count bits LSB-first, or -1 when fewer bits remain. count is 0..32. */
+int bink2_bits_read(Bink2Bits *bits, int count);
+int bink2_bits_read1(Bink2Bits *bits);
+/**
+ * Read a unary code: count the bits before the first bit equal to stop.
+ * Returns max when max bits are read without finding stop, or -1 when the
+ * stream ends first.
+ */
+int bink2_bits_read_unary(Bink2Bits *bits, int stop, int max);
+/**
+ * Read one prefix code: the index of the shortest code (lowest index among
+ * equal lengths) of 1..12 bits matching the stream, or -1 when none does,
+ * after consuming up to 12 bits, or when the stream ends first.
+ */
+int bink2_bits_read_vlc(Bink2Bits *bits, const uint16_t *codes,
+                        const uint8_t *lengths, int count);
+int bink2_bits_left(const Bink2Bits *bits);
+/** True after a read helper ran past the buffer (it marks bitpos). */
+int bink2_bits_failed(const Bink2Bits *bits);
+void bink2_bits_skip(Bink2Bits *bits, int count);
+void bink2_bits_align32(Bink2Bits *bits);
+
+/**
+ * Growing LSB-first bit writer. The same bit order as Bink2Bits, so a buffer
+ * produced here can be handed to bink2_bits_init.
+ */
+typedef struct {
+    unsigned char *data;
+    size_t capacity;
+    size_t bitpos;
+    int failed;
+} Bink2BitWriter;
+
+void bink2_bw_init(Bink2BitWriter *bw);
+void bink2_bw_free(Bink2BitWriter *bw);
+void bink2_bw_reset(Bink2BitWriter *bw);
+/**
+ * Write the low count bits of value, LSB first. count is 0..32. A failed
+ * write marks the writer failed, and every later write fails until
+ * bink2_bw_reset, so a caller can check bink2_bw_failed once at the end.
+ */
+int bink2_bw_put(Bink2BitWriter *bw, unsigned value, int count);
+/** Pad with zero bits up to the next 32-bit boundary. */
+int bink2_bw_align32(Bink2BitWriter *bw);
+int bink2_bw_failed(const Bink2BitWriter *bw);
+size_t bink2_bw_bitpos(const Bink2BitWriter *bw);
+size_t bink2_bw_bytes(const Bink2BitWriter *bw);
+const unsigned char *bink2_bw_data(const Bink2BitWriter *bw);
+
+#endif
diff --git a/vendor/libbink2/src/bink2_dsp.c b/vendor/libbink2/src/bink2_dsp.c
new file mode 100644
index 0000000000000000000000000000000000000000..2ad8fc9e5fe1293a874f09b428555c8902186106
--- /dev/null
+++ b/vendor/libbink2/src/bink2_dsp.c
@@ -0,0 +1,528 @@
+#include "bink2_dsp.h"
+
+#include <math.h>
+#include <string.h>
+
+static int clip8(int v)
+{
+    if (v < 0)
+        return 0;
+    if (v > 255)
+        return 255;
+    return v;
+}
+
+/* The three fused multiply-adds are explicit: the pinned oracle's build
+ * fused these expressions (and only these), so the golden checksums need
+ * a single rounding here and two everywhere else. The library builds with
+ * -ffp-contract=off so no compiler adds or removes a fusion. */
+static void idct_1d_old(float *blk, int step)
+{
+    float t00 =  blk[2 * step] + blk[6 * step];
+    float t01 = fmaf(blk[2 * step] - blk[6 * step], 1.4142135f, -t00);
+    float t02 =  blk[0 * step] + blk[4 * step];
+    float t03 =  blk[0 * step] - blk[4 * step];
+    float t04 =  blk[3 * step] + blk[5 * step];
+    float t05 =  blk[3 * step] - blk[5 * step];
+    float t06 =  blk[1 * step] + blk[7 * step];
+    float t07 =  blk[1 * step] - blk[7 * step];
+    float t08 = t02 + t00;
+    float t09 = t02 - t00;
+    float t10 = t03 + t01;
+    float t11 = t03 - t01;
+    float t12 = t06 + t04;
+    float t13 = (t06 - t04) * 1.4142135f;
+    float t14 = (t07 - t05) * 1.847759f;
+    float t15 = fmaf(t05, 2.613126f, t14) - t12;
+    float t16 = t13 - t15;
+    float t17 = fmaf(t07, 1.0823922f, -t14) + t16;
+
+    blk[0 * step] = t08 + t12;
+    blk[1 * step] = t10 + t15;
+    blk[2 * step] = t11 + t16;
+    blk[3 * step] = t09 - t17;
+    blk[4 * step] = t09 + t17;
+    blk[5 * step] = t11 - t16;
+    blk[6 * step] = t10 - t15;
+    blk[7 * step] = t08 - t12;
+}
+
+void bink2_idct_old(float block[64])
+{
+    int i, j;
+
+    block[0] += 512.0f;
+    for (i = 0; i < 8; i++)
+        idct_1d_old(block + i, 8);
+    for (i = 0; i < 8; i++) {
+        idct_1d_old(block, 1);
+        for (j = 0; j < 8; j++)
+            block[j] -= 512.0f;
+        block += 8;
+    }
+}
+
+void bink2_put_block_f_c(unsigned char *dst, int stride,
+                         const float block[64])
+{
+    int i, j;
+
+    for (i = 0; i < 8; i++) {
+        for (j = 0; j < 8; j++)
+            dst[j] = (unsigned char)clip8((int)lrintf(block[j]));
+        dst += stride;
+        block += 8;
+    }
+}
+
+void bink2_add_block_f_c(unsigned char *dst, int stride,
+                         const float block[64])
+{
+    int i, j;
+
+    for (i = 0; i < 8; i++) {
+        for (j = 0; j < 8; j++)
+            dst[j] = (unsigned char)clip8((int)dst[j] +
+                                          (int)lrintf(block[j]));
+        dst += stride;
+        block += 8;
+    }
+}
+
+/* The SIMD conversions round half to even, as lrintf does in the default
+ * rounding mode, and saturate where lrintf's result would not fit an int.
+ * KB2f block values are far inside that range: AC levels are at most about
+ * 2^10, scaled by at most 128 and a matrix entry near 1. */
+void bink2_put_block_f(unsigned char *dst, int stride, const float block[64])
+{
+#if defined(BINK2_SIMD_FLOAT_BLOCK)
+    BINK2_SIMD(bink2_put_block_f)(dst, stride, block);
+#else
+    bink2_put_block_f_c(dst, stride, block);
+#endif
+}
+
+void bink2_add_block_f(unsigned char *dst, int stride, const float block[64])
+{
+#if defined(BINK2_SIMD_FLOAT_BLOCK)
+    BINK2_SIMD(bink2_add_block_f)(dst, stride, block);
+#else
+    bink2_add_block_f_c(dst, stride, block);
+#endif
+}
+
+#define IDCT_MUL_A(val) ((val) + ((val) >> 2))
+#define IDCT_MUL_B(val) ((val) >> 1)
+#define IDCT_MUL_C(val) ((val) - ((val) >> 2) - ((val) >> 4))
+#define IDCT_MUL_D(val) ((val) + ((val) >> 2) - ((val) >> 4))
+#define IDCT_MUL_E(val) ((val) >> 2)
+
+static void idct_1d_new(int16_t *blk, int step, int shift)
+{
+    int tmp00 =  blk[3 * step] + blk[5 * step];
+    int tmp01 =  blk[3 * step] - blk[5 * step];
+    int tmp02 =  IDCT_MUL_A(blk[2 * step]) + IDCT_MUL_B(blk[6 * step]);
+    int tmp03 =  IDCT_MUL_B(blk[2 * step]) - IDCT_MUL_A(blk[6 * step]);
+    int tmp0  = (blk[0 * step] + blk[4 * step]) + tmp02;
+    int tmp1  = (blk[0 * step] + blk[4 * step]) - tmp02;
+    int tmp2  =  blk[0 * step] - blk[4 * step];
+    int tmp3  =  blk[1 * step] + tmp00;
+    int tmp4  =  blk[1 * step] - tmp00;
+    int tmp5  =  tmp01 + blk[7 * step];
+    int tmp6  =  tmp01 - blk[7 * step];
+    int tmp7  =  tmp4 + IDCT_MUL_C(tmp6);
+    int tmp8  =  IDCT_MUL_C(tmp4) - tmp6;
+    int tmp9  =  IDCT_MUL_D(tmp3) + IDCT_MUL_E(tmp5);
+    int tmp10 =  IDCT_MUL_E(tmp3) - IDCT_MUL_D(tmp5);
+    int tmp11 =  tmp2 + tmp03;
+    int tmp12 =  tmp2 - tmp03;
+
+    blk[0 * step] = (int16_t)((tmp0  + tmp9)  >> shift);
+    blk[1 * step] = (int16_t)((tmp11 + tmp7)  >> shift);
+    blk[2 * step] = (int16_t)((tmp12 + tmp8)  >> shift);
+    blk[3 * step] = (int16_t)((tmp1  + tmp10) >> shift);
+    blk[4 * step] = (int16_t)((tmp1  - tmp10) >> shift);
+    blk[5 * step] = (int16_t)((tmp12 - tmp8)  >> shift);
+    blk[6 * step] = (int16_t)((tmp11 - tmp7)  >> shift);
+    blk[7 * step] = (int16_t)((tmp0  - tmp9)  >> shift);
+}
+
+void bink2_idct_new_c(int32_t block[64])
+{
+    int16_t tmp[64];
+    int i;
+
+    for (i = 0; i < 64; i++)
+        tmp[i] = (int16_t)block[i];
+    for (i = 0; i < 8; i++)
+        idct_1d_new(tmp + i, 8, 0);
+    for (i = 0; i < 8; i++)
+        idct_1d_new(tmp + i * 8, 1, 6);
+    for (i = 0; i < 64; i++)
+        block[i] = tmp[i];
+}
+
+void bink2_put_block_c(unsigned char *dst, int stride,
+                       const int32_t block[64])
+{
+    int i, j;
+
+    for (i = 0; i < 8; i++) {
+        for (j = 0; j < 8; j++)
+            dst[j] = (unsigned char)clip8(block[j * 8 + i]);
+        dst += stride;
+    }
+}
+
+void bink2_add_block_c(unsigned char *dst, int stride,
+                       const int32_t block[64])
+{
+    int i, j;
+
+    for (i = 0; i < 8; i++) {
+        for (j = 0; j < 8; j++)
+            dst[j] = (unsigned char)clip8((int)dst[j] + block[j * 8 + i]);
+        dst += stride;
+    }
+}
+
+void bink2_idct_new(int32_t block[64])
+{
+#if defined(BINK2_SIMD)
+    BINK2_SIMD(bink2_idct_new)(block);
+#else
+    bink2_idct_new_c(block);
+#endif
+}
+
+void bink2_put_block(unsigned char *dst, int stride, const int32_t block[64])
+{
+#if defined(BINK2_SIMD)
+    BINK2_SIMD(bink2_put_block)(dst, stride, block);
+#else
+    bink2_put_block_c(dst, stride, block);
+#endif
+}
+
+void bink2_add_block(unsigned char *dst, int stride, const int32_t block[64])
+{
+#if defined(BINK2_SIMD)
+    BINK2_SIMD(bink2_add_block)(dst, stride, block);
+#else
+    bink2_add_block_c(dst, stride, block);
+#endif
+}
+
+#define EDGE_STRIDE 32
+
+static void edge_copy(unsigned char *dst, const unsigned char *src,
+                      int src_stride, int x0, int y0, int bw, int bh,
+                      int w, int h)
+{
+    int i, j;
+
+    for (j = 0; j < bh; j++) {
+        int sy = y0 + j;
+
+        if (sy < 0)
+            sy = 0;
+        else if (sy >= h)
+            sy = h - 1;
+        for (i = 0; i < bw; i++) {
+            int sx = x0 + i;
+
+            if (sx < 0)
+                sx = 0;
+            else if (sx >= w)
+                sx = w - 1;
+            dst[j * EDGE_STRIDE + i] = src[sy * src_stride + sx];
+        }
+    }
+}
+
+#define LH_FILTER(src) \
+    ((((((src)[0] + (src)[1]) * 19) >> 1) - \
+      ((src)[-1] + (src)[2]) * 2 + \
+      (((src)[-2] + (src)[3]) >> 1) + 8) >> 4)
+#define LV_FILTER(src, i) \
+    ((((((src)[0] + (src)[i]) * 19) >> 1) - \
+      ((src)[-(i)] + (src)[2 * (i)]) * 2 + \
+      (((src)[-2 * (i)] + (src)[3 * (i)]) >> 1) + 8) >> 4)
+
+/* Points *msrc at the reference block for (x, y) + mv/2, through a
+ * clamped copy in edge[] when the 6-tap filter would leave the frame. */
+static void luma_source(unsigned char edge[EDGE_STRIDE * 24],
+                        const unsigned char *src, int src_stride,
+                        int x, int y, int frame_w, int frame_h,
+                        int mvx, int mvy,
+                        const unsigned char **msrc, int *ss)
+{
+    int fw = (frame_w + 31) & ~31;
+    int fh = (frame_h + 31) & ~31;
+    int mx = x + (mvx >> 1);
+    int my = y + (mvy >> 1);
+
+    if (mx < 2 || my < 2 || mx + 19 > fw || my + 19 > fh) {
+        edge_copy(edge, src, src_stride, mx - 2, my - 2, 21, 21, fw, fh);
+        *msrc = edge + 2 + 2 * EDGE_STRIDE;
+        *ss = EDGE_STRIDE;
+    } else {
+        *msrc = src + mx + my * src_stride;
+        *ss = src_stride;
+    }
+}
+
+void bink2_mc_luma_block_c(unsigned char *dst, int dst_stride,
+                           const unsigned char *msrc, int ss,
+                           int hmode, int vmode)
+{
+    int i, j;
+
+    if (hmode == 0 && vmode == 0) {
+        for (j = 0; j < 16; j++) {
+            memcpy(dst, msrc, 16);
+            dst += dst_stride;
+            msrc += ss;
+        }
+    } else if (vmode == 0) {
+        for (j = 0; j < 16; j++) {
+            for (i = 0; i < 16; i++)
+                dst[i] = (unsigned char)clip8(LH_FILTER(msrc + i));
+            dst += dst_stride;
+            msrc += ss;
+        }
+    } else if (hmode == 0) {
+        for (i = 0; i < 16; i++) {
+            for (j = 0; j < 16; j++)
+                dst[j * dst_stride + i] =
+                    (unsigned char)clip8(LV_FILTER(msrc + j * ss + i, ss));
+        }
+    } else {
+        unsigned char temp[21 * 16];
+
+        msrc -= 2 * ss;
+        for (i = 0; i < 21; i++) {
+            for (j = 0; j < 16; j++)
+                temp[i * 16 + j] =
+                    (unsigned char)clip8(LH_FILTER(msrc + j));
+            msrc += ss;
+        }
+        for (j = 0; j < 16; j++) {
+            for (i = 0; i < 16; i++)
+                dst[i] = (unsigned char)clip8(
+                    LV_FILTER(temp + (j + 2) * 16 + i, 16));
+            dst += dst_stride;
+        }
+    }
+}
+
+void bink2_mc_luma_c(unsigned char *dst, int dst_stride,
+                     const unsigned char *src, int src_stride,
+                     int x, int y, int frame_w, int frame_h,
+                     int mvx, int mvy)
+{
+    unsigned char edge[EDGE_STRIDE * 24];
+    const unsigned char *msrc;
+    int ss;
+
+    luma_source(edge, src, src_stride, x, y, frame_w, frame_h, mvx, mvy,
+                &msrc, &ss);
+    bink2_mc_luma_block_c(dst, dst_stride, msrc, ss, mvx & 1, mvy & 1);
+}
+
+void bink2_mc_luma(unsigned char *dst, int dst_stride,
+                   const unsigned char *src, int src_stride,
+                   int x, int y, int frame_w, int frame_h,
+                   int mvx, int mvy)
+{
+    unsigned char edge[EDGE_STRIDE * 24];
+    const unsigned char *msrc;
+    int ss;
+
+    luma_source(edge, src, src_stride, x, y, frame_w, frame_h, mvx, mvy,
+                &msrc, &ss);
+#if defined(BINK2_SIMD)
+    BINK2_SIMD(bink2_mc_luma_block)(dst, dst_stride, msrc, ss, mvx & 1,
+                                    mvy & 1);
+#else
+    bink2_mc_luma_block_c(dst, dst_stride, msrc, ss, mvx & 1, mvy & 1);
+#endif
+}
+
+#define CH1_FILTER(src) (((src)[0] * 6 + (src)[1] * 2 + 4) >> 3)
+#define CH2_FILTER(src) (((src)[0] + (src)[1] + 1) >> 1)
+#define CH3_FILTER(src) (((src)[0] * 2 + (src)[1] * 6 + 4) >> 3)
+#define CV1_FILTER(src, i) (((src)[0] * 6 + (src)[i] * 2 + 4) >> 3)
+#define CV2_FILTER(src, i) (((src)[0] + (src)[i] + 1) >> 1)
+#define CV3_FILTER(src, i) (((src)[0] * 2 + (src)[i] * 6 + 4) >> 3)
+
+static int chroma_h(int mode, const unsigned char *src)
+{
+    switch (mode) {
+    case 1:
+        return CH1_FILTER(src);
+    case 2:
+        return CH2_FILTER(src);
+    case 3:
+        return CH3_FILTER(src);
+    default:
+        return src[0];
+    }
+}
+
+static int chroma_v(int mode, const unsigned char *src, int stride)
+{
+    switch (mode) {
+    case 1:
+        return CV1_FILTER(src, stride);
+    case 2:
+        return CV2_FILTER(src, stride);
+    case 3:
+        return CV3_FILTER(src, stride);
+    default:
+        return src[0];
+    }
+}
+
+static void chroma_source(unsigned char edge[EDGE_STRIDE * 24],
+                          const unsigned char *src, int src_stride,
+                          int x, int y, int frame_w, int frame_h,
+                          int mvx, int mvy,
+                          const unsigned char **msrc, int *ss)
+{
+    int fw = (frame_w + 15) & ~15;
+    int fh = (frame_h + 15) & ~15;
+    int mx = x + (mvx >> 2);
+    int my = y + (mvy >> 2);
+
+    if (mx < 0 || my < 0 || mx + 9 > fw || my + 9 > fh) {
+        edge_copy(edge, src, src_stride, mx, my, 9, 9, fw, fh);
+        *msrc = edge;
+        *ss = EDGE_STRIDE;
+    } else {
+        *msrc = src + mx + my * src_stride;
+        *ss = src_stride;
+    }
+}
+
+void bink2_mc_chroma_block_c(unsigned char *dst, int dst_stride,
+                             const unsigned char *msrc, int ss,
+                             int hmode, int vmode)
+{
+    int i, j;
+
+    if (hmode == 0 && vmode == 0) {
+        for (j = 0; j < 8; j++) {
+            memcpy(dst, msrc, 8);
+            dst += dst_stride;
+            msrc += ss;
+        }
+    } else if (vmode == 0) {
+        for (j = 0; j < 8; j++) {
+            for (i = 0; i < 8; i++)
+                dst[i] = (unsigned char)clip8(chroma_h(hmode, msrc + i));
+            dst += dst_stride;
+            msrc += ss;
+        }
+    } else if (hmode == 0) {
+        for (i = 0; i < 8; i++) {
+            for (j = 0; j < 8; j++)
+                dst[j * dst_stride + i] =
+                    (unsigned char)clip8(chroma_v(vmode, msrc + j * ss + i,
+                                                  ss));
+        }
+    } else {
+        unsigned char temp[9 * 8];
+
+        for (i = 0; i < 9; i++) {
+            for (j = 0; j < 8; j++)
+                temp[i * 8 + j] =
+                    (unsigned char)clip8(chroma_h(hmode, msrc + j));
+            msrc += ss;
+        }
+        for (j = 0; j < 8; j++) {
+            for (i = 0; i < 8; i++)
+                dst[i] = (unsigned char)clip8(
+                    chroma_v(vmode, temp + j * 8 + i, 8));
+            dst += dst_stride;
+        }
+    }
+}
+
+void bink2_mc_chroma_c(unsigned char *dst, int dst_stride,
+                       const unsigned char *src, int src_stride,
+                       int x, int y, int frame_w, int frame_h,
+                       int mvx, int mvy)
+{
+    unsigned char edge[EDGE_STRIDE * 24];
+    const unsigned char *msrc;
+    int ss;
+
+    chroma_source(edge, src, src_stride, x, y, frame_w, frame_h, mvx, mvy,
+                  &msrc, &ss);
+    bink2_mc_chroma_block_c(dst, dst_stride, msrc, ss, mvx & 3, mvy & 3);
+}
+
+void bink2_mc_chroma(unsigned char *dst, int dst_stride,
+                     const unsigned char *src, int src_stride,
+                     int x, int y, int frame_w, int frame_h,
+                     int mvx, int mvy)
+{
+    unsigned char edge[EDGE_STRIDE * 24];
+    const unsigned char *msrc;
+    int ss;
+
+    chroma_source(edge, src, src_stride, x, y, frame_w, frame_h, mvx, mvy,
+                  &msrc, &ss);
+#if defined(BINK2_SIMD)
+    BINK2_SIMD(bink2_mc_chroma_block)(dst, dst_stride, msrc, ss, mvx & 3,
+                                      mvy & 3);
+#else
+    bink2_mc_chroma_block_c(dst, dst_stride, msrc, ss, mvx & 3, mvy & 3);
+#endif
+}
+
+void bink2_yuv_row_c(unsigned char *rgb, const unsigned char *y,
+                     const unsigned char *u, const unsigned char *v,
+                     int width, int studio_range)
+{
+    int x;
+
+    for (x = 0; x < width; x++) {
+        int yy = y[x];
+        int uu = u[x / 2] - 128;
+        int vv = v[x / 2] - 128;
+        int r, g, b;
+
+        if (!studio_range) {
+            r = yy + ((359 * vv + 128) >> 8);
+            g = yy - ((88 * uu + 183 * vv + 128) >> 8);
+            b = yy + ((454 * uu + 128) >> 8);
+        } else {
+            int sy = yy - 16;
+
+            r = (298 * sy + 409 * vv + 128) >> 8;
+            g = (298 * sy - 100 * uu - 208 * vv + 128) >> 8;
+            b = (298 * sy + 516 * uu + 128) >> 8;
+        }
+        rgb[x * 3 + 0] = (unsigned char)clip8(r);
+        rgb[x * 3 + 1] = (unsigned char)clip8(g);
+        rgb[x * 3 + 2] = (unsigned char)clip8(b);
+    }
+}
+
+void bink2_yuv_row(unsigned char *rgb, const unsigned char *y,
+                   const unsigned char *u, const unsigned char *v,
+                   int width, int studio_range)
+{
+#if defined(BINK2_SIMD)
+    /* The SIMD body converts 16 pixels at a time; the tail is scalar. */
+    int done = BINK2_SIMD(bink2_yuv_row16)(rgb, y, u, v, width,
+                                           studio_range);
+
+    bink2_yuv_row_c(rgb + (size_t)done * 3, y + done, u + done / 2,
+                    v + done / 2, width - done, studio_range);
+#else
+    bink2_yuv_row_c(rgb, y, u, v, width, studio_range);
+#endif
+}
diff --git a/vendor/libbink2/src/bink2_dsp.h b/vendor/libbink2/src/bink2_dsp.h
new file mode 100644
index 0000000000000000000000000000000000000000..45b55c5c33d6d45519c544e68f00221f05ecca4c
--- /dev/null
+++ b/vendor/libbink2/src/bink2_dsp.h
@@ -0,0 +1,109 @@
+#ifndef LIBBINK2_DSP_H
+#define LIBBINK2_DSP_H
+
+#include <stdint.h>
+
+/* SIMD is chosen at compile time: NEON on arm64, SSE2 on x86-64. Each
+ * routine below dispatches to it; the *_c versions are the scalar
+ * references, kept in every build so tests can compare against them.
+ * Define BINK2_NO_SIMD (CMake -DBINK2_SIMD=OFF) to use only scalar code. */
+#if !defined(BINK2_NO_SIMD)
+#if defined(__ARM_NEON) || defined(__ARM_NEON__) || defined(_M_ARM64)
+#define BINK2_SIMD_NEON 1
+#elif defined(__SSE2__) || defined(_M_X64) || \
+    (defined(_M_IX86_FP) && _M_IX86_FP >= 2)
+#define BINK2_SIMD_SSE2 1
+#endif
+#endif
+
+void bink2_idct_old(float block[64]);
+void bink2_put_block_f(unsigned char *dst, int stride, const float block[64]);
+void bink2_add_block_f(unsigned char *dst, int stride, const float block[64]);
+void bink2_put_block_f_c(unsigned char *dst, int stride,
+                         const float block[64]);
+void bink2_add_block_f_c(unsigned char *dst, int stride,
+                         const float block[64]);
+
+void bink2_idct_new(int32_t block[64]);
+void bink2_put_block(unsigned char *dst, int stride, const int32_t block[64]);
+void bink2_add_block(unsigned char *dst, int stride, const int32_t block[64]);
+void bink2_idct_new_c(int32_t block[64]);
+void bink2_put_block_c(unsigned char *dst, int stride,
+                       const int32_t block[64]);
+void bink2_add_block_c(unsigned char *dst, int stride,
+                       const int32_t block[64]);
+
+void bink2_mc_luma(unsigned char *dst, int dst_stride,
+                   const unsigned char *src, int src_stride,
+                   int x, int y, int frame_w, int frame_h,
+                   int mvx, int mvy);
+void bink2_mc_chroma(unsigned char *dst, int dst_stride,
+                     const unsigned char *src, int src_stride,
+                     int x, int y, int frame_w, int frame_h,
+                     int mvx, int mvy);
+void bink2_mc_luma_c(unsigned char *dst, int dst_stride,
+                     const unsigned char *src, int src_stride,
+                     int x, int y, int frame_w, int frame_h,
+                     int mvx, int mvy);
+void bink2_mc_chroma_c(unsigned char *dst, int dst_stride,
+                       const unsigned char *src, int src_stride,
+                       int x, int y, int frame_w, int frame_h,
+                       int mvx, int mvy);
+/* The filter step alone: src points at the block's top-left sample, with
+ * the taps around it readable (2 before and 3 after for luma, 1 after for
+ * chroma). hmode/vmode are the sub-pel phases. */
+void bink2_mc_luma_block_c(unsigned char *dst, int dst_stride,
+                           const unsigned char *src, int src_stride,
+                           int hmode, int vmode);
+void bink2_mc_chroma_block_c(unsigned char *dst, int dst_stride,
+                             const unsigned char *src, int src_stride,
+                             int hmode, int vmode);
+
+/* One row of YUV 4:2:0 to packed RGB24: y has width samples, u and v have
+ * (width + 1) / 2. Full-range BT.601, or studio range when studio_range. */
+void bink2_yuv_row_c(unsigned char *rgb, const unsigned char *y,
+                     const unsigned char *u, const unsigned char *v,
+                     int width, int studio_range);
+void bink2_yuv_row(unsigned char *rgb, const unsigned char *y,
+                   const unsigned char *u, const unsigned char *v,
+                   int width, int studio_range);
+
+#if defined(BINK2_SIMD_NEON)
+#define BINK2_SIMD(name) name##_neon
+#elif defined(BINK2_SIMD_SSE2)
+#define BINK2_SIMD(name) name##_sse2
+#endif
+
+/* Round-to-nearest-even float conversion needs AArch64 NEON (vcvtnq). */
+#if (defined(BINK2_SIMD_NEON) && \
+     (defined(__aarch64__) || defined(_M_ARM64))) || \
+    defined(BINK2_SIMD_SSE2)
+#define BINK2_SIMD_FLOAT_BLOCK 1
+#endif
+
+#if defined(BINK2_SIMD)
+void BINK2_SIMD(bink2_idct_new)(int32_t block[64]);
+void BINK2_SIMD(bink2_put_block)(unsigned char *dst, int stride,
+                                 const int32_t block[64]);
+void BINK2_SIMD(bink2_add_block)(unsigned char *dst, int stride,
+                                 const int32_t block[64]);
+void BINK2_SIMD(bink2_mc_luma_block)(unsigned char *dst, int dst_stride,
+                                     const unsigned char *src, int src_stride,
+                                     int hmode, int vmode);
+void BINK2_SIMD(bink2_mc_chroma_block)(unsigned char *dst, int dst_stride,
+                                       const unsigned char *src,
+                                       int src_stride, int hmode, int vmode);
+/* Converts the first (width & ~15) pixels of a row and returns that
+ * count; reads no sample past them. */
+int BINK2_SIMD(bink2_yuv_row16)(unsigned char *rgb, const unsigned char *y,
+                                const unsigned char *u, const unsigned char *v,
+                                int width, int studio_range);
+#endif
+#if defined(BINK2_SIMD_FLOAT_BLOCK)
+void BINK2_SIMD(bink2_put_block_f)(unsigned char *dst, int stride,
+                                   const float block[64]);
+void BINK2_SIMD(bink2_add_block_f)(unsigned char *dst, int stride,
+                                   const float block[64]);
+#endif
+
+#endif
diff --git a/vendor/libbink2/src/bink2_dsp_neon.c b/vendor/libbink2/src/bink2_dsp_neon.c
new file mode 100644
index 0000000000000000000000000000000000000000..9c0cc7d0a19b5913901421ec9acac94c5aa61d90
--- /dev/null
+++ b/vendor/libbink2/src/bink2_dsp_neon.c
@@ -0,0 +1,383 @@
+/* NEON versions of the DSP routines. Each matches its scalar reference in
+ * bink2_dsp.c bit for bit; tests/test_dsp_simd.c checks that. */
+#include "bink2_dsp.h"
+
+#include <stddef.h>
+
+#if defined(BINK2_SIMD_NEON)
+
+#include <arm_neon.h>
+
+/* The integer IDCT's multiplies, on four 32-bit lanes. */
+#define MUL_A(x) vaddq_s32((x), vshrq_n_s32((x), 2))
+#define MUL_B(x) vshrq_n_s32((x), 1)
+#define MUL_C(x) vsubq_s32(vsubq_s32((x), vshrq_n_s32((x), 2)), \
+                           vshrq_n_s32((x), 4))
+#define MUL_D(x) vsubq_s32(vaddq_s32((x), vshrq_n_s32((x), 2)), \
+                           vshrq_n_s32((x), 4))
+#define MUL_E(x) vshrq_n_s32((x), 2)
+
+/* One 1-D IDCT on four lanes: b[k] holds coefficient k of each lane. */
+static void idct8(const int32x4_t b[8], int32x4_t o[8])
+{
+    int32x4_t t00 = vaddq_s32(b[3], b[5]);
+    int32x4_t t01 = vsubq_s32(b[3], b[5]);
+    int32x4_t t02 = vaddq_s32(MUL_A(b[2]), MUL_B(b[6]));
+    int32x4_t t03 = vsubq_s32(MUL_B(b[2]), MUL_A(b[6]));
+    int32x4_t s04 = vaddq_s32(b[0], b[4]);
+    int32x4_t t0 = vaddq_s32(s04, t02);
+    int32x4_t t1 = vsubq_s32(s04, t02);
+    int32x4_t t2 = vsubq_s32(b[0], b[4]);
+    int32x4_t t3 = vaddq_s32(b[1], t00);
+    int32x4_t t4 = vsubq_s32(b[1], t00);
+    int32x4_t t5 = vaddq_s32(t01, b[7]);
+    int32x4_t t6 = vsubq_s32(t01, b[7]);
+    int32x4_t t7 = vaddq_s32(t4, MUL_C(t6));
+    int32x4_t t8 = vsubq_s32(MUL_C(t4), t6);
+    int32x4_t t9 = vaddq_s32(MUL_D(t3), MUL_E(t5));
+    int32x4_t t10 = vsubq_s32(MUL_E(t3), MUL_D(t5));
+    int32x4_t t11 = vaddq_s32(t2, t03);
+    int32x4_t t12 = vsubq_s32(t2, t03);
+
+    o[0] = vaddq_s32(t0, t9);
+    o[1] = vaddq_s32(t11, t7);
+    o[2] = vaddq_s32(t12, t8);
+    o[3] = vaddq_s32(t1, t10);
+    o[4] = vsubq_s32(t1, t10);
+    o[5] = vsubq_s32(t12, t8);
+    o[6] = vsubq_s32(t11, t7);
+    o[7] = vsubq_s32(t0, t9);
+}
+
+/* Transposes an 8x8 matrix of int16 held as eight row vectors. */
+static void transpose8(int16x8_t r[8])
+{
+    int16x8x2_t a0 = vtrnq_s16(r[0], r[1]);
+    int16x8x2_t a1 = vtrnq_s16(r[2], r[3]);
+    int16x8x2_t a2 = vtrnq_s16(r[4], r[5]);
+    int16x8x2_t a3 = vtrnq_s16(r[6], r[7]);
+    int32x4x2_t b0 = vtrnq_s32(vreinterpretq_s32_s16(a0.val[0]),
+                               vreinterpretq_s32_s16(a1.val[0]));
+    int32x4x2_t b1 = vtrnq_s32(vreinterpretq_s32_s16(a0.val[1]),
+                               vreinterpretq_s32_s16(a1.val[1]));
+    int32x4x2_t b2 = vtrnq_s32(vreinterpretq_s32_s16(a2.val[0]),
+                               vreinterpretq_s32_s16(a3.val[0]));
+    int32x4x2_t b3 = vtrnq_s32(vreinterpretq_s32_s16(a2.val[1]),
+                               vreinterpretq_s32_s16(a3.val[1]));
+
+#define JOIN(lo, hi) vreinterpretq_s16_s32(vcombine_s32(lo, hi))
+    r[0] = JOIN(vget_low_s32(b0.val[0]), vget_low_s32(b2.val[0]));
+    r[1] = JOIN(vget_low_s32(b1.val[0]), vget_low_s32(b3.val[0]));
+    r[2] = JOIN(vget_low_s32(b0.val[1]), vget_low_s32(b2.val[1]));
+    r[3] = JOIN(vget_low_s32(b1.val[1]), vget_low_s32(b3.val[1]));
+    r[4] = JOIN(vget_high_s32(b0.val[0]), vget_high_s32(b2.val[0]));
+    r[5] = JOIN(vget_high_s32(b1.val[0]), vget_high_s32(b3.val[0]));
+    r[6] = JOIN(vget_high_s32(b0.val[1]), vget_high_s32(b2.val[1]));
+    r[7] = JOIN(vget_high_s32(b1.val[1]), vget_high_s32(b3.val[1]));
+#undef JOIN
+}
+
+/* One IDCT pass over eight lanes held as int16 vectors r[k], then the
+ * scalar's ">> shift" and truncation back to int16. */
+static void idct_pass(int16x8_t r[8], int shift)
+{
+    int32x4_t lo[8], hi[8], olo[8], ohi[8];
+    int k;
+
+    for (k = 0; k < 8; k++) {
+        lo[k] = vmovl_s16(vget_low_s16(r[k]));
+        hi[k] = vmovl_s16(vget_high_s16(r[k]));
+    }
+    idct8(lo, olo);
+    idct8(hi, ohi);
+    for (k = 0; k < 8; k++) {
+        if (shift) {
+            olo[k] = vshrq_n_s32(olo[k], 6);
+            ohi[k] = vshrq_n_s32(ohi[k], 6);
+        }
+        r[k] = vcombine_s16(vmovn_s32(olo[k]), vmovn_s32(ohi[k]));
+    }
+}
+
+void bink2_idct_new_neon(int32_t block[64])
+{
+    int16x8_t r[8];
+    int k;
+
+    /* Rows, truncated to int16 as the scalar does. */
+    for (k = 0; k < 8; k++)
+        r[k] = vcombine_s16(vmovn_s32(vld1q_s32(block + 8 * k)),
+                            vmovn_s32(vld1q_s32(block + 8 * k + 4)));
+    idct_pass(r, 0);    /* columns: lanes are columns */
+    transpose8(r);
+    idct_pass(r, 1);    /* rows: lanes are rows */
+    transpose8(r);
+    for (k = 0; k < 8; k++) {
+        vst1q_s32(block + 8 * k, vmovl_s16(vget_low_s16(r[k])));
+        vst1q_s32(block + 8 * k + 4, vmovl_s16(vget_high_s16(r[k])));
+    }
+}
+
+/* block[j * 8 + i] is output row i, column j. Saturating to int16 first
+ * gives the same result as clamping the int32 to 0..255. */
+static void load_transposed(int16x8_t r[8], const int32_t block[64])
+{
+    int k;
+
+    for (k = 0; k < 8; k++)
+        r[k] = vcombine_s16(vqmovn_s32(vld1q_s32(block + 8 * k)),
+                            vqmovn_s32(vld1q_s32(block + 8 * k + 4)));
+    transpose8(r);
+}
+
+void bink2_put_block_neon(unsigned char *dst, int stride,
+                          const int32_t block[64])
+{
+    int16x8_t r[8];
+    int i;
+
+    load_transposed(r, block);
+    for (i = 0; i < 8; i++)
+        vst1_u8(dst + (long)i * stride, vqmovun_s16(r[i]));
+}
+
+void bink2_add_block_neon(unsigned char *dst, int stride,
+                          const int32_t block[64])
+{
+    int16x8_t r[8];
+    int i;
+
+    load_transposed(r, block);
+    for (i = 0; i < 8; i++) {
+        unsigned char *d = dst + (long)i * stride;
+        int16x8_t px = vreinterpretq_s16_u16(vmovl_u8(vld1_u8(d)));
+
+        vst1_u8(d, vqmovun_s16(vqaddq_s16(px, r[i])));
+    }
+}
+
+/* Luma 6-tap half-pel filter on eight samples, taps at -2..3:
+ * ((((p0 + p1) * 19) >> 1) - (m1 + p2) * 2 + ((m2 + p3) >> 1) + 8) >> 4,
+ * clamped to 0..255. Every intermediate fits in int16. */
+static uint8x8_t luma_tap(uint8x8_t m2, uint8x8_t m1, uint8x8_t p0,
+                          uint8x8_t p1, uint8x8_t p2, uint8x8_t p3)
+{
+    int16x8_t a = vreinterpretq_s16_u16(vaddl_u8(p0, p1));
+    int16x8_t b = vreinterpretq_s16_u16(vaddl_u8(m1, p2));
+    int16x8_t c = vreinterpretq_s16_u16(vaddl_u8(m2, p3));
+    int16x8_t r = vshrq_n_s16(vmulq_n_s16(a, 19), 1);
+
+    r = vsubq_s16(r, vshlq_n_s16(b, 1));
+    r = vaddq_s16(r, vshrq_n_s16(c, 1));
+    r = vaddq_s16(r, vdupq_n_s16(8));
+    return vqmovun_s16(vshrq_n_s16(r, 4));
+}
+
+static uint8x16_t luma_tap16(const uint8x16_t r[6])
+{
+    uint8x8_t lo = luma_tap(vget_low_u8(r[0]), vget_low_u8(r[1]),
+                            vget_low_u8(r[2]), vget_low_u8(r[3]),
+                            vget_low_u8(r[4]), vget_low_u8(r[5]));
+    uint8x8_t hi = luma_tap(vget_high_u8(r[0]), vget_high_u8(r[1]),
+                            vget_high_u8(r[2]), vget_high_u8(r[3]),
+                            vget_high_u8(r[4]), vget_high_u8(r[5]));
+
+    return vcombine_u8(lo, hi);
+}
+
+/* Horizontal filter of one 16-sample row. Reads s[-2..18] only. */
+static uint8x16_t luma_hrow(const unsigned char *s)
+{
+    uint8x16_t lo = vld1q_u8(s - 2);    /* s[-2..13] */
+    uint8x16_t hi = vld1q_u8(s + 3);    /* s[3..18] */
+    uint8x8_t a = luma_tap(vget_low_u8(lo),
+                           vget_low_u8(vextq_u8(lo, lo, 1)),
+                           vget_low_u8(vextq_u8(lo, lo, 2)),
+                           vget_low_u8(vextq_u8(lo, lo, 3)),
+                           vget_low_u8(vextq_u8(lo, lo, 4)),
+                           vget_low_u8(vextq_u8(lo, lo, 5)));
+    uint8x8_t b = luma_tap(vget_low_u8(vextq_u8(hi, hi, 3)),
+                           vget_low_u8(vextq_u8(hi, hi, 4)),
+                           vget_low_u8(vextq_u8(hi, hi, 5)),
+                           vget_low_u8(vextq_u8(hi, hi, 6)),
+                           vget_low_u8(vextq_u8(hi, hi, 7)),
+                           vget_low_u8(vextq_u8(hi, hi, 8)));
+
+    return vcombine_u8(a, b);
+}
+
+void bink2_mc_luma_block_neon(unsigned char *dst, int dst_stride,
+                              const unsigned char *src, int ss,
+                              int hmode, int vmode)
+{
+    uint8x16_t rows[21];
+    int i, j;
+
+    if (hmode == 0 && vmode == 0) {
+        for (j = 0; j < 16; j++)
+            vst1q_u8(dst + (long)j * dst_stride,
+                     vld1q_u8(src + (long)j * ss));
+        return;
+    }
+    if (vmode == 0) {
+        for (j = 0; j < 16; j++)
+            vst1q_u8(dst + (long)j * dst_stride,
+                     luma_hrow(src + (long)j * ss));
+        return;
+    }
+    /* rows[i] is source row i - 2, filtered horizontally when hmode. */
+    for (i = 0; i < 21; i++) {
+        const unsigned char *row = src + (long)(i - 2) * ss;
+
+        rows[i] = hmode ? luma_hrow(row) : vld1q_u8(row);
+    }
+    for (j = 0; j < 16; j++)
+        vst1q_u8(dst + (long)j * dst_stride, luma_tap16(rows + j));
+}
+
+/* Chroma quarter-pel filter: (w0 * a + w1 * b + 4) >> 3 with w1 = 2 * mode
+ * and w0 = 8 - w1. Mode 2's (a + b + 1) >> 1 is the same value. */
+static uint8x8_t chroma_tap(uint8x8_t a, uint8x8_t b, int mode)
+{
+    uint16x8_t x = vmull_u8(a, vdup_n_u8((uint8_t)(8 - 2 * mode)));
+
+    x = vmlal_u8(x, b, vdup_n_u8((uint8_t)(2 * mode)));
+    return vrshrn_n_u16(x, 3);
+}
+
+void bink2_mc_chroma_block_neon(unsigned char *dst, int dst_stride,
+                                const unsigned char *src, int ss,
+                                int hmode, int vmode)
+{
+    uint8x8_t rows[9];
+    int i, j;
+
+    if (hmode == 0 && vmode == 0) {
+        for (j = 0; j < 8; j++)
+            vst1_u8(dst + (long)j * dst_stride, vld1_u8(src + (long)j * ss));
+        return;
+    }
+    if (vmode == 0) {
+        for (j = 0; j < 8; j++) {
+            const unsigned char *row = src + (long)j * ss;
+
+            vst1_u8(dst + (long)j * dst_stride,
+                    chroma_tap(vld1_u8(row), vld1_u8(row + 1), hmode));
+        }
+        return;
+    }
+    for (i = 0; i < 9; i++) {
+        const unsigned char *row = src + (long)i * ss;
+
+        rows[i] = hmode ? chroma_tap(vld1_u8(row), vld1_u8(row + 1), hmode)
+                        : vld1_u8(row);
+    }
+    for (j = 0; j < 8; j++)
+        vst1_u8(dst + (long)j * dst_stride,
+                chroma_tap(rows[j], rows[j + 1], vmode));
+}
+
+/* YUV to RGB for four pixels in 32-bit lanes; yy is luma, uu and vv are
+ * chroma - 128. Matches bink2_yuv_row_c's integer formulas exactly. */
+static void yuv4(int32x4_t yy, int32x4_t uu, int32x4_t vv, int studio,
+                 int32x4_t *r, int32x4_t *g, int32x4_t *b)
+{
+    const int32x4_t half = vdupq_n_s32(128);
+
+    if (!studio) {
+        *r = vaddq_s32(yy, vshrq_n_s32(vmlaq_n_s32(half, vv, 359), 8));
+        *g = vsubq_s32(yy, vshrq_n_s32(
+                 vmlaq_n_s32(vmlaq_n_s32(half, uu, 88), vv, 183), 8));
+        *b = vaddq_s32(yy, vshrq_n_s32(vmlaq_n_s32(half, uu, 454), 8));
+    } else {
+        int32x4_t sy = vmlaq_n_s32(half, vsubq_s32(yy, vdupq_n_s32(16)),
+                                   298);
+
+        *r = vshrq_n_s32(vmlaq_n_s32(sy, vv, 409), 8);
+        *g = vshrq_n_s32(vmlaq_n_s32(vmlaq_n_s32(sy, uu, -100), vv, -208),
+                         8);
+        *b = vshrq_n_s32(vmlaq_n_s32(sy, uu, 516), 8);
+    }
+}
+
+static uint8x8_t clamp8(int32x4_t lo, int32x4_t hi)
+{
+    return vqmovun_s16(vcombine_s16(vqmovn_s32(lo), vqmovn_s32(hi)));
+}
+
+int bink2_yuv_row16_neon(unsigned char *rgb, const unsigned char *y,
+                         const unsigned char *u, const unsigned char *v,
+                         int width, int studio_range)
+{
+    const int16x8_t bias = vdupq_n_s16(128);
+    int x;
+
+    for (x = 0; x + 16 <= width; x += 16) {
+        uint8x16_t ly = vld1q_u8(y + x);
+        uint8x8x2_t du = vzip_u8(vld1_u8(u + x / 2), vld1_u8(u + x / 2));
+        uint8x8x2_t dv = vzip_u8(vld1_u8(v + x / 2), vld1_u8(v + x / 2));
+        uint8x8_t ry[2], gy[2], by[2];
+        uint8x16x3_t out;
+        int h;
+
+        for (h = 0; h < 2; h++) {
+            uint8x8_t y8 = h ? vget_high_u8(ly) : vget_low_u8(ly);
+            int16x8_t y16 = vreinterpretq_s16_u16(vmovl_u8(y8));
+            int16x8_t u16 = vsubq_s16(
+                vreinterpretq_s16_u16(vmovl_u8(du.val[h])), bias);
+            int16x8_t v16 = vsubq_s16(
+                vreinterpretq_s16_u16(vmovl_u8(dv.val[h])), bias);
+            int32x4_t r0, g0, b0, r1, g1, b1;
+
+            yuv4(vmovl_s16(vget_low_s16(y16)), vmovl_s16(vget_low_s16(u16)),
+                 vmovl_s16(vget_low_s16(v16)), studio_range, &r0, &g0, &b0);
+            yuv4(vmovl_s16(vget_high_s16(y16)),
+                 vmovl_s16(vget_high_s16(u16)),
+                 vmovl_s16(vget_high_s16(v16)), studio_range, &r1, &g1, &b1);
+            ry[h] = clamp8(r0, r1);
+            gy[h] = clamp8(g0, g1);
+            by[h] = clamp8(b0, b1);
+        }
+        out.val[0] = vcombine_u8(ry[0], ry[1]);
+        out.val[1] = vcombine_u8(gy[0], gy[1]);
+        out.val[2] = vcombine_u8(by[0], by[1]);
+        vst3q_u8(rgb + (size_t)x * 3, out);
+    }
+    return x;
+}
+
+#if defined(BINK2_SIMD_FLOAT_BLOCK)
+/* Eight floats rounded half to even (lrintf in the default mode) and
+ * saturated to int16. */
+static int16x8_t round8(const float *p)
+{
+    return vcombine_s16(vqmovn_s32(vcvtnq_s32_f32(vld1q_f32(p))),
+                        vqmovn_s32(vcvtnq_s32_f32(vld1q_f32(p + 4))));
+}
+
+void bink2_put_block_f_neon(unsigned char *dst, int stride,
+                            const float block[64])
+{
+    int i;
+
+    for (i = 0; i < 8; i++)
+        vst1_u8(dst + (long)i * stride, vqmovun_s16(round8(block + 8 * i)));
+}
+
+void bink2_add_block_f_neon(unsigned char *dst, int stride,
+                            const float block[64])
+{
+    int i;
+
+    for (i = 0; i < 8; i++) {
+        unsigned char *d = dst + (long)i * stride;
+        int16x8_t px = vreinterpretq_s16_u16(vmovl_u8(vld1_u8(d)));
+
+        vst1_u8(d, vqmovun_s16(vqaddq_s16(px, round8(block + 8 * i))));
+    }
+}
+#endif
+
+#else
+typedef int bink2_dsp_neon_unused;
+#endif
diff --git a/vendor/libbink2/src/bink2_dsp_sse2.c b/vendor/libbink2/src/bink2_dsp_sse2.c
new file mode 100644
index 0000000000000000000000000000000000000000..2cbd1c87cf8743d03ca6c4ada3f5f074ce901d46
--- /dev/null
+++ b/vendor/libbink2/src/bink2_dsp_sse2.c
@@ -0,0 +1,469 @@
+/* SSE2 versions of the DSP routines. Each matches its scalar reference in
+ * bink2_dsp.c bit for bit; tests/test_dsp_simd.c checks that. */
+#include "bink2_dsp.h"
+
+#include <stddef.h>
+
+#if defined(BINK2_SIMD_SSE2)
+
+#include <emmintrin.h>
+
+/* The integer IDCT's multiplies, on four 32-bit lanes. */
+#define MUL_A(x) _mm_add_epi32((x), _mm_srai_epi32((x), 2))
+#define MUL_B(x) _mm_srai_epi32((x), 1)
+#define MUL_C(x) _mm_sub_epi32(_mm_sub_epi32((x), _mm_srai_epi32((x), 2)), \
+                               _mm_srai_epi32((x), 4))
+#define MUL_D(x) _mm_sub_epi32(_mm_add_epi32((x), _mm_srai_epi32((x), 2)), \
+                               _mm_srai_epi32((x), 4))
+#define MUL_E(x) _mm_srai_epi32((x), 2)
+
+/* One 1-D IDCT on four lanes: b[k] holds coefficient k of each lane. */
+static void idct8(const __m128i b[8], __m128i o[8])
+{
+    __m128i t00 = _mm_add_epi32(b[3], b[5]);
+    __m128i t01 = _mm_sub_epi32(b[3], b[5]);
+    __m128i t02 = _mm_add_epi32(MUL_A(b[2]), MUL_B(b[6]));
+    __m128i t03 = _mm_sub_epi32(MUL_B(b[2]), MUL_A(b[6]));
+    __m128i s04 = _mm_add_epi32(b[0], b[4]);
+    __m128i t0 = _mm_add_epi32(s04, t02);
+    __m128i t1 = _mm_sub_epi32(s04, t02);
+    __m128i t2 = _mm_sub_epi32(b[0], b[4]);
+    __m128i t3 = _mm_add_epi32(b[1], t00);
+    __m128i t4 = _mm_sub_epi32(b[1], t00);
+    __m128i t5 = _mm_add_epi32(t01, b[7]);
+    __m128i t6 = _mm_sub_epi32(t01, b[7]);
+    __m128i t7 = _mm_add_epi32(t4, MUL_C(t6));
+    __m128i t8 = _mm_sub_epi32(MUL_C(t4), t6);
+    __m128i t9 = _mm_add_epi32(MUL_D(t3), MUL_E(t5));
+    __m128i t10 = _mm_sub_epi32(MUL_E(t3), MUL_D(t5));
+    __m128i t11 = _mm_add_epi32(t2, t03);
+    __m128i t12 = _mm_sub_epi32(t2, t03);
+
+    o[0] = _mm_add_epi32(t0, t9);
+    o[1] = _mm_add_epi32(t11, t7);
+    o[2] = _mm_add_epi32(t12, t8);
+    o[3] = _mm_add_epi32(t1, t10);
+    o[4] = _mm_sub_epi32(t1, t10);
+    o[5] = _mm_sub_epi32(t12, t8);
+    o[6] = _mm_sub_epi32(t11, t7);
+    o[7] = _mm_sub_epi32(t0, t9);
+}
+
+static void transpose8(__m128i r[8])
+{
+    __m128i a0 = _mm_unpacklo_epi16(r[0], r[1]);
+    __m128i a1 = _mm_unpackhi_epi16(r[0], r[1]);
+    __m128i a2 = _mm_unpacklo_epi16(r[2], r[3]);
+    __m128i a3 = _mm_unpackhi_epi16(r[2], r[3]);
+    __m128i a4 = _mm_unpacklo_epi16(r[4], r[5]);
+    __m128i a5 = _mm_unpackhi_epi16(r[4], r[5]);
+    __m128i a6 = _mm_unpacklo_epi16(r[6], r[7]);
+    __m128i a7 = _mm_unpackhi_epi16(r[6], r[7]);
+    __m128i b0 = _mm_unpacklo_epi32(a0, a2);
+    __m128i b1 = _mm_unpackhi_epi32(a0, a2);
+    __m128i b2 = _mm_unpacklo_epi32(a1, a3);
+    __m128i b3 = _mm_unpackhi_epi32(a1, a3);
+    __m128i b4 = _mm_unpacklo_epi32(a4, a6);
+    __m128i b5 = _mm_unpackhi_epi32(a4, a6);
+    __m128i b6 = _mm_unpacklo_epi32(a5, a7);
+    __m128i b7 = _mm_unpackhi_epi32(a5, a7);
+
+    r[0] = _mm_unpacklo_epi64(b0, b4);
+    r[1] = _mm_unpackhi_epi64(b0, b4);
+    r[2] = _mm_unpacklo_epi64(b1, b5);
+    r[3] = _mm_unpackhi_epi64(b1, b5);
+    r[4] = _mm_unpacklo_epi64(b2, b6);
+    r[5] = _mm_unpackhi_epi64(b2, b6);
+    r[6] = _mm_unpacklo_epi64(b3, b7);
+    r[7] = _mm_unpackhi_epi64(b3, b7);
+}
+
+/* Sign-extends the low and high four int16 lanes to int32. */
+static __m128i widen_lo(__m128i x)
+{
+    return _mm_srai_epi32(_mm_unpacklo_epi16(x, x), 16);
+}
+
+static __m128i widen_hi(__m128i x)
+{
+    return _mm_srai_epi32(_mm_unpackhi_epi16(x, x), 16);
+}
+
+/* Truncates eight int32 lanes to int16, like a C cast; SSE2 only has a
+ * saturating pack, so sign-extend the low halves first. */
+static __m128i narrow_trunc(__m128i lo, __m128i hi)
+{
+    lo = _mm_srai_epi32(_mm_slli_epi32(lo, 16), 16);
+    hi = _mm_srai_epi32(_mm_slli_epi32(hi, 16), 16);
+    return _mm_packs_epi32(lo, hi);
+}
+
+static void idct_pass(__m128i r[8], int shift)
+{
+    __m128i lo[8], hi[8], olo[8], ohi[8];
+    int k;
+
+    for (k = 0; k < 8; k++) {
+        lo[k] = widen_lo(r[k]);
+        hi[k] = widen_hi(r[k]);
+    }
+    idct8(lo, olo);
+    idct8(hi, ohi);
+    for (k = 0; k < 8; k++) {
+        if (shift) {
+            olo[k] = _mm_srai_epi32(olo[k], 6);
+            ohi[k] = _mm_srai_epi32(ohi[k], 6);
+        }
+        r[k] = narrow_trunc(olo[k], ohi[k]);
+    }
+}
+
+static __m128i load4(const int32_t *p)
+{
+    return _mm_loadu_si128((const __m128i *)(const void *)p);
+}
+
+void bink2_idct_new_sse2(int32_t block[64])
+{
+    __m128i r[8];
+    int k;
+
+    for (k = 0; k < 8; k++)
+        r[k] = narrow_trunc(load4(block + 8 * k), load4(block + 8 * k + 4));
+    idct_pass(r, 0);
+    transpose8(r);
+    idct_pass(r, 1);
+    transpose8(r);
+    for (k = 0; k < 8; k++) {
+        _mm_storeu_si128((__m128i *)(void *)(block + 8 * k), widen_lo(r[k]));
+        _mm_storeu_si128((__m128i *)(void *)(block + 8 * k + 4),
+                         widen_hi(r[k]));
+    }
+}
+
+/* block[j * 8 + i] is output row i, column j. Saturating to int16 first
+ * gives the same result as clamping the int32 to 0..255. */
+static void load_transposed(__m128i r[8], const int32_t block[64])
+{
+    int k;
+
+    for (k = 0; k < 8; k++)
+        r[k] = _mm_packs_epi32(load4(block + 8 * k), load4(block + 8 * k + 4));
+    transpose8(r);
+}
+
+void bink2_put_block_sse2(unsigned char *dst, int stride,
+                          const int32_t block[64])
+{
+    __m128i r[8];
+    int i;
+
+    load_transposed(r, block);
+    for (i = 0; i < 8; i++)
+        _mm_storel_epi64((__m128i *)(void *)(dst + (long)i * stride),
+                         _mm_packus_epi16(r[i], r[i]));
+}
+
+void bink2_add_block_sse2(unsigned char *dst, int stride,
+                          const int32_t block[64])
+{
+    const __m128i zero = _mm_setzero_si128();
+    __m128i r[8];
+    int i;
+
+    load_transposed(r, block);
+    for (i = 0; i < 8; i++) {
+        unsigned char *d = dst + (long)i * stride;
+        __m128i px = _mm_unpacklo_epi8(
+            _mm_loadl_epi64((const __m128i *)(const void *)d), zero);
+
+        px = _mm_adds_epi16(px, r[i]);
+        _mm_storel_epi64((__m128i *)(void *)d, _mm_packus_epi16(px, px));
+    }
+}
+
+static __m128i load8(const unsigned char *p)
+{
+    return _mm_loadl_epi64((const __m128i *)(const void *)p);
+}
+
+/* Eight samples at p, zero-extended to 16-bit lanes. */
+static __m128i load8w(const unsigned char *p)
+{
+    return _mm_unpacklo_epi8(load8(p), _mm_setzero_si128());
+}
+
+/* Luma 6-tap half-pel filter on eight 16-bit lanes, taps at -2..3:
+ * ((((p0 + p1) * 19) >> 1) - (m1 + p2) * 2 + ((m2 + p3) >> 1) + 8) >> 4.
+ * Every intermediate fits in int16; the caller packs with saturation.
+ * The taps come as an array: 32-bit MSVC cannot pass more than three
+ * vectors by value. */
+static __m128i luma_tap(const __m128i t[6])
+{
+    __m128i a = _mm_add_epi16(t[2], t[3]);
+    __m128i b = _mm_add_epi16(t[1], t[4]);
+    __m128i c = _mm_add_epi16(t[0], t[5]);
+    __m128i r = _mm_srai_epi16(_mm_mullo_epi16(a, _mm_set1_epi16(19)), 1);
+
+    r = _mm_sub_epi16(r, _mm_slli_epi16(b, 1));
+    r = _mm_add_epi16(r, _mm_srai_epi16(c, 1));
+    r = _mm_add_epi16(r, _mm_set1_epi16(8));
+    return _mm_srai_epi16(r, 4);
+}
+
+/* Horizontal filter of one 16-sample row. Reads s[-2..18] only. */
+static __m128i luma_hrow(const unsigned char *s)
+{
+    __m128i lo[6], hi[6];
+    int k;
+
+    for (k = 0; k < 6; k++) {
+        lo[k] = load8w(s - 2 + k);
+        hi[k] = load8w(s + 6 + k);
+    }
+    return _mm_packus_epi16(luma_tap(lo), luma_tap(hi));
+}
+
+static __m128i load16(const unsigned char *p)
+{
+    return _mm_loadu_si128((const __m128i *)(const void *)p);
+}
+
+static void store16(unsigned char *p, __m128i v)
+{
+    _mm_storeu_si128((__m128i *)(void *)p, v);
+}
+
+static __m128i luma_tap16(const __m128i r[6])
+{
+    const __m128i zero = _mm_setzero_si128();
+    __m128i lo[6], hi[6];
+    int k;
+
+    for (k = 0; k < 6; k++) {
+        lo[k] = _mm_unpacklo_epi8(r[k], zero);
+        hi[k] = _mm_unpackhi_epi8(r[k], zero);
+    }
+    return _mm_packus_epi16(luma_tap(lo), luma_tap(hi));
+}
+
+void bink2_mc_luma_block_sse2(unsigned char *dst, int dst_stride,
+                              const unsigned char *src, int ss,
+                              int hmode, int vmode)
+{
+    __m128i rows[21];
+    int i, j;
+
+    if (hmode == 0 && vmode == 0) {
+        for (j = 0; j < 16; j++)
+            store16(dst + (long)j * dst_stride, load16(src + (long)j * ss));
+        return;
+    }
+    if (vmode == 0) {
+        for (j = 0; j < 16; j++)
+            store16(dst + (long)j * dst_stride,
+                    luma_hrow(src + (long)j * ss));
+        return;
+    }
+    /* rows[i] is source row i - 2, filtered horizontally when hmode. */
+    for (i = 0; i < 21; i++) {
+        const unsigned char *row = src + (long)(i - 2) * ss;
+
+        rows[i] = hmode ? luma_hrow(row) : load16(row);
+    }
+    for (j = 0; j < 16; j++)
+        store16(dst + (long)j * dst_stride, luma_tap16(rows + j));
+}
+
+/* Chroma quarter-pel filter on 16-bit lanes: (w0 * a + w1 * b + 4) >> 3
+ * with w1 = 2 * mode and w0 = 8 - w1. Mode 2's (a + b + 1) >> 1 is the
+ * same value. */
+static __m128i chroma_tap(__m128i a, __m128i b, int mode)
+{
+    __m128i x = _mm_mullo_epi16(a, _mm_set1_epi16((short)(8 - 2 * mode)));
+
+    x = _mm_add_epi16(x, _mm_mullo_epi16(b, _mm_set1_epi16((short)(2 * mode))));
+    return _mm_srli_epi16(_mm_add_epi16(x, _mm_set1_epi16(4)), 3);
+}
+
+static void store8w(unsigned char *p, __m128i v)
+{
+    _mm_storel_epi64((__m128i *)(void *)p, _mm_packus_epi16(v, v));
+}
+
+void bink2_mc_chroma_block_sse2(unsigned char *dst, int dst_stride,
+                                const unsigned char *src, int ss,
+                                int hmode, int vmode)
+{
+    __m128i rows[9];
+    int i, j;
+
+    if (hmode == 0 && vmode == 0) {
+        for (j = 0; j < 8; j++)
+            store8w(dst + (long)j * dst_stride, load8w(src + (long)j * ss));
+        return;
+    }
+    if (vmode == 0) {
+        for (j = 0; j < 8; j++) {
+            const unsigned char *row = src + (long)j * ss;
+
+            store8w(dst + (long)j * dst_stride,
+                    chroma_tap(load8w(row), load8w(row + 1), hmode));
+        }
+        return;
+    }
+    for (i = 0; i < 9; i++) {
+        const unsigned char *row = src + (long)i * ss;
+
+        rows[i] = hmode ? chroma_tap(load8w(row), load8w(row + 1), hmode)
+                        : load8w(row);
+    }
+    for (j = 0; j < 8; j++)
+        store8w(dst + (long)j * dst_stride,
+                chroma_tap(rows[j], rows[j + 1], vmode));
+}
+
+/* (a * ca + b * cb) for four pixels: lanes 0..3 or 4..7 of a and b, via
+ * the pairwise multiply-add, since SSE2 has no 32-bit multiply. */
+static __m128i madd_lo(__m128i a, __m128i b, __m128i coef)
+{
+    return _mm_madd_epi16(_mm_unpacklo_epi16(a, b), coef);
+}
+
+static __m128i madd_hi(__m128i a, __m128i b, __m128i coef)
+{
+    return _mm_madd_epi16(_mm_unpackhi_epi16(a, b), coef);
+}
+
+static __m128i pair(short ca, short cb)
+{
+    return _mm_set_epi16(cb, ca, cb, ca, cb, ca, cb, ca);
+}
+
+/* Eight pixels: y in 16-bit lanes, u and v - 128 in 16-bit lanes. The
+ * formulas are bink2_yuv_row_c's, term for term. */
+static void yuv8(__m128i y, __m128i u, __m128i v, int studio,
+                 __m128i *r, __m128i *g, __m128i *b)
+{
+    const __m128i one = _mm_set1_epi16(1);
+    const __m128i half = _mm_set1_epi32(128);
+    __m128i rl, rh, gl, gh, bl, bh;
+
+    if (!studio) {
+        __m128i yl = madd_lo(y, one, pair(1, 0));
+        __m128i yh = madd_hi(y, one, pair(1, 0));
+
+        rl = _mm_add_epi32(yl, _mm_srai_epi32(madd_lo(v, one, pair(359, 128)),
+                                              8));
+        rh = _mm_add_epi32(yh, _mm_srai_epi32(madd_hi(v, one, pair(359, 128)),
+                                              8));
+        gl = _mm_sub_epi32(yl, _mm_srai_epi32(_mm_add_epi32(
+                 madd_lo(u, v, pair(88, 183)), half), 8));
+        gh = _mm_sub_epi32(yh, _mm_srai_epi32(_mm_add_epi32(
+                 madd_hi(u, v, pair(88, 183)), half), 8));
+        bl = _mm_add_epi32(yl, _mm_srai_epi32(madd_lo(u, one, pair(454, 128)),
+                                              8));
+        bh = _mm_add_epi32(yh, _mm_srai_epi32(madd_hi(u, one, pair(454, 128)),
+                                              8));
+    } else {
+        __m128i sy = _mm_sub_epi16(y, _mm_set1_epi16(16));
+
+        rl = _mm_srai_epi32(_mm_add_epi32(madd_lo(sy, v, pair(298, 409)),
+                                          half), 8);
+        rh = _mm_srai_epi32(_mm_add_epi32(madd_hi(sy, v, pair(298, 409)),
+                                          half), 8);
+        gl = _mm_srai_epi32(_mm_add_epi32(madd_lo(sy, u, pair(298, -100)),
+                                          madd_lo(v, one, pair(-208, 128))),
+                            8);
+        gh = _mm_srai_epi32(_mm_add_epi32(madd_hi(sy, u, pair(298, -100)),
+                                          madd_hi(v, one, pair(-208, 128))),
+                            8);
+        bl = _mm_srai_epi32(_mm_add_epi32(madd_lo(sy, u, pair(298, 516)),
+                                          half), 8);
+        bh = _mm_srai_epi32(_mm_add_epi32(madd_hi(sy, u, pair(298, 516)),
+                                          half), 8);
+    }
+    *r = _mm_packs_epi32(rl, rh);
+    *g = _mm_packs_epi32(gl, gh);
+    *b = _mm_packs_epi32(bl, bh);
+}
+
+int bink2_yuv_row16_sse2(unsigned char *rgb, const unsigned char *y,
+                         const unsigned char *u, const unsigned char *v,
+                         int width, int studio_range)
+{
+    const __m128i zero = _mm_setzero_si128();
+    const __m128i bias = _mm_set1_epi16(128);
+    int x;
+
+    for (x = 0; x + 16 <= width; x += 16) {
+        __m128i ly = load16(y + x);
+        __m128i u8 = load8(u + x / 2);
+        __m128i v8 = load8(v + x / 2);
+        __m128i du = _mm_unpacklo_epi8(u8, u8);
+        __m128i dv = _mm_unpacklo_epi8(v8, v8);
+        unsigned char r[16], g[16], b[16];
+        __m128i r0, g0, b0, r1, g1, b1;
+        unsigned char *out = rgb + (size_t)x * 3;
+        int i;
+
+        yuv8(_mm_unpacklo_epi8(ly, zero),
+             _mm_sub_epi16(_mm_unpacklo_epi8(du, zero), bias),
+             _mm_sub_epi16(_mm_unpacklo_epi8(dv, zero), bias),
+             studio_range, &r0, &g0, &b0);
+        yuv8(_mm_unpackhi_epi8(ly, zero),
+             _mm_sub_epi16(_mm_unpackhi_epi8(du, zero), bias),
+             _mm_sub_epi16(_mm_unpackhi_epi8(dv, zero), bias),
+             studio_range, &r1, &g1, &b1);
+        store16(r, _mm_packus_epi16(r0, r1));
+        store16(g, _mm_packus_epi16(g0, g1));
+        store16(b, _mm_packus_epi16(b0, b1));
+        for (i = 0; i < 16; i++) {
+            out[i * 3 + 0] = r[i];
+            out[i * 3 + 1] = g[i];
+            out[i * 3 + 2] = b[i];
+        }
+    }
+    return x;
+}
+
+/* Eight floats rounded in the current mode (half to even by default, as
+ * lrintf) and saturated to int16. */
+static __m128i round8(const float *p)
+{
+    return _mm_packs_epi32(_mm_cvtps_epi32(_mm_loadu_ps(p)),
+                           _mm_cvtps_epi32(_mm_loadu_ps(p + 4)));
+}
+
+void bink2_put_block_f_sse2(unsigned char *dst, int stride,
+                            const float block[64])
+{
+    int i;
+
+    for (i = 0; i < 8; i++) {
+        __m128i r = round8(block + 8 * i);
+
+        _mm_storel_epi64((__m128i *)(void *)(dst + (long)i * stride),
+                         _mm_packus_epi16(r, r));
+    }
+}
+
+void bink2_add_block_f_sse2(unsigned char *dst, int stride,
+                            const float block[64])
+{
+    const __m128i zero = _mm_setzero_si128();
+    int i;
+
+    for (i = 0; i < 8; i++) {
+        unsigned char *d = dst + (long)i * stride;
+        __m128i px = _mm_unpacklo_epi8(
+            _mm_loadl_epi64((const __m128i *)(const void *)d), zero);
+
+        px = _mm_adds_epi16(px, round8(block + 8 * i));
+        _mm_storel_epi64((__m128i *)(void *)d, _mm_packus_epi16(px, px));
+    }
+}
+
+#else
+typedef int bink2_dsp_sse2_unused;
+#endif
diff --git a/vendor/libbink2/src/bink2_filter.c b/vendor/libbink2/src/bink2_filter.c
new file mode 100644
index 0000000000000000000000000000000000000000..2537eb2a72b1b2bab2275f653f5fa125629bef19
--- /dev/null
+++ b/vendor/libbink2/src/bink2_filter.c
@@ -0,0 +1,598 @@
+#include "bink2_filter.h"
+#include "bink2_video.h"
+
+int bink2_filter_covers(int version, int stage)
+{
+    /* RAD's studied decoder rejects KB2l and KB2n, so nothing is known
+     * about them. */
+    int known = version >= 'f' && version <= 'm' && version != 'l';
+
+    switch (stage) {
+    case BINK2_STAGE_DEBLOCK:
+    case BINK2_STAGE_DCRECON:
+        return known;
+    case BINK2_STAGE_RESIDUAL:
+        /* KB2f inter syntax has no residual filter to reproduce. */
+        return known && version != 'f';
+    default:
+        return 0;
+    }
+}
+
+unsigned bink2_filter_db_class_mask(int class_p, int class_q)
+{
+    unsigned mask = 0;
+
+    if (class_p == 3 && class_q == 3)
+        return 0;
+    if (class_p >= 2)
+        mask |= BINK2_DB_TAP_P1;
+    if (class_p >= 1)
+        mask |= BINK2_DB_TAP_P0;
+    if (class_q >= 1)
+        mask |= BINK2_DB_TAP_Q0;
+    if (class_q >= 2)
+        mask |= BINK2_DB_TAP_Q1;
+    return mask;
+}
+
+int bink2_filter_mv_differ(int ax, int ay, int bx, int by)
+{
+    int dx = ax - bx;
+    int dy = ay - by;
+
+    return dx >= 2 || dx <= -2 || dy >= 2 || dy <= -2;
+}
+
+/* Division rounding towards minus infinity, for a positive divisor; C99's
+ * '/' truncates and '>>' on a negative value is implementation-defined. */
+static int floor_div(int x, int k)
+{
+    return x >= 0 ? x / k : -((k - 1 - x) / k);
+}
+
+static unsigned char clamp255(int v)
+{
+    return (unsigned char)(v < 0 ? 0 : v > 255 ? 255 : v);
+}
+
+void bink2_filter_db_edge(unsigned char *q0, int across, int along,
+                          unsigned mask)
+{
+    int line;
+
+    if (!(mask & BINK2_DB_TAPS_ALL))
+        return;
+    for (line = 0; line < 8; line++, q0 += along) {
+        unsigned char *p1 = q0 - 2 * across;
+        unsigned char *p0 = q0 - across;
+        unsigned char *q1 = q0 + across;
+        int d = *q0 - *p0;
+        int a = floor_div(d + 4, 8);
+        int b = floor_div(d + 2, 4);
+
+        /* Every tap uses the line's original p0 and q0 through d. */
+        if (mask & BINK2_DB_TAP_P1)
+            *p1 = clamp255(*p1 + a);
+        if (mask & BINK2_DB_TAP_P0)
+            *p0 = clamp255(*p0 + b);
+        if (mask & BINK2_DB_TAP_Q0)
+            *q0 = clamp255(*q0 - b);
+        if (mask & BINK2_DB_TAP_Q1)
+            *q1 = clamp255(*q1 - a);
+    }
+}
+
+/* Motion vector of the 16x16 luma quadrant holding luma pixel (x, y). */
+static void quadrant_mv(const Bink2Video *v, int x, int y, int *mx, int *my)
+{
+    size_t k = ((size_t)(y >> 5) * v->mb_w + (x >> 5)) * 4 +
+               (size_t)(((x >> 4) & 1) | (((y >> 4) & 1) << 1));
+
+    *mx = v->mv[0][k];
+    *my = v->mv[1][k];
+}
+
+/* Taps for the edge segment between blocks with words wp and wq. (px, py)
+ * and (qx, qy) are luma pixels on either side of the edge, used when both
+ * macroblocks are non-intra; on16 says the edge is on a 16-pixel luma
+ * boundary (every chroma edge is). */
+static unsigned edge_mask(const Bink2Video *v, unsigned wp, unsigned wq,
+                          int on16, int px, int py, int qx, int qy)
+{
+    int ax, ay, bx, by;
+
+    if ((wp | wq) & BINK2_INFO_INTRA)
+        return bink2_filter_db_class_mask(
+            (int)(wp >> BINK2_INFO_CLASS_SHIFT) & 3,
+            (int)(wq >> BINK2_INFO_CLASS_SHIFT) & 3);
+    if (!on16)
+        return 0;
+    quadrant_mv(v, px, py, &ax, &ay);
+    quadrant_mv(v, qx, qy, &bx, &by);
+    return bink2_filter_mv_differ(ax, ay, bx, by) ? BINK2_DB_TAPS_ALL : 0;
+}
+
+/* One direction of one plane. Block (j, i) is the jth 8x8 block of the
+ * ith block row; the edge before it lies on luma column or row 8j << s or
+ * 8i << s, which also indexes the edge arrays. */
+static void deblock_plane(Bink2Video *v, int p, int vertical)
+{
+    int s = p ? 1 : 0;
+    int cols = (int)(v->aligned_w >> 3) >> s;
+    int rows = (int)(((v->height + 15) & ~15UL) >> 3) >> s;
+    int stride = v->stride[p];
+    const uint16_t *info = v->blk_info[p];
+    int bs = v->blk_stride[p];
+    int i, j;
+
+    for (i = vertical ? 0 : 1; i < rows; i++) {
+        int ly = (8 * i) << s;
+
+        if (!vertical && v->row_flags[i << s])
+            continue;
+        for (j = vertical ? 1 : 0; j < cols; j++) {
+            int lx = (8 * j) << s;
+            unsigned char *q0 = v->cur[p] + (size_t)(8 * i) * stride + 8 * j;
+            unsigned mask;
+
+            if (vertical) {
+                if (v->col_flags[j << s])
+                    continue;
+                mask = edge_mask(v, info[i * bs + j - 1], info[i * bs + j],
+                                 s || !(j & 1), lx - 1, ly, lx, ly);
+                if (mask)
+                    bink2_filter_db_edge(q0, 1, stride, mask);
+            } else {
+                mask = edge_mask(v, info[(i - 1) * bs + j], info[i * bs + j],
+                                 s || !(i & 1), lx, ly - 1, lx, ly);
+                if (mask)
+                    bink2_filter_db_edge(q0, stride, 1, mask);
+            }
+        }
+    }
+}
+
+void bink2_filter_deblock(Bink2Video *v)
+{
+    int p;
+
+    /* Every vertical edge before any horizontal one. */
+    if (!(v->frame_flags & 0x4000))
+        for (p = 0; p < 3; p++)
+            deblock_plane(v, p, 1);
+    if (!(v->frame_flags & 0x8000))
+        for (p = 0; p < 3; p++)
+            deblock_plane(v, p, 0);
+}
+
+unsigned bink2_filter_residual_dirs(const Bink2Video *v)
+{
+    unsigned dirs = 0;
+
+    if (!v->filters_on ||
+        !bink2_filter_covers(v->version, BINK2_STAGE_RESIDUAL) ||
+        !(v->frame_flags & 0x2000) || (v->frame_flags & 0x40000))
+        return 0;
+    if (!(v->frame_flags & 0x4000))
+        dirs |= BINK2_RES_VERTICAL;
+    if (!(v->frame_flags & 0x8000))
+        dirs |= BINK2_RES_HORIZONTAL;
+    return dirs;
+}
+
+unsigned bink2_filter_residual_word(int dc, int symbols)
+{
+    return (bink2_video_ac_class(symbols) << BINK2_INFO_CLASS_SHIFT) |
+           ((unsigned)dc & BINK2_INFO_DC_MASK);
+}
+
+/* The value of x in 16-bit two's complement. */
+static int wrap16(int x)
+{
+    x &= 0xFFFF;
+    return x >= 0x8000 ? x - 0x10000 : x;
+}
+
+/* The signed 13-bit DC of a word. */
+static int word_dc(unsigned w)
+{
+    int dc = (int)(w & BINK2_INFO_DC_MASK);
+
+    return dc >= 0x1000 ? dc - 0x2000 : dc;
+}
+
+void bink2_filter_residual_edge(int16_t *r2, int across, int along,
+                                unsigned wa, unsigned wb)
+{
+    int ca = (int)(wa >> BINK2_INFO_CLASS_SHIFT) & 3;
+    int cb = (int)(wb >> BINK2_INFO_CLASS_SHIFT) & 3;
+    int line;
+
+    if (ca == 0 && cb == 0)
+        return;
+    if (ca == 3 && cb == 3) {
+        int diff = word_dc(wa) - word_dc(wb);
+
+        if (diff >= -32 && diff <= 32)
+            return;
+    }
+    for (line = 0; line < 8; line++, r2 += along) {
+        int16_t *r0 = r2 - 2 * across;
+        int16_t *r1 = r2 - across;
+        int16_t *r3 = r2 + across;
+        int d = wrap16(*r2 - *r1);
+        int a = floor_div(wrap16(d + 4), 8);
+        int b = floor_div(wrap16(d + 2), 4);
+
+        /* a and b come from the line's original r1 and r2. */
+        if (ca >= 2)
+            *r0 = (int16_t)wrap16(*r0 + a);
+        if (ca >= 1)
+            *r1 = (int16_t)wrap16(*r1 + b);
+        if (cb >= 1)
+            *r2 = (int16_t)wrap16(*r2 - b);
+        if (cb >= 2)
+            *r3 = (int16_t)wrap16(*r3 - a);
+    }
+}
+
+void bink2_filter_residual(int16_t *res, int stride, int n,
+                           const unsigned *words, unsigned dirs)
+{
+    int bx, by;
+
+    /* Footprints within one direction never overlap, so only vertical
+     * before horizontal matters. */
+    if (dirs & BINK2_RES_VERTICAL)
+        for (by = 0; by < n; by++)
+            for (bx = 1; bx < n; bx++)
+                bink2_filter_residual_edge(res + (size_t)(8 * by) * stride +
+                                           8 * bx, 1, stride,
+                                           words[by * n + bx - 1],
+                                           words[by * n + bx]);
+    if (dirs & BINK2_RES_HORIZONTAL)
+        for (by = 1; by < n; by++)
+            for (bx = 0; bx < n; bx++)
+                bink2_filter_residual_edge(res + (size_t)(8 * by) * stride +
+                                           8 * bx, stride, 1,
+                                           words[(by - 1) * n + bx],
+                                           words[by * n + bx]);
+}
