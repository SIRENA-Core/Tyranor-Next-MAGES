+++ b/src/profile/games/sghd/optionsmenu.h
@@ -0,0 +1,85 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+#include "../../../spritesheet.h"
+#include "../../../util.h"
+
+// Options screen of the STEINS;GATE (Steam, 2016) generation of the MAGES. PC engine, described entirely by the
+// profile: every page, row, sprite and position is taken from the original Game.exe (see the sg-pc profile).
+namespace Impacto {
+namespace Profile {
+namespace SGHD {
+namespace OptionsMenu {
+
+enum class RowType { Toggle, Slider, Choice, Radio, Voice };
+
+struct Row {
+  RowType Type = RowType::Toggle;
+  // Engine setting the row edits (see UI::SGHD::OptionsMenu::GetValue)
+  std::string Setting;
+  int CharacterId = 0;  // Voice rows: index into ConfigSystem::VoiceVolume / VoiceMuted
+
+  RectF Underline{};  // drawn stretched while the row has the cursor
+  RectF HitArea{};    // mouse: hover = cursor, click = change, drag = slider value
+
+  // Toggle: value sprite at Position
+  glm::vec2 Position{};
+  Sprite TrueSprite;
+  Sprite FalseSprite;
+
+  // Slider / Voice: knob centre line and value range (values in the original's integer units)
+  float KnobX = 0.0f;
+  float KnobY = 0.0f;
+  float KnobRange = 0.0f;
+  float Min = 0.0f;
+  float Max = 1.0f;
+  float Step = 1.0f;  // per 1/60 s while left / right is held
+  RectF DragArea{};   // slider: value = (mouse x - DragArea.X - DragInset) / (DragArea.Width - 2 * DragInset)
+  float DragInset = 0.0f;
+
+  // Choice (one sprite moved to Positions[value]) / Radio (Sprite at Position, knob at Positions[value])
+  Sprite Sprite_;
+  std::vector<glm::vec2> Positions;
+  int FixedValue = 0;  // Choice / Radio rows that have no engine setting on this platform
+
+  // Voice: cursor frame and "voice on" mark
+  Sprite CursorSprite;
+  glm::vec2 CursorPosition{};
+  Sprite OnSprite;
+  glm::vec2 OnPosition{};
+  RectF ToggleArea{};
+};
+
+struct Page {
+  Sprite Paper;
+  glm::vec2 PaperPosition{};
+  Sprite Guide;
+  glm::vec2 GuidePosition{};
+  std::vector<Row> Rows;
+};
+
+struct Tab {
+  Sprite Normal;
+  Sprite Highlighted;
+  glm::vec2 Position{};
+  glm::vec2 CheckPosition{};
+  RectF HitArea{};
+};
+
+inline Sprite BackgroundSprite;
+inline Sprite UnderlineSprite;
+inline Sprite KnobSprite;
+inline Sprite TabCheckSprite;
+inline std::vector<Page> Pages;
+inline std::vector<Tab> Tabs;
+inline float PageSlideFrames = 32.0f;
+inline float PageSlideDistance = 1024.0f;
+
+void Configure();
+
+}  // namespace OptionsMenu
+}  // namespace SGHD
+}  // namespace Profile
+}  // namespace Impacto
