   auto drawType = EnsureGetMember<Game::DrawComponentType>("DrawType");
 
diff --git a/src/profile/games/mo6tw/systemmenu.h b/src/profile/games/mo6tw/systemmenu.h
index fbcafb1b1c0be316c0dd68d4dd49448e53488801..5c8c12a71add6a37058e207c0a9fe5c613eca731 100644
--- a/src/profile/games/mo6tw/systemmenu.h
+++ b/src/profile/games/mo6tw/systemmenu.h
@@ -13,6 +13,18 @@ inline Sprite SystemMenuBackgroundSprite;
 inline Sprite MenuEntriesHighlightedSprite;
 
 inline float MenuEntriesTargetWidth;
+
+// Optional, for menus like STEINS;GATE's (all absent = previous behaviour):
+// one label per entry, drawn behind the background at MenuEntriesLabelX and revealed from the right edge of its
+// sprite while the entry has focus (MenuEntriesLabelRevealDuration seconds for the full width);
+inline Sprite MenuEntriesLabelSprites[64];
+inline int MenuEntriesLabelNum = 0;
+inline float MenuEntriesLabelX = 0.0f;
+inline float MenuEntriesLabelRevealDuration = 0.0f;
+// the whole menu slides in from the left by this distance while SW_SYSMENUALPHA rises from 0 to 256;
