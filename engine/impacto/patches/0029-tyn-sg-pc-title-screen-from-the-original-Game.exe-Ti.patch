@@ -0,0 +1,57 @@
+#pragma once
+
+#include <random>
+#include <vector>
+
+#include "../../ui/menu.h"
+#include "../../profile/games/sghd/titlemenu.h"
+
+namespace Impacto {
+namespace UI {
+namespace SGHD {
+
+// Title screen of the STEINS;GATE (Steam) engine generation, as the original Game.exe draws and handles it
+// (SW_TITLEMODE 0 fade in, 1 press start, 2 press start chosen, 3 menu, 4 menu fading in, 5 menu under a screen opened
+// from the title). Press start is handled by the TitleMenu instruction; this class handles the menu: a main list
+// with sub lists, a chosen entry blinks before the script gets SW_TITLECUR1 and SF_TITLEEND. The script waits in
+// TitleMenu(Main) while a sub list is open or an entry blinks, so it does not see the presses meant for them.
+class TitleMenu : public Menu {
+ public:
+  TitleMenu();
+
+  void Show() override;
+  void Hide() override;
+  void Update(float dt) override;
+  void UpdateInput(float dt) override;
+  void Render() override;
+
+ private:
+  using SubList = Profile::SGHD::TitleMenu::SubList;
+
+  const SubList* SubListOf(int entry) const;
+  void Reset();
+  void StartDecide();
+  void UpdateFlicker(float frames);
+  void RenderFlicker(float alpha);
+  void RenderMenu(int alpha);
+
+  int Cursor = 0;              // main entry, -1 = none (mouse)
+  std::vector<int> SubCursor;  // per main entry, -1 = none (mouse)
+  float SubCounter = 0.0f;     // 0 closed .. SubOpenFrames open
+  int SubDirection = 0;        // 1 opening, -1 closing
+  float DecideCounter = 0.0f;  // > 0 while the chosen entry blinks
+  bool Decided = false;        // SF_TITLEEND raised, until the script resets it
+  float StartBlink = 0.0f;
+  float FrameClock = 0.0f;
+  int LastMode = -1;
+
+  std::mt19937 Rng{std::random_device{}()};
+  std::vector<float> FlickerTimers;
+  std::vector<bool> FlickerOn;
+  float BarTimer = 0.0f;
+  int BarChoice = 0;
+};
+
+}  // namespace SGHD
+}  // namespace UI
+}  // namespace Impacto
diff --git a/src/profile/games/sghd/titlemenu.cpp b/src/profile/games/sghd/titlemenu.cpp
new file mode 100644
