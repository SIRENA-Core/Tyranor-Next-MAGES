@@ -68,6 +69,15 @@ constexpr float Scale = 1.5f;  // 1280x720 units of the text routines -> 1920x10
 const SpriteSheet* SurfaceSheet(int surf) {
   auto surfIt = Renderer->SurfToId.find(surf);
   if (surfIt == Renderer->SurfToId.end()) {
+    // a file the engine keeps loaded itself (not a script handled sheet, e.g. DATA01 in surface 80): the script's
+    // load named it
+    auto loaderIt = SpriteLoader::Sprites.find(surf);
+    if (loaderIt != SpriteLoader::Sprites.end() && loaderIt->second->ArchiveId >= 0) {
+      const Io::AssetPath want = Io::AssetPathKey::KeyToAssetPath(
+          {.MountId = (uint32_t)loaderIt->second->ArchiveId, .Id = (uint32_t)loaderIt->second->FileId});
+      for (auto const& [name, sheet] : Profile::SpriteSheets)
+        if (!sheet.ScriptHandled && sheet.Path.Mount == want.Mount && sheet.Path.Id == want.Id) return &sheet;
+    }
     static bool empty[256] = {};
     if (surf >= 0 && surf < 256 && !empty[surf]) {
       empty[surf] = true;
