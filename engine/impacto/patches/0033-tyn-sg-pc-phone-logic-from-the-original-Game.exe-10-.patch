+// 0x4591e0 mode 5: a received mail
+void ModeReadInbox() {
+  const int mail = SW(0x6a5c);
+  if (Cancel()) {
+    if (MailBit(mail, 3) && !MailBit(mail, 2)) {
+      Finished();
+      return;
+    }
+    SetMode(3);
+    if (MouseMode()) SW(0x6a58) = 0xff;
+    return;
+  }
+  S.Hover = 0;
+  MailScroll(0, 0x6a78, 0x6a74);
+  if (!Decide()) {
+    MailScrollKeys(0x6a78, 0x6a74);
+    return;
+  }
+  if (MailBit(mail, 3) && !MailBit(mail, 2)) {
+    Finished();
+    return;
+  }
+  if (S.Mails[mail][MailAttach] == 999) {
+    if (!GetFlag(0xa29) || !MailBit(mail, 2) || MailBit(mail, 4) || S.Mails[mail][MailReply] == 999) {
+      SetMode(3);
+      if (MouseMode()) SW(0x6a58) = 0xff;
+      return;
+    }
+  }
+  SW(0x6a80) = MouseMode() ? 0xff : 0;
+  SetMode(0x13);
+}
