+// the order the quick saves are listed in (DAT_02ed0700): newest first, empty entries last
+void SortQuickSaves() {
+  int order[SaveSystem::MaxSaveEntries];
+  std::iota(order, order + SaveSystem::MaxSaveEntries, 0);
+  std::stable_sort(order, order + SaveSystem::MaxSaveEntries, [](int a, int b) {
+    const bool ua = FUN_00479360(2, a) == 1, ub = FUN_00479360(2, b) == 1;
+    if (ua != ub) return ua;
+    return ua && FUN_00479150(2, b, a);
+  });
+  for (int i = 0; i < SaveSystem::MaxSaveEntries; i++)
+    *reinterpret_cast<int32_t*>(Sg0Emu::At(0x02ed0700 + i * 4)) = order[i];
+}
+}  // namespace
+
+// 10:23 (0x485f10)
+void SaveMenuInstruction(Vm::Sc3VmThread* thread) {
+  thread->IpOffset += 2;
+  const uint8_t type = *thread->GetIp();
+  thread->IpOffset++;
+  if (type == 0 || type == 10) {
+    const uint8_t mode = *thread->GetIp();
+    thread->IpOffset++;
+    SortQuickSaves();
+    FUN_00455f90(mode);
+    // the click that opened the screen is not one on it (the original's update runs from the next frame)
+    ClearMouse();
+    Vm::Interface::PADinputButtonWentDown = 0;
+  } else if (type == 1) {
+    BridgeInput();
+    const int typeBefore = Sw(0x3a30);
+    Sw(0x3a30) = 0x7fff;
+    FUN_00456030();
+    // a chosen entry: the original's save types (1 save, 2 quick save) as the engine's (SaveType: 0 Full, 1 Quick)
+    Sw(0x3a30) = Sw(0x3a30) == 0x7fff ? typeBefore : (Sw(0x3a30) == 2 ? 1 : 0);
+    Vm::Interface::PADinputButtonWentDown = *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x01979f10));
+    ClearMouse();
+  }
+}
+
+}  // namespace Phone
+}  // namespace SG0
+}  // namespace Impacto
