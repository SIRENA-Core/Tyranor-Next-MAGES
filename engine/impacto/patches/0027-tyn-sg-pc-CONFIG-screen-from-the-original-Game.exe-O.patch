@@ -0,0 +1,117 @@
+-- STEINS;GATE (Steam) CONFIG screen, OptionsMenuType.SGHD. Everything below is taken from the original Game.exe:
+-- the page draw routines (page 0 basic / text 0x438ef0, page 1 sound 0x438240, page 2 character voices 0x438a60,
+-- common tabs 0x43b490; drawSprite 0x432230, stretched draw 0x432710), the input routine (0x439b00..) and the
+-- defaults (0x438030..). All art is on CONFIG.DDS (system.mpk id 5); its texts are part of the (localised) sheet.
+-- The game computes in 1280x720 units and draws at x1.5; values below are already in 1920x1080 units.
+--   * a background (0, 0, 1920 x 1080), per page a paper sheet (954 x 916) at (83, 95) and a button guide at (97, 987);
+--   * the focused row gets a red underline (sheet 1921.5, 1.5, 664.5 x 33, drawn stretched);
+--   * on / off values are text sprites 237 x 33 (sheet x 1921.5): y 156 yes, 192 no, 300 read only, 336 all,
+--     408 every scene;
+--   * slider knobs (2589, 1.5, 33 x 33): a half transparent one at the value the screen opened with, a solid one at
+--     the current value. Text speed 256..4096 (step 30 per frame), auto wait 256..2048 (step 14), volumes 0..128
+--     (step 1); knob x = (337 + (v - 256) * 240 / range) * 1.5 resp. (348 + v * 244 / 128) * 1.5;
+--   * page tabs at y 916, highlighted (+88 on the sheet) under the mouse, a check mark at (723 + 46 * page, 922);
+--   * pages slide sideways in 32 frames, 32 px per frame.
+-- Window mode and resolution have no meaning on this platform: they show the fixed state (full screen, 1920x1080).
+-- Row hit areas: the original's table (Game.exe .data, hit-area group 11); rows 3 / 4 of page 0 use the underline.
+
+root.SpriteSheets["Config"] = {
+    Path = { Mount = "system", Id = 5 },
+    DesignWidth = 3072,
+    DesignHeight = 2048
+};
+
+local function sprite(name, x, y, w, h)
+    root.Sprites[name] = { Sheet = "Config", Bounds = { X = x, Y = y, Width = w, Height = h } };
+    return name;
+end
+
+local yes = sprite("ConfigYes", 1921.5, 156, 237, 33);
+local no = sprite("ConfigNo", 1921.5, 192, 237, 33);
+local readOnly = sprite("ConfigReadOnly", 1921.5, 300, 237, 33);
+local all = sprite("ConfigAll", 1921.5, 336, 237, 33);
+local everyScene = sprite("ConfigEveryScene", 1921.5, 408, 237, 33);
+
+local function underline(x1, y1, x2, y2) return { X = x1, Y = y1, Width = x2 - x1, Height = y2 - y1 }; end
+
+local function toggle(setting, x, y, trueSprite, falseSprite, ul, hit)
+    return { Type = "Toggle", Setting = setting, Position = { X = x, Y = y }, TrueSprite = trueSprite,
+             FalseSprite = falseSprite, Underline = ul, HitArea = hit };
+end
+
+local function slider(setting, knobX, knobRange, knobY, min, max, step, ul, hit)
+    return { Type = "Slider", Setting = setting, KnobX = knobX, KnobRange = knobRange, KnobY = knobY, Min = min,
+             Max = max, Step = step, Underline = ul, HitArea = hit, DragArea = hit, DragInset = 16.5 };
+end
+
+-- page 0: basic / text settings
+local page0Rows = {
+    toggle("TriggerStopSkip", 766.5, 264, yes, no, underline(153, 279, 955.5, 312), { X = 153, Y = 263, Width = 742, Height = 33 }),
+    toggle("ShowTipsNotification", 766.5, 325.5, yes, no, underline(153, 340.5, 955.5, 373.5), { X = 153, Y = 324, Width = 742, Height = 33 }),
+    toggle("AutoQuickSaveScene", 766.5, 385.5, everyScene, no, underline(153, 402, 955.5, 435), { X = 153, Y = 384, Width = 742, Height = 33 }),
+    { Type = "Choice", Setting = "WindowMode", FixedValue = 1, Sprite = sprite("ConfigWindowModeFocus", 1930, 576, 224, 88),
+      Positions = { { X = 499, Y = 418 }, { X = 693, Y = 418 } },
+      Underline = underline(153, 462, 955.5, 495), HitArea = underline(153, 462, 955.5, 495) },
+    { Type = "Radio", Setting = "Resolution", FixedValue = 2, Sprite = sprite("ConfigResolution", 1930, 520, 394, 56),
+      Position = { X = 518, Y = 435 }, Positions = { { X = 563, Y = 502.5 }, { X = 693, Y = 502.5 }, { X = 824, Y = 502.5 } },
+      Underline = underline(153, 522, 955.5, 555), HitArea = underline(153, 522, 955.5, 555) },
+    slider("TextSpeed", 505.5, 360, 672, 256, 4096, 30, underline(153, 690, 967.5, 723), { X = 504, Y = 664, Width = 393, Height = 49 }),
+    slider("AutoSpeed", 505.5, 360, 727.5, 256, 2048, 14, underline(153, 744, 967.5, 777), { X = 504, Y = 719, Width = 393, Height = 49 }),
+    toggle("SkipAll", 766.5, 787.5, all, readOnly, underline(153, 805.5, 967.5, 838.5), { X = 153, Y = 789, Width = 742, Height = 33 }),
+};
+
+-- page 1: sound settings (voice, BGM, sound effects, movie volume, voice sync, skip voice)
+local page1Rows = {};
+local volumes = { "VoiceVolume", "BGMVolume", "SEVolume", "MovieVolume" };
+for i = 0, 3 do
+    page1Rows[#page1Rows + 1] = slider(volumes[i + 1], 522, 366, 262.5 + 60 * i, 0, 128, 1,
+        underline(153, 283.5 + 60 * i, 997.5, 316.5 + 60 * i), { X = 520, Y = 253 + 60 * i, Width = 399, Height = 49 });
+end
+page1Rows[#page1Rows + 1] = toggle("SyncVoice", 615, 502.5, yes, no, underline(153, 523.5, 997.5, 556.5), { X = 153, Y = 506, Width = 742, Height = 33 });
+page1Rows[#page1Rows + 1] = toggle("SkipVoice", 615, 562.5, yes, no, underline(153, 583.5, 997.5, 616.5), { X = 153, Y = 566, Width = 742, Height = 33 });
+
+-- page 2: character voices; row i edits the engine's (script mapped) character id below
+local characterIds = { 0, 1, 4, 3, 5, 2, 6, 7, 8, 9, 10, 11 };
+local page2Rows = {};
+for i = 0, 11 do
+    local y = (160 + 31 * i) * 1.5;
+    local hitY = 256 + 46.5 * i;
+    page2Rows[#page2Rows + 1] = {
+        Type = "Voice", CharacterId = characterIds[i + 1],
+        CursorSprite = sprite("ConfigVoiceCursor" .. i, 2265, 37.5, 66, 75), CursorPosition = { X = 159, Y = y },
+        OnSprite = sprite("ConfigVoiceOn" .. i, 2334, 37.5, 72, 75), OnPosition = { X = 156, Y = y },
+        KnobX = 526.5, KnobRange = 366, KnobY = (160 + 31 * i + 16) * 1.5, Min = 0, Max = 128, Step = 1,
+        Underline = underline(204, (160 + 31 * i + 29) * 1.5, 1011, (160 + 31 * i + 51) * 1.5),
+        HitArea = { X = 525, Y = hitY, Width = 399, Height = 49 }, DragArea = { X = 525, Y = hitY, Width = 399, Height = 49 },
+        DragInset = 16.5, ToggleArea = { X = 172, Y = hitY, Width = 40, Height = 40 }
+    };
+end
+
+root.OptionsMenu = {
+    Type = OptionsMenuType.SGHD,
+    DrawType = DrawComponentType.SystemMenu,
+    FadeInDuration = 16 / 60,
+    FadeOutDuration = 16 / 60,
+    BackgroundSprite = sprite("ConfigBackground", 0, 0, 1920, 1080),
+    UnderlineSprite = sprite("ConfigUnderline", 1921.5, 1.5, 664.5, 33),
+    KnobSprite = sprite("ConfigKnob", 2589, 1.5, 33, 33),
+    TabCheckSprite = sprite("ConfigTabCheck", 2154, 628, 64, 36),
+    PageSlideFrames = 32,
+    PageSlideDistance = 1024,
+    Pages = {
+        { PaperSprite = sprite("ConfigPaper0", 1, 1129, 954, 916), PaperPosition = { X = 83, Y = 95 },
+          GuideSprite = sprite("ConfigGuide0", 1361, 1081, 1038, 46), GuidePosition = { X = 97, Y = 987 }, Rows = page0Rows },
+        { PaperSprite = sprite("ConfigPaper1", 957, 1129, 954, 916), PaperPosition = { X = 83, Y = 95 },
+          GuideSprite = sprite("ConfigGuide1", 1361, 1081, 1038, 46), GuidePosition = { X = 97, Y = 987 }, Rows = page1Rows },
+        { PaperSprite = sprite("ConfigPaper2", 1913, 1129, 954, 916), PaperPosition = { X = 83, Y = 95 },
+          GuideSprite = sprite("ConfigGuide2", 1, 1081, 1358, 46), GuidePosition = { X = 97, Y = 987 }, Rows = page2Rows },
+    },
+    Tabs = {
+        { Sprite = sprite("ConfigTab0", 2154, 576, 60, 52), HighlightedSprite = sprite("ConfigTab0H", 2154, 664, 60, 52),
+          Position = { X = 721, Y = 916 }, CheckPosition = { X = 723, Y = 922 }, HitArea = { X = 721, Y = 916, Width = 60, Height = 52 } },
+        { Sprite = sprite("ConfigTab1", 2214, 576, 48, 52), HighlightedSprite = sprite("ConfigTab1H", 2214, 664, 48, 52),
+          Position = { X = 781, Y = 916 }, CheckPosition = { X = 769, Y = 922 }, HitArea = { X = 781, Y = 916, Width = 48, Height = 52 } },
+        { Sprite = sprite("ConfigTab2", 2262, 576, 62, 52), HighlightedSprite = sprite("ConfigTab2H", 2262, 664, 62, 52),
+          Position = { X = 829, Y = 916 }, CheckPosition = { X = 815, Y = 922 }, HitArea = { X = 829, Y = 916, Width = 62, Height = 52 } },
+    }
+};
