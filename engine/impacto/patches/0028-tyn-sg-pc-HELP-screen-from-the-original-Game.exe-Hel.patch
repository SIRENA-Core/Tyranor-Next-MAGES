--- /dev/null
+++ b/src/games/sghd/helpmenu.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include "../../ui/menu.h"
+
+namespace Impacto {
+namespace UI {
+namespace SGHD {
+
+// HELP screen of the STEINS;GATE (Steam) engine generation, as the original Game.exe draws and handles it: visible
+// while the script shows submenu 11 (SW_SYSSUBMENUNO, faded with SW_SYSSUBMENUCT and SW_SYSSUBMENUALPHA), Back raises
+// SF_SUBMENUEXIT, next / previous page (keys, wheel, tabs) slides the new page in over the old one. The pages are
+// preloaded, so the script's manual loading thread is never asked to load (see InstHelp).
+class HelpMenu : public Menu {
+ public:
+  void Show() override;
+  void Hide() override;
+  void Update(float dt) override;
+  void UpdateInput(float dt) override;
+  void Render() override;
+
+ private:
+  bool ScriptShown() const;
+  void ChangePage(int target, int direction);
+
+  int CurrentPage = 0;
+  int PreviousPage = 0;
+  int HoveredTab = -1;
+  float SlideCounter = 0.0f;    // PageSlideFrames .. 0
+  float SlideDirection = 0.0f;  // -1: new page from the left, 1: from the right
+  float BlinkCounter = 0.0f;
+};
+
+}  // namespace SGHD
+}  // namespace UI
+}  // namespace Impacto
