diff --git a/src/games/sghd/phone.cpp b/src/games/sghd/phone.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c20482ec0f837342710ae1a33031aaddfbafb015
--- /dev/null
+++ b/src/games/sghd/phone.cpp
@@ -0,0 +1,1800 @@
+#include "phone.h"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <ctime>
+
+#include "phonestate.h"
+#include "../../audio/audiosystem.h"
+#include "../../audio/audiochannel.h"
+#include "../../inputsystem.h"
+#include "../../log.h"
+#include "../../mem.h"
+#include "../../vm/expression.h"
+#include "../../vm/interface/input.h"
+#include "../../vm/thread.h"
+#include "../../vm/vm.h"
+
+namespace Impacto {
+namespace SGHD {
+namespace Phone {
+
+using namespace Impacto::Vm;
+using namespace Impacto::Vm::Interface;
+
+State S;
+
+// ------------------------------------------------------------------------------------------------ helpers
+
+namespace {
+
+// Input bits of the original (0x44ce30); the phone reads "went down" and "repeat" masks.
+constexpr uint32_t BtnDecide = 0x1000, BtnCancel = 0x2000, BtnUp = 0x10000, BtnDown = 0x20000,
+                   BtnLeft = 0x40000, BtnRight = 0x80000;
+uint32_t InDown = 0, InRepeat = 0;
+void ReadInput() {
+  InDown = InRepeat = 0;
+  const uint32_t wentDown = PADinputButtonWentDown | PADinputMouseWentDown,
+                 repeat = PADinputButtonRepeatDown | PADinputButtonWentDown;
+  auto map = [](uint32_t pad, uint32_t& out) {
+    if (pad & PAD1A) out |= BtnDecide;
+    if (pad & PAD1B) out |= BtnCancel;
+    if (pad & PAD1UP) out |= BtnUp;
+    if (pad & PAD1DOWN) out |= BtnDown;
+    if (pad & PAD1LEFT) out |= BtnLeft;
+    if (pad & PAD1RIGHT) out |= BtnRight;
+  };
+  map(wentDown, InDown);
+  map(repeat, InRepeat);
+}
+
+bool Decide() { return InDown & BtnDecide; }
+bool Cancel() { return InDown & BtnCancel; }
+bool Up() { return InRepeat & BtnUp; }
+bool Down() { return InRepeat & BtnDown; }
+bool Left() { return InRepeat & BtnLeft; }
+bool Right() { return InRepeat & BtnRight; }
+void ClickDecide() { InDown |= BtnDecide; }
+
+}  // namespace
+
+// Mouse mode of the original: no keyboard cursor, the entries follow the pointer. The phone hit areas are not
+// implemented yet, so the phone is always driven like with a pad (the host's on-screen keys provide the buttons).
+bool MouseMode() { return false; }
+bool Hit(int /*id*/, int /*kind*/) { return false; }
+
+void PlaySe(int id) { Audio::PlayInGroup(Audio::ACG_SE, "se", id, false, 0.0f); }
+
+void Achievement(int /*id*/) {}  // Steam achievements (0x45c790, 0x45c7b0)
+
+// Background music requests of the mail attachments (DAT_026da670.. in the original).
+void PlayBgm(uint32_t id, bool loop) {
+  if (id == 0xffffffff) {
+    Audio::Channels[Audio::AC_BGM0]->Stop(0.0f);
+    return;
+  }
+  Audio::Channels[Audio::AC_BGM0]->Play("bgm", id, loop, 0.0f);
+}
+bool BgmPlaying(uint32_t /*id*/) { return Audio::Channels[Audio::AC_BGM0]->GetState() == Audio::ACS_Playing; }
+
+const uint8_t* ScriptString(uint32_t strNo) {
+  return &ScriptBuffers[S.ScriptBuffer][ScriptGetStrAddress(S.ScriptBuffer, strNo)];
+}
+
+// Number of lines of a script string wrapped to width (0x442790). Approximation until the phone text layout is in:
+// one em per character, explicit line breaks counted.
+int LineCount(uint32_t strNo, int width, int size) {
+  const uint8_t* p = ScriptString(strNo);
+  int lines = 1, x = 0;
+  while (*p != 0xff) {
+    const uint8_t b = *p;
+    if (b == 0x00) {  // line break
+      lines++;
+      x = 0;
+      p++;
+    } else if (b < 0x80) {  // other tags: skip the tag byte (their operands are rare in mails)
+      p++;
+    } else {
+      x += size;
+      if (x > width) {
+        lines++;
+        x = size;
+      }
+      p += 2;
+    }
+  }
+  return x == 0 && lines > 1 ? lines - 1 : lines;
+}
+
+// Mail state bit (mail * 5 + bit) in the saved bit field and in the byte mirror.
+void SetMailBit(int mail, int bit, bool value) {
+  const uint32_t i = mail * 5 + bit;
+  S.MailState[i] = value;
+  if (value)
+    S.Bits[i >> 3] |= 1 << (i & 7);
+  else
+    S.Bits[i >> 3] &= ~(1 << (i & 7));
+}
+bool MailBit(int mail, int bit) { return S.MailState[mail * 5 + bit] != 0; }
+
+bool ContactBit(int contact) {
+  const uint32_t i = contact + 0xdac;
+  return (S.Bits[i >> 3] >> (i & 7)) & 1;
+}
+void SetContactBit(int contact, bool value) {
+  const uint32_t i = contact + 0xdac;
+  if (value)
+    S.Bits[i >> 3] |= 1 << (i & 7);
+  else
+    S.Bits[i >> 3] &= ~(1 << (i & 7));
+}
+
+// Lines of a mail (header + text), for the scroll range (as in 0x457ca0 and others).
+uint32_t MailLines(int mail) {
+  int n = LineCount(S.Mails[mail][MailText] + 2, 0x116, 0x18) + 2;
+  int t = LineCount(S.Mails[mail][MailText], 0xfe, 0x18);
+  return n + (t == 0 ? 1 : t);
+}
+
+// ------------------------------------------------------------------------------------------------ data
+
+// 0x45bcf0 (10:37:04): the mail table and the attachment, ringtone and wallpaper tables from six script labels.
+void MailInit(int scriptBufferId, const uint16_t* mails, uint16_t strA, uint16_t strB, const uint16_t* attach,
+              const uint16_t* ringtones, const uint16_t* wallpapers) {
+  S.ScriptBuffer = scriptBufferId;
+  S.StrBaseA = strA;
+  S.StrBaseB = strB;
+  S.MailCount = 0;
+  while (mails[0] != 0xff && S.MailCount < MaxMails) {
+    auto& m = S.Mails[S.MailCount++];
+    m[MailKind] = mails[0];
+    m[MailDateHi] = mails[1];
+    m[MailDateLo] = mails[2];
+    m[MailAttach] = mails[3];
+    for (int i = 0; i < 8; i++) m[MailReply + i] = mails[4 + i];
+    m[MailText] = mails[12];
+    mails += 15;
+  }
+  S.AttachCount = 0;
+  for (; attach[0] != 0xff && S.AttachCount < MaxAttach; attach += 2) {
+    auto& a = S.Attach[S.AttachCount];
+    a.fill(0);
+    a[0] = attach[0];
+    a[1] = attach[1];
+    const uint16_t* d = (const uint16_t*)&ScriptBuffers[scriptBufferId][ScriptGetLabelAddress(scriptBufferId, attach[1])];
+    if (a[0] == 1 || a[0] == 5 || a[0] == 2) {
+      const int last = a[0] == 2 ? 7 : 12;
+      for (int i = 2; i < last; i++) {
+        a[i] = d[i - 2];
+        if (d[i - 2] == 0xff) break;
+      }
+    } else if (a[0] == 3) {
+      for (int i = 0; i < 5; i++) {  // (entry, value, flag) triples
+        a[2 + i * 3] = d[i * 3];
+        if (d[i * 3] == 0xff) break;
+        a[3 + i * 3] = d[i * 3 + 1];
+        a[4 + i * 3] = d[i * 3 + 2];
+      }
+    }
+    S.AttachCount++;
+  }
+  S.RingtoneCount = 0;
+  for (; ringtones[0] != 0xffff && S.RingtoneCount < MaxRingtones; ringtones += 4) {
+    for (int i = 0; i < 4; i++) S.Ringtones[S.RingtoneCount][i] = ringtones[i];
+    S.RingtoneCount++;
+  }
+  S.WallpaperCount = 0;
+  for (; wallpapers[0] != 0xffff && S.WallpaperCount < MaxWallpapers; wallpapers += 3) {
+    for (int i = 0; i < 3; i++) S.Wallpapers[S.WallpaperCount][i] = wallpapers[i];
+    S.WallpaperCount++;
+  }
+}
+
+// 0x459f60: ringtones and wallpapers that are unlocked (no flag or the flag set).
+void BuildUnlocked() {
+  S.RingtoneListCount = 0;
+  for (uint32_t i = 0; i < S.RingtoneCount; i++)
+    if (S.Ringtones[i][3] == 0 || GetFlag(S.Ringtones[i][3])) S.RingtoneList[S.RingtoneListCount++] = i;
+  S.WallpaperListCount = 0;
+  for (uint32_t i = 0; i < S.WallpaperCount; i++)
+    if (S.Wallpapers[i][2] == 0 || GetFlag(S.Wallpapers[i][2])) S.WallpaperList[S.WallpaperListCount++] = i;
+}
+
+bool MailNewer(uint32_t a, uint32_t b) {  // sort key of 0x4544e0 (date, time), newest first
+  return S.Mails[a][MailDateHi] > S.Mails[b][MailDateHi] ||
+         (S.Mails[a][MailDateHi] == S.Mails[b][MailDateHi] && S.Mails[a][MailDateLo] > S.Mails[b][MailDateLo]);
+}
+
+// 0x4544e0 (10:37:05): inbox / sent lists, address book, who can be called / mailed.
+void BuildLists() {
+  SW(0x2eec) = SW(0x1f68);
+  S.SentCount = S.InboxCount = 0;
+  bool allRead = true;
+  for (uint32_t i = 0; i < S.MailCount; i++) {
+    if (!MailBit(i, 0)) continue;
+    if ((S.Mails[i][MailKind] & 1) == 0) {
+      if (!MailBit(i, 1)) allRead = false;
+      S.Inbox[S.InboxCount++] = i;
+    } else {
+      S.Sent[S.SentCount++] = i;
+    }
+  }
+  SetFlag(0xa3b, allRead);
+  std::stable_sort(S.Inbox.begin(), S.Inbox.begin() + S.InboxCount, MailNewer);
+  std::stable_sort(S.Sent.begin(), S.Sent.begin() + S.SentCount, MailNewer);
+  SW(0x6a60) = S.SentCount;
+  SW(0x6a64) = S.InboxCount;
+
+  S.ContactCount = 0;
+  for (uint32_t c = 0; c < MaxContacts; c++)
+    if (ContactBit(c)) S.Contacts[S.ContactCount++] = c;
+  std::stable_sort(S.Contacts.begin(), S.Contacts.begin() + S.ContactCount,
+                   [](uint32_t a, uint32_t b) { return S.ContactOrder[a] < S.ContactOrder[b]; });
+  SW(0x6a90) = S.ContactCount;
+
+  // the four bytes of GlobalVars[6830] / [6848] name the contacts that can be called / mailed (0x459ca0)
+  S.CanCall.fill(0);
+  S.CanMail.fill(0);
+  for (int i = 0; i < 4; i++) {
+    const uint32_t a = (SW(0x6ab8) >> (i * 8)) & 0xff, b = (SW(0x6b00) >> (i * 8)) & 0xff;
+    if (a < MaxContacts) S.CanCall[a] = 1;
+    if (b < MaxContacts) S.CanMail[b] = 1;
+  }
+  BuildUnlocked();
+}
+
+// 0x45b9a0: answered mail
+void MarkReplied(int mail) {
+  for (uint32_t i = 0; i < S.InboxCount; i++)
+    if (S.Inbox[i] == (uint32_t)mail) {
+      SetMailBit(mail, 4, true);
+      return;
+    }
+}
+
+// 0x44d460: a sent mail goes to the top of the sent list
+void PushSent(int mail) {
+  for (uint32_t i = S.SentCount; i > 0; i--) S.Sent[i] = S.Sent[i - 1];
+  S.Sent[0] = mail;
+  S.SentCount++;
+}
+
+// 0x44d850: is there an unread mail in the inbox?
+void CheckUnread() {
+  S.HasUnread = 0;
+  for (uint32_t i = 0; i < S.MailCount; i++)
+    if ((S.Mails[i][MailKind] & 1) == 0 && MailBit(i, 0) && !MailBit(i, 1)) {
+      S.HasUnread = 1;
+      return;
+    }
+}
+
+void ClearLinkHitAreas() { S.LinkAreaCount = 0; }  // 0x45a950
+
+// ------------------------------------------------------------------------------------------------ modes
+
+namespace {
+
+void SetMode(int mode) { SW(0x6a48) = mode; }
+
+void MailEnterRead(int mail) {  // shared by the inbox and sent lists
+  SW(0x6a74) = 0;
+  SW(0x6a78) = MailLines(mail);
+}
+
+// 0x4548d0 mode 0: home screen
+void ModeHome() {
+  S.Hover = 0;
+  if (MouseMode() && Hit(0, 8)) ClickDecide();
+  if (Cancel()) {
+    SetFlag(0xa30, 1);
+    SetFlag(0xa31, 1);
+    return;
+  }
+  if (!Decide()) return;
+  if (GetFlag(0xa2d)) {
+    SetFlag(0xa2f, 1);
+    SetFlag(0xa33, 1);
+    SetFlag(0xa31, 1);
+    return;
+  }
+  if (!GetFlag(0xa2c)) {
+    SetMode(0x14);
+    SW(0x6a70) = 0;
+    if (GetFlag(0xa3c) && GetFlag(800) && (GetFlag(0xa2b) || GetFlag(0xa2a))) SW(0x6a70) = 1;
+    if (MouseMode()) SW(0x6a70) = 0xff;
+    SW(0x6a7c) = 0;
+    return;
+  }
+  // a new mail arrived: straight into the inbox
+  SetFlag(0xa2c, 0);
+  SetFlag(0x643, 1);
+  S.Unk_eb994 = 0;
+  PlaySe(0x9c);
+  SetMode(3);
+  SW(0x6a54) = 0;
+  SW(0x6a58) = 0;
+  SW(0x6a4c) = 0;
+  if (MailBit(S.Inbox[SW(0x6a58) + SW(0x6a54) * 12], 1)) SW(0x6a58) = 1;
+  if (MouseMode()) SW(0x6a58) = 0xff;
+}
+
+// 0x455ae0 mode 1: mail menu (inbox / sent)
+void ModeMailMenu() {
+  if (Cancel()) {
+    SW(0x6a70) = 0;
+    SetMode(0x14);
+    return;
+  }
+  S.Hover = 0;
+  if (MouseMode()) {
+    SW(0x6a4c) = 0xff;
+    for (int i = 0; i < 2; i++)
+      if (Hit(i + 5, 1)) S.Hover = 1, SW(0x6a4c) = i;
+    for (int i = 0; i < 2; i++)
+      if (Hit(i + 5, 8)) ClickDecide();
+  }
+  if (!Decide()) {
+    if (Up()) SW(0x6a4c) = SW(0x6a4c) == 0xff ? 0 : SW(0x6a4c) ^ 1;
+    if (Down()) SW(0x6a4c) = SW(0x6a4c) == 0xff ? 0 : SW(0x6a4c) ^ 1;
+  } else if (SW(0x6a4c) != 0xff) {
+    SW(0x6a54) = 0;
+    SW(0x6a58) = 0;
+    if (SW(0x6a4c) == 0) {
+      SetMode(3);
+    } else {
+      SetMode(2);
+      Achievement(0x18);
+    }
+    if (MouseMode()) SW(0x6a58) = 0xff;
+  }
+}
+
+// paging of a 12 entry list (shared by 0x457ca0 and 0x4587f0)
+void ListPrevPage() { SW(0x6a54) = SW(0x6a54) == 0 ? SW(0x6a50) : SW(0x6a54) - 1; }
+void ListNextPage() {
+  if ((uint32_t)SW(0x6a54) < (uint32_t)SW(0x6a50))
+    SW(0x6a54)++;
+  else
+    SW(0x6a54) = 0;
+}
+
+void ListMouse(uint32_t count) {
+  SW(0x6a58) = 0xff;
+  S.ArrowHover = 0;
+  if (Hit(0, 0x200)) ListPrevPage();
+  if (Hit(0, 0x400)) ListNextPage();
+  if (Hit(0x18, 1)) S.Hover = 1, S.ArrowHover = 1;
+  if (Hit(0x19, 1)) S.Hover = 1, S.ArrowHover = 2;
+  if (Hit(0x18, 8)) ListPrevPage();
+  if (Hit(0x19, 8)) ListNextPage();
+  for (uint32_t i = 0; i < 12; i++)
+    if (Hit(i + 0xc, 1) && i + SW(0x6a54) * 12 < count) S.Hover = 1, SW(0x6a58) = i;
+  for (uint32_t i = 0; i < 12; i++)
+    if (Hit(i + 0xc, 8) && i + SW(0x6a54) * 12 < count) ClickDecide();
+}
+
+// keyboard movement in a 12 entry list (0x457ca0 / 0x4587f0)
+void ListKeys(uint32_t count, bool resetRowOnDownWrap) {
+  if (Up()) {
+    const int row = SW(0x6a58);
+    if (row == 0xff) {
+      SW(0x6a58) = 0;
+    } else if (row == 0) {
+      if (SW(0x6a54) == 0) {
+        SW(0x6a54) = SW(0x6a50);
+        SW(0x6a58) = count - SW(0x6a54) * 12 - 1;
+      } else {
+        SW(0x6a54)--;
+        SW(0x6a58) = 0xb;
+      }
+    } else {
+      SW(0x6a58) = row - 1;
+    }
+  }
+  if (Down()) {
+    const uint32_t row = SW(0x6a58);
+    if (row == 0xff) {
+      SW(0x6a58) = 0;
+    } else if (row < 0xb && row + SW(0x6a54) * 12 < count - 1) {
+      SW(0x6a58) = row + 1;
+    } else {
+      ListNextPage();
+      SW(0x6a58) = 0;
+    }
+  }
+  (void)resetRowOnDownWrap;
+  if (Left()) {
+    SW(0x6a58) = 0;
+    ListPrevPage();
+  }
+  if (Right()) {
+    SW(0x6a58) = 0;
+    ListNextPage();
+  }
+}
+
+// 0x457ca0 mode 2: sent mails
+void ModeSentList() {
+  if (S.SentCount == 0) {
+    if (Cancel()) {
+      SetMode(1);
+      if (MouseMode()) SW(0x6a4c) = 0xff;
+    }
+    if (!Decide()) return;
+    SetMode(1);
+    if (MouseMode()) SW(0x6a4c) = 0xff;
+    return;
+  }
+  SW(0x6a50) = (S.SentCount - 1) / 12;
+  if (Cancel()) {
+    SetMode(1);
+    if (MouseMode()) SW(0x6a4c) = 0xff;
+    return;
+  }
+  S.Hover = 0;
+  if (MouseMode()) ListMouse(S.SentCount);
+  if (Decide()) {
+    if (SW(0x6a58) == 0xff) return;
+    MailEnterRead(SW(0x6a5c));
+    SetMode(4);
+    return;
+  }
+  ListKeys(S.SentCount, true);
+  if (SW(0x6a58) == 0xff) return;
+  SW(0x6a5c) = S.Sent[SW(0x6a58) + SW(0x6a54) * 12];
+}
