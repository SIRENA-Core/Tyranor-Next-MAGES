+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace Impacto {
+namespace SGHD {
+namespace Phone {
+
+constexpr uint32_t Red = 0xff1111;  // highlighted text of the phone
+
+// phone.cpp
+bool MailBit(int mail, int bit);
+
+// phonerender.cpp: drawing helpers (destinations in the original's 1280x720 units, sources in texture pixels)
+int PhoneSurface();
+void Spr(int surf, float sx, float sy, float w, float h, float dx, float dy, int alpha, uint32_t rgb = 0xffffff);
+void SprStretch(int surf, float sx, float sy, float w, float h, float x0, float y0, float x1, float y1, int alpha);
+void Rect(float x, float y, float w, float h, uint32_t rgb, int alpha);
+void Text(int x, int y, int maxWidth, const uint8_t* str, int skip, int lines, uint32_t color, int size, int alpha);
+void TextLinks(int x, int y, int maxWidth, const uint8_t* str, int skip, int lines, int size, int alpha, int sel);
+void TextAscii(int x, int y, const std::string& str, uint32_t color, int size, int alpha);
+int TextWidth(const uint8_t* str, int size);
+int LineCountOf(const uint8_t* str, int maxWidth, int size);
+const uint8_t* Str(uint32_t strNo);
+std::string Num2(uint32_t v);
+void DrawStatusBar(int x, int y, int alpha);
+void DrawMark(int kind, int x, int y, int alpha);
+void DrawWallpaper(int x, int y, int alpha);
+void DrawTitleBar(int which, int x, int y, int alpha);
+void DrawPanel(int strOffset, int x, int y, uint32_t color, int alpha);
+void DrawChoice(int str0, int str1, int sel, int x, int y, int alpha);
+void DrawMainMenu(int x, int y, int alpha);
+
+// the remaining screens (phonescreens.cpp)
+void DrawMoreScreens(int mode, int x, int y, int alpha);
+void DrawMailWithLinks(int titleBar, int mail, int top, int count, float subjectIcon, bool links, int linkSel, int x,
+                       int y, int alpha);
+void DrawDotsRing(int x, int y, int alpha);  // 0x453e60
+void DrawRemainingScreens(int mode, int x, int y, int alpha);  // phonescreens2.cpp
+void DrawLastScreens(int mode, int x, int y, int alpha);       // phonescreens3.cpp
+
+void RenderPhone();
