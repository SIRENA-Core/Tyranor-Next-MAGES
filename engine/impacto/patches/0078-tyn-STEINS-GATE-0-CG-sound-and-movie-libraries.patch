+void LibraryInstruction(Vm::Sc3VmThread* thread, int opcode) {
+  thread->IpOffset += 2;
+  const uint8_t type = *thread->GetIp();
+  thread->IpOffset++;
+  const bool update = type == 1;
+  if (update) BridgeInput();
+  switch (opcode) {
+    case 0x1f:
+      if (type == 0) {
+        FUN_0042a4f0();
+        FUN_0042c530();
+      } else if (type == 1) {
+        FUN_0042c630();
+      } else if (type == 3) {
+        FUN_0042e2b0();
+      }
+      break;
+    case 0x1d:
+      if (type == 0) FUN_0042d220();
+      else if (type == 1) FUN_0042d3c0();
+      break;
+    case 0x20:
+      if (type == 0) FUN_0042cda0();
+      else if (type == 1) FUN_0042ce10();
+      break;
+  }
+  BridgeLibraryAudio();
+  if (update) {
+    Vm::Interface::PADinputButtonWentDown = *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x01979f10));
+    ClearMouse();
+  }
+}
