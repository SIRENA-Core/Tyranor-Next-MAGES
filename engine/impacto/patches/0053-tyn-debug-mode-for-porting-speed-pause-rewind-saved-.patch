+#pragma once
+
+// Porting tools of the debug mode (UserConfig CommonSettings.DebugMode, or the DebugMenu game feature): game speed,
+// pause and single steps, automatic snapshots for rewinding, saved states, jumps of a script thread to any label of
+// any script, skip of everything, unlocks. Shown as the "Porting" tab of the debug menu; on touch screens three
+// fingers at once open the menu.
+
+#include <cstdint>
+#include <string>
+
+union SDL_Event;
+
+namespace Impacto {
+namespace DebugTools {
+
+bool Enabled();
+// the debug menu asks to be opened (gesture)
+bool OpenRequested();
+
+// SDL events, before the game sees them (the three finger gesture). True: a touch on a debug window, which the
+// game must not see (ImGui's own capture test lags one frame behind on touch screens). The fingers of the three
+// finger gesture that the game already saw go down are lifted as canceled, so the gesture is no tap for it.
+bool HandleEvent(SDL_Event& e);
+
+// game logic ticks to run this frame: 0 while paused (unless a step was asked for), the speed otherwise
+int TicksThisFrame();
+// before every extra tick of a frame: the input of the frame only counts once
+void BeforeExtraTick();
+// right before the VM runs in a logic tick (after the game's own skip check): the forced skip
+void BeforeVmUpdate();
+// after every logic tick: pending restores and jumps
+void AfterTick();
+// the text and animations that run on frame time follow the speed
+float ScaleFrameTime(float dt);
+
+// a checkpoint of the main script thread (a new line about to show, id = its line number in the script): the
+// automatic rewind snapshots
+void OnCheckpoint(int id);
+// a checkpoint comes in the middle of an instruction (a message, a choice, an autosave point); the VM calls this
+// once that instruction is done, with the offset it started at. The snapshot points the thread back there: a
+// restore runs the checkpoint instruction again (shows the line again, sets the choices up again).
+inline bool SnapshotPending = false;
+void TakePendingSnapshot(int thread, uint32_t instructionStart);
+
+// the "Porting" tab of the debug menu, and a small status line over the game
+void ShowTab();
+void ShowStatus();
+// the names of the tab and of its window, in the language chosen in the tab (ids stay the same)
+const char* PortingTitle();
+const char* PortingWindowTitle();
+
+}  // namespace DebugTools
+}  // namespace Impacto
