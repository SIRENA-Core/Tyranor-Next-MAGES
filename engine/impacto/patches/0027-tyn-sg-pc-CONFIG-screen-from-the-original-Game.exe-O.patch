diff --git a/src/games/sghd/optionsmenu.cpp b/src/games/sghd/optionsmenu.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9abdddeed150190e3f5905675c6af236973c5f63
--- /dev/null
+++ b/src/games/sghd/optionsmenu.cpp
@@ -0,0 +1,360 @@
+#include "optionsmenu.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "../../renderer/renderer.h"
+#include "../../mem.h"
+#include "../../inputsystem.h"
+#include "../../audio/audiosystem.h"
+#include "../../profile/scriptvars.h"
+#include "../../profile/configsystem.h"
+#include "../../vm/interface/input.h"
+#include "../../ui/ui.h"
+#include "../../data/savesystem.h"
+
+namespace Impacto {
+namespace UI {
+namespace SGHD {
+
+using namespace Impacto::Profile::SGHD::OptionsMenu;
+using namespace Impacto::Profile::ScriptVars;
+using namespace Impacto::Vm::Interface;
+namespace Cfg = Impacto::Profile::ConfigSystem;
+namespace Layout = Impacto::Profile::SGHD::OptionsMenu;
+
+namespace {
+
+constexpr int SubMenuOptions = 5;
+
+void DrawStretched(const Sprite& sprite, const RectF& dest, glm::vec4 col) {
+  Renderer->DrawSprite(sprite, dest, col);
+}
+
+}  // namespace
+
+OptionsMenu::OptionsMenu() : UI::OptionsMenu() {
+  Cursor.assign(Layout::Pages.size(), 0);
+  OpenValues.resize(Layout::Pages.size());
+  for (size_t p = 0; p < Layout::Pages.size(); p++) OpenValues[p].assign(Layout::Pages[p].Rows.size(), 0.0f);
+}
+
+// ---------------------------------------------------------------- settings
+
+float OptionsMenu::GetValue(const Row& row) const {
+  const std::string& s = row.Setting;
+  if (row.Type == RowType::Voice) return Cfg::VoiceVolume[row.CharacterId] * 128.0f;
+  if (s == "TriggerStopSkip") return Cfg::TriggerStopSkip;
+  if (s == "ShowTipsNotification") return Cfg::ShowTipsNotification;
+  if (s == "AutoQuickSaveScene")
+    return (Cfg::AutoQuickSave & +Cfg::AutoQuickSaveType::OnScene) != 0;
+  if (s == "SkipAll") return !Cfg::SkipRead;
+  if (s == "SyncVoice") return Cfg::SyncVoice;
+  if (s == "SkipVoice") return Cfg::SkipVoice;
+  if (s == "TextSpeed") return Cfg::TextSpeed * 60.0f;
+  if (s == "AutoSpeed") return Cfg::AutoSpeed * 60.0f;
+  if (s == "VoiceVolume") return Audio::GroupVolumes[Audio::ACG_Voice] * 128.0f;
+  if (s == "BGMVolume") return Audio::GroupVolumes[Audio::ACG_BGM] * 128.0f;
+  if (s == "SEVolume") return Audio::GroupVolumes[Audio::ACG_SE] * 128.0f;
+  if (s == "MovieVolume") return Audio::GroupVolumes[Audio::ACG_Movie] * 128.0f;
+  return (float)row.FixedValue;
+}
+
+void OptionsMenu::SetValue(const Row& row, float value) {
+  value = std::clamp(value, row.Min, row.Max);
+  const std::string& s = row.Setting;
+  if (row.Type == RowType::Voice) {
+    Cfg::VoiceVolume[row.CharacterId] = value / 128.0f;
+    return;
+  }
+  const bool b = value != 0.0f;
+  if (s == "TriggerStopSkip") Cfg::TriggerStopSkip = b;
+  else if (s == "ShowTipsNotification") Cfg::ShowTipsNotification = b;
+  else if (s == "AutoQuickSaveScene")
+    Cfg::AutoQuickSave = b ? (Cfg::AutoQuickSave | +Cfg::AutoQuickSaveType::OnScene) : 0;
+  else if (s == "SkipAll") Cfg::SkipRead = !b;
+  else if (s == "SyncVoice") Cfg::SyncVoice = b;
+  else if (s == "SkipVoice") Cfg::SkipVoice = b;
+  else if (s == "TextSpeed") Cfg::TextSpeed = value / 60.0f;
+  else if (s == "AutoSpeed") Cfg::AutoSpeed = value / 60.0f;
+  else if (s == "VoiceVolume") Audio::GroupVolumes[Audio::ACG_Voice] = value / 128.0f;
+  else if (s == "BGMVolume") Audio::GroupVolumes[Audio::ACG_BGM] = value / 128.0f;
+  else if (s == "SEVolume") Audio::GroupVolumes[Audio::ACG_SE] = value / 128.0f;
+  else if (s == "MovieVolume") Audio::GroupVolumes[Audio::ACG_Movie] = value / 128.0f;
+  // rows without an engine setting (window mode, resolution) keep their fixed value
+}
+
+bool OptionsMenu::GetVoiceOn(const Row& row) const { return !Cfg::VoiceMuted[row.CharacterId]; }
+void OptionsMenu::SetVoiceOn(const Row& row, bool on) { Cfg::VoiceMuted[row.CharacterId] = !on; }
+
+void OptionsMenu::UpdateValues() {
+  for (size_t p = 0; p < Layout::Pages.size(); p++)
+    for (size_t r = 0; r < Layout::Pages[p].Rows.size(); r++) OpenValues[p][r] = GetValue(Layout::Pages[p].Rows[r]);
+}
+
+// ---------------------------------------------------------------- visibility
+
+int OptionsMenu::ScriptAlpha() const {
+  if (ScrWork[SW_SYSSUBMENUNO] != SubMenuOptions && ScrWork[SW_OPTIONALPHA] == 0) return 0;
+  return std::clamp(ScrWork[SW_SYSSUBMENUALPHA], 0, 256);
+}
+
+void OptionsMenu::Show() {
+  if (State == Shown || State == Showing) return;
+  State = Shown;
+  CurrentPage = 0;
+  TargetPage = 0;
+  SlideCounter = 0.0f;
+  // as the original in mouse mode: no row has the cursor until a direction key or the mouse picks one
+  std::fill(Cursor.begin(), Cursor.end(), -1);
+  UpdateValues();
+  if (UI::FocusedMenu != nullptr) {
+    LastFocusedMenu = UI::FocusedMenu;
+    LastFocusedMenu->IsFocused = false;
+  }
+  IsFocused = true;
+  UI::FocusedMenu = this;
+}
+
+void OptionsMenu::Hide() {
+  if (State == Hidden) return;
+  State = Hidden;
+  DraggedRow = -1;
+  if (LastFocusedMenu != nullptr) {
+    UI::FocusedMenu = LastFocusedMenu;
+    LastFocusedMenu->IsFocused = true;
+  } else {
+    UI::FocusedMenu = nullptr;
+  }
+  IsFocused = false;
+}
+
+void OptionsMenu::UpdateVisibility() {
+  const int alpha = ScriptAlpha();
+  if (alpha > 0 && State == Hidden) Show();
+  if (alpha == 0 && State != Hidden) Hide();
+  // keep the menu focus while shown (the title menu re-takes it every frame when it is shown under this screen)
+  if (State == Shown && UI::FocusedMenu != this) {
+    if (UI::FocusedMenu != nullptr && UI::FocusedMenu != LastFocusedMenu) {
+      LastFocusedMenu = UI::FocusedMenu;
+      LastFocusedMenu->IsFocused = false;
+    }
+    UI::FocusedMenu = this;
+    IsFocused = true;
+  }
+}
+
+void OptionsMenu::Update(float dt) {
+  UpdateVisibility();
+  if (SlideCounter != 0.0f) {
+    const float frames = dt * 60.0f;
+    SlideCounter += SlideCounter > 0.0f ? frames : -frames;
+    if (std::abs(SlideCounter) >= PageSlideFrames) {
+      CurrentPage = TargetPage;
+      SlideCounter = 0.0f;
+    }
+  }
+  // As in the original the screen owns the input while it is fully shown (the title menu keeps the engine's menu
+  // focus when CONFIG is opened from the title, so do not depend on it).
+  if (State == Shown && ScriptAlpha() == 256 && !GetFlag(SF_SUBMENUEXIT)) UpdateInput(dt);
+}
+
+// ---------------------------------------------------------------- input
+
+void OptionsMenu::ChangePage(int target, int direction) {
+  if (SlideCounter != 0.0f || target == (int)CurrentPage) return;
+  TargetPage = target;
+  SlideCounter = direction > 0 ? 1.0f : -1.0f;
+  Audio::PlayInGroup(Audio::ACG_SE, "sysse", 1, false, 0.0f);
+}
+
+void OptionsMenu::UpdateInput(float dt) {
+  if (SlideCounter != 0.0f) return;
+  const int page = (int)CurrentPage;
+  const int pages = (int)Layout::Pages.size();
+  std::vector<Row>& rows = Layout::Pages[page].Rows;
+  int& cursor = Cursor[page];
+  const bool useMouse = Input::CurrentInputDevice == Input::Device::Mouse ||
+                        Input::CurrentInputDevice == Input::Device::Touch;
+  const glm::vec2 mouse = Input::CurMousePos;
+  const bool mouseDown = (PADinputMouseIsDown & PAD1A) != 0;
+  const bool mouseClick = (PADinputMouseWentDown & PAD1A) != 0;
+
+  // Back: leave the screen (the script fades out on SF_SUBMENUEXIT)
+  if ((PADinputButtonWentDown & PAD1B) || (PADinputMouseWentDown & PAD1B)) {
+    Audio::PlayInGroup(Audio::ACG_SE, "sysse", 3, false, 0.0f);
+    SetFlag(SF_SUBMENUEXIT, true);
+    // the original keeps these values in its system data; write it now so they survive a restart
+    SaveSystem::SaveSystemData();
+    SaveSystem::WriteSaveFile();
+    PADinputButtonWentDown = PADinputMouseWentDown = 0;
+    return;
+  }
+
+  // Pages: L1 / R1 (Q / E) and the tabs
+  if (PADinputButtonWentDown & PAD1R1) ChangePage((page + 1) % pages, 1);
+  if (PADinputButtonWentDown & PAD1L1) ChangePage((page + pages - 1) % pages, -1);
+  HoveredTab = -1;
+  if (useMouse) {
+    for (int i = 0; i < (int)Layout::Tabs.size(); i++) {
+      if (!Layout::Tabs[i].HitArea.ContainsPoint(mouse)) continue;
+      HoveredTab = i;
+      if (mouseClick && i != page) ChangePage(i, i > page ? 1 : -1);
+    }
+  }
+  if (SlideCounter != 0.0f) {
+    PADinputButtonWentDown = PADinputMouseWentDown = 0;
+    return;
+  }
+
+  // Cursor
+  const int n = (int)rows.size();
+  if (PADinputButtonRepeatDown & (PAD1DOWN | PAD1UP)) {
+    if (cursor < 0) cursor = 0;  // original: from "none" both keys go to the first row
+    else if (PADinputButtonRepeatDown & PAD1DOWN) cursor = (cursor + 1) % n;
+    else cursor = (cursor + n - 1) % n;
+  }
+  if (useMouse && !mouseDown) DraggedRow = -1;
+  // hover (mouse) or tap (touch: the click is reported when the finger lifts) moves the cursor; while a press is
+  // held the row under its starting point keeps it
+  // the pointer moves the cursor when it moves, presses or clicks (as the original); a keyboard cursor stays
+  // otherwise
+  const bool pointerActive = mouseDown || mouseClick || Input::PrevMousePos != Input::CurMousePos ||
+                             mouse != LastPointer;
+  LastPointer = mouse;
+  if (useMouse && DraggedRow < 0 && pointerActive) {
+    const glm::vec2 probe = mouseDown ? Input::InitMousePos : mouse;
+    for (int r = 0; r < n; r++) {
+      if (rows[r].HitArea.ContainsPoint(probe) ||
+          (rows[r].ToggleArea.Width > 0 && rows[r].ToggleArea.ContainsPoint(probe)))
+        cursor = r;
+    }
+  }
+
+  if (cursor >= 0 && cursor < n) {
+    const Row& row = rows[cursor];
+    const float frames = dt * 60.0f;
+    const int dir = ((PADinputButtonIsDown & PAD1RIGHT) != 0) - ((PADinputButtonIsDown & PAD1LEFT) != 0);
+    const int dirPress = ((PADinputButtonWentDown & PAD1RIGHT) != 0) - ((PADinputButtonWentDown & PAD1LEFT) != 0);
+    switch (row.Type) {
+      case RowType::Toggle:
+        if (dirPress != 0 || (PADinputButtonWentDown & PAD1A) || (mouseClick && row.HitArea.ContainsPoint(mouse))) {
+          SetValue(row, GetValue(row) != 0.0f ? 0.0f : 1.0f);
+          Audio::PlayInGroup(Audio::ACG_SE, "sysse", 2, false, 0.0f);
+        }
+        break;
+      case RowType::Slider:
+      case RowType::Voice: {
+        if (dir != 0) SetValue(row, GetValue(row) + dir * row.Step * frames);
+        const RectF& area = row.DragArea.Width > 0 ? row.DragArea : row.HitArea;
+        // A drag starts where the press began (a touch only reports a press once it is held or moved, so the
+        // starting point is the place where the finger went down).
+        if (useMouse && mouseDown && DraggedRow < 0 && area.ContainsPoint(Input::InitMousePos)) DraggedRow = cursor;
+        if (useMouse && mouseClick && area.ContainsPoint(mouse)) {
+          const float w = area.Width - 2.0f * row.DragInset;
+          SetValue(row, row.Min + std::clamp((mouse.x - area.X - row.DragInset) / w, 0.0f, 1.0f) * (row.Max - row.Min));
+        }
+        if (useMouse && mouseDown && DraggedRow == cursor) {
+          const float w = area.Width - 2.0f * row.DragInset;
+          const float t = std::clamp((mouse.x - area.X - row.DragInset) / w, 0.0f, 1.0f);
+          SetValue(row, row.Min + t * (row.Max - row.Min));
+        }
+        if (row.Type == RowType::Voice &&
+            ((PADinputButtonWentDown & PAD1Y) ||
+             (mouseClick && row.ToggleArea.Width > 0 && row.ToggleArea.ContainsPoint(mouse)))) {
+          SetVoiceOn(row, !GetVoiceOn(row));
+          Audio::PlayInGroup(Audio::ACG_SE, "sysse", 2, false, 0.0f);
+        }
+      } break;
+      case RowType::Choice:
+      case RowType::Radio:
+        break;  // window mode / resolution: no engine setting on this platform
+    }
+  }
+
+  // The screen owns the input while it is shown.
+  PADinputButtonWentDown = 0;
+  PADinputMouseWentDown = 0;
+}
+
+// ---------------------------------------------------------------- drawing
+
+float OptionsMenu::KnobPosition(const Row& row, float value) const {
+  const float t = (std::clamp(value, row.Min, row.Max) - row.Min) / (row.Max - row.Min);
+  return row.KnobX + t * row.KnobRange;
+}
+
+void OptionsMenu::RenderPage(size_t page, float offsetX, float alpha) {
+  if (page >= Layout::Pages.size() || alpha <= 0.0f) return;
+  const Page& p = Layout::Pages[page];
+  const glm::vec4 col(1.0f, 1.0f, 1.0f, alpha);
+  const glm::vec4 half(1.0f, 1.0f, 1.0f, alpha * 0.5f);
+  const glm::vec2 off(offsetX, 0.0f);
+  Renderer->DrawSprite(p.Paper, p.PaperPosition + off, col);
+  Renderer->DrawSprite(p.Guide, p.GuidePosition + off, col);
+
+  for (size_t r = 0; r < p.Rows.size(); r++) {
+    const Row& row = p.Rows[r];
+    const bool focused = Cursor[page] == (int)r;
+    if (row.Type == RowType::Voice) {
+      if (focused) Renderer->DrawSprite(row.CursorSprite, row.CursorPosition + off, col);
+      if (GetVoiceOn(row)) Renderer->DrawSprite(row.OnSprite, row.OnPosition + off, col);
+    }
+    if (focused && row.Underline.Width > 0)
+      DrawStretched(UnderlineSprite,
+                    RectF(row.Underline.X + offsetX, row.Underline.Y, row.Underline.Width, row.Underline.Height),
+                    col);
+    const float value = GetValue(row);
+    switch (row.Type) {
+      case RowType::Toggle:
+        Renderer->DrawSprite(value != 0.0f ? row.TrueSprite : row.FalseSprite, row.Position + off, col);
+        break;
+      case RowType::Slider:
+      case RowType::Voice: {
+        const float y = row.KnobY;
+        Renderer->DrawSprite(KnobSprite, glm::vec2(KnobPosition(row, OpenValues[page][r]) + offsetX, y), half);
+        Renderer->DrawSprite(KnobSprite, glm::vec2(KnobPosition(row, value) + offsetX, y), col);
+      } break;
+      case RowType::Choice: {
+        const int v = std::clamp((int)value, 0, (int)row.Positions.size() - 1);
+        if (!row.Positions.empty()) Renderer->DrawSprite(row.Sprite_, row.Positions[v] + off, col);
+      } break;
+      case RowType::Radio: {
+        Renderer->DrawSprite(row.Sprite_, row.Position + off, col);
+        const int v = std::clamp((int)value, 0, (int)row.Positions.size() - 1);
+        if (!row.Positions.empty()) Renderer->DrawSprite(KnobSprite, row.Positions[v] + off, col);
+      } break;
+    }
+  }
+}
+
+void OptionsMenu::Render() {
+  if (State == Hidden) return;
+  const float alpha = ScriptAlpha() / 256.0f;
+  if (alpha <= 0.0f) return;
+  Renderer->DrawSprite(BackgroundSprite, glm::vec2(0.0f), glm::vec4(1.0f, 1.0f, 1.0f, alpha));
+
+  if (SlideCounter == 0.0f) {
+    RenderPage(CurrentPage, 0.0f, alpha);
+  } else {
+    // as the original: the old page moves out by SlideCounter * step and fades, the new one comes in from the side
+    const float ct = SlideCounter;
+    const float step = PageSlideDistance / PageSlideFrames;
+    const float progress = std::abs(ct) / PageSlideFrames;
+    RenderPage(CurrentPage, -ct * step, alpha * (1.0f - progress));
+    const float incoming = (ct > 0.0f ? PageSlideFrames - ct : -PageSlideFrames - ct) * step;
+    RenderPage((size_t)TargetPage, incoming, alpha * progress);
+  }
+
+  for (size_t i = 0; i < Layout::Tabs.size(); i++) {
+    const glm::vec4 col(1.0f, 1.0f, 1.0f, alpha);
+    Renderer->DrawSprite((int)i == HoveredTab ? Layout::Tabs[i].Highlighted : Layout::Tabs[i].Normal, Layout::Tabs[i].Position, col);
+  }
+  // the check mark follows the current page (it moves when the slide has finished)
+  if (CurrentPage < Layout::Tabs.size())
+    Renderer->DrawSprite(TabCheckSprite, Layout::Tabs[CurrentPage].CheckPosition, glm::vec4(1.0f, 1.0f, 1.0f, alpha));
+}
+
+}  // namespace SGHD
+}  // namespace UI
+}  // namespace Impacto
