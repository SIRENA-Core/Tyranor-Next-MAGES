+static int old_cbp_luma(Bink2Bits *bits, unsigned prev_cbp,
+                        unsigned *out)
+{
+    unsigned cbp, cbp4, cbplo, cbphi;
+    int b, i, j;
+
+    b = bink2_bits_read1(bits);
+    if (b < 0)
+        return -1;
+    if (b) {
+        b = bink2_bits_read1(bits);
+        if (b < 0)
+            return -1;
+        if (b) {
+            *out = prev_cbp;
+            return 0;
+        }
+        cbplo = prev_cbp & 0xFFFF;
+    } else {
+        cbplo = 0;
+        cbp4 = (prev_cbp >> 4) & 0xF;
+        for (i = 0; i < 4; i++) {
+            b = bink2_bits_read1(bits);
+            if (b < 0)
+                return -1;
+            if (!b) {
+                int v = bink2_bits_read(bits, 4);
+
+                if (v < 0)
+                    return -1;
+                cbp4 = (unsigned)v;
+            }
+            cbplo |= cbp4 << (i * 4);
+        }
+    }
+    cbphi = 0;
+    cbp = cbplo;
+    cbp4 = (prev_cbp >> 20) & 0xF;
+    for (i = 0; i < 4; i++) {
+        if (popcount4(cbp)) {
+            if (popcount4(cbp) == 1) {
+                cbp4 = 0;
+                for (j = 1; j < 16; j <<= 1) {
+                    if (j & cbp) {
+                        b = bink2_bits_read1(bits);
+                        if (b < 0)
+                            return -1;
+                        if (b)
+                            cbp4 |= (unsigned)j;
+                    }
+                }
+            } else {
+                b = bink2_bits_read1(bits);
+                if (b < 0)
+                    return -1;
+                if (!b) {
+                    cbp4 = 0;
+                    for (j = 1; j < 16; j <<= 1) {
+                        if (j & cbp) {
+                            int bit = bink2_bits_read1(bits);
+
+                            if (bit < 0)
+                                return -1;
+                            if (bit)
+                                cbp4 |= (unsigned)j;
+                        }
+                    }
+                }
+            }
+        } else {
+            cbp4 = 0;
+        }
+        cbp4 &= cbp;
+        cbphi = (cbphi >> 4) | (cbp4 << 0x1c);
+        cbp >>= 4;
+    }
+    *out = cbphi | cbplo;
+    return 0;
+}
