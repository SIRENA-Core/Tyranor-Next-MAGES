+// 0x4bdb60: `triangles` * 3 vertices of 10 floats: x, y (screen), z, rhw, r, g, b, a, u, v
+void FUN_004489f0(Arg slot, Arg vertices, Arg triangles, Arg) {
+  const SpriteSheet* sheet = SurfaceSheet(slot.I());
+  if (!sheet) return;
+  const float* v = vertices.P<const float>();
+  const int count = triangles.I() * 3;
+  std::vector<VertexBufferSprites> verts(count);
+  std::vector<uint16_t> indices(count);
+  for (int i = 0; i < count; i++, v += 10) {
+    verts[i].Position = glm::vec2(v[0], v[1]);
+    verts[i].Tint = glm::vec4(v[4], v[5], v[6], v[7]);
+    verts[i].UV = glm::vec2(v[8], v[9]);
+    indices[i] = (uint16_t)i;
+  }
+  Renderer->DrawPrimitives(*sheet, ShaderProgramType::Sprite, verts, indices);
+}
