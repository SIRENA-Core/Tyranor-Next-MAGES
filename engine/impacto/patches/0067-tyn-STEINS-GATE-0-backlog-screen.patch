+// 0x42fb00 on a script string: the expression at p (a colour tag), its value into *out; the position after it
+const uint8_t* EvalAt(const uint8_t* p, void* out) {
+  for (uint32_t b = 0; b < Vm::MaxLoadedScripts; b++) {
+    const auto& buf = Vm::ScriptBuffers[b];
+    if (buf.empty() || p < buf.data() || p >= buf.data() + buf.size()) continue;
+    Vm::Sc3VmThread thread;
+    thread.ScriptBufferId = b;
+    thread.IpOffset = (uint32_t)(p - buf.data());
+    const int v = Vm::ExpressionEval(&thread);
+    if (out) std::memcpy(out, &v, 4);
+    return buf.data() + thread.IpOffset;
+  }
+  if (out) std::memset(out, 0, 4);
+  return p + 1;
+}
