+// The CONFIG screen of STEINS;GATE 0: instruction 10:13 (0x4858c0: 0 / 10 = init 0x453620, 1 = the update of a frame
+// 0x453d70, 2 = 0x4524f0, 3 = BGM volume back, 4 = defaults of the page 0x4527b0) and its drawing (0x452910 on the
+// system menu layer) are translated with the phone (phonecode.cpp). The settings stay in the original's variables
+// (0x2ee7670..), which are filled from the engine's settings when the screen opens and written back to them every
+// frame. Rows (Game.exe 0x5c92e0: variable, mute variable, type, min, max):
+//   0 0x2ee76bc trigger stops skipping   1 0x2ee76b4 TIPS notification   2 0x2ee7694 auto quick save (bits: 1 trigger,
+//   2 scene)   3 0x2ee76c4 full screen   4 0x2ee76c8 resolution   5 0x2ee7684 text speed (0x100..0x1000)
+//   6 0x2ee7688 auto mode wait (0x100..0x800)   7 0x2ee7690 skip (0 read only, 1 all)   8 0x2ee76d0 message send LR
+//   9..12 0x2ee7670 / 74 / 78 / 80 voice, BGM, SE, movie volume (0..0x80)   13 0x2ee768c voice sync
+//   14 0x2ee76b0 voice skip   15.. 0x2ee55c0 + 4 i character voice volume, 0x2ee5538 + 4 i voice on
+// Full screen and resolution have no meaning here: the screen shows full screen, 1920x1080 and does not change them.
+#include "phone.h"
+
+#include <algorithm>
+
+#include "phoneglobals.h"
+#include "../../audio/audiosystem.h"
+#include "../../profile/configsystem.h"
+#include "../../vm/interface/input.h"
+#include "../../vm/thread.h"
+
+namespace Impacto {
+namespace SG0 {
+namespace PhoneCode {
+
+// 0x4906f0: the window size (the screen does not change it here)
+void FUN_004906f0() {}
+
+}  // namespace PhoneCode
+
+namespace Phone {
+
+using namespace PhoneCode;
+namespace Cfg = Impacto::Profile::ConfigSystem;
+
+namespace {
+
+int32_t& V(uint32_t address) { return *reinterpret_cast<int32_t*>(Sg0Emu::At(address)); }
+
+// 0x2ee5538 .. 0x2ee55c0: 34 characters (the engine keeps VoiceCount)
+constexpr int Voices = std::min(34, Profile::ConfigSystem::VoiceCount);
+
+void FixedScreen() {
+  V(0x02ee76c4) = V(0x02ee53c4) = 1;  // full screen
+  V(0x02ee76c8) = V(0x02ee53c8) = 2;  // 1920x1080
+  V(0x02ee5384) = 1;
+  V(0x02ee5388) = 2;
+}
+
+}  // namespace
+
+// the engine's settings into the original's variables
+void ConfigToOriginal() {
+  V(0x02ee76bc) = Cfg::TriggerStopSkip ? 1 : 0;
+  V(0x02ee76b4) = Cfg::ShowTipsNotification ? 1 : 0;
+  V(0x02ee7694) = Cfg::AutoQuickSave & 3;
+  V(0x02ee7684) = std::clamp((int)(Cfg::TextSpeed * 60.0f + 0.5f), 0x100, 0x1000);
+  V(0x02ee7688) = std::clamp((int)(Cfg::AutoSpeed * 60.0f + 0.5f), 0x100, 0x800);
+  V(0x02ee7690) = Cfg::SkipRead ? 0 : 1;
+  V(0x02ee76d0) = Cfg::AdvanceTextOnDirectionalInput ? 1 : 0;
+  V(0x02ee7670) = (int)(Audio::GroupVolumes[Audio::ACG_Voice] * 128.0f + 0.5f);
+  V(0x02ee7674) = (int)(Audio::GroupVolumes[Audio::ACG_BGM] * 128.0f + 0.5f);
+  V(0x02ee7678) = (int)(Audio::GroupVolumes[Audio::ACG_SE] * 128.0f + 0.5f);
+  V(0x02ee7680) = (int)(Audio::GroupVolumes[Audio::ACG_Movie] * 128.0f + 0.5f);
+  V(0x02ee768c) = Cfg::SyncVoice ? 1 : 0;
+  V(0x02ee76b0) = Cfg::SkipVoice ? 1 : 0;
+  for (int i = 0; i < Voices; i++) {
+    V(0x02ee55c0 + i * 4) = (int)(Cfg::VoiceVolume[i] * 128.0f + 0.5f);
+    V(0x02ee5538 + i * 4) = Cfg::VoiceMuted[i] ? 0 : 1;  // 1: the voice is on
+  }
+  FixedScreen();
+}
+
+// and back
+void ConfigFromOriginal() {
+  Cfg::TriggerStopSkip = V(0x02ee76bc) != 0;
+  Cfg::ShowTipsNotification = V(0x02ee76b4) != 0;
+  Cfg::AutoQuickSave = (uint8_t)(V(0x02ee7694) & 3);
+  Cfg::TextSpeed = V(0x02ee7684) / 60.0f;
+  Cfg::AutoSpeed = V(0x02ee7688) / 60.0f;
+  Cfg::SkipRead = V(0x02ee7690) == 0;
+  Cfg::AdvanceTextOnDirectionalInput = V(0x02ee76d0) != 0;
+  Audio::GroupVolumes[Audio::ACG_Voice] = V(0x02ee7670) / 128.0f;
+  Audio::GroupVolumes[Audio::ACG_BGM] = V(0x02ee7674) / 128.0f;
+  Audio::GroupVolumes[Audio::ACG_SE] = V(0x02ee7678) / 128.0f;
+  Audio::GroupVolumes[Audio::ACG_Movie] = V(0x02ee7680) / 128.0f;
+  Cfg::SyncVoice = V(0x02ee768c) != 0;
+  Cfg::SkipVoice = V(0x02ee76b0) != 0;
+  for (int i = 0; i < Voices; i++) {
+    Cfg::VoiceVolume[i] = V(0x02ee55c0 + i * 4) / 128.0f;
+    Cfg::VoiceMuted[i] = V(0x02ee5538 + i * 4) == 0;
+  }
+  FixedScreen();
+}
+
+// 10:13 (0x4858c0)
+void ConfigInstruction(Vm::Sc3VmThread* thread) {
+  thread->IpOffset += 2;
+  const uint8_t type = *thread->GetIp();
+  thread->IpOffset++;
+  switch (type) {
+    case 0:
+    case 10:
+      ConfigToOriginal();
+      FUN_00453620();
+      ClearMouse();
+      Vm::Interface::PADinputButtonWentDown = 0;
+      break;
+    case 1:
+      BridgeInput();
+      FUN_00453d70();
+      Vm::Interface::PADinputButtonWentDown = *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x01979f10));
+      ClearMouse();
+      ConfigFromOriginal();
+      break;
+    case 2:
+      FUN_004524f0();
+      ConfigFromOriginal();
+      break;
+    case 3:
+      V(0x02ee766c) = V(0x02ee7670);
+      break;
+    case 4:
+      FUN_004527b0();
+      ConfigFromOriginal();
+      break;
+    default:
+      break;
+  }
+}
+
+}  // namespace Phone
+}  // namespace SG0
+}  // namespace Impacto
