+#pragma once
+// Support for the translated STEINS;GATE 0 phone (phonecode.cpp, generated from the Ghidra decompile of Game.exe):
+// the globals of the original live at their addresses in emulated memory, and the functions of Game.exe the phone
+// calls keep their names (FUN_00xxxxxx) with an engine implementation in phoneshim.cpp.
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+#include "../../mem.h"
+
+namespace Impacto {
+namespace SG0 {
+namespace Sg0Emu {
+
+namespace Types {
+typedef uint8_t undefined;
+typedef uint8_t undefined1;
+typedef uint16_t undefined2;
+typedef uint32_t undefined4;
+typedef uint64_t undefined8;
+typedef uint8_t byte;
+typedef uint16_t ushort;
+typedef uint32_t uint;
+typedef long double float10;
+}  // namespace Types
+
+struct RdataChunk {
+  uint32_t Address;
+  uint8_t Bytes[16];
+};
+
+// Address of the original global in emulated memory (read only data of Game.exe, .data, the phone's and the input
+// globals). ScrWork is not emulated: DAT_02ee7660 is the engine's ScrWork.
+uint8_t* At(uint32_t address);
+// address of a label / of string strNo in script buffer `buffer`
+const uint8_t* LabelPtr(uint32_t buffer, uint32_t label);
+const uint8_t* StrPtr(uint32_t buffer, uint32_t strNo);
+void Reset();
+
+// A call argument of the original: integer, float or pointer. Ghidra prints float immediates as their bit pattern,
+// so an integer passed where the original takes a float is read as float bits.
+struct Arg {
+  uint64_t Raw = 0;
+  double F = 0;
+  enum Kind : uint8_t { Int, Float, Ptr } K = Int;
+  Arg(int v) : Raw((uint32_t)v) {}
+  Arg(unsigned v) : Raw(v) {}
+  Arg(long v) : Raw((uint32_t)v) {}
+  Arg(unsigned long v) : Raw(v) {}
+  Arg(long long v) : Raw((uint64_t)v) {}
+  Arg(unsigned long long v) : Raw(v) {}
+  Arg(char v) : Raw((uint8_t)v) {}
+  Arg(unsigned char v) : Raw(v) {}
+  Arg(short v) : Raw((uint16_t)v) {}
+  Arg(unsigned short v) : Raw(v) {}
+  Arg(bool v) : Raw(v) {}
+  Arg(float v) : F(v), K(Float) {}
+  Arg(double v) : F(v), K(Float) {}
+  Arg(long double v) : F((double)v), K(Float) {}
+  template <typename T>
+  Arg(T* p) : Raw((uint64_t)(uintptr_t)p), K(Ptr) {}
+  int I() const { return K == Float ? (int)F : (int)(uint32_t)Raw; }
+  uint32_t U() const { return K == Float ? (uint32_t)(int64_t)F : (uint32_t)Raw; }
+  float Fl() const {
+    if (K == Float) return (float)F;
+    uint32_t bits = (uint32_t)Raw;
+    float f;
+    std::memcpy(&f, &bits, 4);
+    return f;
+  }
+  template <typename T>
+  T* P() const {
+    return reinterpret_cast<T*>((uintptr_t)Raw);
+  }
+};
+
+}  // namespace Sg0Emu
+
+namespace PhoneCode {
+using Sg0Emu::Arg;
+using namespace Sg0Emu::Types;
+
+extern const Sg0Emu::RdataChunk RdataChunks[];
+extern const size_t RdataChunkCount;
+
+// The engine's ScrWork plays the original's script work area (int array at DAT_02ee7660).
+#define DAT_02ee7660 ((uintptr_t)Impacto::ScrWork.data())
+
+// Game.exe functions the phone calls (phoneshim.cpp). Floats are passed as Arg (Ghidra prints float immediates as
+// their bit pattern); coordinates of the sprite functions are in 1920x1080 units, those of the text in 1280x720.
+// The engine's input of this frame into the original's input globals (pad masks, mouse buttons, wheel)
+void BridgeInput();
+// hand ported (phonerine.cpp): the RINE conversation reader reads the script bytes itself
+void FUN_00476d50();
+void FUN_00477040();
+// Steam achievement (0x477b20): nothing to unlock here
+void FUN_00477b20(Arg);
+void FUN_00446e90(Arg);  // clear the render target
+bool FUN_00446ef0(Arg group, Arg index, Arg mode);  // is the mouse over the hit area (as of the last frame)
+void FUN_00446f60(Arg x, Arg y, Arg w, Arg h, Arg group, Arg index);  // hit area for the next frame
+void FUN_004489f0(Arg slot, Arg vertices, Arg triangles, Arg mode);  // triangle list (x y z w r g b a u v)
+void FUN_00448d40(Arg x, Arg y, Arg w, Arg h, Arg color, Arg alpha, Arg = 0);
+void FUN_0044b5a0(Arg target);  // render target (8: the screen)
+void FUN_0044c0b0(Arg slot, Arg maskSlot, Arg sx, Arg sy, Arg w, Arg h, Arg mx, Arg my, Arg dx, Arg dy, Arg color,
+                  Arg alpha, Arg mode, Arg progress, Arg range);
+void FUN_0044cba0(Arg slot, Arg sx, Arg sy, Arg w, Arg h, Arg dx, Arg dy, Arg color, Arg alpha, Arg mode);
+void FUN_0044f270(Arg slot, Arg sx, Arg sy, Arg w, Arg h, Arg x0, Arg y0, Arg x1, Arg y1, Arg color, Arg alpha,
+                  Arg mode);
+int FUN_0045d840(Arg maxWidth, Arg str, Arg size);   // line count
+int FUN_0045d9d0(Arg width, Arg str, Arg size);      // line count, *width: in max width, out width of the last line
+void FUN_00461220(Arg font, Arg x, Arg y, Arg maxWidth, Arg str, Arg skipLines, Arg lines, Arg color, Arg size,
+                  Arg alpha, Arg draw);
+void FUN_00462f30(Arg font, Arg x, Arg y, Arg maxWidth, Arg str, Arg maxGlyphs, Arg color, Arg size, Arg alpha);
+int FUN_004643a0(Arg str, Arg maxGlyphs, Arg size);  // width of a line
+char FUN_0046b010(Arg key);
+void FUN_0046b320();
+void FUN_0046b4a0();
+uint32_t FUN_0047f170(Arg buffer, Arg label, Arg = 0, Arg = 0);  // offset of a label in its script buffer
+uint32_t FUN_0047f1f0(Arg buffer, Arg str);  // handle of a script string (the original: its address)
+int FUN_00490e60();  // language (0 JP, 1 EN, 2 ZHC, 3 ZHT)
+int FUN_004919d0(Arg flag);
+void FUN_00491b90(Arg flag, Arg value);
+void FUN_004c65a0(Arg, Arg);
+void FUN_004d3170(Arg dst, Arg src, Arg n);  // memcpy
+
+}  // namespace PhoneCode
+}  // namespace SG0
+}  // namespace Impacto
