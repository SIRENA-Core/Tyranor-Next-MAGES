+      const int c = Eval();
+      FUN_00473560(a, b, c);
+      FUN_00491b90(0xab5, 0);
+      Sw(0x6800) = 3;
+      FUN_00491b90(0x4b5, 1);
+    } break;
+    default:
+      break;
+  }
+}
