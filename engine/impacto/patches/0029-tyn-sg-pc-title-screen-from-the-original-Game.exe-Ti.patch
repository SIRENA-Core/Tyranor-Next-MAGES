@@ -0,0 +1,314 @@
+#include "titlemenu.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "../../profile/ui/titlemenu.h"
+#include "../../profile/game.h"
+#include "../../profile/scriptvars.h"
+#include "../../renderer/renderer.h"
+#include "../../ui/ui.h"
+#include "../../mem.h"
