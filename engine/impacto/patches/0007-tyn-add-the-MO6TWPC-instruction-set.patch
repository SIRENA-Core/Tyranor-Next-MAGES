 #include "inst_macros.inc"
 
+#include <bitset>
+
 #include "expression.h"
 #include "../log.h"
 #include "../mem.h"
@@ -408,6 +410,33 @@ VmInstruction(InstUnk100FMO6) {
       "{:d})\n",
       type, arg1, arg2, arg3);
 }
+// Placeholder for opcodes of the MO6TWPC tables that are not implemented. Same
+// semantics as InstDummy (does nothing, does not advance the IP, so a script
+// that really executes one will hang), but logs an error once per opcode so
+// that the hang can be attributed.
+VmInstruction(InstDummyPC) {
+  static std::bitset<0x8000> reported;
+  const uint8_t* ip = thread->GetIp();
+  const size_t key = (static_cast<size_t>(ip[0] & 0x7F) << 8) | ip[1];
+  if (!reported.test(key)) {
+    reported.set(key);
+    ImpLog(LogLevel::Error, LogChannel::VM,
+           "Unimplemented MO6TWPC opcode {:02x}:{:02x} reached (script buffer "
+           "{:d}, address {:#0x}); the thread will not advance\n",
+           ip[0] & 0x7F, ip[1], thread->ScriptBufferId, thread->IpOffset);
+  }
+}
+VmInstruction(InstUnk100FPC) {
+  StartInstruction;
+  ImpLogSlow(LogLevel::Warning, LogChannel::VMStub,
+             "STUB instruction Unk100FPC()\n");
+}
+VmInstruction(InstUnk005APC) {
+  StartInstruction;
+  PopUint16(arg);
+  ImpLogSlow(LogLevel::Warning, LogChannel::VMStub,
+             "STUB instruction Unk005APC(arg: {:d})\n", arg);
+}
 VmInstruction(InstUnk1010MO6) {
   StartInstruction;
   PopUint8(type);
