diff --git a/profiles/sg0-pc/hud/backlogmenu.lua b/profiles/sg0-pc/hud/backlogmenu.lua
index e8bcd6849c08c368b793547d921551b7ad871b25..cdb06525201c40d345f5c07194dc57431f59e9a5 100644
--- a/profiles/sg0-pc/hud/backlogmenu.lua
+++ b/profiles/sg0-pc/hud/backlogmenu.lua
@@ -1,35 +1,41 @@
--- STEINS;GATE (Steam) backlog. Sprite bounds measured on BACKLOG.DDS (2048x1080): the dark panel with the BACKLOG
--- header spans x 95..1789, its scrollbar track x 1790..1823 (full height), the scrollbar thumb is at (1940, 58, 12x103),
--- the voice icon at (1974, 6, 59x54); columns 0..91 are transparent. The sheet has no highlight or controls strip: those
--- use a transparent patch. BLOGMASK.DDS (1920x1080) masks the text to the middle of the panel.
+-- STEINS;GATE 0 backlog. The screen itself (the SYSM_SAVEMENU background, the BACKLOG panel faded in through its
+-- mask, the BACKLOG corner mark) is drawn by the game code ported from Game.exe (0x451fe0, games/sg0/sysmenu.cpp,
+-- under the engine's menus); this engine backlog class draws the entries and the scroll bar over it, with the
+-- original's geometry (0x451fe0 / 0x464b90, 1280x720 units drawn at x1.5):
+--   * text from x 240 (360), the window of the entries y 46..646 (69..969), first entry at y 84 (126);
+--   * voice icon: BACKLOG.DDS (1926, 114, 66 x 54), 22.5 left of and 3.5 below the entry;
+--   * scroll bar thumb: BACKLOG.DDS (1926, 0, 42 x 108) at x 1776, y 60 .. 60 + 804.
+-- The panel does not scroll: the engine's background, header and track are a transparent strip of the sheet
+-- (columns 0..80 of BACKLOG.DDS are empty).
 root.BacklogMenu = {
     Type = BacklogMenuType.CC,
     DrawType = DrawComponentType.SystemMenu,
 
-    BacklogBackgroundSprite = "BacklogBackground",
+    BacklogBackgroundSprite = "BacklogNone",
 
-    BacklogHeaderSprite = "BacklogHeader",
+    BacklogHeaderSprite = "BacklogNone",
     BacklogHeaderPosition = { X = 0, Y = 0 },
 
-    BacklogControlsSprite = "BacklogControls",
-    BacklogControlsPosition = { X = 0, Y = 988 },
+    BacklogControlsSprite = "BacklogNone",
+    BacklogControlsPosition = { X = 0, Y = 0 },
 
-    EntryHighlightSprite = "EntryHighlight",
+    EntryHighlightSprite = "BacklogNone",
     EntryHighlightLocation = EntryHighlightLocationType.AllLinesLeftOfScreen,
     EntryHighlightOffset = { X = 0, Y = 0 },
     EntryHighlightPadding = 16.0,
 
     VoiceIconSprite = "VoiceIcon",
-    VoiceIconOffset = { X = -7, Y = 3 },
+    VoiceIconOffset = { X = -22.5, Y = 3.5 },
 
     ScrollbarTrackSprite = "ScrollbarTrack",
     ScrollbarThumbSprite = "ScrollbarThumb",
-    ScrollbarPosition = { X = 1790, Y = 0 },
-    ScrollbarThumbLength = 103,
+    ScrollbarPosition = { X = 1776, Y = 60 },
+    ScrollbarThumbLength = 108,
 
-    EntriesStart = { X = 12, Y = 150 },
-    RenderingBounds = { X = 95, Y = 135, Width = 1695, Height = 840 },
-    EntryYPadding = 26,
+    -- the entries are laid out in message mode 9 (REVMessageModeIdx), which starts 240 to the right
+    EntriesStart = { X = 120, Y = 126 },
+    RenderingBounds = { X = 0, Y = 69, Width = 1920, Height = 900 },
+    EntryYPadding = 27,
 
     FadeInDuration = 0.5,
     FadeOutDuration = 0.5,
@@ -39,42 +45,25 @@ root.BacklogMenu = {
     ScrollingSpeed = 900,
     PageUpDownHeight = 765,
 
