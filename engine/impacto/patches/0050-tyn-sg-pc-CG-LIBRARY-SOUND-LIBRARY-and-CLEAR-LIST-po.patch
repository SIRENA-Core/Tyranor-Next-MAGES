new file mode 100644
index 0000000000000000000000000000000000000000..f2fce926476072f8a1e6d62cc8a84bf091370ef7
--- /dev/null
+++ b/src/games/sghd/soundlibrary.cpp
@@ -0,0 +1,296 @@
+// SOUND LIBRARY of STEINS;GATE (Steam): 10:1D type 0 (0x436b30) / type 1 (0x436c70), drawn by 0x4374f0 while
+// GlobalVars[2148] is 10. The script handles the cancel key.
+
+#include "soundlibrary.h"
+
+#include <algorithm>
+#include <array>
+#include <random>
+#include <string>
+
+#include "phonerender.h"
+#include "../../audio/audiochannel.h"
+#include "../../audio/audiosystem.h"
+#include "../../data/savesystem.h"
+#include "../../inputsystem.h"
+#include "../../mem.h"
+#include "../../profile/dialogue.h"
+#include "../../profile/sprites.h"
+#include "../../renderer/renderer.h"
+#include "../../text/text.h"
+#include "../../vm/interface/input.h"
+#include "../../vm/vm.h"
+
+namespace Impacto {
+namespace SGHD {
+namespace SoundLibrary {
+
+using namespace Impacto::Vm::Interface;
+
+namespace {
+
+constexpr int Surface = 0x9e;  // MUSIC, loaded by the script
+constexpr int Count = 35, Rows = 16, MaxScroll = Count - Rows;
+// 0x52befc: BGM number of every entry
+constexpr std::array<int, Count> Tracks = {0,  1,  3,  5,  43, 47, 7,  41, 45, 9,  11, 25, 24, 27, 33, 37, 17, 15,
+                                           13, 35, 57, 59, 19, 39, 31, 21, 29, 66, 68, 70, 72, 74, 76, 81, 82};
+// hit areas (table 0x52c100, group 0xb): rows 1..16, the scroll bar 17 and its thumb 18, mode 19, stop 20
+constexpr float RowX = 333, RowY = 255, RowW = 1443, RowH = 42;
+constexpr float BarX = 1791, BarY = 270, BarW = 37, BarH = 703, ThumbH = 100;
+constexpr float ModeX = 1545, ModeY = 148, ModeW = 255, ModeH = 37;
+constexpr float StopX = 153, StopY = 139, StopW = 57, StopH = 57;
+
+std::array<bool, Count> Unlocked{};
+int Cursor = 0xff;      // DAT_0164cacc
+int Scroll = 0;         // DAT_0164cae0
+int Mode = 2;           // DAT_0052bee8: 0 one track again, 1 to the end, 2 all again, 3 shuffled
+int Playing = 0xff;     // DAT_0052bef8
+bool HoverMode = false, HoverStop = false, Dragging = false;
+std::array<int, Count> Shuffle{};
+int ShufflePos = 0;
+bool Started = false;   // a track was started and has not been seen playing yet
+
+bool MouseMode() {
+  return Input::CurrentInputDevice == Input::Device::Mouse || Input::CurrentInputDevice == Input::Device::Touch;
+}
+bool Inside(glm::vec2 p, float x, float y, float w, float h) {
+  return p.x >= x && p.x < x + w && p.y >= y && p.y < y + h;
+}
+
+void NewShuffle() {  // 0x437970
+  for (int i = 0; i < Count; i++) Shuffle[i] = i;
+  static std::mt19937 rng{std::random_device{}()};
+  std::shuffle(Shuffle.begin(), Shuffle.end(), rng);
+  ShufflePos = 0;
+}
+
+void PlayTrack(int entry, bool loop) {
+  Playing = entry;
+  Audio::Channels[Audio::AC_BGM0]->Play("bgm", Tracks[entry], loop, 0.0f);
+  Started = true;
+}
+
+void Stop() {
+  Audio::Channels[Audio::AC_BGM0]->Stop(0.0f);
+  Playing = 0xff;
+  Started = false;
+}
+
+bool TrackEnded() {
+  const bool playing = Audio::Channels[Audio::AC_BGM0]->GetState() == Audio::ACS_Playing;
+  if (playing) Started = false;
+  return Playing != 0xff && !playing && !Started;
+}
+
+std::vector<ProcessedTextGlyph> Text(int index, glm::vec2 pos) {
+  auto ctx = Vm::ScriptGetTextTableStrAddress(4, index);
+  Vm::Sc3Stream stream(&ctx.Buffers[ctx.BufferId][ctx.IpOffset]);
+  return TextLayoutPlainLine(stream, std::nullopt, *Profile::Dialogue::DialogueFont, 20 * 1.5f,
+                             DialogueColorPair{0xffffff, 0}, 1.0f, pos, TextAlignment::Left);
+}
+
+// 0x445950 keeps a text inside its width: a longer one is squeezed horizontally
+void Fit(std::vector<ProcessedTextGlyph>& g, float maxWidth) {
+  if (g.empty()) return;
+  const float w = GetTextWidth(g);
+  if (w <= maxWidth) return;
+  const float x0 = g.front().DestRect.X, f = maxWidth / w;
+  for (auto& glyph : g) {
+    glyph.DestRect.X = x0 + (glyph.DestRect.X - x0) * f;
+    glyph.DestRect.Width *= f;
+  }
+}
+
+}  // namespace
+
+void Init() {
+  // 0x436890: the tracks that are always there, and those the endings and the second of every pair open
+  auto* save = SaveSystem::Implementation;
+  if (save) {
+    auto set = [&](int id) { save->SetBgmFlag(id, true); };
+    set(0), set(1), set(81), set(82), set(67);
+    if (GetFlag(0x38e) || GetFlag(0x391) || GetFlag(0x393) || GetFlag(0x392) || GetFlag(0x394)) set(71);
+    if (GetFlag(0x390)) set(69);
+    if (GetFlag(0x38f)) set(66);
+    constexpr int Pairs[][2] = {{3, 2},   {5, 4},   {7, 6},   {9, 8},   {11, 10}, {13, 12}, {15, 14}, {17, 16},
+                                {19, 18}, {21, 20}, {25, 22}, {24, 23}, {27, 26}, {29, 28}, {31, 30}, {33, 32},
+                                {35, 34}, {37, 36}, {39, 38}, {41, 40}, {43, 42}, {45, 44}, {47, 46}, {49, 48},
+                                {51, 50}, {53, 52}, {55, 54}, {57, 56}, {59, 58}, {61, 60}, {63, 62}, {65, 64},
+                                {68, 67}, {70, 69}, {72, 71}, {74, 73}, {76, 75}};
+    for (auto [to, from] : Pairs)
+      if (save->GetBgmFlag(from)) set(to);
+  }
+  for (int i = 0; i < Count; i++) Unlocked[i] = save && save->GetBgmFlag(Tracks[i]);
+  Scroll = 0;
+  Mode = 2;
+  Playing = 0xff;
+  Started = false;
+  Dragging = false;
+  Cursor = MouseMode() ? 0xff : 0;
+  NewShuffle();
+}
+
+void Update() {
+  const bool mouse = MouseMode();
+  const glm::vec2 p = Input::CurMousePos;
+  const bool click = (PADinputMouseWentDown & PAD1A) != 0;
+  bool decide = (PADinputButtonWentDown & PAD1A) != 0;
+  bool stop = (PADinputButtonWentDown & PAD1Y) != 0;
+  bool mode = (PADinputButtonWentDown & PAD1X) != 0;
+  HoverMode = HoverStop = false;
+  if (mouse) {
+    Cursor = 0xff;
+    if (Input::MouseWheelDeltaY > 0) Scroll = Scroll < 4 ? 0 : Scroll - 4;
+    if (Input::MouseWheelDeltaY < 0) Scroll = Scroll < 15 ? Scroll + 4 : MaxScroll;
+    const float free = BarH - ThumbH;
+    const float thumb = (float)(((Scroll * 0x192) / 0x13) * 3 >> 1);
+    if (Dragging && !(PADinputMouseIsDown & PAD1A)) Dragging = false;
+    if (click && Inside(p, BarX, BarY + thumb, BarW, ThumbH)) Dragging = true;
+    if (Dragging) {
+      const float y = std::clamp(p.y - BarY - ThumbH / 2, 0.0f, free);
+      const float step = free / MaxScroll;
+      Scroll = std::clamp((int)((step / 2 + y) / step), 0, MaxScroll);
+      return;
+    }
+    if (click && Inside(p, BarX, BarY, BarW, BarH)) {
+      if (p.y < BarY + thumb) Scroll = 0;
+      if (p.y > BarY + ThumbH + thumb) Scroll = 4;
+    }
+    for (int r = 0; r < Rows; r++) {
+      if (!Inside(p, RowX, RowY + RowH * r, RowW, RowH)) continue;
+      Cursor = r;
+      if (click) decide = true;
+      break;
+    }
+    HoverStop = Inside(p, StopX, StopY, StopW, StopH);
+    HoverMode = Inside(p, ModeX, ModeY, ModeW, ModeH);
+    if (click && HoverStop) stop = true;
+    if (click && HoverMode) mode = true;
+  }
+  if (PADinputButtonRepeatDown & PAD1UP) {
+    if (Cursor == 0xff) {
+      Cursor = 0;
+    } else if (Cursor < 2) {
+      if (Scroll == 0) {
+        if (Cursor != 0) Cursor--;
+      } else {
+        Scroll--;
+      }
+    } else {
+      Cursor--;
+    }
+  }
+  if (PADinputButtonRepeatDown & PAD1DOWN) {
+    if (Cursor == 0xff) {
+      Cursor = 0;
+    } else if (Cursor < 0xe) {
+      Cursor++;
+    } else if (Scroll < MaxScroll) {
+      Scroll++;
+    } else if (Scroll + Cursor < Count - 1) {
+      Cursor++;
+    }
+  }
+  if (((PADinputButtonWentDown | PADinputMouseWentDown) & PAD1B) != 0) {
+    // leaving: the title music again (the script fades the screen out)
+    Playing = 0xff;
+    Audio::Channels[Audio::AC_BGM0]->Play("bgm", 0, true, 0.0f);
+    return;
+  }
+  if (decide && Cursor < 0xff && Unlocked[Scroll + Cursor] && Playing != Scroll + Cursor) {
+    PlayTrack(Scroll + Cursor, Mode == 0);
+    PADinputButtonWentDown &= ~PAD1A;
+    PADinputMouseWentDown &= ~PAD1A;
+  }
+  if (stop) Stop();
+  if (mode) {
+    Mode = (Mode + 1) & 3;
+    if (Mode == 3) NewShuffle();
+  }
+  // what follows the end of a track
+  if (TrackEnded()) {
+    switch (Mode) {
+      case 0:
+        PlayTrack(Playing, true);
+        break;
+      case 1: {
+        int next = Playing + 1;
+        while (next < Count && !Unlocked[next]) next++;
+        if (next >= Count) {
+          Stop();
+        } else {
+          PlayTrack(next, false);
+        }
+        break;
+      }
+      case 2: {
+        int next = Playing;
+        do next = (next + 1) % Count;
+        while (!Unlocked[next]);
+        PlayTrack(next, false);
+        break;
+      }
+      case 3: {
+        int next = Playing;
+        for (int guard = 0; guard < Count * 2; guard++) {
+          if (ShufflePos == Count) NewShuffle();
+          const int e = Shuffle[ShufflePos++];
+          if (e != Playing && Unlocked[e]) {
+            next = e;
+            break;
+          }
+        }
+        PlayTrack(next, false);
+        break;
+      }
+    }
+  }
+}
+
+void Render() {
+  if (ScrWork[2148] != 10 || ScrWork[2147] == 0) return;
+  using namespace Phone;
+  const int a = ScrWork[2147] << 3;
+  const float alpha = std::min(a, 256) / 256.0f;
+  constexpr float k = 1.5f;
+  Spr(Surface, 0, 0, 1920, 1080, 0, 0, a);
+  if (auto it = Profile::SpriteSheets.find("Data"); it != Profile::SpriteSheets.end()) {
+    Sprite guide(it->second, 0x600 + 1.0f, 2 * 0x2a + 0x600 + 1.0f, 1534, 40);
+    Renderer->DrawSprite(guide, RectF(1, 995, 1534, 40), glm::vec4(1, 1, 1, alpha));
+  }
+  if (Cursor < 0xff) Spr(Surface, 1.5f, 1081.5f, 1917, 42, 1.5f / k, Cursor * 0x1c + 0xaa, a);
+  Spr(Surface, 1921.5f, 270, 33, 114, 1795.5f / k, (Scroll * 0x192) / 0x13 + 0x97, a);
+  if (Playing != 0xff && Scroll <= Playing && Playing < Scroll + Rows)
+    Spr(Surface, 1993.5f, 37.5f, 33, 33, 355.5f / k, (Playing - Scroll) * 0x1c + 0xad, a);
+  Spr(Surface, 1994, Mode * 24 + 0x124 + 1.0f, 163, 22, 1639 / k, 157 / k, a, HoverMode ? 0xffee77 : 0xffffff);
+  if (HoverStop) Spr(Surface, 1950, 400, 66, 66, 149 / k, 136 / k, a);
+
+  auto draw = [&](std::vector<ProcessedTextGlyph> g) {
+    Profile::Dialogue::DialogueFont->DrawProcessedText(g, alpha, RendererOutlineMode::None);
+  };
+  draw(Text(0, {0x103 * k, 0x92 * k}));
+  draw(Text(2, {0x150 * k, 0x92 * k}));
+  draw(Text(4, {0x235 * k, 0x92 * k}));
+  for (int i = 0; i < Rows; i++) {
+    const int e = Scroll + i;
+    const float y = (0xae + 0x1c * i) * k;
+    char num[8];
+    std::snprintf(num, sizeof(num), "%02d", e + 1);
+    draw(TextLayoutPlainString(num, *Profile::Dialogue::DialogueFont, 20 * k, DialogueColorPair{0xffffff, 0}, 1.0f,
+                               {0x10d * k, y}, TextAlignment::Left));
+    if (!Unlocked[e]) {
+      draw(Text(3, {0x19f * k, y}));
+    } else {
+      auto title = Text((e + 2) * 3 + 1, {0x150 * k, y});
+      Fit(title, 0xcd * k);
+      draw(std::move(title));
+      auto artist = Text((e + 2) * 3 + 2, {0x235 * k, y});
+      Fit(artist, 0x274 * k);
+      draw(std::move(artist));
+    }
+  }
+}
