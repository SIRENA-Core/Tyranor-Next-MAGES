+
+// The flip clock of a time leap (Game.exe 0x41a140 / 0x41a960 / 0x418d60), see timeleap.cpp.
+
+namespace Impacto {
+namespace SGHD {
+namespace TimeLeap {
+
+// 10:3A: from date (MMDD), from time (hhmm), to date, to time, an unused value, the buffer of the texture
