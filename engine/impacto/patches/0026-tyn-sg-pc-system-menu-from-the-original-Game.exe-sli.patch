   MenuEntriesTargetWidth = EnsureGetMember<float>("MenuEntriesTargetWidth");
   SystemMenuX = EnsureGetMember<float>("SystemMenuX");
   SystemMenuY = EnsureGetMember<float>("SystemMenuY");
