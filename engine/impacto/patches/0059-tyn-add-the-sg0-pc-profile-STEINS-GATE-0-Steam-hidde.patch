+--  9 font_a, 10 font_b, 11 font2_a, 12 font2_b, 13 gsysmes, 14 help, 15 menuchip, 16 meswin, 17 phone, 18 phone_b,
+--  19 phone3, 20 pwcg, 21 savemenu, 22 sysm_savemenu, 23 sysm_tips, 24 tipschips, 25 title_chip, 26..28 title_logo1..3,
+--  29 wavtable.dat, 30 phone_rine.
+-- Sheets whose screens are not ported yet alias the closest sheet so that the HUD definitions load.
+local function sheet(id, w, h, scriptHandled)
+    return { Path = { Mount = "system", Id = id }, DesignWidth = w, DesignHeight = h, ScriptHandled = scriptHandled };
+end
