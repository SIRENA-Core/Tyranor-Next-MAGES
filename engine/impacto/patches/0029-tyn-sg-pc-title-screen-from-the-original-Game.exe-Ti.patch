+++ b/src/profile/games/sghd/titlemenu.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <vector>
+
+#include "../../../spritesheet.h"
+#include "../../../util.h"
+
+// Title screen of the STEINS;GATE (Steam, 2016) generation of the MAGES. PC engine. Main entries, sub lists, the
+// flickering decoration, the button guide, positions and timings are profile data (taken from the original Game.exe,
+// see the sg-pc profile); the main entry sprites and "press start" come from the common title menu fields.
+namespace Impacto {
+namespace Profile {
+namespace SGHD {
+namespace TitleMenu {
+
+struct FlickerItem {
+  Sprite Sprite_;
+  glm::vec2 Position{};
+  bool Random = false;  // shown or hidden at random (re-chosen every 10..39 frames); otherwise always
+};
+
+struct SubItem {
+  Sprite Normal;
+  Sprite Highlighted;
+  glm::vec2 Position{};  // when fully open
+  RectF HitArea{};
+  int Id = 0;  // SW_TITLECUR1 value
+};
+
+struct SubList {
+  int Entry = 0;      // main entry that opens it
+  int IfFlag = -1;    // used when this flag is set ...
+  int IfNotFlag = -1;  // ... or not set (-1: no condition)
+  Sprite Bracket;
+  glm::vec2 BracketPosition{};  // when fully open
+  std::vector<SubItem> Items;
+};
+
+inline Sprite BackgroundSprite;
+inline std::vector<FlickerItem> FlickerItems;
+inline Sprite FlickerBarSprite;  // drawn with one of FlickerBarWidths, chosen at random
+inline glm::vec2 FlickerBarPosition{};
+inline std::vector<float> FlickerBarWidths;
+inline Sprite GuideSprite;
+inline glm::vec2 GuidePosition{};
+
+inline float PressToStartBlinkFrames = 64.0f;  // mode 1; mode 2 blinks with SW_TITLEDISPCT & 15
+inline glm::vec2 MenuPosition{};               // first main entry when fully shown
+inline float MenuSpacing = 0.0f;
+inline float MenuSlideDistance = 0.0f;  // the entries come in from the right while the menu fades in
+inline std::vector<RectF> MenuHitAreas;
+inline std::vector<int> MenuEntryIds;  // SW_TITLECUR1 values (entries with a sub list open it instead)
+inline std::vector<SubList> SubLists;
+inline float SubOpenFrames = 32.0f;
+inline float SubSlideDistance = 0.0f;  // sub lists come in from the right while they open
+inline float DecideFrames = 64.0f;     // the chosen entry blinks this long before the script is told
+inline int DecideBlinkFrames = 8;
+
+void Configure();
+
+}  // namespace TitleMenu
+}  // namespace SGHD
+}  // namespace Profile
+}  // namespace Impacto
