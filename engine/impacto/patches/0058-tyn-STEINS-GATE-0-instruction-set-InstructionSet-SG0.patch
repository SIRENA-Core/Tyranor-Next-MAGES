diff --git a/src/vm/inst_sg0.h b/src/vm/inst_sg0.h
new file mode 100644
index 0000000000000000000000000000000000000000..4b80c35bc9639e538ddee10a9e29821987cc7d79
--- /dev/null
+++ b/src/vm/inst_sg0.h
@@ -0,0 +1,176 @@
+#pragma once
+// STEINS;GATE 0 (Steam) instructions whose operands or meaning differ from STEINS;GATE (Steam), whose dialect it
+// otherwise shares. Header-only on purpose (like the opcode tables): vm.cpp is the only user.
+// Addresses are functions of the S;G0 Game.exe (opcode tables 0xdcc198 system, 0xdcc320 user 1).
+#include "inst_sghd.h"
+#include "../inputsystem.h"
+#include "../util.h"
+#include "../profile/game.h"
+#include "../profile/vm.h"
+#include "inst_controlflow.h"
+#include "interface/input.h"
+
+namespace Impacto {
+
+namespace Vm {
+
+namespace Sg0Detail {
+
+inline uint16_t ReadU16(Sc3VmThread* thread) {
+  const uint16_t v = SDL_Swap16LE(UnalignedRead<uint16_t>(thread->GetIp()));
+  thread->IpOffset += 2;
+  return v;
+}
+
+inline uint8_t ReadU8(Sc3VmThread* thread) {
+  const uint8_t v = *thread->GetIp();
+  thread->IpOffset += 1;
+  return v;
+}
+
+// Pushes the return id of the current script buffer and continues at labelAdr of scriptBufferId (the original stores
+// the return label and the buffer at thread + 0x30 / + 0x50, at most 8 deep).
+inline void PushAndJump(Sc3VmThread* thread, uint16_t retNum, uint32_t scriptBufferId, uint32_t labelAdr) {
+  if (thread->CallStackDepth == MaxCallStackDepth) {
+    ImpLog(LogLevel::Error, LogChannel::VM, "SG0 conditional call: call stack overflow\n");
+    return;
+  }
+  if (Profile::Vm::UseReturnIds) {
+    thread->ReturnIds[thread->CallStackDepth] = retNum;
+  } else {
+    thread->ReturnAddresses[thread->CallStackDepth] = thread->IpOffset;
+  }
+  thread->ReturnScriptBufferIds[thread->CallStackDepth++] = thread->ScriptBufferId;
+  thread->ScriptBufferId = scriptBufferId;
+  thread->IpOffset = labelAdr;
+}
+
+}  // namespace Sg0Detail
+
+// 00:53 (0x47f4d0): one byte, an expression and a label that the original reads and ignores.
+inline void InstSg0Unk0053(Sc3VmThread* thread, float dt) {
+  thread->IpOffset += 3;
+  (void)ExpressionEval(thread);
+  thread->IpOffset += 2;
+}
+
+// 00:54 (0x47f510): CallIfFlag(value, flag, label, return id): call the local label when the flag equals the value.
+inline void InstSg0CallIfFlag(Sc3VmThread* thread, float dt) {
+  using namespace Sg0Detail;
+  thread->IpOffset += 2;
+  const uint8_t value = ReadU8(thread);
+  const int flag = ExpressionEval(thread);
+  const uint32_t labelAdr = ScriptGetLabelAddress(thread->ScriptBufferId, ReadU16(thread));
+  const uint16_t retNum = ReadU16(thread);
+  if (GetFlag(flag) == (bool)value) PushAndJump(thread, retNum, thread->ScriptBufferId, labelAdr);
+}
+
+// 00:55 (0x47f5c0): JumpFarIfFlag(value, flag, script buffer, label).
+inline void InstSg0JumpFarIfFlag(Sc3VmThread* thread, float dt) {
+  using namespace Sg0Detail;
+  thread->IpOffset += 2;
+  const uint8_t value = ReadU8(thread);
+  const int flag = ExpressionEval(thread);
+  const int scriptBufferId = ExpressionEval(thread);
+  const uint32_t labelAdr = ScriptGetLabelAddress(scriptBufferId, ReadU16(thread));
+  if (GetFlag(flag) == (bool)value) {
+    thread->ScriptBufferId = scriptBufferId;
+    thread->IpOffset = labelAdr;
+  }
+}
+
+// 00:56 (0x47f640): CallFarIfFlag(value, flag, script buffer, label, return id).
+inline void InstSg0CallFarIfFlag(Sc3VmThread* thread, float dt) {
+  using namespace Sg0Detail;
+  thread->IpOffset += 2;
+  const uint8_t value = ReadU8(thread);
+  const int flag = ExpressionEval(thread);
+  const int scriptBufferId = ExpressionEval(thread);
+  const uint32_t labelAdr = ScriptGetLabelAddress(scriptBufferId, ReadU16(thread));
+  const uint16_t retNum = ReadU16(thread);
+  if (GetFlag(flag) == (bool)value) PushAndJump(thread, retNum, scriptBufferId, labelAdr);
+}
+
+// 00:58 (0x47f770): mouse on jump. Types 2 / 3 take a rectangle (x, y, w, h) and jump when it is clicked (2) or only
+// hovered (3); the other types take a button mask (1 left, 2 right, 4 middle, 8 wheel up, 0x100000 wheel down,
+// 0x200000 any button) and jump when "the mask went down" equals the type.
+inline void InstSg0MouseOnJump(Sc3VmThread* thread, float dt) {
+  using namespace Sg0Detail;
+  thread->IpOffset += 2;
+  const uint8_t type = ReadU8(thread);
+  int rect[4] = {};
+  int mask = 0;
+  if (type == 2 || type == 3) {
+    for (int& v : rect) v = ExpressionEval(thread);
+  } else {
+    mask = ExpressionEval(thread);
+  }
+  const uint32_t labelAdr = ScriptGetLabelAddress(thread->ScriptBufferId, ReadU16(thread));
+
+  using namespace Impacto::Input;
+  if (type == 2 || type == 3) {
+    // the script rectangles are in the 1280x720 space of the original
+    const float scale = Profile::Game::DesignWidth / 1280.0f;
+    const RectF area(rect[0] * scale, rect[1] * scale, rect[2] * scale, rect[3] * scale);
+    const bool inside = area.ContainsPoint(CurMousePos);
+    const bool clicked = inside && MouseButtonWentDown[SDL_BUTTON_LEFT];
+    if ((type == 2 && clicked) || (type == 3 && inside && !clicked)) thread->IpOffset = labelAdr;
+    return;
+  }
+  bool down = false;
+  if ((mask & 0x200000) && (MouseButtonWentDown[SDL_BUTTON_LEFT] || MouseButtonWentDown[SDL_BUTTON_RIGHT] ||
+                            MouseButtonWentDown[SDL_BUTTON_MIDDLE]))
+    down = true;
+  if ((mask & 1) && MouseButtonWentDown[SDL_BUTTON_LEFT]) down = true;
+  if ((mask & 2) && MouseButtonWentDown[SDL_BUTTON_RIGHT]) down = true;
+  if ((mask & 4) && MouseButtonWentDown[SDL_BUTTON_MIDDLE]) down = true;
+  if ((mask & 8) && MouseWheelDeltaY > 0) down = true;
+  if ((mask & 0x100000) && MouseWheelDeltaY < 0) down = true;
+  if ((bool)type == down) thread->IpOffset = labelAdr;
+}
+
+// 00:59 (0x47f980): keyboard on jump(type, key, mode, label). Bit 1 of the type picks a configurable key (KBcustom)
+// instead of a key code; mode 0 tests "is down", 1 "went down"; the jump is taken when the result equals bit 0.
+inline void InstSg0KeyboardOnJump(Sc3VmThread* thread, float dt) {
+  using namespace Sg0Detail;
+  thread->IpOffset += 2;
+  const uint8_t type = ReadU8(thread);
+  const int key = ExpressionEval(thread);
+  const int mode = ExpressionEval(thread);
+  const uint32_t labelAdr = ScriptGetLabelAddress(thread->ScriptBufferId, ReadU16(thread));
+  if (mode != 0 && mode != 1) {
+    if (type & 1) thread->IpOffset = labelAdr;  // the original compares against an unset result
+    return;
+  }
+  using namespace Impacto::Input;
+  std::span<const bool> keys = mode == 0 ? std::span<const bool>(KeyboardButtonIsDown)
+                                         : std::span<const bool>(KeyboardButtonWentDown);
+  bool result;
+  if (type & 2) {
+    result = Interface::GetKbCustom(key, [&](KeyboardScanCode code) { return keys[code]; });
+  } else {
+    result = key >= 0 && key < (int)keys.size() && keys[key];
+  }
+  if (result == (bool)(type & 1)) thread->IpOffset = labelAdr;
+}
+
+// 10:37 (0x482df0): the RINE messenger and phone group. Operands per type as the original reads them
+// (h = label / u16, E = expression); types the original does not handle take no operands.
+inline void InstSg0Group1037(Sc3VmThread* thread, float dt) {
+  static constexpr SghdDetail::SubShape Shapes[] = {
+      {0x00, "hhhhhhh"}, {0x01, ""},   {0x02, ""},   {0x03, ""},    {0x04, ""},    {0x0a, "h"}, {0x0b, ""},
+      {0x0c, "EE"},      {0x0d, "EE"}, {0x0f, "EEE"}, {0x28, ""},   {0x29, ""},    {0x2a, "E"}, {0x2b, "E"},
+      {0x2c, "E"},       {0x2d, "E"},  {0x2e, "EEE"}, {0x2f, ""},   {0x30, "E"},   {0x31, "EE"}, {0x32, "h"},
+  };
+  SghdDetail::RunGroup(thread, "SG0 RINE 10:37", Shapes);
+}
+
+// 10:38 (0x4831a0): type byte, a label when the type is 0. Not used by the shipped scripts.
+inline void InstSg0Group1038(Sc3VmThread* thread, float dt) {
+  static constexpr SghdDetail::SubShape Shapes[] = {{0x00, "h"}};
+  SghdDetail::RunGroup(thread, "SG0 10:38", Shapes);
+}
+
+}  // namespace Vm
+
+}  // namespace Impacto
