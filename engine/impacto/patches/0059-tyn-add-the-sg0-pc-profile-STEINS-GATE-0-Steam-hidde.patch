@@ -0,0 +1,46 @@
+-- STEINS;GATE (Steam) HELP screen, HelpMenuType.SGHD. Everything below is taken from the original Game.exe: the draw
+-- routine 0x4351f0, the input routine 0x435640, Help(Init) 0x4355a0 and the hit areas at 0x52b670 (group 11).
+--   * the pages are the full screen pictures of manual.mpk (PAGE1 keyboard & mouse, PAGE2 controller; localised data
+--     brings its own); while SW_SYSSUBMENUCT counts 0..32 the page comes in from x = -400 and fades in with it;
+--   * on a page change the new page slides in over the old one in 16 frames, 48 px per frame, fading in: next page
+--     (and the tabs) from the left, previous page from the right;
+--   * DATA01: page number (55 x 60 per digit from 0, 808) at (1715, 858) and the page count (110, 808, 60 x 60) at
+--     (1760, 858); two tabs (87 x 32 at 1678 + 65 i, 935): grey (87, 868), the hovered one yellow (174, 868), else the
+--     current page's one blue (0, 868), both blinking over 32 frames; the button guide (1, 1747, 1534 x 40) at (1, 995).
+-- The original draws the controller page's button names over PAGE2 only when a pad layout is configured in its
+-- launcher; there is none on this platform, so the page shows as the original without one.
+
+for i = 0, 1 do
+    root.SpriteSheets["ManualPage" .. i] = {
+        Path = { Mount = "manual", Id = i },
+        DesignWidth = 1920,
+        DesignHeight = 1080
+    };
+    root.Sprites["HelpPage" .. i] = { Sheet = "ManualPage" .. i, Bounds = { X = 0, Y = 0, Width = 1920, Height = 1080 } };
+end
+
+local function data(name, x, y, w, h)
+    root.Sprites[name] = { Sheet = "Data", Bounds = { X = x, Y = y, Width = w, Height = h } };
+    return name;
+end
+
+root.HelpMenu = {
+    Type = HelpMenuType.SGHD,
+    DrawType = DrawComponentType.SystemMenu,
+    Pages = { "HelpPage0", "HelpPage1" },
+    PageNumberSprites = { data("HelpPageNumber0", 0, 808, 55, 60), data("HelpPageNumber1", 55, 808, 55, 60) },
+    PageNumberPosition = { X = 1715, Y = 858 },
+    PageCountSprite = data("HelpPageCount", 110, 808, 60, 60),
+    PageCountPosition = { X = 1760, Y = 858 },
+    TabSprite = data("HelpTab", 87, 868, 87, 32),
+    TabHoverSprite = data("HelpTabHover", 174, 868, 87, 32),
+    TabCurrentSprite = data("HelpTabCurrent", 0, 868, 87, 32),
+    TabPositions = { { X = 1678, Y = 935 }, { X = 1743, Y = 935 } },
+    TabHitAreas = { { X = 1692, Y = 935, Width = 60, Height = 32 }, { X = 1758, Y = 935, Width = 60, Height = 32 } },
+    GuideSprite = data("HelpGuide", 1, 1747, 1534, 40),
+    GuidePosition = { X = 1, Y = 995 },
+    EnterDistance = 400,
+    PageSlideFrames = 16,
+    PageSlideStep = 48,
+    BlinkFrames = 32,
+};
