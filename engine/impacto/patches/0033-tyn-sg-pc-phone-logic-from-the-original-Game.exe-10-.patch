+// 0x4579a0 mode 29: set or listen to a ringtone
+void ModeRingtoneActions() {
+  if (Cancel()) {
+    SetMode(SW(0x6aec) == 1 ? 0xf : 0x10);
+    if (MouseMode()) SW(0x6af0) = 0xff;
+    return;
+  }
+  S.Hover = 0;
+  if (MouseMode()) {
+    SW(0x6af8) = 0xff;
+    if (Hit(10, 1)) S.Hover = 1, SW(0x6af8) = 0;
+    if (SW(0x6af0) != 0 && Hit(0xb, 1)) S.Hover = 1, SW(0x6af8) = 1;
+    if (Hit(10, 8)) ClickDecide();
+    if (SW(0x6af0) != 0 && Hit(0xb, 8)) ClickDecide();
+  }
+  if (Decide() && SW(0x6af8) != 0xff) {
+    const int sel = SW(0x6af0);
+    if (SW(0x6af8) == 1 || sel == 0) {
+      SetMode(0x1e);
+      const int col = SW(0x6aec) == 1 ? 0 : 1;
+      const int var = SW(0x6aec) == 1 ? 0x1f6c : 0x1f74;
+      SW(var) = sel == 0 ? 0xffff : S.Ringtones[S.RingtoneList[sel - 1]][col];
+    } else {
+      SetMode(0x1f);
+      const uint32_t r = S.RingtoneList[sel - 1];
+      S.PlayTime = 0;
+      S.ReturnMode = (SW(0x6aec) != 1) + 0xf;
+      S.Unk_6f54 = 0;
+      S.PlayingIdx = r;
+      S.Unk_6f58 = 0x78;
+      S.PlayingId = S.Ringtones[r][0];
+      PlayBgm(S.PlayingId, true);
+    }
+  }
+  for (bool pressed : {Up(), Down()}) {
+    if (!pressed) continue;
+    if ((uint32_t)SW(0x6af8) == 0xff)
+      SW(0x6af8) = 0;
+    else if (SW(0x6af0) != 0)
+      SW(0x6af8) ^= 1;
+  }
+}
