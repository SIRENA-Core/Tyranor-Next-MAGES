+// Phone screens, part 3: the phone trigger mail, ringtone / wallpaper / vibration actions, music, attachments.
+#include "phonerender.h"
+#include "phonestate.h"
+
+#include <cstdio>
+
+#include "../../mem.h"
+
+namespace Impacto {
+namespace SGHD {
+namespace Phone {
+
+namespace {
+constexpr float Scale = 1.5f;
+
+// 0x450980 mode 27: a received mail whose underlined words can be chosen (selected word S.LinkSel)
+void DrawTriggerMail(int x, int y, int alpha) {
+  const int mail = SW(0x6a5c);
+  DrawMailWithLinks(2, mail, SW(0x6a74), SW(0x6a78), 2278.5f, !MailBit(mail, 4), (int)S.LinkSel, x, y, alpha);
+}
+
+// 0x4511a0 mode 28
+void DrawTriggerActions(int x, int y, int alpha) {
+  DrawTriggerMail(x, y, alpha);
+  const int mail = SW(0x6a5c);
+  const bool canAnswer = GetFlag(0xa29) && GetFlag(0xa35) && mail == SW(0x6aa0) && S.Mails[mail][MailReply] != 999 &&
+                         !MailBit(mail, 4) && S.LinkSel != 0xff;
+  const bool attach = S.Mails[mail][MailAttach] != 999;
+  if (!canAnswer && !attach) return;
+  if (canAnswer && attach)
+    DrawChoice(10, 0xb, SW(0x6a80), x, y + 0x1d, alpha);
+  else if (!canAnswer)
+    DrawChoice(0xb, 9999, SW(0x6a80), x, y + 0x1d, alpha);
+  else
+    DrawChoice(10, 9999, SW(0x6a80), x, y + 0x1d, alpha);
+}
+
+void DrawRingtoneList(int x, int y, int alpha) {
+  DrawRemainingScreens(SW(0x6aec) == 1 ? 0xf : 0x10, x, y, alpha);
+}
+void DrawFourList(int x, int y, int alpha) { DrawRemainingScreens(SW(0x6aec) == 3 ? 0x11 : 0x12, x, y, alpha); }
+
+// 0x451870 modes 31 / 206: playing a piece of music (name scrolls when too long, play time)
+void DrawMusic(int x, int y, int alpha) {
+  const int surf = PhoneSurface();
+  Spr(surf, 877.5f, 1293, 297, 45, x + 0x24, y + 0x3c, alpha);
+  DrawDotsRing(x, y - 0x18, alpha);
+  const uint8_t* name = Str(S.Ringtones[S.PlayingIdx][2] + S.StrBaseA);
+  const uint8_t* from = name;
+  if (TextWidth(name, 0x18) > 0xdc) {
+    if (S.Unk_6f58 == 0) {
+      S.Unk_6f54++;
+      S.Unk_6f58 = 8;
+    } else {
+      S.Unk_6f58--;
+    }
+    uint32_t i = 0;
+    bool end = false;
+    for (; i < S.Unk_6f54; i++, from += 2)
+      if (from[1] == 0xff) {
+        end = true;
+        break;
+      }
+    if (end || *from == 0xff) {
+      S.Unk_6f58 = 0x78;
+      S.Unk_6f54 = 0;
+      from = name;
+    }
+  }
+  Text(x + 0x18, y + 0x94, 0xdc, from, 0, 1, 0xffffff, 0x18, alpha);
+  Spr(surf, 2239.5f, 1060.5f, 414, 75, x, y + 0xec, alpha);
+  const uint32_t secs = S.PlayTime / 0x3c;
+  char t[16];
+  std::snprintf(t, sizeof(t), "%02u:%02u:%02u", (secs / 0xe10) % 100, (secs % 0xe10) / 0x3c, (secs % 0xe10) % 0x3c);
+  int dx = x + 0x28;
+  for (int i = 0; i < 8; i++, dx += 0x18) {
+    const int sx = t[i] == ':' ? 0x29e : (t[i] - '0') * 0x18 + 0x14e;
+    Spr(surf, (float)(sx + 1) * Scale, 1366.5f, 33, 45, dx, y + 0xd6, alpha);
+  }
+}
+
+}  // namespace
+
+void DrawLastScreens(int mode, int x, int y, int alpha) {
+  switch (mode) {
+    case 0x1b: DrawTriggerMail(x, y, alpha); break;
+    case 0x1c: DrawTriggerActions(x, y, alpha); break;
+    case 0x1d:  // 0x4512d0: set / listen
+      DrawRingtoneList(x, y, alpha);
+      if (SW(0x6af0) == 0)
+        DrawChoice(0x16, 9999, SW(0x6af8), x, y + 0x1d, alpha);
+      else
+        DrawChoice(0x15, 0x16, SW(0x6af8), x, y + 0x1d, alpha);
+      break;
+    case 0x1e:  // 0x451810: "set"
+      DrawRingtoneList(x, y, alpha);
+      DrawPanel(SW(0x6aec) == 1 ? 0x22 : 0x33, x, y + 0x1d, 0, alpha);
+      break;
+    case 0x1f:
+    case 0xce: DrawMusic(x, y, alpha); break;
+    case 0x20:  // 0x451c50
+      DrawFourList(x, y, alpha);
+      if (SW(0x6af0) == 0)
+        DrawChoice(0x16, 9999, SW(0x6af8), x, y + 0x1d, alpha);
+      else
+        DrawChoice(0x32, 0x16, SW(0x6af8), x, y + 0x1d, alpha);
+      break;
+    case 0x21:  // 0x451cc0
+      DrawFourList(x, y, alpha);
+      DrawPanel(SW(0x6aec) == 3 ? 0x34 : 0x35, x, y + 0x1d, 0, alpha);
+      break;
+    case 0x22:  // 0x451d20: send the answer?
+      DrawMoreScreens(0x16, x, y, alpha);
+      DrawChoice(0x36, 0x37, SW(0x6afc), x, y + 0x1d, alpha);
+      break;
+    case 0x23:  // 0x451d60
+      DrawRemainingScreens(0xe, x, y, alpha);
+      DrawChoice(0x4c, 0x16, SW(0x6af8), x, y + 0x1d, alpha);
+      break;
+    case 0x24:  // 0x451da0
+      DrawRemainingScreens(0xe, x, y, alpha);
+      DrawPanel(0x4b, x, y + 0x1d, 0, alpha);
+      break;
+    case 0x25: DrawWallpaper(x, y, alpha); break;  // 0x45c150
+    case 0x26:  // 0x451dd0
+      DrawFourList(x, y, alpha);
+      if (SW(0x6af0) == 0)
+        DrawChoice(0x16, 9999, SW(0x6af8), x, y + 0x1d, alpha);
+      else
+        DrawChoice(0x32, 0x16, SW(0x6af8), x, y + 0x1d, alpha);
+      DrawPanel(0x4f, x, y + 0x1d, 0, alpha);
+      break;
+    case 0x27: {  // 0x451e50
+      DrawMoreScreens(6, x, y, alpha);
+      if (!GetFlag(0xa2a))
+        DrawChoice(0x10, 9999, 0, x, y + 0x1d, alpha);
+      else if (!GetFlag(0xa2b))
+        DrawChoice(0x11, 9999, 0, x, y + 0x1d, alpha);
+      else
+        DrawChoice(0x10, 0x11, SW(0x6b04), x, y + 0x1d, alpha);
+      break;
+    }
+    case 0x28:  // 0x452400
+      DrawMoreScreens(0x16, x, y, alpha);
+      DrawChoice(0x36, 9999, SW(0x6afc), x, y + 0x1d, alpha);
+      break;
+    case 200:
+    case 0xc9:
+    case 0xca:
+    case 0xcb:
+    case 0xcc:
+    case 0xcd:
+    case 0xcf:
+    case 0xd0:
+    case 0xd1:  // 0x44fb60: the mail stays on the phone while an attachment is shown
+      if (S.ReturnMode == 5)
+        DrawMoreScreens(5, x, y, alpha);
+      else if (S.ReturnMode == 0x1b)
+        DrawTriggerMail(x, y, alpha);
+      break;
+    default: break;
+  }
+}
