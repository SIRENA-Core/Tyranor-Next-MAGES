diff --git a/src/games/sghd/helpmenu.cpp b/src/games/sghd/helpmenu.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..51efea0c0c8dd8a6c95756893935041f91fc720c
--- /dev/null
+++ b/src/games/sghd/helpmenu.cpp
@@ -0,0 +1,162 @@
+#include "helpmenu.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "../../profile/games/sghd/helpmenu.h"
+#include "../../ui/ui.h"
+#include "../../profile/scriptvars.h"
+#include "../../renderer/renderer.h"
+#include "../../mem.h"
+#include "../../inputsystem.h"
+#include "../../vm/interface/input.h"
+#include "../../audio/audiosystem.h"
+
+namespace Impacto {
+namespace UI {
+namespace SGHD {
+
+using namespace Impacto::Profile::SGHD::HelpMenu;
+using namespace Impacto::Profile::ScriptVars;
+using namespace Impacto::Vm::Interface;
+
+namespace {
+constexpr int SubMenuHelp = 11;
+}
+
+// The original draws the screen whenever the script's submenu number is HELP; its opacity is
+// SW_SYSSUBMENUCT / 32 * SW_SYSSUBMENUALPHA / 256.
+bool HelpMenu::ScriptShown() const {
+  return ScrWork[SW_SYSSUBMENUNO] == SubMenuHelp && ScrWork[SW_SYSSUBMENUCT] > 0 &&
+         ScrWork[SW_SYSSUBMENUALPHA] > 0;
+}
+
+void HelpMenu::Show() {
+  if (State == Shown) return;
+  State = Shown;
+  // the original's Help(Init) starts at the first page every time
+  CurrentPage = PreviousPage = 0;
+  SlideCounter = 0.0f;
+  HoveredTab = -1;
+  if (UI::FocusedMenu != nullptr && UI::FocusedMenu != this) {
+    LastFocusedMenu = UI::FocusedMenu;
+    LastFocusedMenu->IsFocused = false;
+  }
+  IsFocused = true;
+  UI::FocusedMenu = this;
+}
+
+void HelpMenu::Hide() {
+  if (State == Hidden) return;
+  State = Hidden;
+  if (LastFocusedMenu != nullptr) {
+    UI::FocusedMenu = LastFocusedMenu;
+    LastFocusedMenu->IsFocused = true;
+  } else {
+    UI::FocusedMenu = nullptr;
+  }
+  LastFocusedMenu = nullptr;
+  IsFocused = false;
+}
+
+void HelpMenu::Update(float dt) {
+  const bool shown = ScriptShown();
+  if (shown && State == Hidden) Show();
+  if (!shown && State != Hidden) Hide();
+  if (State != Shown) return;
+  // keep the menu focus while shown (the title menu would otherwise take the input of this screen)
+  if (UI::FocusedMenu != this) {
+    if (UI::FocusedMenu != nullptr) {
+      LastFocusedMenu = UI::FocusedMenu;
+      LastFocusedMenu->IsFocused = false;
+    }
+    UI::FocusedMenu = this;
+    IsFocused = true;
+  }
+
+  const float frames = dt * 60.0f;
+  BlinkCounter = std::fmod(BlinkCounter + frames, BlinkFrames);
+  if (SlideCounter > 0.0f) {
+    SlideCounter = std::max(0.0f, SlideCounter - frames);
+    return;  // as the original: no input while a page slides in
+  }
+  if (ScrWork[SW_SYSSUBMENUCT] >= 32 && ScrWork[SW_SYSSUBMENUALPHA] >= 256 && !GetFlag(SF_SUBMENUEXIT))
+    UpdateInput(dt);
+}
+
+void HelpMenu::ChangePage(int target, int direction) {
+  if (target == CurrentPage) return;
+  PreviousPage = CurrentPage;
+  CurrentPage = target;
+  // original: next page (and the tabs) bring the new page in from the left, previous page from the right
+  SlideDirection = (float)direction;
+  SlideCounter = PageSlideFrames;
+}
+
+void HelpMenu::UpdateInput(float dt) {
+  const int pages = (int)Pages.size();
+  if (pages == 0) return;
+
+  if ((PADinputButtonWentDown & PAD1B) || (PADinputMouseWentDown & PAD1B)) {
+    Audio::PlayInGroup(Audio::ACG_SE, "sysse", 3, false, 0.0f);
+    SetFlag(SF_SUBMENUEXIT, true);
+    SetFlag(SF_MANUALLOAD_END, true);  // ends the script's manual loading thread
+    PADinputButtonWentDown = PADinputMouseWentDown = 0;
+    return;
+  }
+
+  HoveredTab = -1;
+  const bool useMouse =
+      Input::CurrentInputDevice == Input::Device::Mouse || Input::CurrentInputDevice == Input::Device::Touch;
+  if (useMouse) {
+    for (int i = 0; i < (int)TabHitAreas.size() && i < pages; i++) {
+      if (!TabHitAreas[i].ContainsPoint(Input::CurMousePos)) continue;
+      HoveredTab = i;
+      if (PADinputMouseWentDown & PAD1A) ChangePage(i, -1);
+    }
+  }
+  if (SlideCounter == 0.0f) {
+    if ((PADinputButtonWentDown & PAD1R1) || Input::MouseWheelDeltaY < 0) ChangePage((CurrentPage + 1) % pages, -1);
+    else if ((PADinputButtonWentDown & PAD1L1) || Input::MouseWheelDeltaY > 0)
+      ChangePage((CurrentPage + pages - 1) % pages, 1);
+  }
+
+  // the screen owns the input while it is shown
+  PADinputButtonWentDown = 0;
+  PADinputMouseWentDown = 0;
+}
+
+void HelpMenu::Render() {
+  if (State != Shown || Pages.empty()) return;
+  const float ct = (float)std::clamp(ScrWork[SW_SYSSUBMENUCT], 0, 32);
+  const float alpha = ct / 32.0f * std::clamp(ScrWork[SW_SYSSUBMENUALPHA], 0, 256) / 256.0f;
+  if (alpha <= 0.0f) return;
+  const float x = ct / 32.0f * EnterDistance - EnterDistance;
+  const int pages = (int)Pages.size();
+  const int page = std::clamp(CurrentPage, 0, pages - 1);
+
+  if (SlideCounter > 0.0f)
+    Renderer->DrawSprite(Pages[std::clamp(PreviousPage, 0, pages - 1)], glm::vec2(x, 0.0f), glm::vec4(1.0f));
+  const float slide = SlideCounter / PageSlideFrames;
+  Renderer->DrawSprite(Pages[page], glm::vec2(x + SlideDirection * PageSlideStep * SlideCounter, 0.0f),
+                       glm::vec4(glm::vec3(1.0f), (1.0f - slide) * alpha));
+
+  const glm::vec4 col(glm::vec3(1.0f), alpha);
+  if (page < (int)PageNumberSprites.size()) Renderer->DrawSprite(PageNumberSprites[page], PageNumberPosition, col);
+  Renderer->DrawSprite(PageCountSprite, PageCountPosition, col);
+
+  // tabs; the hovered one, else the current page's one, blinks
+  const float half = BlinkFrames / 2.0f;
+  const float blink = (BlinkCounter < half ? BlinkCounter : BlinkFrames - BlinkCounter) / half;
+  const glm::vec4 blinkCol(glm::vec3(1.0f), alpha * blink);
+  for (int i = 0; i < (int)TabPositions.size() && i < pages; i++) {
+    Renderer->DrawSprite(TabSprite, TabPositions[i], col);
+    if (HoveredTab == i) Renderer->DrawSprite(TabHoverSprite, TabPositions[i], blinkCol);
+    else if (page == i) Renderer->DrawSprite(TabCurrentSprite, TabPositions[i], blinkCol);
+  }
+  Renderer->DrawSprite(GuideSprite, GuidePosition, col);
+}
+
+}  // namespace SGHD
+}  // namespace UI
+}  // namespace Impacto
diff --git a/src/games/sghd/helpmenu.h b/src/games/sghd/helpmenu.h
new file mode 100644
