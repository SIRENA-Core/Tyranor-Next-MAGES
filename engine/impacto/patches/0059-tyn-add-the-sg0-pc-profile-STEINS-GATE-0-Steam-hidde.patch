+    MinWidth = 441,
+    TextFontSize = 48,
+    TextX = 960,
+    TextMiddleY = 354,
+    TextLineHeight = 51,
+    TextMarginY = 0,
+    ShadowOffset = 1.5,
+    -- the global box (SystemMes modes 10..17, e.g. EXIT GAME) dims the screen with black at 3 / 4 of its opacity
+    GlobalDim = 0.75,
+    ChoiceRightX = 1020,
+    ChoiceY = 546,
+    ChoiceSpacing = 60,
+    ChoiceHitY = 547,
+    ChoiceHitHeight = 48,
+    HighlightSprite = data("SysMesBoxHighlight", 65, 1, 94, 30),
