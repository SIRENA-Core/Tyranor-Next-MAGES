+        yearNumFirstX = yearNumFirstX + yearNum1Width;
+        numFirstX = numFirstX + num1Width;
+    else
+        yearNumFirstX = yearNumFirstX + yearNumWidth;
+        numFirstX = numFirstX + numWidth;
+    end
+end
