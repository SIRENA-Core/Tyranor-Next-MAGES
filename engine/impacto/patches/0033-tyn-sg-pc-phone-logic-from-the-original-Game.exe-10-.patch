+// 0x459520 mode 6: address book
+void ModeAddressBook() {
+  if (Cancel()) {
+    if (!GetFlag(0x65f)) {
+      SW(0x6a70) = MouseMode() ? 0xff : 1;
+      SetMode(0x14);
+    }
+    return;
+  }
+  S.Hover = 0;
+  if (MouseMode()) {
+    SW(0x6a94) = 0xff;
+    for (uint32_t i = 0; i < S.ContactCount; i++)
+      if (Hit(i + 0xc, 1)) S.Hover = 1, SW(0x6a94) = i;
+    for (uint32_t i = 0; i < S.ContactCount; i++)
+      if (Hit(i + 0xc, 8)) ClickDecide();
+  }
+  if (Decide() && SW(0x6a94) != 0xff) {
+    SW(0x6b04) = 0;
+    if (GetFlag(0xa29)) {
+      const uint32_t c = S.Contacts[SW(0x6a94)];
+      if ((GetFlag(0xa2a) && S.CanMail[c]) || (GetFlag(0xa2b) && S.CanCall[c])) {
+        SetMode(7);
+        if (MouseMode()) SW(0x6b04) = 0xff;
+        return;
+      }
+    }
+  }
+  if (Up()) {
+    const uint32_t row = SW(0x6a94);
+    SW(0x6a94) = row == 0xff ? 0 : (row == 0 ? S.ContactCount : row) - 1;
+  }
+  if (Down()) {
+    const uint32_t row = SW(0x6a94);
+    SW(0x6a94) = (row != 0xff && row < S.ContactCount - 1) ? row + 1 : 0;
+  }
+}
