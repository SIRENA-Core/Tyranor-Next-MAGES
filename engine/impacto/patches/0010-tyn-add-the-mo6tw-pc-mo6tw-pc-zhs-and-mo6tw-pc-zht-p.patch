+    ["Default"] = {
+        Type = FontType.SingleSheet,
+        Sheet = "Font",
+        GridSize = { X = 64, Y = 125 },
+        AdvanceWidthsTable = {},
+        AdvanceWidthsEmWidth = 48,
+    }
+};
+
+local overrides = root.Mo6PcAdvanceOverrides;
+for i = 1, (64 * 125) do
