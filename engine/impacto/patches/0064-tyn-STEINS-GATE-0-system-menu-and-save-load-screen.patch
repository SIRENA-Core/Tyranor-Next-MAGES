+
+// the C library of the original
+void FUN_004d2bf0(Arg dst, Arg src, Arg n) { std::memmove(dst.P<void>(), src.P<const void>(), n.U()); }
+int FID_conflict___itoa_s(Arg value, Arg buf, Arg size, Arg radix) {
+  std::snprintf(buf.P<char>(), size.U(), radix.I() == 16 ? "%x" : "%d", value.I());
+  return 0;
+}
+int _strcat_s(Arg dst, Arg size, Arg src) {
+  char* d = dst.P<char>();
+  const size_t len = std::strlen(d);
+  std::snprintf(d + len, size.U() > len ? size.U() - len : 0, "%s", src.P<const char>());
+  return 0;
+}
