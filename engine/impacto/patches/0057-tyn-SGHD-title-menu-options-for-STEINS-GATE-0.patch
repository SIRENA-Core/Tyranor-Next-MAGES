+// S;G0 (0x45b030): the pieces at (256 - pieceAlpha) / 2 every frame, then 0..3 dots, the last ones first.
+void TitleMenu::RenderFlickerSg0(int pieceAlpha, int dotAlpha) {
+  const glm::vec4 pieces(glm::vec3(1.0f), (256 - pieceAlpha) * 0.5f / 256.0f);
+  for (size_t i = 0; i < FlickerItems.size(); i++)
+    if (!FlickerItems[i].Random || FlickerOn[i])
+      Renderer->DrawSprite(FlickerItems[i].Sprite_, FlickerItems[i].Position, pieces);
+  if (FlickerDotCounts.empty() || dotAlpha <= 0) return;
+  const int total = (int)FlickerDotPositions.size();
+  const int count = std::min(FlickerDotCounts[std::clamp(BarChoice, 0, (int)FlickerDotCounts.size() - 1)], total);
+  const glm::vec4 dots(glm::vec3(1.0f), dotAlpha / 256.0f);
+  for (int i = total - count; i < total; i++) Renderer->DrawSprite(FlickerDotSprite, FlickerDotPositions[i], dots);
+}
+
+// S;G0 (0x45be40): the logo animation and the title text over it.
+void TitleMenu::RenderLogo(int alpha) {
+  if (LogoFrames.empty() || alpha <= 0) return;
+  const glm::vec4 col(glm::vec3(1.0f), alpha / 256.0f);
+  const int frame = (int)(LogoClock / std::max(LogoFrameTicks, 1.0f)) % (int)LogoFrames.size();
+  Renderer->DrawSprite(LogoFrames[frame], LogoPosition, col);
+  if (HasLogoText) Renderer->DrawSprite(LogoTextSprite, LogoTextPosition, col);
+}
+
+void TitleMenu::RenderSubList(const SubList& sub, bool hideChosen) {
+  const float c = SubCounter;
+  const int chosenItem = SubCursor[Cursor];
+  if (SubAnimation == 1) {
+    // S;G0 (0x45ac90 / 0x45b470 / 0x45ba80): pointer first, then bracket and items, uncovered by a wipe
+    const float start = std::min(SubFadeStartFrames, SubOpenFrames - 1.0f);
+    const float pointer = std::min(1.0f, c / std::max(start, 1.0f));
+    const float items = std::max(c - start, 0.0f) / (SubOpenFrames - start);
+    if (HasSubPointer) {
+      const float x = SubPointerPosition.x - SubPointerDistance + (int)(pointer * SubPointerDistance);
+      Renderer->DrawSprite(SubPointerSprite, glm::vec2(x, SubPointerPosition.y),
+                           glm::vec4(glm::vec3(1.0f), (int)(pointer * 256.0f) / 256.0f));
+    }
+    const glm::vec4 col(glm::vec3(1.0f), (int)(items * 256.0f) / 256.0f);
+    Renderer->DrawSprite(sub.Bracket, sub.BracketPosition, col);
+    for (int i = 0; i < (int)sub.Items.size(); i++) {
+      const bool chosen = chosenItem == i;
+      if (chosen && hideChosen) continue;
+      Renderer->DrawSprite(chosen ? sub.Items[i].Highlighted : sub.Items[i].Normal, sub.Items[i].Position, col);
+    }
+    if (SubWipeArea.Width > 0.0f) {
+      const float done = (float)(int)(items * SubWipeDistance);
+      Sprite wipe = BackgroundSprite;
+      wipe.Bounds = RectF(BackgroundSprite.Bounds.X + SubWipeArea.X + done, BackgroundSprite.Bounds.Y + SubWipeArea.Y,
+                          SubWipeArea.Width - done, SubWipeArea.Height);
+      if (wipe.Bounds.Width > 0.0f)
+        Renderer->DrawSprite(wipe, glm::vec2(SubWipeArea.X + done, SubWipeArea.Y), glm::vec4(1.0f));
+    }
+    return;
+  }
+  const glm::vec2 off(SubSlideDistance * (SubOpenFrames - c) / SubOpenFrames, 0.0f);
+  const glm::vec4 col(glm::vec3(1.0f), c / SubOpenFrames);
+  Renderer->DrawSprite(sub.Bracket, sub.BracketPosition + off, col);
+  for (int i = 0; i < (int)sub.Items.size(); i++) {
+    const bool chosen = chosenItem == i;
+    if (chosen && hideChosen) continue;
+    Renderer->DrawSprite(chosen ? sub.Items[i].Highlighted : sub.Items[i].Normal, sub.Items[i].Position + off, col);
+  }
+}
