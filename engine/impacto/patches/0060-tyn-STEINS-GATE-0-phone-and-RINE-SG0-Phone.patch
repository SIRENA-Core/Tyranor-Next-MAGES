+namespace {
+struct HitArea {
+  int Group, Index;
+  RectF Area;
+};
+std::vector<HitArea> Areas;  // registered since the last frame start
+std::vector<HitArea> Hovered;
+uint32_t FrameMouse = 0;
+int32_t FrameWheel = 0;
+}  // namespace
+
+// The input system of the original (0x4b1210 / 0x4b17a0): the areas registered during a frame decide what the mouse
+// is over at the start of the next one.
+void BeginFrame() {
+  Hovered.clear();
+  for (const HitArea& a : Areas)
+    if (a.Area.ContainsPoint(Input::CurMousePos)) Hovered.push_back(a);
+  Areas.clear();
+}
+
+void BridgeInput() {
+  using namespace Impacto::Vm::Interface;
+  *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x01979f10)) = PADinputButtonWentDown;
+  *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x01979f14)) = PADinputButtonIsDown;
+  *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x01979f18)) = PADinputButtonRepeatDown;
+  *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x01979f1c)) = PADinputButtonRepeatAccelDown;
+  // the configurable buttons (PADcustom) of the original at 0x197a1c0
+  for (size_t i = 0; i < PADcustom.size() && i < 64; i++)
+    *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x0197a1c0 + (uint32_t)i * 4)) = PADcustom[i];
+  *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x032fc7a0)) = FrameMouse;
+  *reinterpret_cast<int32_t*>(Sg0Emu::At(0x032fc7e0)) = FrameWheel;
+}
+
+// The mouse of this frame, taken before the scripts run (UpdateInput): while the phone is open the scene does not
+// get it; the phone's update reads it once.
+void CaptureInput() {
+  FrameMouse = MouseBits();
+  FrameWheel = Input::MouseWheelDeltaY > 0 ? 1 : Input::MouseWheelDeltaY < 0 ? -1 : 0;
+}
+
+// The mouse buttons that went down this frame as the original has them (1 left, 2 right, 4 middle); a tap is a left
+// click, a two finger tap a right click.
+uint32_t MouseBits() {
+  uint32_t mouse = 0;
+  if (Input::MouseButtonWentDown[SDL_BUTTON_LEFT] || Input::TouchTapCount == 1) mouse |= 1;
+  if (Input::MouseButtonWentDown[SDL_BUTTON_RIGHT] || Input::TouchTapCount == 2) mouse |= 2;
+  if (Input::MouseButtonWentDown[SDL_BUTTON_MIDDLE]) mouse |= 4;
+  return mouse;
+}
+
+// The phone's clicks do not reach the scene.
+void ClearMouse() {
+  for (bool& b : Input::MouseButtonWentDown) b = false;
+  Input::TouchTapCount = 0;
+  Impacto::Vm::Interface::PADinputMouseWentDown = 0;
+}
+
+// After the phone's update: the buttons it took (it clears them in its copy) are gone for the scripts too, and
+// the scene gets no clicks while the phone is open.
+void ConsumeInput() {
+  using namespace Impacto::Vm::Interface;
+  PADinputButtonWentDown &= *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x01979f10));
+  ClearMouse();
+  FrameMouse = 0;
+  FrameWheel = 0;
+  LoopFrames = 2;
+}
+
+// The ringtone list plays the ringtone through the BGM channel request of the original (0x2ed16e0 + channel * 0x98:
+// track, loop, ..., play request; channel DAT_00dde0f0, the BGM channel not playing) and stops it with track -1.
+// Here the ringtone plays on the second BGM channel while the scene's BGM waits.
+void BridgeAudio() {
+  const uint32_t channel = *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x00dde0f0)) & 1;
+  int32_t* req = reinterpret_cast<int32_t*>(Sg0Emu::At(0x02ed16e0 + channel * 0x98));
+  static int32_t playing = -1;
+  if (req[0] >= 0 && req[3] != 0) {
+    if (req[0] != playing) {
+      Audio::Channels[Audio::AC_BGM0]->Pause();
+      Audio::Channels[Audio::AC_BGM1]->Play("bgm", req[0], req[1] != 0, 0.0f);
+      playing = req[0];
+    }
+    req[3] = 0;
+  } else if (req[0] == -1 && playing != -1) {
+    Audio::Channels[Audio::AC_BGM1]->Stop(0.0f);
+    Audio::Channels[Audio::AC_BGM0]->Resume();
+    playing = -1;
+  }
+}
