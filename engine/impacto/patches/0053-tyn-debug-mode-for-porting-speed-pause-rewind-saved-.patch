+static int ThreadIndex(const Sc3VmThread* t) { return t ? (int)(t - ThreadPool) : -1; }
+static Sc3VmThread* ThreadAt(int i) { return i < 0 ? nullptr : &ThreadPool[i]; }
+
+void SaveVmState(VmState& out) {
+  out.Pool.resize(MaxThreads);
+  for (int i = 0; i < MaxThreads; i++) {
+    out.Pool[i].Data = ThreadPool[i];
+    out.Pool[i].Previous = ThreadIndex(ThreadPool[i].PreviousContext);
+    out.Pool[i].Next = ThreadIndex(ThreadPool[i].NextContext);
+    out.Pool[i].NextFree = ThreadIndex(ThreadPool[i].NextFreeContext);
+  }
+  for (int g = 0; g < MaxThreadGroups; g++) {
+    out.Heads[g] = ThreadIndex(ThreadGroupHeads[g]);
+    out.Tails[g] = ThreadIndex(ThreadGroupTails[g]);
+    out.Counts[g] = ThreadGroupCount[g];
+    out.States[g] = ThreadGroupState[g];
+  }
+  out.NextFree = ThreadIndex(NextFreeThreadCtx);
+  for (int b = 0; b < MaxLoadedScripts; b++)
+    out.ScriptIds[b] = ScriptBuffers[b].empty() ? -1 : (int)LoadedScriptMetas[b].Id;
+}
+
+void RestoreVmState(const VmState& in) {
+  for (int b = 0; b < MaxLoadedScripts; b++) {
+    const int current = ScriptBuffers[b].empty() ? -1 : (int)LoadedScriptMetas[b].Id;
+    if (in.ScriptIds[b] >= 0 && in.ScriptIds[b] != current) LoadScript(b, (uint32_t)in.ScriptIds[b]);
+  }
+  for (int i = 0; i < MaxThreads && i < (int)in.Pool.size(); i++) {
+    ThreadPool[i] = in.Pool[i].Data;
+    ThreadPool[i].PreviousContext = ThreadAt(in.Pool[i].Previous);
+    ThreadPool[i].NextContext = ThreadAt(in.Pool[i].Next);
+    ThreadPool[i].NextFreeContext = ThreadAt(in.Pool[i].NextFree);
+  }
+  for (int g = 0; g < MaxThreadGroups; g++) {
+    ThreadGroupHeads[g] = ThreadAt(in.Heads[g]);
+    ThreadGroupTails[g] = ThreadAt(in.Tails[g]);
+    ThreadGroupCount[g] = in.Counts[g];
+    ThreadGroupState[g] = in.States[g];
+  }
+  NextFreeThreadCtx = ThreadAt(in.NextFree);
+}
