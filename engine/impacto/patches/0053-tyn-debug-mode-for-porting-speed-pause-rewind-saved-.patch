+int MainThreadIndex() {
+  const int id = ScrWork[SW_MAINTHDP] & 0x7FFFFFFF;
+  return id >= 0 && id < Vm::MaxThreads ? id : -1;
+}
+
+std::string ScriptName(int buffer) {
+  if (buffer < 0 || buffer >= Vm::MaxLoadedScripts || Vm::ScriptBuffers[buffer].empty()) return "-";
+  return Vm::LoadedScriptMetas[buffer].FileName;
+}
+
+// the id of the last checkpoint: the line number in the script (SW_LINEID is not used by every game)
+int LastCheckpoint = -1;
+
+Snapshot Capture(std::string label) {
+  Snapshot s;
+  s.Scr.assign(ScrWork.begin(), ScrWork.end());
+  s.Flags.assign(FlagWork.begin(), FlagWork.end());
+  Vm::SaveVmState(s.Vm);
+  if (IsSghd()) s.Game.assign(SGHD::Phone::SaveData(), SGHD::Phone::SaveData() + SGHD::Phone::SaveDataSize);
+  const int main = MainThreadIndex();
+  if (main >= 0) {
+    const int buffer = (int)Vm::ThreadPool[main].ScriptBufferId;
+    s.Script = ScriptName(buffer);
+    s.ScriptId = Vm::ScriptBuffers[buffer].empty() ? -1 : (int)Vm::LoadedScriptMetas[buffer].Id;
+  }
+  s.Line = LastCheckpoint;
+  for (const auto& [surf, loader] : SpriteLoader::Sprites) {
+    if (!loader || loader->Status != LoadStatus::Loaded || loader->ArchiveId < 0) continue;
+    s.Sprites.insert(s.Sprites.end(), {surf, loader->ArchiveId, loader->FileId});
+  }
+  s.When = (int64_t)std::time(nullptr);
+  const bool hasLine = s.Line >= 0 && s.Line != 0xffff;
+  const std::string where = hasLine ? s.Script + " #" + std::to_string(s.Line) : s.Script;
+  s.Label = label.empty() ? where : label;
+  return s;
+}
+
+// what the scripts would load again after a restore: backgrounds, characters, the music
+void Resync() {
+  for (int i = 0; i < 8; i++) {
+    const int surf = ScrWork[SW_BG1SURF + i];
+    const int id = ScrWork[SW_BG1NO + i * Profile::Vm::ScrWorkBgStructSize];
+    auto it = Backgrounds2D.find(surf);
+    if (it == Backgrounds2D.end() || !it->second || it->second->Status == LoadStatus::Loading) continue;
+    it->second->LoadAsync((uint32_t)id);
+  }
+  for (int i = 0; i < (int)MaxCharacters2D; i++) {
+    const int surf = ScrWork[SW_CHA1SURF + i];
+    if (surf < 0 || surf >= (int)MaxCharacters2D) continue;
+    Character2D& cha = Characters2D[surf];
+    if (cha.Status == LoadStatus::Loading) continue;
+    const size_t off = (size_t)Profile::Vm::ScrWorkChaStructSize * i;
+    const int id = ScrWork[SW_CHA1NO + off];
+    if (id == 0) {
+      if (cha.Status == LoadStatus::Loaded) cha.Unload();
+      continue;
+    }
+    cha.LoadAsync((uint32_t)id | ((uint32_t)ScrWork[SW_CHA1FACE + off] << 16));
+  }
+  const int bgm = ScrWork[SW_BGMREQNO];
+  if (bgm >= 0 && bgm < 0xFFFF) {
+    Audio::Channels[Audio::AC_BGM0]->Play("bgm", (uint32_t)bgm, true, 0.5f);
+  } else {
+    Audio::Channels[Audio::AC_BGM0]->Stop(0.5f);
+  }
+}
+
+void Restore(const Snapshot& s) {
+  for (auto* player : Video::Players)
+    if (player && player->IsPlaying) player->Stop();
+  std::copy_n(s.Scr.begin(), std::min(s.Scr.size(), ScrWork.size()), ScrWork.begin());
+  std::copy_n(s.Flags.begin(), std::min(s.Flags.size(), FlagWork.size()), FlagWork.begin());
+  Vm::RestoreVmState(s.Vm);
+  // the text on screen belongs to the later state: empty and hide the pages; the next message shows the box
+  // again when its window is open (SF_MESWINDOW0OPENFL), as after loading a save
+  for (DialoguePage& page : DialoguePages) {
+    page.Clear();
+    page.Hide();
+    page.FadeAnimation.Finish();
+  }
+  if (UI::SelectionMenuPtr && UI::SelectionMenuPtr->State != UI::MenuState::Hidden) {
+    UI::SelectionMenuPtr->Hide();
+    UI::SelectionMenuPtr->State = UI::MenuState::Hidden;
+  }
+  if (IsSghd() && s.Game.size() == (size_t)SGHD::Phone::SaveDataSize) {
+    std::copy(s.Game.begin(), s.Game.end(), SGHD::Phone::SaveData());
+    SGHD::Phone::AfterLoad();
+  }
+  for (size_t i = 0; i + 2 < s.Sprites.size(); i += 3) {
+    const int surf = s.Sprites[i];
+    if (SpriteLoader::Sprites.contains(surf)) continue;
+    SpriteLoader::Sprites.emplace(surf, new SpriteLoader());
+    SpriteLoader::Sprites[surf]->LoadAsync(surf, s.Sprites[i + 1], s.Sprites[i + 2]);
+  }
+  LastCheckpoint = s.Line;
+  Resync();
+  LastMessage = std::string(L("restored: ", "已恢复：")) + s.Label;
+}
+
+void Jump(const JumpRequest& j) {
+  const int thread = j.Thread >= 0 ? j.Thread : MainThreadIndex();
+  if (thread < 0 || j.Buffer < 0 || j.Buffer >= Vm::MaxLoadedScripts) return;
+  if (Vm::ScriptBuffers[j.Buffer].empty() || (int)Vm::LoadedScriptMetas[j.Buffer].Id != j.ScriptId) {
+    if (!Vm::LoadScript((uint32_t)j.Buffer, (uint32_t)j.ScriptId)) {
+      LastMessage = L("cannot load script ", "无法载入剧本 ") + std::to_string(j.ScriptId);
+      return;
+    }
+  }
+  Vm::Sc3VmThread& t = Vm::ThreadPool[thread];
+  t.ScriptBufferId = (uint32_t)j.Buffer;
+  t.IpOffset = Vm::ScriptGetLabelAddress((uint32_t)j.Buffer, (uint32_t)j.Label);
+  t.WaitCounter = 0;
+  t.Flags &= ~(uint32_t)Vm::TF_Pause;
+  if (j.ClearStack) t.CallStackDepth = 0;
+  LastMessage = L("thread ", "线程 ") + std::to_string(thread) + " -> " + ScriptName(j.Buffer) +
+                L(" label ", " 标签 ") + std::to_string(j.Label);
+}
+
+int LabelCount(int buffer) {
+  if (buffer < 0 || buffer >= Vm::MaxLoadedScripts || Vm::ScriptBuffers[buffer].size() < 16) return 0;
+  const uint32_t first = Vm::ScriptGetLabelAddress((uint32_t)buffer, 0);
+  return first > 12 ? (int)((first - 12) / 4) : 0;
+}
