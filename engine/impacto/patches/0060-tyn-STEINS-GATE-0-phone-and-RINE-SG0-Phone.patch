+// ------------------------------------------------------------------------------------------------ sprites
+
+// The phone textures are loaded by the scripts (LoadTexture into surfaces 74, 170..179); the profile lists them as
+// script handled sheets, so a surface is drawn from the sheet whose file the script put there.
+const SpriteSheet* SurfaceSheet(int surf) {
+  auto surfIt = Renderer->SurfToId.find(surf);
+  if (surfIt == Renderer->SurfToId.end()) return nullptr;
+  auto keyIt = Renderer->SheetPathToId.find(Io::AssetPathKey::KeyToAssetPath(surfIt->second));
+  if (keyIt == Renderer->SheetPathToId.end()) return nullptr;
+  for (auto const& [name, sheet] : Profile::SpriteSheets) {
+    if (!sheet.ScriptHandled) continue;
+    auto idIt = Renderer->SheetPathToId.find(sheet.Path);
+    if (idIt != Renderer->SheetPathToId.end() && keyIt->second == idIt->second) return &sheet;
+  }
+  return nullptr;
+}
+
+// render target n of the original is drawable as surface 200 + n; target 8 is the screen
+int CurrentTarget = 8;
+int Framebuffer(int target) { return target == 8 ? 0 : target; }
+
+// a sprite of the part (sx, sy, w, h) of surface `slot`, false if the surface has nothing loaded
+bool SurfaceSprite(int slot, float sx, float sy, float w, float h, Sprite& out, SpriteSheet& fbSheet) {
+  if (slot >= 200 && slot < 200 + MaxFramebuffers && slot != 208) {
+    const RectF viewport = Window->GetViewport();
+    fbSheet = SpriteSheet(viewport.Width, viewport.Height);
+    fbSheet.IsScreenCap = true;
+    fbSheet.Texture = Renderer->GetFramebufferTexture(slot - 200);
+    const glm::vec2 k = viewport.GetSize() / glm::vec2(Profile::Game::DesignWidth, Profile::Game::DesignHeight);
+    out = Sprite(fbSheet, sx * k.x, sy * k.y, w * k.x, h * k.y, 1.0f / k);
+    return true;
+  }
+  const SpriteSheet* sheet = SurfaceSheet(slot);
+  if (!sheet) return false;
+  out = Sprite(*sheet, sx, sy, w, h);
+  return true;
+}
+
+glm::vec4 Tint(uint32_t rgb, int alpha) {
+  return glm::vec4(((rgb >> 16) & 0xff) / 255.0f, ((rgb >> 8) & 0xff) / 255.0f, (rgb & 0xff) / 255.0f,
+                   std::clamp(alpha / 255.0f, 0.0f, 1.0f));
+}
+
+// ------------------------------------------------------------------------------------------------ text
+
+const uint8_t* Rd(uint32_t address) { return Sg0Emu::At(address); }
+
+// A script string: handle of FUN_0047f1f0
+struct Str {
+  uint32_t Buffer = 0;
+  uint32_t Offset = 0;
+  const uint8_t* P() const { return ScriptBuffers[Buffer].data() + Offset; }
+};
+
+Str StrOf(const Arg& a) {
+  const uint32_t h = a.U();
+  Str s;
+  if (!(h & 0x80000000u)) {
+    ImpLog(LogLevel::Error, LogChannel::General, "SG0 phone: not a string handle {:08x}\n", h);
+    return s;
+  }
+  s.Buffer = (h >> 20) & 0x7ff;
+  s.Offset = ScriptGetStrAddress(s.Buffer, h & 0xfffff);
+  return s;
+}
+
+// 0x42fb00 on a colour tag (0x04 + expression): evaluates it, moves the string position past it
+int TagValue(Str& s) {
+  Sc3VmThread thread;
+  thread.ScriptBufferId = s.Buffer;
+  thread.IpOffset = s.Offset + 1;
+  const int v = ExpressionEval(&thread);
+  s.Offset = thread.IpOffset;
+  return v;
+}
+
+bool StartsWord(uint32_t code) {  // glyphs that stay on the line of the word before them (0x5cb108 and the marks)
+  if ((code != 0 && code <= 0x3e) || code == 0x4a) return true;
+  for (int i = 0; i < 10; i++)
+    if (*reinterpret_cast<const uint32_t*>(Rd(0x5cb108 + i * 4)) == code) return true;
+  return false;
+}
+
+// width of a glyph as the draw routines take it: `table` 0x5cb250 / 0x5c9b58; cell = width of its cell (of 32)
+uint32_t DrawWidth(uint32_t code, uint32_t size, uint32_t table, uint32_t& cell) {
+  if (code < 0x15f) {
+    cell = Rd(table)[code];
+    return cell * size >> 5;
+  }
+  if (code < 0x1ec0) {
+    cell = 0x20;
+    return size;
+  }
+  cell = Rd(0x5c9b59)[0];
+  return cell * size >> 5;
+}
+
+// width of a glyph as the measuring routines 0x45d840 / 0x45d9d0 take it
+uint32_t MeasureWidth(uint32_t code, uint32_t size) {
+  if (code < 0x15f) return Rd(0x5cb250)[code] * size >> 5;
+  if (code < 0x1ec0) return size;
+  return Rd(0x5c9b59)[0];
+}
+
+uint32_t TagColor(int index, bool shadow) {  // 0x5cb3e0: pairs of (colour, shadow colour)
+  return *reinterpret_cast<const uint32_t*>(Rd(0x5cb3e0 + index * 8 + (shadow ? 4 : 0)));
+}
+
+struct PlacedGlyph {
+  uint32_t Code, Cell;
+  float X0, X1, Y;
+  uint32_t Color;
+};
+
+// glyph cell (code % 64, code / 64) of 32 units, drawn stretched over (x0, y)..(x1, y + size) (0x448fc0)
+void DrawGlyphs(const std::vector<PlacedGlyph>& glyphs, uint32_t size, int alpha) {
+  auto sheetIt = Profile::SpriteSheets.find("Font");
+  if (sheetIt == Profile::SpriteSheets.end() || alpha <= 0) return;
+  for (const PlacedGlyph& g : glyphs) {
+    const uint32_t col = g.Code & 0x3f, row = g.Code >> 6;
+    Sprite sprite(sheetIt->second, (col * 0x20 + 1) * Scale, (row * 0x20 + 1) * Scale,
+                  ((int)g.Cell - 2) * Scale, 45.0f);
+    Renderer->DrawSprite(sprite, RectF(g.X0 * Scale, g.Y * Scale, (g.X1 - g.X0) * Scale, size * Scale),
+                         Tint(g.Color, alpha));
+  }
+}
