@@ -0,0 +1,48 @@
+-- STEINS;GATE (Steam) system message box (confirmations such as "Load this data?" with Yes / No), SysMesBoxType.SGHD.
+-- Everything below is taken from the original Game.exe: the box draw routine 0x43d470, the layout 0x43da50 (width
+-- and choice hit areas), the input routine 0x43dc00 and the fades of SystemMes (16 per frame). The game computes in
+-- 1280x720 units and draws at x1.5; values below are already in 1920x1080 units.
+--   * content width W = the widest message, the choices with 60 px each, at least 441;
+--   * DATA01 pieces 273 px high at y 336: left (1.5, 1263, 72) at 906 - W / 2, right (724.5, 1263, 72) at
+--     942 + W / 2, the middle (73.5, 1263, 651) stretched between them;
+--   * messages: font size 48, left aligned at 960 - W / 2, first line y 354, 51 px apart, white with black copies
+--     1.5 px up-left and down-right;
+--   * choices on one row at y 546, 60 px apart, ending at 1020 + W / 2; the chosen one gets DATA01 (65, 1, 94, 30)
+--     stretched over its width from y 550.5 to 595.5; hit areas 48 px high from y 547;
+--   * the second, global box (modes 10..17, drawn by 0x46e66e) first covers the screen with black at 3 / 4 of its
+--     opacity and reports its choice in SW_SYSSEL + 1.
+local function data(name, x, y, w, h)
+    root.Sprites[name] = { Sheet = "Data", Bounds = { X = x, Y = y, Width = w, Height = h } };
+    return name;
+end
+
+root.SysMesBoxDisplay = {
+    Type = SysMesBoxType.SGHD,
+    DrawType = DrawComponentType.SystemMessage,
+    BoxLeftSprite = data("SysMesBoxLeft", 1.5, 1263, 72, 273),
