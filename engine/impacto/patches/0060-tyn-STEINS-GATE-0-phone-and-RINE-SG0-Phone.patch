+namespace {
+uint16_t U16(Sc3VmThread* thread) {
+  const uint8_t* p = thread->GetIp();
+  thread->IpOffset += 2;
+  return (uint16_t)(p[0] | (p[1] << 8));
+}
+const uint8_t* LabelArg(Sc3VmThread* thread) { return Sg0Emu::LabelPtr(thread->ScriptBufferId, U16(thread)); }
+}  // namespace
+
+// 0x482df0
+void Instruction(Sc3VmThread* thread) {
+  thread->IpOffset += 2;
+  const uint8_t type = *thread->GetIp();
+  thread->IpOffset++;
+  switch (type) {
+    case 0x00: {
+      const ushort* a = reinterpret_cast<const ushort*>(LabelArg(thread));
+      const ushort* b = reinterpret_cast<const ushort*>(LabelArg(thread));
+      const ushort* c = reinterpret_cast<const ushort*>(LabelArg(thread));
+      const ushort* d = reinterpret_cast<const ushort*>(LabelArg(thread));
+      const byte* e = LabelArg(thread);
+      const ushort* f = reinterpret_cast<const ushort*>(LabelArg(thread));
+      const ushort* g = reinterpret_cast<const ushort*>(LabelArg(thread));
+      FUN_00476410(thread->ScriptBufferId, const_cast<ushort*>(a), const_cast<ushort*>(b), const_cast<ushort*>(c),
+                   const_cast<ushort*>(d), const_cast<byte*>(e), const_cast<ushort*>(f), const_cast<ushort*>(g));
+    } break;
+    case 0x01:
+      FUN_004705d0();
+      break;
+    case 0x02:
+      BridgeInput();
+      FUN_00472b50();
+      ConsumeInput();
+      BridgeAudio();
+      break;
+    case 0x03:
+      FUN_00470090();
+      break;
+    case 0x04:
+      FUN_00470a10();
+      break;
+    case 0x0a:
+      FUN_00477310(thread->ScriptBufferId, U16(thread));
+      break;
+    case 0x0b:
+      FUN_00476940();
+      break;
+    case 0x0c:  // random RINE messages (_RNDRINE): the PC version reads the operands and does nothing
+    case 0x0d:
+      ExpressionEval(thread);
+      ExpressionEval(thread);
+      break;
+    case 0x0f:
+      ExpressionEval(thread);
+      ExpressionEval(thread);
+      ExpressionEval(thread);
+      break;
+    case 0x28:
+      FUN_004757a0();
+      break;
+    case 0x29:
+      FUN_00475810();
+      break;
+    case 0x2a:
+      FUN_004751c0(ExpressionEval(thread));
+      break;
+    case 0x2b:
+      FUN_004750d0(ExpressionEval(thread));
+      break;
+    case 0x2c:
+      FUN_00475080(ExpressionEval(thread));
+      break;
+    case 0x2d:
+      FUN_00475160(ExpressionEval(thread));
+      break;
+    case 0x2e: {
+      const int a = ExpressionEval(thread);
+      const int b = ExpressionEval(thread);
+      const int c = ExpressionEval(thread);
+      FUN_00473560(a, b, c);
+    } break;
+    case 0x2f:
+      FUN_00474fb0();
+      break;
+    case 0x30:
+      FUN_00475000(ExpressionEval(thread));
+      break;
+    case 0x31: {
+      const int a = ExpressionEval(thread);
+      const int b = ExpressionEval(thread);
+      FUN_004745e0(a, b);
+    } break;
+    case 0x32:
+      *reinterpret_cast<int*>(DAT_02ee7660 + 0x67fc) = FUN_00470110(U16(thread));
+      break;
+    default:  // 05..09, 0E, 10..27, 33..: nothing (read no operands)
+      break;
+  }
+}
