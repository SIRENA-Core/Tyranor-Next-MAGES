@@ -0,0 +1,44 @@
+#pragma once
+
+#include "../../../spritesheet.h"
+#include "../../../util.h"
+
+// System message box (confirmations) of the STEINS;GATE (Steam, 2016) generation of the MAGES. PC engine. The box
+// is three pieces whose middle is stretched to the width of the longest line (or of the choices); the messages are
+// left aligned, the choices right aligned on one row. Values come from the profile (taken from the original
+// Game.exe, see the sg-pc profile); the common SysMesBox fields give the text size, first line, line height and fades.
+namespace Impacto {
+namespace Profile {
+namespace SGHD {
+namespace SysMesBox {
+
+inline Sprite BoxLeft;
+inline Sprite BoxMiddle;
+inline Sprite BoxRight;
+inline float BoxY = 0.0f;
+// With the content width W: left piece at BoxLeftX - W / 2, right piece at BoxRightX + W / 2, the middle piece
+// stretched between them.
+inline float BoxLeftX = 0.0f;
+inline float BoxRightX = 0.0f;
+inline float MinWidth = 0.0f;
+// Choices: right aligned so that they end at ChoiceRightX + W / 2, ChoiceSpacing apart.
+inline float ChoiceRightX = 0.0f;
+inline float ChoiceY = 0.0f;
+inline float ChoiceSpacing = 0.0f;
+inline float ChoiceHitY = 0.0f;
+inline float ChoiceHitHeight = 0.0f;
+// The chosen choice: a sprite stretched over its width, from HighlightY to HighlightY + HighlightHeight.
+inline Sprite Highlight;
+inline float HighlightY = 0.0f;
+inline float HighlightHeight = 0.0f;
+// Black copies of the text at -ShadowOffset and +ShadowOffset.
+inline float ShadowOffset = 0.0f;
+// The global box (STEINS;GATE modes 10..17) first covers the screen with black at this share of its opacity.
+inline float GlobalDim = 0.0f;
+
+void Configure();
+
+}  // namespace SysMesBox
+}  // namespace SGHD
+}  // namespace Profile
+}  // namespace Impacto
