diff --git a/profiles/mo6tw-pc/charset.lua b/profiles/mo6tw-pc/charset.lua
new file mode 100644
index 0000000000000000000000000000000000000000..8f0fc2c46580e0df6a4e0f8e7497b38296291001
--- /dev/null
+++ b/profiles/mo6tw-pc/charset.lua
@@ -0,0 +1,57 @@
+-- Glyph flags for the 64x125 glyph grid of the PC fonts (font / font_ht / font_kt).
+-- The symbol/kana region (rows 0..9) is laid out identically in all three fonts: punctuation
+-- ids were verified by rendering cells 188..255, 275/276, 389..392 and 419..424 of each
+-- atlas side by side (e.g. 190 '、' 191 '。' 192 '，' 196 '？' 197 '！' 216/217 '「」').
+-- Simplified/Traditional Chinese only differ in the kanji region (ids >= ~700), which has
+-- no punctuation.
+root.Charset = {
+    Flags = {}
+};
+
+for i = 0, (64 * 125) - 1 do root.Charset.Flags[i] = 0; end
+
+local spaces = {[0]=0, 63};
+for i = 0, #spaces do
+    root.Charset.Flags[spaces[i]] = root.Charset.Flags[spaces[i]] | CharacterTypeFlags.Space;
+end
+
+-- 、 。 ． ， ？ ！ 〜 ” ー ） 〕 ］ ｝ 〉 》 」 』 】☆ ★ ♪ 々 ぁ ぃ ぅ ぇ
+-- ぉ っ ゃ ゅ ょ ァ ィ ゥ ェ ォ ッ ャ ュ ョ –
+local wordEndingPuncts = {
+    [0]=0x00BE, 0x00BF, 0x00C1,
+    0x00C0, 0x00C4, 0x00C5,
+    0x00E4, 0x00CB, 0x00E5,
+    0x00CD, 0x00CF, 0x00D1,
+    0x00D3, 0x00D5, 0x00D7,
+    0x00D9, 0x00DB, 0x00DD,
+    0x01A5, 0x01A6, 0x00E6,
+    0x0187, 0x00E8, 0x00E9,
+    0x00EA, 0x00EB, 0x00EC,
+    0x00ED, 0x00EE, 0x00EF,
+    0x00F0, 0x00F2, 0x00F3,
+    0x00F4, 0x00F5, 0x00F6,
+    0x00F7, 0x00F8, 0x00F9,
+    0x00FA, 0x0113
+};
+for i = 0, #wordEndingPuncts do
+    root.Charset.Flags[wordEndingPuncts[i]] = root.Charset.Flags[wordEndingPuncts[i]] | CharacterTypeFlags.WordEndingPunct;
+end
+
+-- Chinese text also uses full-width ： (0xC2) and ； (0xC3) which must not start a line
+if root.Mo6Pc.Lang ~= "ja" then
+    local zhEndingPuncts = {[0]=0x00C2, 0x00C3};
+    for i = 0, #zhEndingPuncts do
+        root.Charset.Flags[zhEndingPuncts[i]] = root.Charset.Flags[zhEndingPuncts[i]] | CharacterTypeFlags.WordEndingPunct;
+    end
+end
+
+-- space(63) space(0) “ （ 〔 ［ ｛ 〈 《 「
+local wordStartingPuncts = {
+    [0]=63, 0, 0x00CA,
+    0x00CC, 0x00CE, 0x00D0,
+    0x00D2, 0x00D4, 0x00D6,
+    0x00D8, 0x00DA, 0x00DC
+};
+for i = 0, #wordStartingPuncts do
+    root.Charset.Flags[wordStartingPuncts[i]] = root.Charset.Flags[wordStartingPuncts[i]] | CharacterTypeFlags.WordStartingPunct;
+end
