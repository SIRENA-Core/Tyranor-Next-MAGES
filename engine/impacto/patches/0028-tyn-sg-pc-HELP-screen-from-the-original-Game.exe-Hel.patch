diff --git a/src/profile/games/sghd/helpmenu.h b/src/profile/games/sghd/helpmenu.h
new file mode 100644
index 0000000000000000000000000000000000000000..f142ea3173555910a2e8e9937de0183a21123b9a
--- /dev/null
+++ b/src/profile/games/sghd/helpmenu.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <vector>
+
+#include "../../../spritesheet.h"
+#include "../../../util.h"
+
+// HELP screen of the STEINS;GATE (Steam, 2016) generation of the MAGES. PC engine: full screen manual pages with a
+// page number, page tabs and a button guide. Every sprite, position and timing comes from the profile (taken from
+// the original Game.exe, see the sg-pc profile).
+namespace Impacto {
+namespace Profile {
+namespace SGHD {
+namespace HelpMenu {
+
+inline std::vector<Sprite> Pages;              // full screen manual pages
+inline std::vector<Sprite> PageNumberSprites;  // one per page
+inline glm::vec2 PageNumberPosition{};
+inline Sprite PageCountSprite;
+inline glm::vec2 PageCountPosition{};
+inline Sprite TabSprite;         // every tab
+inline Sprite TabHoverSprite;    // over the tab under the mouse (blinking)
+inline Sprite TabCurrentSprite;  // over the tab of the current page (blinking)
+inline std::vector<glm::vec2> TabPositions;
+inline std::vector<RectF> TabHitAreas;
+inline Sprite GuideSprite;
+inline glm::vec2 GuidePosition{};
+
+// While SW_SYSSUBMENUCT counts 0..32 the page comes in from x = -EnterDistance.
+inline float EnterDistance = 400.0f;
+// A page change slides the new page in from PageSlideStep * PageSlideFrames pixels aside, fading it in.
+inline float PageSlideFrames = 16.0f;
+inline float PageSlideStep = 48.0f;
+inline float BlinkFrames = 32.0f;
+
+void Configure();
+
+}  // namespace HelpMenu
+}  // namespace SGHD
+}  // namespace Profile
+}  // namespace Impacto
