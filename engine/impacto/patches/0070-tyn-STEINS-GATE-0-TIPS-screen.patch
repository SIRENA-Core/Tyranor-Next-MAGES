+// The TIPS screen of STEINS;GATE 0: instruction 10:33 (0x486540: 0 = the TIPS table at a label 0x458cb0, 1 0x459a90,
+// 2 = the update of a frame 0x459eb0, 4 0x45a9b0) and its drawing (0x458d30 on the system menu layer, the TIPS
+// text through the original's text layout 0x4673e0) are translated with the phone (phonecode.cpp).
+#include "phone.h"
+
+#include "phoneglobals.h"
+#include "../../vm/interface/input.h"
+#include "../../vm/thread.h"
+#include "../../vm/expression.h"
+
+#include <cstring>
+
+namespace Impacto {
+namespace SG0 {
+namespace Phone {
+
+using namespace PhoneCode;
+
+void MesModeFormat(const Vm::Sc3VmThread* thread) {
+  Vm::Sc3VmThread t = *thread;
+  t.IpOffset += 2;
+  const int id = Vm::ExpressionEval(&t);
+  const uint8_t* p = t.GetIp();
+  const uint16_t label = (uint16_t)(p[0] | (p[1] << 8));
+  if (id < 0 || id >= 0x20) return;
+  std::memcpy(Sg0Emu::At(0x017710d8 + id * 0x30), Sg0Emu::LabelPtr(t.ScriptBufferId, label), 0x30);
+}
+
+// 10:33 (0x486540)
+void TipsInstruction(Vm::Sc3VmThread* thread) {
+  thread->IpOffset += 2;
+  const uint8_t type = *thread->GetIp();
+  thread->IpOffset++;
+  switch (type) {
+    case 0: {
+      const uint8_t* p = thread->GetIp();
+      const uint16_t label = (uint16_t)(p[0] | (p[1] << 8));
+      thread->IpOffset += 2;
+      FUN_00458cb0(thread->ScriptBufferId,
+                   const_cast<ushort*>(reinterpret_cast<const ushort*>(Sg0Emu::LabelPtr(thread->ScriptBufferId, label))));
+    } break;
+    case 1:
+    case 2:
+    case 4:
+      BridgeInput();
+      if (type == 1)
+        FUN_00459a90();
+      else if (type == 2)
+        FUN_00459eb0();
+      else
+        FUN_0045a9b0();
+      Vm::Interface::PADinputButtonWentDown = *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x01979f10));
+      ClearMouse();
+      break;
+    default:
+      break;
+  }
+}
