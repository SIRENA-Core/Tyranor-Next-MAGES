+// ---------------------------------------------------------------- saved states (a file next to the save file)
+
+std::string StatesPath() {
+  std::filesystem::path p(Profile::SaveSystem::SaveFilePath);
+  return (p.parent_path() / "debug-states.bin").string();
+}
+
+template <typename T>
+void Put(std::ofstream& f, const T& v) {
+  f.write(reinterpret_cast<const char*>(&v), sizeof(T));
+}
+template <typename T>
+bool Get(std::ifstream& f, T& v) {
+  return (bool)f.read(reinterpret_cast<char*>(&v), sizeof(T));
+}
+void PutBytes(std::ofstream& f, const void* p, size_t n) {
+  Put(f, (uint64_t)n);
+  f.write(static_cast<const char*>(p), (std::streamsize)n);
+}
+template <typename T>
+bool GetVector(std::ifstream& f, std::vector<T>& v) {
+  uint64_t n = 0;
+  if (!Get(f, n) || n > (1u << 28)) return false;
+  v.resize((size_t)(n / sizeof(T)));
+  return (bool)f.read(reinterpret_cast<char*>(v.data()), (std::streamsize)n);
+}
+
+constexpr uint32_t StatesMagic = 0x32534454;  // "TDS2"
+
+void WriteStates() {
+  std::ofstream f(StatesPath(), std::ios::binary | std::ios::trunc);
+  if (!f) {
+    LastMessage = L("cannot write ", "无法写入 ") + StatesPath();
+    return;
+  }
+  Put(f, StatesMagic);
+  Put(f, (uint32_t)Saved.size());
+  Put(f, (uint32_t)sizeof(Vm::Sc3VmThread));
+  for (const Snapshot& s : Saved) {
+    PutBytes(f, s.Label.data(), s.Label.size());
+    PutBytes(f, s.Script.data(), s.Script.size());
+    Put(f, s.ScriptId), Put(f, s.Line), Put(f, s.When);
+    PutBytes(f, s.Scr.data(), s.Scr.size() * sizeof(int));
+    PutBytes(f, s.Flags.data(), s.Flags.size());
+    PutBytes(f, s.Vm.Pool.data(), s.Vm.Pool.size() * sizeof(Vm::VmState::Thread));
+    Put(f, s.Vm.Heads), Put(f, s.Vm.Tails), Put(f, s.Vm.Counts), Put(f, s.Vm.States), Put(f, s.Vm.NextFree);
+    Put(f, s.Vm.ScriptIds);
+    PutBytes(f, s.Game.data(), s.Game.size());
+    PutBytes(f, s.Sprites.data(), s.Sprites.size() * sizeof(int));
+  }
+}
+
+void ReadStates() {
+  SavedLoaded = true;
+  Saved.clear();
+  std::ifstream f(StatesPath(), std::ios::binary);
+  uint32_t magic = 0, count = 0, threadSize = 0;
+  if (!f || !Get(f, magic) || magic != StatesMagic || !Get(f, count) || !Get(f, threadSize) ||
+      threadSize != sizeof(Vm::Sc3VmThread))
+    return;  // none yet, or written by another build
+  for (uint32_t i = 0; i < count; i++) {
+    Snapshot s;
+    std::vector<char> label, script;
+    if (!GetVector(f, label) || !GetVector(f, script)) return;
+    s.Label.assign(label.begin(), label.end());
+    s.Script.assign(script.begin(), script.end());
+    if (!Get(f, s.ScriptId) || !Get(f, s.Line) || !Get(f, s.When)) return;
+    if (!GetVector(f, s.Scr) || !GetVector(f, s.Flags) || !GetVector(f, s.Vm.Pool)) return;
+    if (!Get(f, s.Vm.Heads) || !Get(f, s.Vm.Tails) || !Get(f, s.Vm.Counts) || !Get(f, s.Vm.States) ||
+        !Get(f, s.Vm.NextFree) || !Get(f, s.Vm.ScriptIds) || !GetVector(f, s.Game) || !GetVector(f, s.Sprites))
+      return;
+    Saved.push_back(std::move(s));
+  }
+}
+
+// ---------------------------------------------------------------- unlocks
+
+// as if the movie had ended: the scripts waiting for it go on. The forced skip leaves the looping movies (title,
+// backgrounds: play modes 2, 3 and 5, +8 with alpha) alone, nothing waits for them.
+void SkipMovies(bool keepLooping = false) {
+  for (int i = 0; i < Video::VP_Count; i++) {
+    if (!Video::Players[i] || !Video::Players[i]->IsPlaying) continue;
+    const int mode = ScrWork[SW_MOVIE_PLAYMODE + 20 * i] % 20 % 8;
+    if (keepLooping && (mode == 2 || mode == 3 || mode == 5)) continue;
+    Video::Players[i]->Stop();
+    SetFlag(SF_MOVIEPLAY + i, false);
+    SetFlag(SF_MOVIE_DRAWWAIT + i, false);  // scripts wait for the first frame before they wait for the end
+  }
+}
+
+void UnlockAll() {
+  auto* save = SaveSystem::Implementation;
+  if (!save) return;
+  for (int i = 0; i < 1200; i++) save->SetEVStatus(i);
+  for (int i = 0; i < 200; i++) save->SetBgmFlag(i, true);
+  if (auto* tips = TipsSystem::Implementation.get())
+    for (size_t i = 0; i < tips->TipEntryCount; i++) save->SetTipStatus(i, false, false, false);
+  SaveSystem::SaveSystemData();
+  LastMessage = L("CG, music and tips unlocked", "已解锁 CG、音乐与 TIPS");
+}
