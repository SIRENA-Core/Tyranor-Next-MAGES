+// The save / load menu of STEINS;GATE 0: instruction 10:23 (0x485f10: 0 / 10 = init 0x455f90, 1 = the update of a
+// frame 0x456030) and its drawing (0x454f80 on the system menu layer) are translated with the phone
+// (phonecode.cpp). The original reads its save entries directly (0x479330: the header of an entry); here the
+// headers are filled from the engine's save system in the layout the translated code reads:
+//   +0x00 u16 status (1 = used)   +0x08 u16 year   +0x0a u8 day   +0x0b u8 month   +0x0c u8 second   +0x0d u8 minute
+//   +0x0e u8 hour   +0x10 u32 play time (seconds)   +0x14 u32 title (scene)   +0x1c u32 bit 0: write protected
+// Save types of the original: 1 = save (engine SaveType::Full), 2 = quick save (SaveType::Quick).
+#include "phone.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <numeric>
+
+#include "phoneglobals.h"
+#include "../../data/savesystem.h"
+#include "../../renderer/renderer.h"
+#include "../../vm/interface/input.h"
+#include "../../vm/thread.h"
+#include "../../vm/vm.h"
+
+namespace Impacto {
+namespace SG0 {
+namespace PhoneCode {
+
+using SaveSystem::SaveType;
+
+namespace {
+
+int& Sw(int offset) { return *reinterpret_cast<int*>(DAT_02ee7660 + offset); }
+
+SaveType TypeOf(int type) { return type == 2 ? SaveType::Quick : SaveType::Full; }
+
+struct alignas(4) Header {
+  uint8_t Bytes[0x28];
+};
+Header Headers[3][SaveSystem::MaxSaveEntries];
+
+Header& Fill(int type, int i) {
+  Header& h = Headers[std::clamp(type, 0, 2)][std::clamp(i, 0, SaveSystem::MaxSaveEntries - 1)];
+  std::memset(h.Bytes, 0, sizeof(h.Bytes));
+  if (type != 1 && type != 2) return h;
+  const SaveType t = TypeOf(type);
+  const uint8_t status = SaveSystem::GetSaveStatus(t, i);
+  auto put16 = [&](int o, uint16_t v) { std::memcpy(h.Bytes + o, &v, 2); };
+  auto put32 = [&](int o, uint32_t v) { std::memcpy(h.Bytes + o, &v, 4); };
+  put16(0, status);
+  if (status == 1) {
+    const tm& date = SaveSystem::GetSaveDate(t, i);
+    put16(8, (uint16_t)(date.tm_year + 1900));
+    h.Bytes[0x0a] = (uint8_t)date.tm_mday;
+    h.Bytes[0x0b] = (uint8_t)(date.tm_mon + 1);
+    h.Bytes[0x0c] = (uint8_t)date.tm_sec;
+    h.Bytes[0x0d] = (uint8_t)date.tm_min;
+    h.Bytes[0x0e] = (uint8_t)date.tm_hour;
+    put32(0x10, SaveSystem::GetSavePlayTime(t, i));
+    put32(0x14, (uint32_t)SaveSystem::GetSaveTitle(t, i));
+  }
+  put32(0x1c, (SaveSystem::GetSaveFlags(t, i) & SaveSystem::WriteProtect) ? 1 : 0);
+  return h;
+}
+
+}  // namespace
+
+int FUN_00479360(Arg type, Arg i) { return *reinterpret_cast<uint16_t*>(Fill(type.I(), i.I()).Bytes); }
+
+uint FUN_00479100(Arg type, Arg i) { return *reinterpret_cast<uint32_t*>(Fill(type.I(), i.I()).Bytes + 0x1c) & 1; }
+
+ushort* FUN_00479330(Arg type, Arg i) { return reinterpret_cast<ushort*>(Fill(type.I(), i.I()).Bytes); }
+
+// 0x479150: entry b is newer than entry a
+bool FUN_00479150(Arg type, Arg a, Arg b) {
+  const Header ha = Fill(type.I(), a.I()), hb = Fill(type.I(), b.I());
+  auto key = [](const Header& h) {
+    uint16_t year;
+    std::memcpy(&year, h.Bytes + 8, 2);
+    return std::tuple(year, h.Bytes[0x0b], h.Bytes[0x0a], h.Bytes[0x0e], h.Bytes[0x0d], h.Bytes[0x0c]);
+  };
+  return key(ha) < key(hb);
+}
+
+// 0x47a380: write protection of an entry, written to the save file at once
+void FUN_0047a380(Arg type, Arg i, Arg locked) {
+  if (type.I() != 1 && type.I() != 2) return;
+  const SaveType t = TypeOf(type.I());
+  uint8_t flags = SaveSystem::GetSaveFlags(t, i.I());
+  flags = locked.I() ? (flags | SaveSystem::WriteProtect) : (flags & ~SaveSystem::WriteProtect);
+  SaveSystem::SetSaveFlags(t, i.I(), flags);
+  SaveSystem::WriteSaveFile();
+}
+
+// 0x4645a0: string n of the system text table t (instruction 01:21, the engine's TextTable)
+uint32_t FUN_004645a0(Arg t, Arg n) {
+  const auto& entry = Vm::TextTable[t.I()];
+  const uint8_t* p = Vm::ScriptBuffers[entry.scriptBufferId].data() + entry.labelAdr;
+  const uint16_t base = (uint16_t)(p[0] | (p[1] << 8));
+  return FUN_0047f1f0(entry.scriptBufferId, base + n.I());
+}
