+// ------------------------------------------------------------------------------------------------ text
+
+// 0x462f30: one line of at most maxGlyphs glyphs; squeezed to maxWidth when wider
+void FUN_00462f30(Arg font, Arg x, Arg y, Arg maxWidth, Arg str, Arg maxGlyphs, Arg color, Arg size, Arg alpha) {
+  Str s = StrOf(str);
+  const uint32_t limit = maxGlyphs.U() ? maxGlyphs.U() : 0xff;
+  const uint32_t maxW = maxWidth.U() ? maxWidth.U() : 0x500;
+  const uint32_t sz = size.U();
+  const uint32_t table = font.I() == 0x4c ? 0x5c9b58 : 0x5cb250;
+  const bool shadow = color.U() == 0;
+  uint32_t col = color.U();
+  struct G {
+    uint32_t Code, Cell, W, Color;
+  };
+  std::vector<G> gs;
+  uint32_t total = 0;
+  for (const uint8_t* p = s.P(); *p != 0xff && gs.size() <= limit; p = s.P()) {
+    if (*p & 0x80) {
+      const uint32_t code = ((*p & 0x7f) << 8) | p[1];
+      uint32_t cell;
+      const uint32_t w = DrawWidth(code, sz, table, cell);
+      total += w;
+      gs.push_back({code, cell, w, col});
+      s.Offset += 2;
+    } else if (*p == 0) {
+      total = 0;
+      s.Offset++;
+    } else if (*p == 4) {
+      col = TagColor(TagValue(s), shadow);
+    } else {
+      s.Offset++;
+    }
+  }
+  if (maxW < total)
+    for (G& g : gs) g.W = g.W * maxW / total;
+  std::vector<PlacedGlyph> placed;
+  int gx = x.I();
+  for (const G& g : gs) {
+    placed.push_back({g.Code, g.Cell, (float)gx, (float)(gx + (int)g.W), (float)y.I(), g.Color});
+    gx += g.W;
+  }
+  DrawGlyphs(placed, sz, alpha.I());
+}
+
+// 0x461220: lines `skipLines` .. `skipLines + lines` of a text broken at maxWidth
+void FUN_00461220(Arg font, Arg x, Arg y, Arg maxWidth, Arg str, Arg skipLines, Arg lines, Arg color, Arg size,
+                  Arg alpha, Arg draw) {
+  Str s = StrOf(str);
+  const uint32_t maxW = maxWidth.U() ? maxWidth.U() : 0x500;
+  const uint32_t sz = size.U();
+  const uint32_t table = font.I() == 0x4e ? 0x5cb250 : 0x5c9b58;
+  // the lines skipped: broken at the width, no keeping of words
+  uint32_t line = 0, w = 0;
+  for (const uint8_t* p = s.P(); line < skipLines.U(); p = s.P()) {
+    if (*p == 0xff) return;
+    if (*p & 0x80) {
+      uint32_t cell;
+      w += DrawWidth(((*p & 0x7f) << 8) | p[1], sz, table, cell);
+      if (maxW < w) {
+        line++;
+        w = 0;
+      } else {
+        s.Offset += 2;
+      }
+    } else if (*p == 0) {
+      line++;
+      w = 0;
+      s.Offset++;
+    } else if (*p == 4) {
+      TagValue(s);
+    } else {
+      s.Offset++;
+    }
+  }
+  const bool shadow = color.U() == 0;
+  uint32_t col = color.U();
+  line = 0;
+  w = 0;
+  int gx = x.I();
+  std::vector<PlacedGlyph> placed;
+  bool inWord = false;
+  size_t wordGlyph = 0;
+  Str wordStart;
+  uint32_t wordX = 0;
+  for (const uint8_t* p = s.P(); line < lines.U() && *p != 0xff; p = s.P()) {
+    if (*p & 0x80) {
+      const uint32_t code = ((*p & 0x7f) << 8) | p[1];
+      if (w == 0 && code == 0x3f) {  // a space at the start of a line
+        s.Offset += 2;
+        continue;
+      }
+      if (StartsWord(code)) {
+        if (!inWord) {
+          wordGlyph = placed.size();
+          wordStart = s;
+          wordX = w;
+        }
+        inWord = true;
+      } else {
+        inWord = false;
+      }
+      uint32_t cell;
+      const uint32_t gw = DrawWidth(code, sz, table, cell);
+      w += gw;
+      if (maxW < w) {
+        if (inWord && wordX != 0) {  // the marks go to the next line with the glyph before them
+          placed.resize(wordGlyph);
+          s = wordStart;
+        }
+        line++;
+        w = 0;
+        gx = x.I();
+        inWord = false;
+        continue;
+      }
+      s.Offset += 2;
+      placed.push_back({code, cell, (float)gx, (float)(gx + (int)gw), (float)(line * sz + y.I()), col});
+      gx += gw;
+    } else {
+      if (*p == 0) {
+        line++;
+        w = 0;
+        gx = x.I();
+        s.Offset++;
+      } else if (*p == 4) {
+        col = TagColor(TagValue(s), shadow);
+      } else {
+        s.Offset++;
+      }
+      inWord = false;
+    }
+  }
+  if (draw.I() != 0) DrawGlyphs(placed, sz, alpha.I());
+}
+
+namespace {
+// 0x45d840 / 0x45d9d0: lines of a text broken at maxWidth, the width of its last line
+int Measure(uint32_t maxWidth, Str s, uint32_t size, uint32_t* lastWidth) {
+  if (maxWidth == 0) maxWidth = 0x500;
+  int lines = 1;
+  uint32_t w = 0, prevW = 0;
+  bool wrapped = false, inWord = false;
+  Str wordStart;
+  uint32_t wordX = 0;
+  for (const uint8_t* p = s.P(); *p != 0xff; p = s.P()) {
+    if (*p & 0x80) {
+      const uint32_t code = ((*p & 0x7f) << 8) | p[1];
+      if (w == 0 && code == 0x3f) {
+        s.Offset += 2;
+        continue;
+      }
+      if (StartsWord(code)) {
+        if (!inWord) {
+          wordStart = s;
+          wordX = w;
+        }
+        inWord = true;
+      } else {
+        inWord = false;
+      }
+      const uint32_t nw = w + MeasureWidth(code, size);
+      if (maxWidth < nw) {
+        if (inWord && wordX != 0) s = wordStart;
+        prevW = w;
+        lines++;
+        w = 0;
+        wrapped = true;
+        inWord = false;
+        continue;
+      }
+      w = nw;
+      s.Offset += 2;
+      wrapped = false;
+    } else {
+      if (*p == 0) {
+        prevW = w;
+        lines++;
+        w = 0;
+        wrapped = false;
+        s.Offset++;
+      } else if (*p == 4) {
+        TagValue(s);
+      } else {
+        s.Offset++;
+      }
+      inWord = false;
+    }
+  }
+  if (w == 0 && wrapped) {  // broken right at the end: the last line is the one before
+    lines--;
+    if (lastWidth) *lastWidth = prevW;
+  } else if (lastWidth) {
+    *lastWidth = w;
+  }
+  return lines;
+}
+}  // namespace
+
+int FUN_0045d840(Arg maxWidth, Arg str, Arg size) { return Measure(maxWidth.U(), StrOf(str), size.U(), nullptr); }
+
+int FUN_0045d9d0(Arg width, Arg str, Arg size) {
+  uint32_t* w = width.P<uint32_t>();
+  return Measure(w ? *w : 0, StrOf(str), size.U(), w);
+}
+
+int FUN_004643a0(Arg str, Arg maxGlyphs, Arg size) {
+  Str s = StrOf(str);
+  const uint32_t limit = maxGlyphs.U() ? maxGlyphs.U() : 0xff;
+  const uint32_t sz = size.U();
+  uint32_t w = 0, n = 0;
+  for (const uint8_t* p = s.P(); *p != 0xff && n <= limit; p = s.P()) {
+    if (*p & 0x80) {
+      const uint32_t code = ((*p & 0x7f) << 8) | p[1];
+      if (code < 0x15f)
+        w += Rd(0x5cb250)[code] * sz >> 5;
+      else if (code >= 0x1ec0)
+        w += Rd(0x5cb251)[0] * sz >> 5;
+      else
+        w += sz;
+      n++;
+      s.Offset += 2;
+    } else if (*p == 4) {
+      TagValue(s);
+    } else {
+      s.Offset++;
+    }
+  }
+  return (int)w;
+}
