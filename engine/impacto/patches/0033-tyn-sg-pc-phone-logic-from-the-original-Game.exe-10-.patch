+// 0x4587f0 mode 3: inbox
+void ModeInbox() {
+  if (S.InboxCount == 0) {
+    if (Cancel()) {
+      SetMode(1);
+      if (MouseMode()) SW(0x6a4c) = 0xff;
+    }
+    if (!Decide()) return;
+    SetMode(1);
+    if (MouseMode()) SW(0x6a4c) = 0xff;
+    return;
+  }
+  SW(0x6a50) = (S.InboxCount - 1) / 12;
+  if (Cancel()) {
+    SetMode(1);
+    if (MouseMode()) SW(0x6a4c) = 0xff;
+    return;
+  }
+  S.Hover = 0;
+  if (MouseMode()) ListMouse(S.InboxCount);
+  int shown = -1;
+  if (SW(0x6a58) != 0xff) shown = SW(0x6a5c);
+  if (!Decide()) {
+    ListKeys(S.InboxCount, false);
+    if (SW(0x6a58) == 0xff) return;
+    SW(0x6a5c) = S.Inbox[SW(0x6a58) + SW(0x6a54) * 12];
+    return;
+  }
+  if (SW(0x6a58) == 0xff) return;
+  const int mail = SW(0x6a5c);
+  MailEnterRead(mail);
+  Achievement(0x19);
+  if (GetFlag(0xa35) && mail == SW(0x6aa0) && S.Mails[mail][MailReply] != 999) {
+    S.LinkSel = 0xff;
+    ClearLinkHitAreas();
+    SetMode(0x1b);  // the phone trigger: choose a word to answer
+  } else {
+    SetMode(5);
+  }
+  if (shown >= 0) SetMailBit(shown, 1, true);  // read
+}
+
+void MailScroll(int linesVar, int countVar, int topVar) {
+  (void)linesVar;
+  S.ScrollHover = 0;
+  if (MouseMode()) {
+    if (Hit(0, 0x200) && SW(topVar) != 0) SW(topVar)--;
+    if (Hit(0, 0x400) && (uint32_t)SW(countVar) > 0xc && (uint32_t)SW(topVar) < (uint32_t)SW(countVar) - 0xc)
+      SW(topVar)++;
+    if (Hit(0x2e, 1)) S.Hover = 1, S.ScrollHover = 1;
+    if (Hit(0x2f, 1)) S.Hover = 1, S.ScrollHover = 2;
+    if (Hit(0x2e, 8)) {
+      if (SW(topVar) != 0) SW(topVar)--;
+    } else if (Hit(0x2f, 8)) {
+      if ((uint32_t)SW(countVar) > 0xc && (uint32_t)SW(topVar) < (uint32_t)SW(countVar) - 0xc) SW(topVar)++;
+    } else if (Hit(0, 8)) {
+      ClickDecide();
+    }
+  }
+}
+
+void MailScrollKeys(int countVar, int topVar) {
+  if (Up() && SW(topVar) != 0) SW(topVar)--;
+  if (Down() && (uint32_t)SW(countVar) > 0xc && (uint32_t)SW(topVar) < (uint32_t)SW(countVar) - 0xc) SW(topVar)++;
+}
