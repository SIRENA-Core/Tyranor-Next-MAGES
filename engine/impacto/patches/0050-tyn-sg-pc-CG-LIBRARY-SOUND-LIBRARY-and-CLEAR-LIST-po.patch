diff --git a/src/games/sghd/clearlist.cpp b/src/games/sghd/clearlist.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ff316cd440dacc621c35ba8688bb034433d80f05
--- /dev/null
+++ b/src/games/sghd/clearlist.cpp
@@ -0,0 +1,155 @@
+// CLEAR LIST of STEINS;GATE (Steam): drawn by 0x433db0 while GlobalVars[2148] is 7, values of 0x434680. The script
+// only waits for the cancel key.
+
+#include "clearlist.h"
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "album.h"
+#include "phonerender.h"
+#include "../../data/tipssystem.h"
+#include "../../games/mo6twpc/savesystem.h"
+#include "../../mem.h"
+#include "../../profile/dialogue.h"
+#include "../../profile/sprites.h"
+#include "../../renderer/renderer.h"
+#include "../../text/text.h"
+#include "../../vm/vm.h"
+
+namespace Impacto {
+namespace SGHD {
+namespace ClearList {
+
+namespace {
+
+constexpr int Surface = 0xa4;  // CLEARLIST, loaded by the script
+constexpr float K = 1.5f;      // text positions are in the original's 1280 units
+constexpr float Size = 24 * K;
+
+std::vector<ProcessedTextGlyph> Layout(const uint8_t* str, float x) {
+  Vm::Sc3Stream stream(const_cast<uint8_t*>(str));
+  return TextLayoutPlainLine(stream, std::nullopt, *Profile::Dialogue::DialogueFont, Size,
+                             DialogueColorPair{0xffffff, 0}, 1.0f, glm::vec2(x, 0), TextAlignment::Left);
+}
+
+std::vector<ProcessedTextGlyph> TableString(int index, float x) {
+  auto ctx = Vm::ScriptGetTextTableStrAddress(0, index);
+  return Layout(&ctx.Buffers[ctx.BufferId][ctx.IpOffset], x);
+}
+
+// 0x446740: a number in the font's digit glyphs (0x80 + digit), right aligned in `width` cells (0: as long as needed),
+// the free cells blank or, with zeroPad, '0'
+std::vector<ProcessedTextGlyph> Number(uint32_t value, int width, bool zeroPad, float x) {
+  std::string digits = std::to_string(value);
+  if (width != 0) {
+    if ((int)digits.size() > width) digits = digits.substr(digits.size() - width);
+    digits = std::string(width - digits.size(), ' ') + digits;
+  }
+  std::vector<uint8_t> s;
+  for (char c : digits) {
+    const uint16_t g = c == ' ' ? (zeroPad ? 0x80 : 0) : (uint16_t)(c - '0' + 0x80);
+    s.push_back((uint8_t)((g >> 8) | 0x80));
+    s.push_back((uint8_t)g);
+  }
+  s.push_back(0xff);
+  return Layout(s.data(), x);
+}
+
+float Width(const std::vector<ProcessedTextGlyph>& g) { return GetTextWidth(g); }
+
+void Draw(std::vector<ProcessedTextGlyph> g, float x, float y, float alpha) {
+  if (g.empty()) return;
+  const float dx = x - g.front().DestRect.X;
+  for (auto& glyph : g) glyph.Move(glm::vec2(dx, y));
+  Profile::Dialogue::DialogueFont->DrawProcessedText(g, alpha, RendererOutlineMode::None);
+}
+
+// right aligned text ending at `right` (all in screen pixels)
+float DrawRight(std::vector<ProcessedTextGlyph> g, float right, float y, float alpha) {
+  const float x = right - Width(g);
+  Draw(std::move(g), x, y, alpha);
+  return x;
+}
+
+}  // namespace
+
+void Render() {
+  if (ScrWork[2148] != 7 || ScrWork[2147] == 0) return;
+  using namespace Phone;
+  uint32_t ct = (uint32_t)ScrWork[2147];
+  if (ct > 0x20) ct = 0x20 - ct;
+  const int a = (int)(ct * 8);
+  const float alpha = std::min(a, 256) / 256.0f;
+
+  Spr(Surface, 0, 0, 1920, 1080, 0, 0, a);
+  if (auto it = Profile::SpriteSheets.find("Data"); it != Profile::SpriteSheets.end()) {
+    Sprite guide(it->second, 1.0f, 1 * 0x2a + 0x600 + 1.0f, 1534, 40);
+    Renderer->DrawSprite(guide, RectF(1, 995, 1534, 40), glm::vec4(1, 1, 1, alpha));
+  }
+  // the six endings (0x326 first), locked ones show the cell at 0x2a6
+  struct Badge {
+    int Flag, Cell;
+    float X, Y;
+  };
+  constexpr Badge Badges[] = {{0x326, 0, 154.5f, 319.5f},     {0x321, 0x71, 154.5f, 522},
+                              {0x322, 0xe2, 154.5f, 724.5f},  {0x323, 0x153, 981, 319.5f},
+                              {0x324, 0x1c4, 981, 522},       {0x325, 0x235, 981, 724.5f}};
+  int endings = 0;
+  for (const Badge& b : Badges) {
+    const bool got = GetFlag(b.Flag);
+    endings += got;
+    Spr(Surface, 1921.5f, ((got ? b.Cell : 0x2a6) + 1) * K, 789, 166.5f, b.X / K, b.Y / K, a);
+  }
+
+  const float y1 = 0x73 * K, y2 = 0x93 * K;
+  // play time
+  Draw(TableString(7, 0), 0x69 * K, y1, alpha);
+  const uint32_t t = (uint32_t)ScrWork[2001];
+  const uint32_t h = t / 3600, m = t % 3600 / 60, s = t % 60;
+  auto secLabel = TableString(9, 0);
+  const float w9 = Width(secLabel);
+  float x = DrawRight(std::move(secLabel), 0x252 * K, y1, alpha);
+  DrawRight(Number(s, 2, false, 0), x - 2 * K, y1, alpha);
+  if (m != 0 || h != 0) {
+    auto minLabel = TableString(8, 0);
+    x = DrawRight(std::move(minLabel), 0x222 * K - w9, y1, alpha);
+    DrawRight(Number(m, 2, false, 0), x - 2 * K, y1, alpha);
+    if (h != 0) {
+      const float xh = DrawRight(TableString(10, 0), x - 0x30 * K, y1, alpha);
+      DrawRight(Number(h, 0, false, 0), xh - 2 * K, y1, alpha);
+    }
+  }
+  // endings: n / 6
+  Draw(TableString(0x10, 0), 0x69 * K, y2, alpha);
+  x = DrawRight(Number(6, 2, false, 0), 0x252 * K - 2 * K, y2, alpha);
+  x = DrawRight(TableString(0xd, 0), x, y2, alpha);
+  DrawRight(Number(endings, 2, false, 0), x - 2 * K, y2, alpha);
+  // tips: read / all
+  int tipsRead = 0, tipsAll = 0;
+  if (auto* tips = Impacto::TipsSystem::Implementation.get()) {
+    tipsAll = (int)tips->TipEntryCount;
+    for (int i = 0; i < tipsAll; i++) tipsRead += (SaveSystem::GetTipStatus(i) >> 1) & 1;
+  }
+  Draw(TableString(0x11, 0), 0x2b4 * K, y1, alpha);
+  x = DrawRight(Number(tipsAll, 3, false, 0), 0x498 * K - 2 * K, y1, alpha);
+  x = DrawRight(TableString(0xd, 0), x, y1, alpha);
+  DrawRight(Number(tipsRead, 3, false, 0), x - 2 * K, y1, alpha);
+  // CG: viewed share with two decimals
+  int seen = 0, all = 0;
+  Album::Count(seen, all);
+  const uint32_t pct = all ? (uint32_t)(seen * 10000 / all) : 99999;
+  Draw(TableString(0x12, 0), 0x2b4 * K, y2, alpha);
+  auto pctLabel = TableString(0xc, 0);
+  const float w12 = Width(pctLabel);
+  x = DrawRight(std::move(pctLabel), 0x498 * K, y2, alpha);
+  DrawRight(Number(pct % 100, 2, true, 0), x - 2 * K, y2, alpha);
+  const float xd = 0x474 * K - w12;
+  Draw(TableString(0xb, 0), xd, y2, alpha);
+  DrawRight(Number(pct / 100, 0, false, 0), xd - 3 * K, y2, alpha);
+}
+
+}  // namespace ClearList
+}  // namespace SGHD
+}  // namespace Impacto
