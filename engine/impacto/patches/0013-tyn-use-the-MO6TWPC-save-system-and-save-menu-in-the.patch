diff --git a/profiles/mo6tw-pc/savedata.lua b/profiles/mo6tw-pc/savedata.lua
index 99f1ae57734e9da9dd037069937d954d10d61762..a5759d8a6f98b4a59a6675a4bbe2f55d2a67f5eb 100644
--- a/profiles/mo6tw-pc/savedata.lua
+++ b/profiles/mo6tw-pc/savedata.lua
@@ -1,8 +1,6 @@
--- TODO(tyn): no save system for the PC release yet (same as mo8).
--- AllowMissingImplementation: LoadSystemData reports OK with all system state at
--- its zero defaults, otherwise the startup script takes its fatal error path.
+-- Own save format (compatibility with the Steam save files is a non-goal), see
+-- src/games/mo6twpc/savesystem.cpp. One file per language profile, written atomically.
 root.SaveData = {
-    Type = SaveDataType.None,
-    AllowMissingImplementation = true,
+    Type = SaveDataType.MO6TWPC,
     SaveFilePath = root.BasePaths.RootSavesDir .. "/" .. root.Mo6Pc.Dir .. "/SYSTEM.DAT",
 };
