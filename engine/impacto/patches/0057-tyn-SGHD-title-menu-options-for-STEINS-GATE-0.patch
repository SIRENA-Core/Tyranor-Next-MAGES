+bool TitleMenu::EntryShown(int entry) const {
+  if (entry < 0 || entry >= Common::MenuEntriesNum) return false;
+  if (entry >= (int)MenuEntryFlags.size() || MenuEntryFlags[entry] < 0) return true;
+  return GetFlag(MenuEntryFlags[entry]) != 0;
+}
+
+// The hit area of a main entry: from the profile, or (MenuHitSize) where the entry is drawn when fully shown.
+RectF TitleMenu::EntryHitArea(int entry) const {
+  if (MenuHitSize.x <= 0.0f) return MenuHitAreas[entry];
+  int slot = 0;
+  for (int i = 0; i < entry; i++)
+    if (EntryShown(i)) slot++;
+  return RectF(MenuPosition.x, MenuPosition.y + slot * MenuSpacing, MenuHitSize.x, MenuHitSize.y);
+}
+
+// Next shown entry from `from` in direction `step`, wrapping around; none chosen (-1) starts at the first entry.
+int TitleMenu::StepCursor(int from, int step) const {
+  const int n = Common::MenuEntriesNum;
+  if (from < 0) {
+    for (int i = 0; i < n; i++)
+      if (EntryShown(i)) return i;
+    return -1;
+  }
+  int i = from;
+  for (int k = 0; k < n; k++) {
+    i = (i + step + n) % n;
+    if (EntryShown(i)) return i;
+  }
+  return from;
+}
+
