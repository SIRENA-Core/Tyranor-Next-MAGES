+-- contents (script.mpk: 0 _phone, 1 _rndrine, ..., 6 _Startup_win, 7 _system, 8 _tips, ...), which is also the order
+-- of the name tables in Game.exe (0x48b930).
+local dataDir = root.BasePaths.RootGamedataDir .. "/sg0-pc/USRDIR";
+
+root.Vfs = {
+    Mounts = {
+        ["script"] = {dataDir .. "/script.mpk"},
