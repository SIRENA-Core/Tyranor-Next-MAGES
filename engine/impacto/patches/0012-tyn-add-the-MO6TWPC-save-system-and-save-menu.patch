diff --git a/src/games/mo6twpc/savesystem.h b/src/games/mo6twpc/savesystem.h
new file mode 100644
index 0000000000000000000000000000000000000000..877553abf6e9aaf2e3547deb7dde65e76e2c0c8b
--- /dev/null
+++ b/src/games/mo6twpc/savesystem.h
@@ -0,0 +1,119 @@
+#pragma once
+
+#include "../../data/savesystem.h"
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <unordered_set>
+#include <vector>
+
+namespace Impacto {
+namespace MO6TWPC {
+
+using namespace Impacto::SaveSystem;
+
+// Save system of the Windows/Steam release of Memories Off 6 T-Wave.
+//
+// The PC scripts use the CC (PS4) style ScrWork/flag layout and the CC style
+// SaveSystem protocol (Save 70/71 mount, 4 load system data, 0 save system
+// data, 16 flush, 60/61 write, 80/81 check, AutoSave 0xff/10/5, LoadData
+// 0/1), so this implementation follows CCLCC::SaveSystem. The on-disk format
+// is our own (compatibility with the Steam save files is a non-goal) and is
+// documented in savesystem.cpp.
+constexpr int ThumbnailWidth = 240;
+constexpr int ThumbnailHeight = 135;
+constexpr size_t ThumbnailBytes = ThumbnailWidth * ThumbnailHeight * 2;  // RGB565
+
+// Ranges that are persisted per save entry (derived from the PC scripts, see
+// the comment in savesystem.cpp).
+constexpr size_t FlagWorkScript1Src = 50;    // bytes, 50 long (flags 400-799)
+constexpr size_t FlagWorkScript1Len = 50;
+constexpr size_t FlagWorkScript2Src = 300;   // bytes, 100 long (flags 2400-3199)
+constexpr size_t FlagWorkScript2Len = 100;
+constexpr size_t ScrWorkScript1Src = 0;      // ScrWork[0, 1600)
+constexpr size_t ScrWorkScript1Len = 1600;
+constexpr size_t ScrWorkScript2Src = 4300;   // ScrWork[4300, 7300)
+constexpr size_t ScrWorkScript2Len = 3000;
+
+// Ranges that are persisted in the system data
+constexpr size_t SysFlagWorkSrc1 = 100;  // bytes, 50 long (flags 800-1199)
+constexpr size_t SysFlagWorkLen1 = 50;
+constexpr size_t SysFlagWorkSrc2 = 460;  // bytes, 40 long
+constexpr size_t SysFlagWorkLen2 = 40;
+constexpr size_t SysScrWorkSrc = 1600;  // ScrWork[1600, 2100)
+constexpr size_t SysScrWorkLen = 500;
+
+struct SaveFileEntry : SaveFileEntryBase {
+  std::array<uint8_t, FlagWorkScript1Len> FlagWorkScript1{};
+  std::array<uint8_t, FlagWorkScript2Len> FlagWorkScript2{};
+  std::array<int, ScrWorkScript1Len> ScrWorkScript1{};
+  std::array<int, ScrWorkScript2Len> ScrWorkScript2{};
+  std::array<uint8_t, ThumbnailBytes> ThumbnailData{};
+  bool HasThumbnailData = false;
+};
+
+class SaveSystem final : public SaveSystemBase {
+ public:
+  SaveError CheckSaveFile() const override;
+  SaveError MountSaveFile(std::vector<QueuedTexture>& textures) override;
+
+  SaveError LoadSystemData() override;
+  void SaveSystemData() override;
+  void InitializeSystemData() override;
+
+  void SaveThumbnailData() override {}  // thumbnails are captured on flush
+  void SaveMemory() override;
+  void LoadEntry(SaveType type, int id) override;
+  void LoadMemoryNew(LoadProcess load) override;
+  void FlushWorkingSaveEntry(SaveType type, int id, int autoSaveType) override;
+  // Serialises the save file on the main thread; WriteSaveFile() then only
+  // writes those bytes from the worker thread and never touches live state.
+  void PrepareSaveFileWrite() override;
+  SaveError WriteSaveFile() override;
+  SaveError WriteQuickSaveFile() override { return WriteSaveFile(); }
+
+  uint32_t GetSavePlayTime(SaveType type, int id) const override;
+  uint8_t GetSaveFlags(SaveType type, int id) const override;
+  void SetSaveFlags(SaveType type, int id, uint8_t flags) override;
+  tm const& GetSaveDate(SaveType type, int id) const override;
+  uint8_t GetSaveStatus(SaveType type, int id) const override;
+  int GetSaveTitle(SaveType type, int id) const override;
+  uint32_t GetTipStatus(size_t tipId) const override;
+  void SetTipStatus(size_t tipId, bool isLocked, bool isUnread,
+                    bool isNew) override;
+  void SetLineRead(size_t scriptId, size_t lineId) override;
+  bool IsLineRead(size_t scriptId, size_t lineId) const override;
+  void GetReadMessagesCount(int* totalMessageCount,
+                            int* readMessageCount) const override;
+  void GetViewedEVsCount(int* totalEVCount, int* viewedEVCount) const override;
+  void GetEVStatus(int evId, int* totalVariations,
+                   int* viewedVariations) const override;
+  void SetEVStatus(int evId) override;
+  bool GetEVVariationIsUnlocked(size_t evId,
+                                size_t variationIdx) const override;
+  bool GetBgmFlag(int id) const override;
+  void SetBgmFlag(int id, bool flag) override;
+  void SetCheckpointId(int id) override;
+  Sprite& GetSaveThumbnail(SaveType type, int id) override;
+
+ private:
+  void LoadScrWork();
+  void InitSaveSlots();
+
+  std::array<uint8_t, 1024> GameExtraData{};
+  std::array<bool, 1200> EVFlags{};
+  std::array<uint8_t, 200> BGMFlags{};
+  // (scriptId << 16) | lineId of every line that has been read
+  std::unordered_set<uint32_t> ReadLines;
+  // Serialised system data, see SaveSystemData()
+  std::vector<uint8_t> SystemData;
+  // The complete save file as PrepareSaveFileWrite() serialised it. Owned by
+  // the worker thread while a write runs.
+  std::vector<uint8_t> PendingFile;
+
+  std::unique_ptr<SaveFileEntry> WorkingSaveEntry;
+};
+
+}  // namespace MO6TWPC
+}  // namespace Impacto
