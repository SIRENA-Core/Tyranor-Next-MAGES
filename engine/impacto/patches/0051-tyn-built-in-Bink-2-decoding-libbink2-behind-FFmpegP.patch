--- /dev/null
+++ b/src/video/bink2player.h
@@ -0,0 +1,75 @@
+#pragma once
+
+// Bink 2 (KB2*) movies, decoded with libbink2: FFmpeg has no Bink 2 decoder. FFmpegPlayer hands such a stream to
+// this player and forwards its calls.
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include "../audio/audiochannel.h"
+#include "../io/stream.h"
+#include "../renderer/yuvframe.h"
+
+struct bink2_t;
+
+namespace Impacto {
+namespace Video {
+
+class Bink2Player {
+ public:
+  ~Bink2Player();
+
+  // the stream starts with "KB2" (its position is kept)
+  static bool Detect(Io::Stream* stream);
+
+  // takes the stream; false when it cannot be decoded
+  bool Play(Io::Stream* stream, bool loop);
+  void Stop();
+  void Update(float dt);
+  void Render(float videoAlpha);
+  void ReinitAudio();
+
+  bool Playing() const { return IsPlaying; }
+  // the frame on screen, -1 before the first one
+  long ShownFrame() const { return Shown; }
+
+ private:
+  struct Frame {
+    unsigned long Index = 0;
+    std::vector<uint8_t> Y, U, V;  // tightly packed; with alpha the alpha rows follow Y (stacked layout)
+  };
+
+  void DecodeLoop();
+  void Pack(Frame& out, bool decoded);
+  double Clock() const;
+
+  std::vector<uint8_t> Data;
+  bink2_t* Decoder = nullptr;
+  unsigned long Width = 0, Height = 0, Frames = 0;
+  double FrameSeconds = 1.0 / 30.0;
+  bool Alpha = false, Looping = false, IsPlaying = false;
+
+  std::deque<Frame> Queue;
+  std::mutex QueueMutex;
+  std::condition_variable QueueCond;
+  std::thread Worker;
+  std::atomic<bool> Abort{false};
+  bool DecoderDone = false;  // guarded by QueueMutex
+
+  YUVFrame* Texture = nullptr;
+  long Shown = -1;
+  unsigned long Loops = 0;  // looping: how often the movie restarted
+
+  std::unique_ptr<Audio::AudioChannel> AudioOut;
+  bool HasAudio = false;
+  double Elapsed = 0.0;  // the clock without audio
+};
+
+}  // namespace Video
+}  // namespace Impacto
