+void SendReply(int mail, int reply) {  // shared by 0x4568a0 and 0x458df0
+  SetMailBit(reply, 0, true);
+  if (GetFlag(0xa32)) PushSent(reply);
+  if (mail != 0xffff) {
+    if (GetFlag(0xa32)) MarkReplied(mail);
+    SetMailBit(mail, 4, true);
+  }
+  S.NoticeTimer = 0x3c;
+  SetMode(9);
+}
