+  NameMaxWidth = EnsureGetMember<float>("NameMaxWidth");
+  TryGetMember<uint32_t>("TextColor", TextColor);
+  TryGetMember<uint32_t>("EmptyCategoryColor", EmptyCategoryColor);
+  TryGetMember<uint32_t>("UnreadColor", UnreadColor);
+  TryGetMember<uint32_t>("LockedColor", LockedColor);
+  RowArea = EnsureGetMember<RectF>("RowArea");
+  Highlight = EnsureGetMember<Sprite>("HighlightSprite");
+  HeaderBar = EnsureGetMember<Sprite>("HeaderBarSprite");
+  HeaderBarOffset = EnsureGetMember<glm::vec2>("HeaderBarOffset");
+  NewMark = EnsureGetMember<Sprite>("NewSprite");
+  NewMarkX = EnsureGetMember<float>("NewX");
+  Knob = EnsureGetMember<Sprite>("KnobSprite");
+  ListKnobPosition = EnsureGetMember<glm::vec2>("ListKnobPosition");
+  ListKnobRange = EnsureGetMember<float>("ListKnobRange");
+
+  NumberLabelPosition = EnsureGetMember<glm::vec2>("NumberLabelPosition");
+  NumberPosition = EnsureGetMember<glm::vec2>("NumberPosition");
+  NumberFontSize = EnsureGetMember<float>("NumberFontSize");
+  TitleRightX = EnsureGetMember<float>("TitleRightX");
+  TitleY = EnsureGetMember<float>("TitleY");
+  TitleFontSize = EnsureGetMember<float>("TitleFontSize");
+  SubtitleY = EnsureGetMember<float>("SubtitleY");
+  SubtitleFontSize = EnsureGetMember<float>("SubtitleFontSize");
+  TryGetMember<uint32_t>("SubtitleColor", SubtitleColor);
+  LabelPosition = EnsureGetMember<glm::vec2>("LabelPosition");
+  LabelFontSize = EnsureGetMember<float>("LabelFontSize");
+  LabelMaxWidth = EnsureGetMember<float>("LabelMaxWidth");
+  TryGetMember<uint32_t>("LabelColor", LabelColor);
+  ContentPosition = EnsureGetMember<glm::vec2>("ContentPosition");
+  ContentClip = EnsureGetMember<RectF>("ContentClip");
+  ContentPageHeight = EnsureGetMember<float>("ContentPageHeight");
+  TryGetMember<float>("ContentGap", ContentGap);
+  TryGetMember<float>("ContentScrollStep", ContentScrollStep);
+  ContentKnobPosition = EnsureGetMember<glm::vec2>("ContentKnobPosition");
+  ContentKnobRange = EnsureGetMember<float>("ContentKnobRange");
+
+  Guide = EnsureGetMember<Sprite>("GuideSprite");
+  GuidePosition = EnsureGetMember<glm::vec2>("GuidePosition");
+
+  TryGetMember<int>("TextTableId", TextTableId);
+  TryGetMember<int>("CategoryNameString", CategoryNameString);
+  TryGetMember<int>("LockedString", LockedString);
+  TryGetMember<int>("NumberString", NumberString);
+  TryGetMember<int>("ExtraHeaderString", ExtraHeaderString);
+  TryGetMember<int>("ShownTipVar", ShownTipVar);
+  TryGetMember<int>("OpenModeVar", OpenModeVar);
+
+  auto drawType = EnsureGetMember<Game::DrawComponentType>("DrawType");
+  UI::TipsMenuPtr = new UI::SGHD::TipsMenu();
+  UI::Menus[drawType].push_back(UI::TipsMenuPtr);
+}
