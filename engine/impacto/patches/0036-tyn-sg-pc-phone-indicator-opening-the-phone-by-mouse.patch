index 0000000000000000000000000000000000000000..4cb8b4d0f7a3d140df9f7df330d2daec69834111
--- /dev/null
+++ b/src/games/sghd/phoneindicator.cpp
@@ -0,0 +1,113 @@
+// The small phone at the top left of the scene (0x45a9a0, drawn over all layers): date and day of the week, antenna,
+// unread mark; "new mail" blinks over the date, an incoming call shows the caller. Flag 2616 shows it, flag 2617
+// shows the notice of 3 seconds. In the mouse mode of the original a click on it opens the phone (0x434d40).
+#include "phonerender.h"
+#include "phonestate.h"
+
+#include "../../mem.h"
+
+namespace Impacto {
+namespace SGHD {
+namespace Phone {
+
+namespace {
+constexpr float Scale = 1.5f;
+int Alpha = 0;           // DAT_018eb094
+int NoticeTimer = 0;     // DAT_018eb994
+uint32_t MailBlink = 0;  // DAT_018ec748
+bool Hover = false;      // DAT_016411fc
+
+// destinations of this routine are screen pixels in the original
+void SprPx(float sx, float sy, float w, float h, float px, float py, int alpha) {
+  Spr(PhoneSurface(), sx, sy, w, h, px / Scale, py / Scale, alpha);
+}
+void Digit(int d, float px, int alpha) { SprPx((float)(d * 0x18 + 0x14f) * Scale, 1366.5f, 33, 45, px, 91.5f, alpha); }
+}  // namespace
+
+void SetIndicatorHover(bool on) { Hover = on; }
+
+void ResetIndicator() {  // 0x45b2a0
+  Alpha = 0;
+  NoticeTimer = 0;
+  SetFlag(0xa38, 0);
+}
+
+void RenderIndicator() {
+  if (GetFlag(0xa39)) {
+    NoticeTimer = 0xb4;
+    SetFlag(0xa39, 0);
+  }
+  if (!GetFlag(0xa38)) {
+    if (Alpha == 0) return;
+    Alpha -= 0x10;
+  } else if (Alpha < 0x100) {
+    Alpha += 0x10;
+  }
+  const int alpha = Alpha;
+  if (alpha == 0) return;
+  if (NoticeTimer != 0) NoticeTimer--;
+  const bool calling = GetFlag(0xa2d);
+  if (calling || NoticeTimer != 0)
+    SprPx(943.5f, 1120.5f, 396, 126, 79.5f, 40.5f, alpha);
+  else
+    SprPx(580.5f, 1120.5f, 360, 90, 99, 58.5f, alpha);
+  if (S.HasUnread) SprPx(418.5f, 1213.5f, 33, 21, 324, 73.5f, alpha);
+  SprPx(454.5f, 1213.5f, 39, 21, 360, 73.5f, alpha);
+  SprPx(GetFlag(0xa29) ? 496.5f : 535.5f, 1213.5f, 36, 21, 402, 73.5f, alpha);
+
+  if (calling) {  // the caller: name right aligned, or the number when the contact has no name
+    const int caller = SW(0x6a6c);
+    Text(0x4c, 0x34, 200, Str(S.StrBaseA + 0x51), 0, 1, 0xffffff, 0x14, alpha);
+    const uint8_t* name = Str(S.StrBaseB + caller * 2 + 1);
+    if (name[0] == 0x80 && name[1] == 0) {
+      const uint8_t* digits = Str(S.StrBaseB);
+      int x = 0x78;
+      for (const uint8_t* n = Str(S.StrBaseB + caller * 2 + 2); *n != 0xff; n += 2, x += 0x10) {
+        int i = 0;
+        const uint8_t* d = digits;
+        for (; *d != 0xff; d += 2, i++)
+          if (((n[0] & 0x7f) << 8 | n[1]) == ((d[0] & 0x7f) << 8 | d[1])) break;
+        if (*d != 0xff) Spr(PhoneSurface(), (float)(i * 0x10 + 0x1e3) * Scale, 1249.5f, 21, 30, x, 111 / Scale, alpha);
+      }
+    } else {
+      Text(0x128 - TextWidth(name, 0x14), 0x4a, 0xdc, name, 0, 1, 0xffffff, 0x14, alpha);
+    }
+    MailBlink = 0;
+  } else if (NoticeTimer != 0) {
+    Text(0x60, 0x4a, 200, Str(S.StrBaseA + 0x14), 0, 1, 0xffffff, 0x14, alpha);
+    MailBlink = 0;
+  } else {
+    const bool newMail = GetFlag(0xa2c);
+    if (!newMail || ++MailBlink > 0x77) MailBlink = 0;
+    if (newMail && MailBlink < 0x3c) {
+      Text(0x60, 0x4a, 200, Str(S.StrBaseA + 0x50), 0, 1, 0xffffff, 0x14, alpha);
+    } else {  // date GlobalVars[1430]: month * 100 + day
+      uint32_t date = SW(0x1658);
+      if (date == 0) date = 0x3a3;
+      uint32_t thousands = date / 1000;
+      const uint32_t month = (date % 1000) / 100, day = date % 100, tens = day / 10, ones = day % 10;
+      if (thousands != 0) Digit(thousands, 114, alpha);
+      Digit(month, 150, alpha);
+      SprPx(970.5f, 1366.5f, 33, 45, 186, 91.5f, alpha);  // '/'
+      if (tens != 0) Digit(tens, 222, alpha);
+      Digit(ones, 258, alpha);
+      uint32_t week = thousands;  // day of the week of 2010
+      if (month == 7)
+        week = day + 3;
+      else if (month == 8)
+        week = day + 0x22;
+      else if (month == 9)
+        week = day + 0x41;
+      week %= 7;
+      const int wx = week < 3 ? week * 0x33 + 0x149 : (week - 3) * 0x33 + 0x116;
+      const int wy = week < 3 ? 0x338 : 0x34a;
+      SprPx(418.5f, 1237.5f, 73.5f, 24, 309, 111, alpha);
+      SprPx((float)(wx + 1) * Scale, (float)(wy + 1) * Scale, 73.5f, 24, 309, 111, alpha);
+    }
+  }
+  if (Hover) Rect(99, 58.5f, 360, 90, 0xffff44, alpha >> 2);
+}
+
+}  // namespace Phone
+}  // namespace SGHD
+}  // namespace Impacto
