diff --git a/src/games/sghd/timeleap.cpp b/src/games/sghd/timeleap.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..90a4ad38c84bc5f4d9312878ea815cfa9a507d4e
--- /dev/null
+++ b/src/games/sghd/timeleap.cpp
@@ -0,0 +1,278 @@
+// The flip clock of a time leap (STEINS;GATE, Steam version): 10:3A gives the two times, the counter runs while flag
+// 2472 is up and is drawn on the layer GlobalVars[6702] from the background in the script's buffer (EFF_TIMELEAP).
+// Ported from Game.exe: setup 0x41a140, update 0x41a960, drawing 0x418d60 / 0x418e90 / 0x4193c0 / 0x419d60.
+
+#include "timeleap.h"
+
+#include <algorithm>
+#include <array>
+#include <vector>
+
+#include "../../background2d.h"
+#include "../../mem.h"
+#include "../../profile/scriptvars.h"
+#include "../../renderer/renderer.h"
+#include "../../util.h"
+
+namespace Impacto {
+namespace SGHD {
+namespace TimeLeap {
+
+using namespace Impacto::Profile::ScriptVars;
+
+namespace {
+
+// 0x529cb8: the step sizes of the counter in 1/8 minute: speeding up, then slowing down again
+constexpr std::array<uint32_t, 9> Steps = {1, 4, 16, 64, 256, 64, 16, 4, 1};
+// 0x529d00: day / minute units, digit * 4 + flip stage -> cell of the texture (row * 10 + column)
+constexpr std::array<int, 40> UnitCells = {0, 30, 20, 10, 1, 31, 21, 11, 2, 32, 22, 12, 3, 33, 23, 13, 4, 34, 24, 14,
+                                           5, 35, 25, 15, 6, 36, 26, 16, 7, 37, 27, 17, 8, 38, 28, 18, 9, 39, 29, 19};
+// 0x529da0: day tens (digit * 4 + stage), from 16 on the minute tens
+constexpr std::array<int, 40> TensCells = {40, 43, 42, 41, 1, 31, 21, 11, 2, 32, 22, 12, 3, 33, 23, 13, 0, 30, 20, 10,
+                                           1, 31, 21, 11, 2, 32, 22, 12, 3, 33, 23, 13, 4, 34, 24, 14, 5, 47, 46, 15};
+// 0x529e40: hour 0..23 -> (tens, units) cells of flip stage 0..3
+constexpr int HourCells[24][8] = {
+    {40, 0, 40, 30, 40, 20, 40, 10},  {40, 1, 40, 31, 40, 21, 40, 11},  {40, 2, 40, 32, 40, 22, 40, 12},
+    {40, 3, 40, 33, 40, 23, 40, 13},  {40, 4, 40, 34, 40, 24, 40, 14},  {40, 5, 40, 35, 40, 25, 40, 15},
+    {40, 6, 40, 36, 40, 26, 40, 16},  {40, 7, 40, 37, 40, 27, 40, 17},  {40, 8, 40, 38, 40, 28, 40, 18},
+    {40, 9, 43, 39, 42, 29, 41, 19},  {1, 0, 1, 30, 1, 20, 1, 10},      {1, 1, 1, 31, 1, 21, 1, 11},
+    {1, 2, 1, 32, 1, 22, 1, 12},      {1, 3, 1, 33, 1, 23, 1, 13},      {1, 4, 1, 34, 1, 24, 1, 14},
+    {1, 5, 1, 35, 1, 25, 1, 15},      {1, 6, 1, 36, 1, 26, 1, 16},      {1, 7, 1, 37, 1, 27, 1, 17},
+    {1, 8, 1, 38, 1, 28, 1, 18},      {1, 9, 31, 39, 21, 29, 11, 19},   {2, 0, 2, 30, 2, 20, 2, 10},
+    {2, 1, 2, 31, 2, 21, 2, 11},      {2, 2, 2, 32, 2, 22, 2, 12},      {2, 3, 45, 49, 44, 48, 12, 13},
+};
+
+// per counter step (DAT_0145f9c8 ...): the shown digits and the step taken to the next one
+struct Column {
+  std::vector<uint32_t> Month, Day10, Day1, Hour, Min10, Min1, Weekday, Step;
+};
+Column C;
+uint32_t StepCount = 0;  // DAT_0145f9c4
+uint32_t Frame = 0;      // DAT_0146a288
+int BufferId = 0;        // the script's buffer of the texture (DAT_0146a298 holds its surface)
+
+// 1 + the frames before f that show the same value, counted while they do (1..4)
+uint32_t BackRun(const std::vector<uint32_t>& v, uint32_t f) {
+  uint32_t r = 1;
+  for (uint32_t j = 1; j <= 3 && v[f - j] == v[f]; j++) r++;
+  return r;
+}
+
+// the back run, and onwards while the following frames still show the value (capped above 3)
+uint32_t Run(const std::vector<uint32_t>& v, uint32_t f, uint32_t back) {
+  uint32_t s = back;
+  if (v[f + 1] != v[f]) return s;
+  for (uint32_t k = f + 2;; k++) {
+    s++;
+    if (s > 3 || v[k] != v[f]) return s;
+  }
+}
+
+const SpriteSheet* Sheet() {
+  auto it = Backgrounds2D.find(ScrWork[SW_BG1SURF + GetBufferId(BufferId)]);
+  if (it == Backgrounds2D.end() || !it->second || it->second->Status != LoadStatus::Loaded) return nullptr;
+  return &it->second->BgSprite.Sheet;
+}
+
+// 0x432460 with the counter's fixed arguments: part (sx, sy, w, h) of the texture, its point (px, py) at the screen
+// centre, scaled by scale / 256
+void Draw(const SpriteSheet& sheet, float sx, float sy, float w, float h, float px, float py, int alpha, int scale) {
+  if (alpha <= 0) return;
+  const float k = scale / 256.0f;
+  Sprite sprite(sheet, sx, sy, w, h);
+  Renderer->DrawSprite(sprite, RectF(960.0f - px * k, 540.0f - py * k, w * k, h * k),
+                       glm::vec4(1.0f, 1.0f, 1.0f, std::min(alpha / 255.0f, 1.0f)));
+}
+
+// a 105 x 145 cell of the digit rows (row = flip stage, the last row holds the special cells)
+void Cell(const SpriteSheet& sheet, int cell, float px, int alpha, int scale) {
+  Draw(sheet, ((cell % 10) * 105 + 1) * 1.5f, ((cell / 10) * 147 + 206) * 1.5f, 157.5f, 217.5f, px, 108.0f, alpha,
+       scale);
+}
+
+// 0x418e90: day and weekday (the weekday turns with the day's units)
+void DrawDay(const SpriteSheet& s, uint32_t f, int alpha, int scale) {
+  uint32_t s10 = 0, s1 = 0;
+  if (f >= 4) {
+    s10 = BackRun(C.Day10, f) % 4;
+    s1 = BackRun(C.Day1, f) % 4;
+  }
+  Cell(s, TensCells[C.Day10[f] * 4 + s10], 585.0f, alpha, scale);
+  Cell(s, UnitCells[C.Day1[f] * 4 + s1], 424.5f, alpha, scale);
+  const int wy = s1 ? 0x319 - (int)s1 * 0x93 + 1 : 0xce;
+  Draw(s, (C.Weekday[f] * 142 + 1053) * 1.5f, wy * 1.5f, 213.0f, 217.5f, 207.0f, 108.0f, alpha, scale);
+}
+
+// 0x4193c0: hours, as one two digit cell pair; quick changes show two flip stages at once
+void DrawHour(const SpriteSheet& s, uint32_t f, int alpha, int scale) {
+  const int* t = HourCells[C.Hour[f]];
+  auto pair = [&](int i, int a) {
+    Cell(s, t[i], -28.5f, a, scale);
+    Cell(s, t[i + 1], -189.0f, a, scale);
+  };
+  if (f < 4) return pair(0, alpha);
+  const uint32_t e = BackRun(C.Hour, f);
+  if (e >= 4) return pair(0, alpha);
+  const uint32_t r = Run(C.Hour, f, e);
+  if (r >= 4) return pair(2 * e, alpha);
+  if (r == 3 && e == 3) return pair(6, alpha);
+  if (r != 3 && e == 2) {
+    pair(0, alpha);
+    return pair(6, alpha >> 1);
+  }
+  pair(2, alpha);
+  pair(4, alpha >> 1);
+}
+
+// 0x419d60: minutes; while the counter is fast the units are a blur of several faint cells
+void DrawMinute(const SpriteSheet& s, uint32_t f, int alpha, int scale) {
+  auto tens = [&](int i, int a) { Cell(s, TensCells[16 + i], -415.5f, a, scale); };
+  auto units = [&](int i, int a) { Cell(s, UnitCells[i], -576.0f, a, scale); };
+  if (f < 4) {
+    tens(C.Min10[f] * 4, alpha);
+    units(C.Min1[f] * 4, alpha);
+    return;
+  }
+  const int c = C.Min10[f] * 4;
+  const uint32_t e = BackRun(C.Min10, f);
+  const uint32_t r = e >= 4 ? 4 : Run(C.Min10, f, e);
+  if (e >= 4) {
+    tens(c, alpha);
+  } else if (r >= 4) {
+    tens(c + e, alpha);
+  } else if (r == 3 && e == 3) {
+    tens(c + 3, alpha);
+  } else if (r == 2 && e == 1) {
+    tens(c, alpha);
+    tens(c + 3, alpha >> 1);
+  } else if (r == 3 || r == 2) {
+    tens(c + 1, alpha);
+    tens(c + 2, alpha >> 1);
+  } else {
+    tens(c, alpha);
+    tens(c + 3, alpha >> 2);
+    tens(c + 1, alpha >> 2);
+    tens(c + 2, alpha >> 2);
+  }
+
+  const uint32_t st = C.Step[f], d = C.Min1[f];
+  if (st == 1) {
+    const uint32_t b = BackRun(C.Min1, f);
+    return units((b < 4 ? b : 0) + d * 4, alpha);
+  }
+  if (st == 2) {
+    if (BackRun(C.Min1, f) >= 2) {
+      units(d * 4, alpha);
+      return units(d * 4 + 3, alpha >> 1);
+    }
+    units(d * 4 + 1, alpha);
+    return units(d * 4 + 2, alpha >> 1);
+  }
+  units(d * 4, alpha);
+  // the original passes the bare digit as the cell index here (not digit * 4 + stage); kept as it is
+  uint32_t digit = d, phase = 0;
+  const uint32_t count = st < 0x40 ? st : st / 3, advance = st < 0x40 ? 1 : 3;
+  for (uint32_t i = 0; i < count; i++) {
+    phase += advance;
+    if (phase >= 4) {
+      phase -= 4;
+      digit = digit + 1 == 10 ? 0 : digit + 1;
+    }
+    units(digit, alpha / count);
+  }
+}
+
+}  // namespace
+
+void Start(const int (&v)[6]) {
+  BufferId = v[5];
+  const uint32_t t0 = (v[0] % 100) * 1440 + (v[1] / 100) * 60 + v[1] % 100;
+  const uint32_t t1 = (v[2] % 100) * 1440 + (v[3] / 100) * 60 + v[3] % 100;
+  // how many steps of each size: two of each faster size where it fits, the rest in the fastest one that fits
+  uint32_t u = (t0 - t1) * 8;
+  std::array<uint32_t, 9> cnt{};
+  constexpr uint32_t d[4] = {64, 16, 16, 16};
+  const auto& c = Steps;
+  const uint32_t i2 = c[0] * d[0];
+  if (c[1] + i2 * 2 <= u) {
+    const uint32_t i5 = d[1] * c[1];
+    if ((i2 + i5) * 2 + c[2] <= u) {
+      const uint32_t i7 = d[2] * c[2] + i5 + i2;
+      if (c[3] + i7 * 2 <= u) {
+        const uint32_t i4 = d[3] * c[3] + i7;
+        if (c[4] + i4 * 2 <= u) {
+          cnt[4] = (u - i4 * 2) / c[4];
+          u -= cnt[4] * c[4];
+        }
+        const uint32_t n = (u - i7 * 2) / c[3];
+        cnt[5] = n >> 1;
+        u -= n * c[3];
+        cnt[3] = n - cnt[5];
+      }
+      const uint32_t n = (u - (i2 + i5) * 2) / c[2];
+      cnt[6] = n >> 1;
+      u -= n * c[2];
+      cnt[2] = n - cnt[6];
+    }
+    const uint32_t n = (u - i2 * 2) / c[1];
+    u -= n * c[1];
+    cnt[7] = n >> 1;
+    cnt[1] = n - cnt[7];
+  }
+  cnt[8] = u >> 1;
+  cnt[0] = u - cnt[8];
+  StepCount = 4;
+  for (uint32_t x : cnt) StepCount += x;
+  StepCount = std::min<uint32_t>(StepCount, 1200 - 8);  // the original's tables hold 1200 steps
+
+  for (auto* col : {&C.Month, &C.Day10, &C.Day1, &C.Hour, &C.Min10, &C.Min1, &C.Weekday, &C.Step})
+    col->assign(StepCount + 8, 0);
+  uint32_t pos = t0 * 8;
+  for (uint32_t i = 3; i < StepCount; i++) {
+    uint32_t q = pos >> 1;  // quarter minutes
+    const uint32_t day = q / 5760;
+    q %= 5760;
+    C.Month[i] = 8;
+    C.Day10[i] = day / 10;
+    C.Day1[i] = day % 10;
+    C.Hour[i] = q / 240;
+    C.Min10[i] = (q % 240 >> 2) / 10;
+    C.Min1[i] = (q % 240 >> 2) % 10;
+    C.Weekday[i] = (day - 1) % 7;
+    for (size_t k = 0; k < cnt.size(); k++) {
+      if (cnt[k] == 0) continue;
+      cnt[k]--;
+      pos -= Steps[k];
+      C.Step[i] = Steps[k];
+      break;
+    }
+  }
+  for (auto* col : {&C.Month, &C.Day10, &C.Day1, &C.Hour, &C.Min10, &C.Min1, &C.Weekday}) {
+    std::fill(col->begin() + StepCount, col->end(), (*col)[StepCount - 1]);
+    std::fill(col->begin(), col->begin() + 3, (*col)[3]);
+  }
+  std::fill(C.Step.begin() + StepCount, C.Step.end(), 1);
+  std::fill(C.Step.begin(), C.Step.begin() + 3, 1);
+  Frame = 0;
+}
+
+void Update() {
+  if (GetFlag(2472) && ++Frame >= StepCount + 5) SetFlag(2472, 0);
+}
+
+void Render() {
+  const int alpha = ScrWork[6703], scale = ScrWork[6704] >> 8;
+  if (alpha == 0 || StepCount == 0) return;
+  const SpriteSheet* sheet = Sheet();
+  if (!sheet) return;
+  const uint32_t f = std::min(Frame, StepCount + 4);
+  Draw(*sheet, 1.5f, 1.5f, 1920.0f, 304.5f, 960.0f, 153.0f, alpha, scale);
+  Draw(*sheet, (C.Month[0] * 105 + 1) * 1.5f, 309.0f, 157.5f, 217.5f, 807.0f, 108.0f, alpha, scale);
+  DrawDay(*sheet, f, alpha, scale);
+  DrawHour(*sheet, f, alpha, scale);
+  DrawMinute(*sheet, f, alpha, scale);
+}
+
+}  // namespace TimeLeap
+}  // namespace SGHD
+}  // namespace Impacto
