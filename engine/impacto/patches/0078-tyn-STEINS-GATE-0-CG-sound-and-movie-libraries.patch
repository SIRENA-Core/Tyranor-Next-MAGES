+// The sound library plays through the BGM channel request of the original (0x2ed16e0 + channel * 0x98, channel
+// DAT_00dde0ec): +0 track (-1 stops), +4 loop, +0xc play request; the audio thread of the original answers with +0x38
+// (1 while playing) and +0x3c (the track played through, the library then picks the next one). Here the track plays
+// on the engine's BGM channel once (the library repeats it itself).
+void BridgeLibraryAudio() {
+  const uint32_t ch = *reinterpret_cast<uint32_t*>(Sg0Emu::At(0x00dde0ec)) & 1;
+  int32_t* req = reinterpret_cast<int32_t*>(Sg0Emu::At(0x02ed16e0 + ch * 0x98));
+  Audio::AudioChannel* channel = Audio::Channels[Audio::AC_BGM0 + ch].get();
+  static bool started = false;
+  if (req[3] != 0) {
+    req[3] = 0;
+    if (req[0] >= 0) {
+      channel->Play("bgm", (uint32_t)req[0], false, 0.0f);
+      started = true;
+      req[0xe] = 1;
+      req[0xf] = 0;
+    }
+  } else if (req[0] == -1 && started) {
+    channel->Stop(0.0f);
+    started = false;
+    req[0xe] = 0;
+  }
+  if (started && channel->GetState() != Audio::ACS_Playing) {
+    started = false;
+    req[0xe] = 0;
+    req[0xf] = 1;
+  }
+}
