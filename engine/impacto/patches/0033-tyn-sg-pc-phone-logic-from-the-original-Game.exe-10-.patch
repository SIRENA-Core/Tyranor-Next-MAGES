+// 0x459760 mode 7: call or mail the chosen contact
+void ModeContact() {
+  const uint32_t c = S.Contacts[SW(0x6a94)];
+  const bool canMail = GetFlag(0xa2a) && S.CanMail[c];
+  const bool canCall = GetFlag(0xa2b) && S.CanCall[c];
+  if (Cancel()) {
+    SetMode(6);
+    if (MouseMode()) SW(0x6a94) = 0xff;
+    return;
+  }
+  S.Hover = 0;
+  if (MouseMode()) {
+    SW(0x6b04) = 0xff;
+    if (Hit(10, 1)) S.Hover = 1, SW(0x6b04) = 0;
+    if (Hit(0xb, 1) && canMail && canCall) S.Hover = 1, SW(0x6b04) = 1;
+    if (Hit(10, 8)) ClickDecide();
+    if (Hit(0xb, 8) && canMail && canCall) ClickDecide();
+  }
+  if (!Decide()) {
+    for (bool pressed : {Up(), Down()}) {
+      if (!pressed) continue;
+      if ((uint32_t)SW(0x6b04) == 0xff)
+        SW(0x6b04) = 0;
+      else if (canMail && canCall)
+        SW(0x6b04) ^= 1;
+    }
+    return;
+  }
+  if (SW(0x6b04) == 0xff) return;
+  SW(0x6a98) = S.Contacts[SW(0x6a94)];
+  SetFlag(SW(0x6b04) == 0 && canCall ? 0xa36 : 0xa37, 1);
+  SetFlag(0xa33, 1);
+  SetFlag(0xa31, 1);
+}
