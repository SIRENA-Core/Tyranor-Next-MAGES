diff --git a/src/video/bink2player.cpp b/src/video/bink2player.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d6dcb6d9a5ddc696e14ebb5cee3175a6d76d54bc
--- /dev/null
+++ b/src/video/bink2player.cpp
@@ -0,0 +1,274 @@
+#include "bink2player.h"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <optional>
+
+#include <bink2.h>
+
+#include "../audio/audiostream.h"
+#include "../log.h"
+#include "../profile/game.h"
+#include "../renderer/renderer.h"
+
+namespace Impacto {
+namespace Video {
+
+namespace {
+
+// Bink 2 stores full range YUV; the video shader expects the limited range of Rec. 601
+struct RangeTables {
+  std::array<uint8_t, 256> Luma{}, Chroma{};
+  RangeTables() {
+    for (int v = 0; v < 256; v++) {
+      Luma[v] = (uint8_t)(16 + (v * 219 + 127) / 255);
+      Chroma[v] = (uint8_t)std::clamp(128 + ((v - 128) * 224 + (v >= 128 ? 127 : -127)) / 255, 16, 240);
+    }
+  }
+};
+const RangeTables Range;
+
+constexpr size_t MaxQueued = 3;
+
+// PCM of the whole movie, decoded up front
+class PcmStream : public Audio::AudioStream {
+ public:
+  PcmStream(std::vector<int16_t> pcm, int channels, int rate) : Pcm(std::move(pcm)) {
+    ChannelCount = channels;
+    SampleRate = rate;
+    BitDepth = 16;
+    Duration = (int)(Pcm.size() / (size_t)channels);
+  }
+  int Read(void* buffer, int samples) override {
+    const int n = std::max(0, std::min(samples, Duration - ReadPosition));
+    std::memcpy(buffer, Pcm.data() + (size_t)ReadPosition * ChannelCount, (size_t)n * ChannelCount * 2);
+    ReadPosition += n;
+    return n;
+  }
+  void Seek(int samples) override { ReadPosition = std::clamp(samples, 0, Duration); }
+
+ private:
+  std::vector<int16_t> Pcm;
+};
+
+}  // namespace
+
+bool Bink2Player::Detect(Io::Stream* stream) {
+  if (stream == nullptr) return false;
+  const int64_t pos = stream->Position;
+  char magic[3] = {};
+  stream->Seek(0, Io::Set);
+  const bool ok = stream->Read(magic, 3) == 3 && std::memcmp(magic, "KB2", 3) == 0;
+  stream->Seek(pos, Io::Set);
+  return ok;
+}
+
+Bink2Player::~Bink2Player() { Stop(); }
+
+bool Bink2Player::Play(Io::Stream* stream, bool loop) {
+  Stop();
+  // the whole file in memory: libbink2 reads frames from a buffer
+  Data.resize((size_t)stream->Meta.Size);
+  stream->Seek(0, Io::Set);
+  const int64_t got = stream->Read(Data.data(), (int64_t)Data.size());
+  delete stream;
+  if (got != (int64_t)Data.size()) {
+    ImpLog(LogLevel::Error, LogChannel::Video, "Bink 2: short read\n");
+    Data.clear();
+    return false;
+  }
+
+  Decoder = bink2_open_memory(Data.data(), (unsigned long)Data.size());
+  if (!Decoder) {
+    ImpLog(LogLevel::Error, LogChannel::Video, "Bink 2: the stream cannot be decoded\n");
+    Data.clear();
+    return false;
+  }
+  unsigned long current = 0, flags = 0;
+  double usf = 0;
+  bink2_info_all(Decoder, &current, &Frames, &usf);
+  bink2_info_video(Decoder, &Width, &Height, &flags);
+  if (usf > 0) FrameSeconds = usf / 1e6;
+  Alpha = (flags & BINK2_FLAG_ALPHA) != 0;
+  Looping = loop;
+
+  // the sound: a second decoder over the same data, audio only, decoded up front
+  unsigned char trackMask = 0, channels[7] = {}, bitdepth[7] = {};
+  unsigned long rates[7] = {};
+  bink2_info_audio(Decoder, &trackMask, channels, bitdepth, rates);
+  HasAudio = false;
+  if ((trackMask & 1) && channels[0] > 0 && rates[0] > 0) {
+    if (bink2_t* audio = bink2_open_memory(Data.data(), (unsigned long)Data.size())) {
+      bink2_enable_video(audio, 0);
+      bink2_enable_audio(audio, 0, 1);
+      std::vector<int16_t> pcm;
+      char r = bink2_first(audio);
+      while (r == BINK2_MORE || r == BINK2_LAST) {
+        const unsigned char* p = bink2_get_audio(audio, 0);
+        const unsigned long size = bink2_get_audio_size(audio, 0);
+        if (p && size) {
+          const size_t old = pcm.size();
+          pcm.resize(old + size / 2);
+          std::memcpy(pcm.data() + old, p, size / 2 * 2);
+        }
+        if (r == BINK2_LAST) break;
+        r = bink2_next(audio);
+      }
+      bink2_close(audio);
+      if (!pcm.empty()) {
+        AudioOut = Audio::AudioChannel::Create(Audio::AC_SSE3, Audio::ACG_Movie);
+        AudioOut->Play(std::make_unique<PcmStream>(std::move(pcm), channels[0], (int)rates[0]), Looping, 0.0f);
+        HasAudio = true;
+      }
+    }
+  }
+  bink2_enable_audio(Decoder, 0, 0);
+  bink2_enable_video(Decoder, 1);
+
+  Texture = Renderer->CreateYUVFrame((float)Width, (float)(Alpha ? Height * 2 : Height));
+  Abort = false;
+  DecoderDone = false;
+  Shown = -1;
+  Loops = 0;
+  Elapsed = 0.0;
+  IsPlaying = true;
+  Worker = std::thread(&Bink2Player::DecodeLoop, this);
+  ImpLog(LogLevel::Info, LogChannel::Video, "Bink 2: {:d}x{:d}, {:d} frames{}{}\n", Width, Height, Frames,
+         Alpha ? ", alpha" : "", HasAudio ? ", audio" : "");
+  return true;
+}
+
+void Bink2Player::Pack(Frame& out, bool decoded) {
+  const size_t w = Width, h = Height, cw = Width / 2, ch = Height / 2;
+  const size_t lumaRows = Alpha ? h * 2 : h, chromaRows = Alpha ? ch * 2 : ch;
+  out.Y.resize(w * lumaRows);
+  out.U.resize(cw * chromaRows);
+  out.V.resize(cw * chromaRows);
+  auto copy = [](uint8_t* dst, const uint8_t* src, int stride, size_t width, size_t rows,
+                 const std::array<uint8_t, 256>& lut) {
+    for (size_t y = 0; y < rows; y++) {
+      const uint8_t* s = src + (size_t)stride * y;
+      uint8_t* d = dst + width * y;
+      for (size_t x = 0; x < width; x++) d[x] = lut[s[x]];
+    }
+  };
+  const uint8_t* yp = bink2_get_plane(Decoder, BINK2_PLANE_Y);
+  const uint8_t* up = bink2_get_plane(Decoder, BINK2_PLANE_U);
+  const uint8_t* vp = bink2_get_plane(Decoder, BINK2_PLANE_V);
+  if (yp && up && vp) {
+    copy(out.Y.data(), yp, bink2_get_stride(Decoder, BINK2_PLANE_Y), w, h, Range.Luma);
+    copy(out.U.data(), up, bink2_get_stride(Decoder, BINK2_PLANE_U), cw, ch, Range.Chroma);
+    copy(out.V.data(), vp, bink2_get_stride(Decoder, BINK2_PLANE_V), cw, ch, Range.Chroma);
+  }
+  if (Alpha) {
+    // the stacked layout of alpha movies: alpha as luma under the picture, neutral chroma
+    const uint8_t* ap = bink2_get_plane(Decoder, BINK2_PLANE_A);
+    if (ap && decoded) {
+      copy(out.Y.data() + w * h, ap, bink2_get_stride(Decoder, BINK2_PLANE_A), w, h, Range.Luma);
+    } else {
+      // a frame libbink2 cannot decode shows nothing
+      std::fill(out.Y.begin() + (ptrdiff_t)(w * h), out.Y.end(), Range.Luma[0]);
+    }
+    std::fill(out.U.begin() + (ptrdiff_t)(cw * ch), out.U.end(), (uint8_t)128);
+    std::fill(out.V.begin() + (ptrdiff_t)(cw * ch), out.V.end(), (uint8_t)128);
+  }
+}
+
+void Bink2Player::DecodeLoop() {
+  unsigned long index = 0;
+  char r = bink2_first(Decoder);
+  while (!Abort) {
+    Frame f;
+    f.Index = index;
+    Pack(f, r == BINK2_MORE || r == BINK2_LAST);
+    {
+      std::unique_lock lock(QueueMutex);
+      QueueCond.wait(lock, [this] { return Abort || Queue.size() < MaxQueued; });
+      if (Abort) break;
+      Queue.push_back(std::move(f));
+    }
+    index++;
+    if (index >= Frames || r == BINK2_LAST) {
+      if (!Looping) break;
+      r = bink2_first(Decoder);  // looping: the frame numbers go on, the decoder starts over
+      continue;
+    }
+    r = bink2_next(Decoder);
+  }
+  std::lock_guard lock(QueueMutex);
+  DecoderDone = true;
+}
+
+// the movie time: frame time, kept in step with the sound while it plays (a sound track can end before the picture,
+// its position then goes back to 0)
+double Bink2Player::Clock() const { return Elapsed; }
+
+void Bink2Player::Update(float dt) {
+  if (!IsPlaying) return;
+  if (AudioOut) AudioOut->Update(dt);
+  if (Shown >= 0) {
+    Elapsed += dt;
+    if (HasAudio && AudioOut && !Looping && AudioOut->GetState() == Audio::ACS_Playing) {
+      const double heard = AudioOut->PositionInSeconds();
+      if (heard > 0.0) Elapsed = heard;
+    }
+  }
+  const long due = Shown < 0 ? 0 : (long)(Clock() / FrameSeconds);
+
+  // take the newest frame that is due
+  std::optional<Frame> next;
+  bool done = false;
+  {
+    std::lock_guard lock(QueueMutex);
+    while (!Queue.empty() && (long)Queue.front().Index <= due) {
+      next = std::move(Queue.front());
+      Queue.pop_front();
+    }
+    done = DecoderDone && Queue.empty();
+  }
+  QueueCond.notify_one();
+  if (next) {
+    Texture->Submit(next->Y.data(), next->U.data(), next->V.data());
+    Shown = (long)next->Index;
+  }
+  if (done && !next && (Shown < 0 || Clock() >= (double)(Shown + 1) * FrameSeconds)) Stop();
+}
+
+void Bink2Player::Render(float videoAlpha) {
+  if (!IsPlaying || Shown < 0 || !Texture) return;
+  Renderer->DrawVideoTexture(*Texture, RectF(0.0f, 0.0f, Profile::Game::DesignWidth, Profile::Game::DesignHeight),
+                             glm::vec4(1.0f, 1.0f, 1.0f, videoAlpha), Alpha);
+}
+
+void Bink2Player::ReinitAudio() {
+  if (AudioOut) AudioOut->Reinit();
+}
+
+void Bink2Player::Stop() {
+  if (Worker.joinable()) {
+    Abort = true;
+    QueueCond.notify_all();
+    Worker.join();
+  }
+  Queue.clear();
+  if (AudioOut) {
+    AudioOut->Stop(0.0f);
+    AudioOut.reset();
+  }
+  if (Decoder) {
+    bink2_close(Decoder);
+    Decoder = nullptr;
+  }
+  if (Texture) {
+    Texture->Release();
+    Texture = nullptr;
+  }
+  Data.clear();
+  Data.shrink_to_fit();
+  IsPlaying = false;
+  HasAudio = false;
+}
+
+}  // namespace Video
+}  // namespace Impacto
