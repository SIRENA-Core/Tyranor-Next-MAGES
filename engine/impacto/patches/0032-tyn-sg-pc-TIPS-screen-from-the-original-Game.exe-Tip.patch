+#pragma once
+
+#include <vector>
+
+#include "../../ui/tipsmenu.h"
+#include "../../text/tipspage.h"
+#include "tipssystem.h"
+
+namespace Impacto {
+namespace UI {
+namespace SGHD {
+
+// TIPS screen of the STEINS;GATE (Steam) engine generation, as the original Game.exe draws and handles it (draw
+// 0x43e440, init 0x43f050, main 0x43f720): shown while the script's submenu is TIPS (SW_SYSSUBMENUNO 2); first the
+// categories (plus NEW and UNREAD), then the tips of a category with letter headers; the chosen tip is shown on the
+// right with its content scrolled by pages. Back in the tips list returns to the categories; in the categories it
+// is left to the script, which closes the screen.
+class TipsMenu : public UI::TipsMenu {
+ public:
+  void Init() override;
+  void Show() override;
+  void Hide() override;
+  void Update(float dt) override;
+  void UpdateInput(float dt) override;
+  void Render() override;
+
+ private:
+  Impacto::SGHD::TipsSystem* Data() const;
+  float Alpha() const;
+  int Count(int category) const;
+  int Entry(int category, int index) const;
+  bool IsTip(int entry) const { return entry >= 0 && entry < Impacto::SGHD::TipsSystem::LetterHeader; }
+  void OpenCategory(int category);
+  void MoveRow(int direction);
+  void KeepRowVisible();
+  void ShowTip(int tip);
+  void ScrollContent(float delta);
+  int RowAt(glm::vec2 pos) const;
+
+  void DrawLine(const std::vector<ProcessedTextGlyph>& glyphs, float alpha) const;
+  std::vector<ProcessedTextGlyph> Layout(const uint8_t* str, float size, uint32_t color, glm::vec2 pos) const;
+  std::vector<ProcessedTextGlyph> TableString(int index, float size, uint32_t color, glm::vec2 pos,
+                                              int skipChars = 0) const;
+  std::vector<ProcessedTextGlyph> TipString(int tip, int index, float size, uint32_t color, glm::vec2 pos) const;
+  std::vector<ProcessedTextGlyph> Number(int value, float size, uint32_t color, glm::vec2 pos) const;
+
+  bool InTips = false;  // false: categories, true: tips of Category
+  int Category = -1;    // cursor in the categories / category of the tips list
+  int Row = -1;         // cursor in the tips list (absolute index), -1 none
+  int Scroll = 0;       // first visible row of the tips list
+  int ShownTip = -1;
+  std::vector<TipsPage> Pages;
+  float ContentHeight = 0.0f;
+  float ContentScroll = 0.0f;
+  std::vector<bool> NewAtOpen;     // per tip: still new when the screen opened (NEW mark)
+  std::vector<bool> CategoryNew;   // per category: has such a tip
+  glm::vec2 LastPointer{-1.0f};
+};
+
+}  // namespace SGHD
+}  // namespace UI
+}  // namespace Impacto
diff --git a/src/games/sghd/tipssystem.cpp b/src/games/sghd/tipssystem.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..aa91a94e782e8100de88af2a37a7fc58f8c3d4a1
--- /dev/null
+++ b/src/games/sghd/tipssystem.cpp
@@ -0,0 +1,157 @@
+#include "tipssystem.h"
+
+#include <algorithm>
+#include <numeric>
+
+#include "../../data/savesystem.h"
+#include "../../io/memorystream.h"
+#include "../../log.h"
+#include "../../text/text.h"
+#include "../../vm/vm.h"
+#include "../../vm/sc3stream.h"
+
+namespace Impacto {
+namespace SGHD {
+
+using namespace Impacto::Vm;
+using namespace Impacto::Io;
+using Impacto::TipsSystem::TipsDataRecord;
+using Impacto::TipsSystem::AuxDataAdr;
+
+namespace {
+constexpr int EndOfKey = 9999;
+
+std::vector<int> ReadChars(uint8_t* buffer, uint32_t adr) {
+  std::vector<int> out;
+  Sc3Stream stream(&buffer[adr]);
+  while (stream.PeekU8() != 0xff) {
+    StringToken token;
+    token.Read(stream);
+    if (token.Type == STT_Character) out.push_back(token.Val_Int);
+  }
+  return out;
+}
+
+std::vector<int> ReadList(MemoryStream& stream) {
+  std::vector<int> out;
+  for (uint16_t v = ReadLE<uint16_t>(&stream); v != 0xffff; v = ReadLE<uint16_t>(&stream)) out.push_back(v);
+  return out;
+}
+}  // namespace
+
+void TipsSystem::DataInit(uint32_t scriptBufferId, uint32_t tipsDataAdr, uint32_t tipsDataSize) {
+  ScriptBufferId = (uint8_t)scriptBufferId;
+  uint8_t* buffer = ScriptBuffers[scriptBufferId].data();
+  TipEntryCount = 0;
+  Records.assign(MaxCount, {});
+
+  // records
+  std::vector<uint16_t> base;
+  {
+    MemoryStream stream(&buffer[tipsDataAdr], tipsDataSize, false);
+    for (uint16_t count = ReadLE<uint16_t>(&stream); count != 0xff; count = ReadLE<uint16_t>(&stream)) {
+      const uint16_t first = ReadLE<uint16_t>(&stream);
+      stream.Seek(2 * (3 + count), SEEK_CUR);
+      if (TipEntryCount >= Records.size()) {
+        ImpLog(LogLevel::Error, LogChannel::VM, "Too many tips in tips data\n");
+        break;
+      }
+      TipsDataRecord& record = Records[TipEntryCount];
+      record.Id = (uint16_t)TipEntryCount;
+      record.NumberOfContentStrings = std::min<uint16_t>(count, Impacto::TipsSystem::MaxTipStrings - 4);
+      for (int i = 0; i < 4 + record.NumberOfContentStrings; i++)
+        record.StringAdr[i] = ScriptGetStrAddress(scriptBufferId, first + i);
+      base.push_back(first);
+      TipEntryCount++;
+    }
+  }
+  Records.resize(TipEntryCount);
+
+  // letter and category tables
+  std::vector<int> charToLetter, letterToCategory, sortChars;
+  if (AuxDataAdr != 0) {
+    MemoryStream stream(&buffer[AuxDataAdr], 0x10000, false);
+    const uint16_t lettersString = ReadLE<uint16_t>(&stream);
+    const uint16_t sortString = ReadLE<uint16_t>(&stream);
+    charToLetter = ReadList(stream);
+    letterToCategory = ReadList(stream);
+    LettersStringAdr = ScriptGetStrAddress(scriptBufferId, lettersString);
+    sortChars = ReadChars(buffer, ScriptGetStrAddress(scriptBufferId, sortString));
+  }
+  const int categories =
+      letterToCategory.empty() ? 1 : *std::max_element(letterToCategory.begin(), letterToCategory.end()) + 1;
+
+  // sort keys: the position of every reading character in the sort string
+  std::vector<std::vector<int>> keys(TipEntryCount);
+  for (size_t i = 0; i < TipEntryCount; i++) {
+    for (int c : ReadChars(buffer, Records[i].StringAdr[3])) {
+      auto it = std::find(sortChars.begin(), sortChars.end(), c);
+      keys[i].push_back((int)(it - sortChars.begin()));
+    }
+  }
+  std::vector<int> order(TipEntryCount);
+  std::iota(order.begin(), order.end(), 0);
+  std::stable_sort(order.begin(), order.end(), [&](int a, int b) {
+    // element by element; a reading that ends first sorts first
+    const auto& ka = keys[a];
+    const auto& kb = keys[b];
+    for (size_t k = 0;; k++) {
+      const int va = k < ka.size() ? ka[k] : EndOfKey;
+      const int vb = k < kb.size() ? kb[k] : EndOfKey;
+      if (va == EndOfKey) return false;
+      if (vb == EndOfKey) return true;
+      if (va != vb) return va < vb;
+    }
+  });
+
+  Number.assign(TipEntryCount, 0);
+  Lists.assign(categories + 2, {});  // + the NEW and UNREAD lists the menu fills
+  int nextLetter = 0;
+  for (size_t n = 0; n < order.size(); n++) {
+    const int tip = order[n];
+    Number[tip] = (int)n + 1;
+    const int key0 = keys[tip].empty() ? 0 : keys[tip][0];
+    const int letter = key0 < (int)charToLetter.size() ? charToLetter[key0] : 0;
+    Records[tip].CategoryLetterIndex = (uint16_t)letter;
+    const int category =
+        std::clamp(letter < (int)letterToCategory.size() ? letterToCategory[letter] : 0, 0, categories - 1);
+    if (letter >= nextLetter) {
+      Lists[category].push_back(LetterHeader + letter);
+      nextLetter = letter + 1;
+    }
+    Lists[category].push_back(tip);
+  }
+}
+
+void TipsSystem::UpdateTipRecords() {
+  for (size_t i = 0; i < TipEntryCount; i++) {
+    TipsDataRecord& record = Records[i];
+    const uint32_t status = SaveSystem::GetTipStatus(record.Id);
+    record.IsLocked = (status & 1) == 0;
+    record.IsUnread = (status & 2) == 0;
+    record.IsNew = (status & 4) == 0;
+  }
+}
+
+void TipsSystem::SetTipLockedState(size_t id, bool state) {
+  if (id >= TipEntryCount) return;
+  Records[id].IsLocked = state;
+  SaveSystem::SetTipStatus(id, Records[id].IsLocked, Records[id].IsUnread, Records[id].IsNew);
+}
+
+void TipsSystem::SetTipUnreadState(size_t id, bool state) {
+  if (id >= TipEntryCount) return;
+  Records[id].IsUnread = state;
+  SaveSystem::SetTipStatus(id, Records[id].IsLocked, Records[id].IsUnread, Records[id].IsNew);
+}
+
+void TipsSystem::SetTipNewState(size_t id, bool state) {
+  if (id >= TipEntryCount) return;
+  Records[id].IsNew = state;
+  SaveSystem::SetTipStatus(id, Records[id].IsLocked, Records[id].IsUnread, Records[id].IsNew);
+}
+
+bool TipsSystem::GetTipLockedState(size_t id) { return id >= TipEntryCount || Records[id].IsLocked; }
+
+}  // namespace SGHD
+}  // namespace Impacto
