diff --git a/profiles/sg0-pc/hud/titlemenu.lua b/profiles/sg0-pc/hud/titlemenu.lua
new file mode 100644
index 0000000000000000000000000000000000000000..bf1b5838c59fac65be294725181a0901fa0fbc70
--- /dev/null
+++ b/profiles/sg0-pc/hud/titlemenu.lua
@@ -0,0 +1,98 @@
+-- STEINS;GATE 0 (Steam) title screen, TitleMenuType.SGHD with Variant 1. Everything below is taken from the original
+-- Game.exe: the draw dispatch on SW_TITLEMODE (0x45c1b0: modes 0x45c870, 0x45c920, 0x45c990, 0x45ca70, 0x45caf0,
+-- 0x45cb70), the main list (0x45bf90), the CONTINUE sub list (0x45ac90), the EXTRA sub lists (0x45ba80: 0x45b470 once
+-- flag 860 is set, else inline), the decoration (0x45b030), the logo (0x45be40), "press start" (0x45cbe0) and the
+-- input routine (0x45c2f0) with its sub list tables (counts 0x5c95b0 / 0x5c8df4, ids 0x5c95d8 / 0x5c95c4). The game
+-- draws in 1920x1080 with drawSprite 0x44cba0; texture slot 7 is TITLE_CHIP, slots 4..6 are TITLE_LOGO1..3.
+--   * main entries 270 x 42 at (613, 313 + 90 i), normal x 649, chosen x 919; they come in from 128 px to the right
+--     while the menu fades in, under a strip of the background (903, 1, 112 x 1080) that hides them in the gap between
+--     the two pictures; EXTRA is not shown before flag 860 and the entries below it move up;
+--   * sub lists: the pointer fades in and moves from x 905 to 937 over 8 frames, then bracket and items fade in over
+--     24 frames while the background right of x 1025 + 360 * progress is redrawn over them; items 312 x 48 (TIPS 42)
+--     at x 1045, normal x 13, chosen x 337, hit areas 306 x 42 at the item positions. The original registers both
+--     hit areas of the short EXTRA list (before flag 860) at y 519 (0x45bcad, 0x45bd7d), so CLEAR LIST cannot be
+--     clicked there; this profile uses the drawn position 471 for it;
+--   * decoration: three blueprint pieces shown with chance 3/4 (re-chosen every 10..39 frames) at half alpha, fading
+--     out while the menu fades in; 1, 2, 3 or no dots (rand(150) / 25), the right ones first;
+--   * logo: 60 frames of 768 x 768, one every 2 frames, at (576, 134) and the title text at (384, 134), fading out while
+--     the menu fades in;
+--   * the bracketed numbers are SW_TITLECUR1 values of the title script.
+-- Not ported yet: the rotating ornament drawn by the button guide routine 0x456940 (type 6) in mode 3.
+
+local function chip(name, x, y, w, h, sheet)
+    root.Sprites[name] = { Sheet = sheet or "TitleChip", Bounds = { X = x, Y = y, Width = w, Height = h } };
+    return name;
+end
+
+local mainNormal, mainChosen = {}, {};
+for i = 0, 4 do
+    mainNormal[#mainNormal + 1] = chip("TitleMenuEntry" .. i, 649, 1087 + 42 * i, 270, 42);
+    mainChosen[#mainChosen + 1] = chip("TitleMenuEntryH" .. i, 919, 1087 + 42 * i, 270, 42);
+end
+
+-- sub list item: sheet row srcY, height, screen y, SW_TITLECUR1 value
+local function item(name, srcY, h, y, id, hitY)
+    return { Sprite = chip("TitleMenu" .. name, 13, srcY, 312, h),
+             HighlightedSprite = chip("TitleMenu" .. name .. "H", 337, srcY, 312, h),
+             Position = { X = 1045, Y = y }, HitArea = { X = 1045, Y = hitY or y, Width = 306, Height = 42 }, Id = id };
+end
+
+local smallBracket = chip("TitleMenuBracketSmall", 1, 1087, 12, 96);
+
+local logo = {};
+for f = 0, 59 do
+    local sheet = "TitleLogo" .. (math.floor(f / 25) + 1);
+    logo[#logo + 1] = chip("TitleLogo" .. f, (f % 5) * 768, (math.floor(f / 5) % 5) * 768, 768, 768, sheet);
+end
+
+root.TitleMenu = {
+    Type = TitleMenuType.SGHD,
+    Variant = 1,
+    DrawType = DrawComponentType.SystemMenu,
+    BackgroundSprite = chip("TitleMenuBackground", 0, 0, 1920, 1080),
+    PressToStartSprite = chip("TitleMenuPressToStart", 0, 1422, 480, 54),
+    PressToStartPos = { X = 720, Y = 864 },
+    PressToStartAnimDurationIn = 32 / 60,
+    PressToStartAnimDurationOut = 32 / 60,
+    PressToStartBlinkFrames = 64,
+    MenuEntriesNum = 5,
+    MenuEntriesSprites = mainNormal,
+    MenuEntriesHighlightedSprites = mainChosen,
+    MenuPosition = { X = 613, Y = 313 },
+    MenuSpacing = 90,
+    MenuSlideDistance = 128,
+    MenuHitSize = { X = 270, Y = 42 },
+    MenuEntryFlags = { -1, -1, 860, -1, -1 },
+    MenuMask = { Sprite = chip("TitleMenuMask", 903, 1, 112, 1080), Position = { X = 903, Y = 1 } },
+    -- NEW GAME, CONTINUE (sub list), EXTRA (sub list), CONFIG, HELP
+    MenuEntryIds = { 0, 10, 20, 30, 40 },
+    DecideFrames = 64,
+    DecideBlinkFrames = 8,
+    SubOpenFrames = 32,
+    SubAnimation = 1,
+    SubFadeStartFrames = 8,
+    SubPointer = { Sprite = chip("TitleMenuPointer", 649, 1297, 48, 48), Position = { X = 937, Y = 493 }, Distance = 32 },
+    SubWipe = { Area = { X = 1025, Y = 1, Width = 400, Height = 1080 }, Distance = 360 },
+    SubLists = {
+        { Entry = 1, BracketSprite = smallBracket, BracketPosition = { X = 1033, Y = 469 },
+          Items = { item("QuickLoad", 1135, 48, 471, 10), item("Load", 1087, 48, 515, 11) } },
+        { Entry = 2, IfFlag = 860, BracketSprite = chip("TitleMenuBracketLarge", 1, 1183, 12, 234),
+          BracketPosition = { X = 1033, Y = 397 },
+          Items = { item("ClearList", 1183, 48, 397, 20), item("CGLibrary", 1231, 48, 445, 21),
+                    item("SoundLibrary", 1279, 48, 493, 22), item("MovieLibrary", 1327, 48, 541, 23),
+                    item("Tips", 1375, 42, 589, 24) } },
+        { Entry = 2, IfNotFlag = 860, BracketSprite = smallBracket, BracketPosition = { X = 1033, Y = 469 },
+          Items = { item("ClearList2", 1183, 48, 471, 20), item("Tips2", 1375, 48, 519, 24) } },
+    },
+    FlickerShowChance = 0.75,
+    FlickerItems = {
+        { Sprite = chip("TitleFlicker0", 1956, 0, 750, 300), Position = { X = -102, Y = 450 }, Random = true },
+        { Sprite = chip("TitleFlicker1", 1956, 426, 750, 300), Position = { X = 1452, Y = 408 }, Random = true },
+        { Sprite = chip("TitleFlicker2", 2976, 0, 54, 486), Position = { X = 1008, Y = -342 }, Random = true },
+    },
+    FlickerDots = { Sprite = chip("TitleFlickerDot", 1956, 960, 102, 36),
+                    Positions = { { X = 1524, Y = 234 }, { X = 1608, Y = 234 }, { X = 1692, Y = 234 } },
+                    Counts = { 1, 2, 3, 0, 0, 0 } },
+    Logo = { Frames = logo, Position = { X = 576, Y = 134 }, FrameTicks = 2,
+             TextSprite = chip("TitleLogoText", 0, 1536, 1152, 768, "TitleLogo3"), TextPosition = { X = 384, Y = 134 } },
+};
diff --git a/profiles/sg0-pc/savedata.lua b/profiles/sg0-pc/savedata.lua
