@@ -0,0 +1,35 @@
+#pragma once
+
+#include "../../ui/sysmesbox.h"
+
+namespace Impacto {
+namespace UI {
+namespace SGHD {
+
+// System message box of the STEINS;GATE (Steam) engine generation, as the original Game.exe draws and handles it:
+// no choice has the cursor at first; left / right wrap (from none to the first resp. last); Back moves the cursor to
+// the second choice ("no") instead of closing; mouse / touch hover picks a choice, a click takes it.
+class SysMesBox : public UI::SysMesBox {
+ public:
+  void Show() override;
+  void Hide() override;
+  void Update(float dt) override;
+  void UpdateInput(float dt) override;
+  void Render() override;
+
+  void Init() override;
+  void AddMessage(Vm::BufferOffsetContext str) override;
+  void AddChoice(Vm::BufferOffsetContext str) override;
+
+ private:
+  void Layout();
+  void DrawText(std::span<const ProcessedTextGlyph> text, float alpha);
+
+  float Width = 0.0f;
+  std::array<float, 8> ChoiceXs{};
+  int Selection = -1;
+};
+
+}  // namespace SGHD
+}  // namespace UI
+}  // namespace Impacto
