+  }
+  S.ScrollHover = 0;
+  S.Hover = 0;
+  MailScroll(0, 0x6a78, 0x6a74);
+  if (Decide()) {
+    if (S.Mails[mail][MailAttach] == 999) {
+      if (!GetFlag(0xa29) || !GetFlag(0xa35) || mail != SW(0x6aa0) || S.Mails[mail][MailReply] == 999 ||
+          MailBit(mail, 4)) {
+        SetMode(3);
+        if (MouseMode()) SW(0x6a58) = 0xff;
+        return;
+      }
+      if (S.LinkSel == 0xff) return;
+    }
+    SW(0x6a80) = MouseMode() ? 0xff : 0;
