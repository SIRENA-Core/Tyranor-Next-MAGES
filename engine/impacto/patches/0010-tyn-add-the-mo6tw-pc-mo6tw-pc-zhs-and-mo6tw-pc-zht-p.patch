diff --git a/profiles/mo6tw-pc/sprites.lua b/profiles/mo6tw-pc/sprites.lua
new file mode 100644
index 0000000000000000000000000000000000000000..7e81c07d5b903ec0dc18ede36298349d52142a89
--- /dev/null
+++ b/profiles/mo6tw-pc/sprites.lua
@@ -0,0 +1,59 @@
+-- Sprite sheets of the Windows/Steam release of Memories Off 6 T-Wave (system.cpk ids).
+-- Sheets are loaded eagerly at startup, so sheets only used by the extras menus
+-- (album, music, clear list, movie, actors voice) are replaced by a tiny dummy unless
+-- root.Mo6Pc.LoadExtraSheets is true (TODO(tyn): enable once those menus are laid out).
+local lang = root.Mo6Pc.Lang;
+
+-- system.cpk ids per language: {ja, zht (_ht), zhs (_kt)}
+local ids = {
+    font = { ja = 10, zht = 11, zhs = 12 },
+    menu = { ja = 14, zht = 15, zhs = 16 },
+    music = { ja = 18, zht = 19, zhs = 20 },
+    option = { ja = 21, zht = 22, zhs = 23 },
+    savemenu = { ja = 24, zht = 25, zhs = 26 },
+    title = { ja = 29, zht = 35, zhs = 36 },
+};
+
+local function sheet(id, w, h)
+    return { Path = { Mount = "system", Id = id }, DesignWidth = w, DesignHeight = h };
+end
+
+local dummy = sheet(5, 768, 768); -- data03
+
+root.SpriteSheets = {
+    -- PS3 Data sheet x1.5 (exact)
+    Data = sheet(4, 3072, 1536),
+    Font = sheet(ids.font[lang], 3072, 6000),
+    Backlog = sheet(2, 2048, 1110),
+    Options = sheet(ids.option[lang], 4096, 2048),
+    Save = sheet(ids.savemenu[lang], 2048, 2048),
+    Title = sheet(ids.title[lang], 2048, 444),
+    Titlebg = sheet(30, 1920, 1080),  -- title_bg1
+    MainBg = sheet(31, 1920, 1080),   -- title_bg2
+};
+
+local extra = {
+    ClearList = sheet(3, 2048, 2048),
+    Album = sheet(0, 2048, 1716),
+    Album2 = sheet(1, 2748, 1716),
+    AlbumThumbnails0 = sheet(28, 4096, 2565),
+    AlbumThumbnails1 = sheet(28, 4096, 2565),
+    Music = sheet(ids.music[lang], 2048, 1326),
+    MusicThumbnails0 = sheet(ids.music[lang], 2048, 1326),
+    MusicThumbnails1 = sheet(ids.music[lang], 2048, 1326),
+    MusicThumbnails2 = sheet(ids.music[lang], 2048, 1326),
+    MusicThumbnails3 = sheet(ids.music[lang], 2048, 1326),
+    Movie = sheet(ids.menu[lang], 1656, 656),
+    ActorsVoice = sheet(ids.menu[lang], 1656, 656),
+    ActorsVoiceBackground = sheet(30, 1920, 1080),
+};
+
+for name, s in pairs(extra) do
+    if root.Mo6Pc.LoadExtraSheets then
+        root.SpriteSheets[name] = s;
+    else
+        root.SpriteSheets[name] = dummy;
+    end
+end
+
+root.Sprites = {};
