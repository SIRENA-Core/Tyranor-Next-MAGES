+        dc[13] = clipf(dc_mpred(dc[6], dc[12], dc[7]) + tdc[13], mindc, maxdc);
+        dc[14] = clipf(dc_mpred(dc[9], dc[11], dc[12]) + tdc[14], mindc, maxdc);
+        dc[15] = clipf(dc_mpred(dc[12], dc[14], dc[13]) + tdc[15], mindc, maxdc);
+    } else if (!is_luma && (flags & 0x20) && (flags & 0x80)) {
+        dc[0] = clipf((mindc < 0 ? 0.0f : 1024.0f) + tdc[0], mindc, maxdc);
+        dc[1] = clipf(dc[0] + tdc[1], mindc, maxdc);
+        dc[2] = clipf(dc_mpred2(dc[0], dc[1]) + tdc[2], mindc, maxdc);
+        dc[3] = clipf(dc_mpred(dc[0], dc[2], dc[1]) + tdc[3], mindc, maxdc);
+    } else if (!is_luma && (flags & 0x80)) {
+        dc[0] = clipf(dc_mpred2(Ldc[1], Ldc[3]) + tdc[0], mindc, maxdc);
+        dc[1] = clipf(dc[0] + tdc[1], mindc, maxdc);
+        dc[2] = clipf(dc_mpred(Ldc[1], Ldc[3], dc[0]) + tdc[2], mindc, maxdc);
+        dc[3] = clipf(dc_mpred(dc[0], dc[2], dc[1]) + tdc[3], mindc, maxdc);
+    } else if (!is_luma && (flags & 0x20)) {
+        dc[0] = clipf(dc_mpred2(Tdc[2], Tdc[3]) + tdc[0], mindc, maxdc);
+        dc[1] = clipf(dc_mpred(Tdc[2], dc[0], Tdc[3]) + tdc[1], mindc, maxdc);
+        dc[2] = clipf(dc_mpred2(dc[0], dc[1]) + tdc[2], mindc, maxdc);
+        dc[3] = clipf(dc_mpred(dc[0], dc[2], dc[1]) + tdc[3], mindc, maxdc);
+    } else {
+        dc[0] = clipf(dc_mpred(LTdc[3], Ldc[1], Tdc[2]) + tdc[0], mindc, maxdc);
+        dc[1] = clipf(dc_mpred(Tdc[2], dc[0], Tdc[3]) + tdc[1], mindc, maxdc);
+        dc[2] = clipf(dc_mpred(Ldc[1], Ldc[3], dc[0]) + tdc[2], mindc, maxdc);
+        dc[3] = clipf(dc_mpred(dc[0], dc[2], dc[1]) + tdc[3], mindc, maxdc);
+    }
+}
+
+static int old_decode_dc(Bink2Slice *s, Bink2Bits *bits, int is_luma, int q,
+                         int mindc, int maxdc, int flags)
+{
+    float tdc[16] = { 0 };
+    int num_dc = is_luma ? 16 : 4;
+    int dc_bits, i, j;
+
+    dc_bits = bink2_bits_read(bits, 3);
+    if (dc_bits < 0)
+        return -1;
+    if (dc_bits == 7) {
+        int extra = bink2_bits_read(bits, 2);
+
+        if (extra < 0)
+            return -1;
+        dc_bits += extra;
+    }
+    if (dc_bits == 0) {
+        memset(tdc, 0, sizeof(tdc));
+    } else {
+        for (j = 0; j < num_dc; j += 4) {
+            for (i = 0; i < 4; i++) {
+                int value = bink2_bits_read(bits, dc_bits);
+
+                if (value < 0)
+                    return -1;
+                tdc[i + j] = (float)value;
+            }
+            for (i = 0; i < 4; i++) {
+                if (tdc[i + j] != 0.0f) {
+                    int sign = bink2_bits_read1(bits);
+
+                    if (sign < 0)
+                        return -1;
+                    if (sign)
+                        tdc[i + j] = -tdc[i + j];
+                }
+            }
+        }
+    }
+
+    if ((flags & 0x20) && (flags & 0x80) && mindc >= 0) {
+        int nbits = q_dc_bits[q] + dc_bits;
+
+        if (nbits < 10) {
+            int dc_val = bink2_bits_read(bits, 10 - nbits);
+
+            if (dc_val < 0)
+                return -1;
+            if (dc_val) {
+                int sign;
+
+                dc_val <<= dc_bits;
+                sign = bink2_bits_read1(bits);
+                if (sign < 0)
+                    return -1;
+                if (sign)
+                    dc_val = -dc_val;
+            }
+            tdc[0] += (float)dc_val;
+        }
+    }
+
+    for (i = 0; i < num_dc; i++)
+        tdc[i] *= dc_quant[q];
+
+    bink2_video_predict_dc(s, is_luma, (float)mindc, (float)maxdc, flags, tdc);
+    return 0;
+}
+
+/* symbols, when not NULL, receives each block's number of AC value symbols
+ * that decode to a non-zero level. Zero-level value symbols, skip symbols
+ * and the positions a skip covers do not count. */
+static int old_decode_ac(Bink2Bits *bits, const uint8_t *scan,
+                         float block[4][64], unsigned cbp, float q,
+                         const float qmat[64], int symbols[4])
+{
+    int i;
+
+    for (i = 0; i < 4; i++, cbp >>= 1) {
+        const uint16_t *val_codes;
+        const uint8_t *val_bits;
+        const uint16_t *skip_codes;
+        const uint8_t *skip_bits;
+        int next = 0;
+        int idx = 1;
+
+        memset(block[i], 0, 64 * sizeof(float));
+        if (symbols != NULL)
+            symbols[i] = 0;
+        if (!(cbp & 1))
+            continue;
+        if (cbp & 0x10000) {
+            val_codes = bink2f_ac_val_codes[1];
+            val_bits = bink2f_ac_val_bits[1];
+            skip_codes = bink2f_ac_skip_codes[1];
+            skip_bits = bink2f_ac_skip_bits[1];
+        } else {
+            val_codes = bink2f_ac_val_codes[0];
+            val_bits = bink2f_ac_val_bits[0];
+            skip_codes = bink2f_ac_skip_codes[0];
+            skip_bits = bink2f_ac_skip_bits[0];
+        }
+
+        while (idx < 64) {
+            int val = bink2_bits_read_vlc(bits, val_codes, val_bits, 13);
+
+            if (val < 0)
+                return -1;
+            if (val && symbols != NULL)
+                symbols[i]++;
+            if (val) {
+                if (val >= 4) {
+                    int nbits;
+
+                    val -= 3;
+                    nbits = bink2_bits_read(bits, val);
+                    if (nbits < 0)
+                        return -1;
+                    val = nbits + (1 << val) + 2;
+                }
+                if (val) {
+                    int sign = bink2_bits_read1(bits);
+
+                    if (sign < 0)
+                        return -1;
+                    if (sign)
+                        val = -val;
+                }
+            }
+            block[i][scan[idx]] = (float)val * q * qmat[scan[idx]];
+            if (idx > 62)
+                break;
+            idx++;
+            next--;
+            if (next < 1) {
+                int skip = bink2_bits_read_vlc(bits, skip_codes, skip_bits,
+                                    NUM_AC_SKIPS);
+
+                if (skip < 0)
+                    return -1;
+                next = next_skips[skip];
+                skip = old_skips[skip];
+                if (skip == 11) {
+                    int extra = bink2_bits_read(bits, 6);
+
+                    if (extra < 0)
+                        return -1;
+                    skip = extra;
+                }
+                idx += skip;
+            }
+        }
+    }
+    return 0;
+}
+
+/* Y and alpha round the DC with RAD's single-precision bias; chroma
+ * truncates it. */
+unsigned bink2_video_old_intra_word(float dc, int symbols, int round)
+{
+    float r = dc + (round ? 0.49999991f : 0.0f);
+
+    return BINK2_INFO_INTRA |
+           (bink2_video_ac_class(symbols) << BINK2_INFO_CLASS_SHIFT) |
+           ((unsigned)(int)r & 0xFFFu);
+}
+
+static int old_decode_intra_luma(Bink2Video *v, Bink2Slice *s,
+                                 Bink2Bits *bits, unsigned *prev_cbp,
+                                 int *prev_q, int plane, int x, int y,
+                                 int flags)
+{
+    int stride = v->stride[plane];
+    unsigned char *dst = v->cur[plane] + (size_t)y * stride + x;
+    float block[4][64];
+    int symbols[4];
+    float *dc = s->dc_cur[s->mb_pos].dc[s->comp];
+    unsigned cbp;
+    int q, dq, i, j;
+
+    if (old_cbp_luma(bits, *prev_cbp, &cbp) != 0)
+        return -1;
+    *prev_cbp = cbp;
+    dq = old_delta_q(bits);
+    q = *prev_q + dq;
+    if (q < 0 || q >= 16)
+        return -1;
+    *prev_q = q;
+
+    if (old_decode_dc(s, bits, 1, q, 0, 2047, flags) != 0)
+        return -1;
+
+    for (i = 0; i < 4; i++) {
+        if (old_decode_ac(bits, luma_scan, block, cbp >> (4 * i),
+                          ac_quant[q], luma_intra_qmat, symbols) != 0)
+            return -1;
+        for (j = 0; j < 4; j++) {
+            int pos = luma_repos[i * 4 + j];
+            int off = (pos & 3) * 8 + (pos >> 2) * 8 * stride;
+
+            block[j][0] = dc[i * 4 + j] * 0.125f;
+            bink2_idct_old(block[j]);
+            bink2_put_block_f(dst + off, stride, block[j]);
+            bink2_video_set_info(v, plane, x, y, pos & 3, pos >> 2,
+                                 bink2_video_old_intra_word(dc[i * 4 + j],
+                                                            symbols[j], 1));
+        }
+    }
+    return 0;
+}
+
+static int old_decode_intra_chroma(Bink2Video *v, Bink2Slice *s,
+                                   Bink2Bits *bits, unsigned *prev_cbp,
+                                   int *prev_q, int plane, int x, int y,
+                                   int flags)
+{
+    int stride = v->stride[plane];
+    unsigned char *dst = v->cur[plane] + (size_t)(y / 2) * stride + x / 2;
+    float block[4][64];
+    int symbols[4];
+    float *dc = s->dc_cur[s->mb_pos].dc[s->comp];
+    unsigned cbp;
+    int q, dq, i;
+
+    if (old_cbp_chroma(bits, *prev_cbp, &cbp) != 0)
+        return -1;
+    *prev_cbp = cbp;
+    dq = old_delta_q(bits);
+    q = *prev_q + dq;
+    if (q < 0 || q >= 16)
+        return -1;
+    *prev_q = q;
+
+    if (old_decode_dc(s, bits, 0, q, 0, 2047, flags) != 0)
+        return -1;
+    if (old_decode_ac(bits, chroma_scan, block, cbp, ac_quant[q],
+                      chroma_qmat, symbols) != 0)
+        return -1;
+
+    for (i = 0; i < 4; i++) {
+        int off = (i & 1) * 8 + (i >> 1) * 8 * stride;
+
+        block[i][0] = dc[i] * 0.125f;
+        bink2_idct_old(block[i]);
+        bink2_put_block_f(dst + off, stride, block[i]);
+        bink2_video_set_info(v, plane, x, y, i & 1, i >> 1,
+                             bink2_video_old_intra_word(dc[i], symbols[i],
+                                                        0));
+    }
+    return 0;
+}
+
+static int mid_pred(int a, int b, int c)
+{
+    if (a < b) {
+        if (b < c)
+            return b;
+        if (a < c)
+            return c;
+        return a;
+    }
+    if (b < c) {
+        if (a < c)
+            return a;
+        return c;
+    }
+    return b;
+}
+
+#define MV(arr, mb, k, c) ((arr)[(mb) * 8 + (k) * 2 + (c)])
+
+static void old_predict_mv(Bink2Slice *s, int flags, const int raw[4][2])
+{
+    int mb = s->mb_pos;
+    int lm = mb > 0 ? mb - 1 : 0;
+    int32_t *c = s->mv_cur;
+    int32_t *l = s->mv_cur;
+    int32_t *lt = s->mv_prev;
+    int32_t *t = s->mv_prev;
+    int k;
+
+    if (!(flags & 0x80)) {
+        if (flags & 0x20) {
+            MV(c, mb, 0, 0) = raw[0][0] + mid_pred(MV(t, mb, 0, 0), MV(t, mb, 2, 0), MV(t, mb, 3, 0));
+            MV(c, mb, 0, 1) = raw[0][1] + mid_pred(MV(t, mb, 0, 1), MV(t, mb, 2, 1), MV(t, mb, 3, 1));
+            MV(c, mb, 1, 0) = raw[1][0] + mid_pred(MV(t, mb, 2, 0), MV(t, mb, 3, 0), MV(c, mb, 0, 0));
+            MV(c, mb, 1, 1) = raw[1][1] + mid_pred(MV(t, mb, 2, 1), MV(t, mb, 3, 1), MV(c, mb, 0, 1));
+            MV(c, mb, 2, 0) = raw[2][0] + mid_pred(MV(t, mb, 2, 0), MV(c, mb, 0, 0), MV(c, mb, 1, 0));
+            MV(c, mb, 2, 1) = raw[2][1] + mid_pred(MV(t, mb, 2, 1), MV(c, mb, 0, 1), MV(c, mb, 1, 1));
+            MV(c, mb, 3, 0) = raw[3][0] + mid_pred(MV(c, mb, 0, 0), MV(c, mb, 1, 0), MV(c, mb, 2, 0));
+            MV(c, mb, 3, 1) = raw[3][1] + mid_pred(MV(c, mb, 0, 1), MV(c, mb, 1, 1), MV(c, mb, 2, 1));
+        } else {
+            MV(c, mb, 0, 0) = raw[0][0] + mid_pred(MV(lt, lm, 3, 0), MV(t, mb, 2, 0), MV(l, lm, 1, 0));
+            MV(c, mb, 0, 1) = raw[0][1] + mid_pred(MV(lt, lm, 3, 1), MV(t, mb, 2, 1), MV(l, lm, 1, 1));
+            MV(c, mb, 1, 0) = raw[1][0] + mid_pred(MV(t, mb, 2, 0), MV(t, mb, 3, 0), MV(c, mb, 0, 0));
+            MV(c, mb, 1, 1) = raw[1][1] + mid_pred(MV(t, mb, 2, 1), MV(t, mb, 3, 1), MV(c, mb, 0, 1));
+            MV(c, mb, 2, 0) = raw[2][0] + mid_pred(MV(t, mb, 2, 0), MV(c, mb, 0, 0), MV(c, mb, 1, 0));
+            MV(c, mb, 2, 1) = raw[2][1] + mid_pred(MV(t, mb, 2, 1), MV(c, mb, 0, 1), MV(c, mb, 1, 1));
+            MV(c, mb, 3, 0) = raw[3][0] + mid_pred(MV(c, mb, 0, 0), MV(c, mb, 1, 0), MV(c, mb, 2, 0));
+            MV(c, mb, 3, 1) = raw[3][1] + mid_pred(MV(c, mb, 0, 1), MV(c, mb, 1, 1), MV(c, mb, 2, 1));
+        }
+    } else {
+        if (flags & 0x20) {
+            for (k = 0; k < 4; k++) {
+                MV(c, mb, k, 0) = raw[k][0];
+                MV(c, mb, k, 1) = raw[k][1];
+            }
+        } else {
+            MV(c, mb, 0, 0) = raw[0][0] + mid_pred(MV(l, lm, 0, 0), MV(l, lm, 1, 0), MV(l, lm, 3, 0));
+            MV(c, mb, 0, 1) = raw[0][1] + mid_pred(MV(l, lm, 0, 1), MV(l, lm, 1, 1), MV(l, lm, 3, 1));
+            MV(c, mb, 2, 0) = raw[2][0] + mid_pred(MV(l, lm, 1, 0), MV(l, lm, 3, 0), MV(c, mb, 0, 0));
+            MV(c, mb, 2, 1) = raw[2][1] + mid_pred(MV(l, lm, 1, 1), MV(l, lm, 3, 1), MV(c, mb, 0, 1));
+            MV(c, mb, 1, 0) = raw[1][0] + mid_pred(MV(l, lm, 1, 0), MV(c, mb, 0, 0), MV(c, mb, 2, 0));
+            MV(c, mb, 1, 1) = raw[1][1] + mid_pred(MV(l, lm, 1, 1), MV(c, mb, 0, 1), MV(c, mb, 2, 1));
+            MV(c, mb, 3, 0) = raw[3][0] + mid_pred(MV(c, mb, 0, 0), MV(c, mb, 1, 0), MV(c, mb, 2, 0));
+            MV(c, mb, 3, 1) = raw[3][1] + mid_pred(MV(c, mb, 0, 1), MV(c, mb, 1, 1), MV(c, mb, 2, 1));
+        }
+    }
+}
+
+static int old_decode_mv(Bink2Bits *bits, int flags, int mv[4][2])
+{
+    int i, j;
+
+    memset(mv, 0, 8 * sizeof(int));
+    for (i = 0; i < 2; i++) {
+        int nbits = bink2_bits_read(bits, 3);
+
+        if (nbits < 0)
+            return -1;
+        if (nbits == 7) {
+            int extra = bink2_bits_read(bits, 2);
+
+            if (extra < 0)
+                return -1;
+            nbits += extra;
+        }
+        if (nbits) {
+            for (j = 0; j < 4; j++) {
+                int value = bink2_bits_read(bits, nbits);
+
+                if (value < 0)
+                    return -1;
+                mv[j][i] = value;
+            }
+            for (j = 0; j < 4; j++) {
+                if (mv[j][i]) {
+                    int sign = bink2_bits_read1(bits);
+
+                    if (sign < 0)
+                        return -1;
+                    if (sign)
+                        mv[j][i] = -mv[j][i];
+                }
+            }
+        }
+        if ((flags & 0x80) && (flags & 0x20)) {
+            int val = bink2_bits_read(bits, 5);
+
+            if (val < 0)
+                return -1;
+            val *= 16;
+            if (val) {
+                int sign = bink2_bits_read1(bits);
+
+                if (sign < 0)
+                    return -1;
+                if (sign)
+                    val = -val;
+            }
+            for (j = 0; j < 4; j++)
+                mv[j][i] += val;
+        }
+    }
+    return 0;
+}
+
+void bink2_video_mc_luma(Bink2Video *v, const Bink2Slice *s, int x, int y)
+{
+    int32_t *mv = s->mv_cur + s->mb_pos * 8;
+    int k;
+
+    for (k = 0; k < 4; k++) {
+        int bx = x + (k & 1) * 16;
+        int by = y + (k >> 1) * 16;
+
+        bink2_mc_luma(v->cur[0] + (size_t)by * v->stride[0] + bx,
+                      v->stride[0], v->ref[0], v->stride[0],
+                      bx, by, (int)v->width, (int)v->height,
+                      mv[k * 2], mv[k * 2 + 1]);
+    }
+}
+
+void bink2_video_mc_alpha(Bink2Video *v, const Bink2Slice *s, int x, int y)
+{
+    int32_t *mv = s->mv_cur + s->mb_pos * 8;
+    int k;
+
+    if (!v->has_alpha)
+        return;
+    for (k = 0; k < 4; k++) {
+        int bx = x + (k & 1) * 16;
+        int by = y + (k >> 1) * 16;
+
+        bink2_mc_luma(v->cur[3] + (size_t)by * v->stride[3] + bx,
+                      v->stride[3], v->ref[3], v->stride[3],
+                      bx, by, (int)v->width, (int)v->height,
+                      mv[k * 2], mv[k * 2 + 1]);
+    }
+}
+
+void bink2_video_mc_chroma(Bink2Video *v, const Bink2Slice *s, int x, int y)
+{
+    int32_t *mv = s->mv_cur + s->mb_pos * 8;
+    /* The pinned reference passes width/2 and height/2. Clamp only the
+     * degenerate 1-pixel case, which used to build a zero-size edge buffer. */
+    int cw = (int)v->width / 2;
+    int ch = (int)v->height / 2;
+    int k;
+
+    if (cw < 1)
+        cw = 1;
+    if (ch < 1)
+        ch = 1;
+    for (k = 0; k < 4; k++) {
+        int bx = x / 2 + (k & 1) * 8;
+        int by = y / 2 + (k >> 1) * 8;
+
+        bink2_mc_chroma(v->cur[2] + (size_t)by * v->stride[2] + bx,
+                        v->stride[2], v->ref[2], v->stride[2],
+                        bx, by, cw, ch, mv[k * 2], mv[k * 2 + 1]);
+        bink2_mc_chroma(v->cur[1] + (size_t)by * v->stride[1] + bx,
+                        v->stride[1], v->ref[1], v->stride[1],
+                        bx, by, cw, ch, mv[k * 2], mv[k * 2 + 1]);
+    }
+}
+
+static float old_average_block(const unsigned char *src, int stride)
+{
+    int sum = 0;
+    int i;
+
+    for (i = 0; i < 8; i++) {
+        int a = (src[i + 0 * stride] + src[i + 1 * stride] + 1) >> 1;
+        int b = (src[i + 2 * stride] + src[i + 3 * stride] + 1) >> 1;
+        int c = (src[i + 4 * stride] + src[i + 5 * stride] + 1) >> 1;
+        int d = (src[i + 6 * stride] + src[i + 7 * stride] + 1) >> 1;
+        int e = (a + b + 1) >> 1;
+        int f = (c + d + 1) >> 1;
+
+        sum += (e + f + 1) >> 1;
+    }
+    return (float)sum;
+}
+
+static void old_average_luma(const unsigned char *src, int stride, float *dc)
+{
+    int i;
+
+    for (i = 0; i < 16; i++) {
+        int pos = luma_repos[i];
+        int x = pos & 3;
+        int y = pos >> 2;
+
+        dc[i] = old_average_block(src + x * 8 + y * 8 * stride, stride);
+    }
+}
+
+static void old_average_chroma(const unsigned char *src, int stride, float *dc)
+{
+    int i;
+
+    for (i = 0; i < 4; i++) {
+        int x = i & 1;
+        int y = i >> 1;
+
+        dc[i] = old_average_block(src + x * 8 + y * 8 * stride, stride);
+    }
+}
+
+static int old_decode_inter_luma(Bink2Slice *s, Bink2Bits *bits,
+                                 unsigned *prev_cbp, int *prev_q,
+                                 unsigned char *dst, int stride, int flags)
+{
+    float block[4][64];
+    float *dc = s->dc_cur[s->mb_pos].dc[s->comp];
+    unsigned cbp;
+    int q, dq, i, j;
+
+    (void)flags;
+    if (old_cbp_luma(bits, *prev_cbp, &cbp) != 0)
+        return -1;
+    *prev_cbp = cbp;
+    dq = old_delta_q(bits);
+    q = *prev_q + dq;
+    if (q < 0 || q >= 16)
+        return -1;
+    *prev_q = q;
+
+    if (old_decode_dc(s, bits, 1, q, -1023, 1023, 0xA8) != 0)
+        return -1;
+
+    for (i = 0; i < 4; i++) {
+        if (old_decode_ac(bits, luma_scan, block, cbp >> (4 * i),
+                          ac_quant[q], luma_inter_qmat, NULL) != 0)
+            return -1;
+        for (j = 0; j < 4; j++) {
+            int pos = luma_repos[i * 4 + j];
+            int off = (pos & 3) * 8 + (pos >> 2) * 8 * stride;
+
+            block[j][0] = dc[i * 4 + j] * 0.125f;
+            bink2_idct_old(block[j]);
+            bink2_add_block_f(dst + off, stride, block[j]);
+        }
+    }
+    return 0;
+}
+
+static int old_decode_inter_chroma(Bink2Slice *s, Bink2Bits *bits,
+                                   unsigned *prev_cbp, int *prev_q,
+                                   unsigned char *dst, int stride)
+{
+    float block[4][64];
+    float *dc = s->dc_cur[s->mb_pos].dc[s->comp];
+    unsigned cbp;
+    int q, dq, i;
+
+    if (old_cbp_chroma(bits, *prev_cbp, &cbp) != 0)
+        return -1;
+    *prev_cbp = cbp;
+    dq = old_delta_q(bits);
+    q = *prev_q + dq;
+    if (q < 0 || q >= 16)
+        return -1;
+    *prev_q = q;
+
+    if (old_decode_dc(s, bits, 0, q, -1023, 1023, 0xA8) != 0)
+        return -1;
+    if (old_decode_ac(bits, chroma_scan, block, cbp, ac_quant[q],
+                      chroma_qmat, NULL) != 0)
+        return -1;
+
+    for (i = 0; i < 4; i++) {
+        int off = (i & 1) * 8 + (i >> 1) * 8 * stride;
+
+        block[i][0] = dc[i] * 0.125f;
+        bink2_idct_old(block[i]);
+        bink2_add_block_f(dst + off, stride, block[i]);
+    }
+    return 0;
+}
+
+void bink2_video_copy_mb(Bink2Video *v, int x, int y)
+{
+    int r;
+
+    for (r = 0; r < 32; r++)
+        memcpy(v->cur[0] + (size_t)(y + r) * v->stride[0] + x,
+               v->ref[0] + (size_t)(y + r) * v->stride[0] + x, 32);
+    for (r = 0; r < 16; r++) {
+        memcpy(v->cur[2] + (size_t)(y / 2 + r) * v->stride[2] + x / 2,
+               v->ref[2] + (size_t)(y / 2 + r) * v->stride[2] + x / 2, 16);
+        memcpy(v->cur[1] + (size_t)(y / 2 + r) * v->stride[1] + x / 2,
+               v->ref[1] + (size_t)(y / 2 + r) * v->stride[1] + x / 2, 16);
+    }
+    if (v->has_alpha) {
+        for (r = 0; r < 32; r++)
+            memcpy(v->cur[3] + (size_t)(y + r) * v->stride[3] + x,
+                   v->ref[3] + (size_t)(y + r) * v->stride[3] + x, 32);
+    }
+}
+
+static int16_t clamp_motion(int32_t value)
+{
+    if (value < -32768)
+        return -32768;
+    if (value > 32767)
+        return 32767;
+    return (int16_t)value;
+}
+
+void bink2_video_store_motion(Bink2Video *v, const Bink2Slice *s,
+                              int x, int y, int nb)
+{
+    size_t mb = (size_t)(y / 32) * v->mb_w + x / 32;
+    int32_t *mv = s->mv_cur + s->mb_pos * 8;
+    int k;
+
+    for (k = 0; k < 4; k++) {
+        v->mv[0][mb * 4 + k] = clamp_motion(mv[k * 2]);
+        v->mv[1][mb * 4 + k] = clamp_motion(mv[k * 2 + 1]);
+    }
+    v->mv_count[mb] = (unsigned char)nb;
+}
+
+int bink2_video_decode_slice_old(Bink2Video *v, Bink2Slice *s, Bink2Bits *bits,
+                                 int is_keyframe, int y0, int y1)
+{
+    int y, x;
+
+    if (!is_keyframe && !v->has_prev)
+        return BINK2_ERROR;
+
+    memset(s->mv_prev, 0,
+           ((size_t)v->mb_w + 1) * 8 * sizeof(int32_t));
+    memset(s->mv_cur, 0,
+           ((size_t)v->mb_w + 1) * 8 * sizeof(int32_t));
+
+    for (y = y0; y < y1; y += 32) {
+        unsigned y_cbp_intra = 0, u_cbp_intra = 0, v_cbp_intra = 0;
+        unsigned a_cbp_intra = 0;
+        unsigned y_cbp_inter = 0, u_cbp_inter = 0, v_cbp_inter = 0;
+        unsigned a_cbp_inter = 0;
+        int y_q_intra = 8, u_q_intra = 8, v_q_intra = 8, a_q_intra = 8;
+        int y_q_inter = 8, u_q_inter = 8, v_q_inter = 8, a_q_inter = 8;
+
+        memset(s->mv_cur, 0,
+               ((size_t)v->mb_w + 1) * 8 * sizeof(int32_t));
+
+        for (x = 0; x < (int)v->width; x += 32) {
+            int flags = 0;
+            int mb = x / 32;
+            int type;
+            int raw[4][2];
+
+            if (y == y0)
+                flags |= 0x80;
+            if (x == 0)
+                flags |= 0x20;
+            if (x == 32)
+                flags |= 0x200;
+            if (x + 32 >= (int)v->width)
+                flags |= 0x40;
+            if (is_keyframe) {
+                type = 0;
+            } else {
+                type = bink2_bits_read(bits, 2);
+                if (type < 0)
+                    return BINK2_ERROR;
+            }
+            s->mb_pos = mb;
+            s->dc_cur[mb].block_type = type;
+            switch (type) {
+            case 0:
+                if (!is_keyframe) {
+                    if (!(flags & 0xA0) &&
+                        s->dc_prev[mb > 0 ? mb - 1 : 0].block_type != 0) {
+                        int px = x - 32;
+                        int py = y - 32;
+
+                        old_average_luma(v->cur[0] +
+                                         (size_t)py * v->stride[0] + px,
+                                         v->stride[0],
+                                         s->dc_prev[mb - 1].dc[0]);
+                        old_average_chroma(v->cur[2] +
+                                           (size_t)(py / 2) * v->stride[2] + px / 2,
+                                           v->stride[2],
+                                           s->dc_prev[mb - 1].dc[1]);
+                        old_average_chroma(v->cur[1] +
+                                           (size_t)(py / 2) * v->stride[1] + px / 2,
+                                           v->stride[1],
+                                           s->dc_prev[mb - 1].dc[2]);
+                    }
+                    if (!(flags & 0x20) &&
+                        s->dc_cur[mb > 0 ? mb - 1 : 0].block_type != 0) {
+                        old_average_luma(v->cur[0] +
+                                         (size_t)y * v->stride[0] + x - 32,
+                                         v->stride[0],
+                                         s->dc_cur[mb - 1].dc[0]);
+                        old_average_chroma(v->cur[2] +
+                                           (size_t)(y / 2) * v->stride[2] + x / 2 - 16,
+                                           v->stride[2],
+                                           s->dc_cur[mb - 1].dc[1]);
+                        old_average_chroma(v->cur[1] +
+                                           (size_t)(y / 2) * v->stride[1] + x / 2 - 16,
+                                           v->stride[1],
+                                           s->dc_cur[mb - 1].dc[2]);
+                    }
+                    if ((flags & 0x20) && !(flags & 0x80) &&
+                        s->dc_prev[mb + 1].block_type != 0) {
+                        old_average_luma(v->cur[0] +
+                                         (size_t)(y - 32) * v->stride[0] + x + 32,
+                                         v->stride[0],
+                                         s->dc_prev[mb + 1].dc[0]);
+                        old_average_chroma(v->cur[2] +
+                                           (size_t)((y - 32) / 2) * v->stride[2] + x / 2 + 16,
+                                           v->stride[2],
+                                           s->dc_prev[mb + 1].dc[1]);
+                        old_average_chroma(v->cur[1] +
+                                           (size_t)((y - 32) / 2) * v->stride[1] + x / 2 + 16,
+                                           v->stride[1],
+                                           s->dc_prev[mb + 1].dc[2]);
+                    }
+                    if (!(flags & 0x80) &&
+                        s->dc_prev[mb].block_type != 0) {
+                        old_average_luma(v->cur[0] +
+                                         (size_t)(y - 32) * v->stride[0] + x,
+                                         v->stride[0],
+                                         s->dc_prev[mb].dc[0]);
+                        old_average_chroma(v->cur[2] +
+                                           (size_t)((y - 32) / 2) * v->stride[2] + x / 2,
+                                           v->stride[2],
+                                           s->dc_prev[mb].dc[1]);
+                        old_average_chroma(v->cur[1] +
+                                           (size_t)((y - 32) / 2) * v->stride[1] + x / 2,
+                                           v->stride[1],
+                                           s->dc_prev[mb].dc[2]);
+                    }
+                }
+                memset(raw, 0, sizeof(raw));
+                old_predict_mv(s, flags, raw);
+                s->comp = 0;
+                if (old_decode_intra_luma(v, s, bits, &y_cbp_intra,
+                                          &y_q_intra, 0, x, y, flags) != 0)
+                    return BINK2_ERROR;
+                s->comp = 1;
+                if (old_decode_intra_chroma(v, s, bits, &u_cbp_intra,
+                                            &u_q_intra, 2, x, y,
+                                            flags) != 0)
+                    return BINK2_ERROR;
+                s->comp = 2;
+                if (old_decode_intra_chroma(v, s, bits, &v_cbp_intra,
+                                            &v_q_intra, 1, x, y,
+                                            flags) != 0)
+                    return BINK2_ERROR;
+                if (v->has_alpha) {
+                    s->comp = 3;
+                    if (old_decode_intra_luma(v, s, bits, &a_cbp_intra,
+                                              &a_q_intra, 3, x, y,
+                                              flags) != 0)
+                        return BINK2_ERROR;
+                }
+                break;
+            case 1:
+                bink2_video_copy_mb(v, x, y);
+                bink2_video_clear_info(v, x, y);
+                break;
+            case 2:
+            case 3:
+                if (old_decode_mv(bits, flags, raw) != 0)
+                    return BINK2_ERROR;
+                old_predict_mv(s, flags, raw);
+                bink2_video_mc_luma(v, s, x, y);
+                bink2_video_mc_chroma(v, s, x, y);
+                bink2_video_store_motion(v, s, x, y, 4);
+                bink2_video_clear_info(v, x, y);
+                if (type == 3) {
+                    s->comp = 0;
+                    if (old_decode_inter_luma(s, bits, &y_cbp_inter,
+                                              &y_q_inter,
+                                              v->cur[0] +
+                                              (size_t)y * v->stride[0] + x,
+                                              v->stride[0], flags) != 0) {
+                        return BINK2_ERROR;
+                    }
+                    s->comp = 1;
+                    if (old_decode_inter_chroma(s, bits, &u_cbp_inter,
+                                                &u_q_inter,
+                                                v->cur[2] +
+                                                (size_t)(y / 2) * v->stride[2] + x / 2,
+                                                v->stride[2]) != 0)
+                        return BINK2_ERROR;
+                    s->comp = 2;
+                    if (old_decode_inter_chroma(s, bits, &v_cbp_inter,
+                                                &v_q_inter,
+                                                v->cur[1] +
+                                                (size_t)(y / 2) * v->stride[1] + x / 2,
+                                                v->stride[1]) != 0)
+                        return BINK2_ERROR;
+                    if (v->has_alpha) {
+                        s->comp = 3;
+                        if (old_decode_inter_luma(s, bits, &a_cbp_inter,
+                                                  &a_q_inter,
+                                                  v->cur[3] +
+                                                  (size_t)y * v->stride[3] + x,
+                                                  v->stride[3], flags) != 0)
+                            return BINK2_ERROR;
+                    }
+                }
+                break;
+            default:
+                return BINK2_ERROR;
+            }
+        }
+
+        {
+            Bink2OldDc *dc_swap = s->dc_cur;
+            int32_t *mv_swap = s->mv_cur;
+
+            s->dc_cur = s->dc_prev;
+            s->dc_prev = dc_swap;
+            s->mv_cur = s->mv_prev;
+            s->mv_prev = mv_swap;
+        }
+    }
+    return BINK2_OK;
+}
