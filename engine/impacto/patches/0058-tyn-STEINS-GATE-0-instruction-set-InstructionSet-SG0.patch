diff --git a/src/vm/opcodetables_sg0.h b/src/vm/opcodetables_sg0.h
new file mode 100644
index 0000000000000000000000000000000000000000..af26281a141d4adf7543ee38904601f20f7a8a8f
--- /dev/null
+++ b/src/vm/opcodetables_sg0.h
@@ -0,0 +1,39 @@
+#pragma once
+// STEINS;GATE 0 (Steam, 2018) runs the STEINS;GATE (Steam) dialect of the SC3 virtual machine: the opcode tables of
+// both Game.exe builds (S;G0 0xdcc198 / 0xdcbfb0 / 0xdcc320) have the same operand shapes except for the groups
+// below. Configure_SG0() starts from the SGHD tables and applies the overrides.
+// vm.cpp includes this after opcodetables_sghd.h.
+#include "inst_sg0.h"
+
+namespace Impacto {
+
+namespace Vm {
+
+inline InstructionProc OpcodeTableSystem_SG0[256];
+inline InstructionProc OpcodeTableGraph_SG0[256];
+inline InstructionProc OpcodeTableUser1_SG0[256];
+
+inline void Configure_SG0() {
+  Configure_SGHD();
+  for (int i = 0; i < 256; i++) {
+    OpcodeTableSystem_SG0[i] = OpcodeTableSystem_SGHD[i];
+    OpcodeTableGraph_SG0[i] = OpcodeTableGraph_SGHD[i];
+    OpcodeTableUser1_SG0[i] = OpcodeTableUser1_SGHD[i];
+  }
+  // 00:53..00:59 are unused by STEINS;GATE; S;G0 calls, jumps and polls mouse / keyboard with them.
+  OpcodeTableSystem_SG0[0x53] = InstSg0Unk0053;  // byte, expression, label: read and ignored
+  OpcodeTableSystem_SG0[0x54] = InstSg0CallIfFlag;
+  OpcodeTableSystem_SG0[0x55] = InstSg0JumpFarIfFlag;
+  OpcodeTableSystem_SG0[0x56] = InstSg0CallFarIfFlag;
+  OpcodeTableSystem_SG0[0x57] = InstReturnIfFlag;  // (0x47f700) same operands and effect as the upstream one
+  OpcodeTableSystem_SG0[0x58] = InstSg0MouseOnJump;
+  OpcodeTableSystem_SG0[0x59] = InstSg0KeyboardOnJump;
+  OpcodeTableUser1_SG0[0x37] = InstSg0Group1037;  // RINE / phone group (SGHD: the S;G phone)
+  OpcodeTableUser1_SG0[0x38] = InstSg0Group1038;  // same operands as SGHD, not the S;G phone attachments
+  // 10:3A and 10:3F are empty handlers in the S;G0 Game.exe (0x47f0d0); the scripts do not use them.
+  OpcodeTableUser1_SG0[0x3a] = OpcodeTableUser1_CC[0x3a];
+}
+
+}  // namespace Vm
+
+}  // namespace Impacto
