+namespace TipsMenu {
+
+void Configure() {
+  RowY = EnsureGetMember<float>("RowY");
+  RowHeight = EnsureGetMember<float>("RowHeight");
+  TryGetMember<int>("VisibleRows", VisibleRows);
+  FontSize = EnsureGetMember<float>("FontSize");
+  TryGetMember<float>("ShadowOffset", ShadowOffset);
+  CategoryX = EnsureGetMember<float>("CategoryX");
+  HeaderX = EnsureGetMember<float>("HeaderX");
