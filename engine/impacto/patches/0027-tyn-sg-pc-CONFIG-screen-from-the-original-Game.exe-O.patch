+#pragma once
+
+#include <array>
+#include <vector>
+
+#include "../../ui/optionsmenu.h"
+#include "../../profile/games/sghd/optionsmenu.h"
+
+namespace Impacto {
+namespace UI {
+namespace SGHD {
+
+// Options (CONFIG) screen of the STEINS;GATE (Steam) engine generation. Layout, sprites, value ranges and steps
+// come from the profile (taken from the original Game.exe); this class only reproduces the original behaviour:
+// visible while the script shows submenu 5 (SW_SYSSUBMENUNO / SW_SYSSUBMENUALPHA), Back raises SF_SUBMENUEXIT, pages
+// slide sideways, every page keeps its own cursor, sliders draw a half transparent knob at the value they had when
+// the screen opened.
+class OptionsMenu : public UI::OptionsMenu {
+ public:
+  OptionsMenu();
+
+  void Show() override;
+  void Hide() override;
+  void Update(float dt) override;
+  void UpdateInput(float dt) override;
+  void Render() override;
+
+ protected:
+  void UpdateValues() override;
+  void UpdateVisibility() override;
+
+ private:
+  using Row = Profile::SGHD::OptionsMenu::Row;
+
+  float GetValue(const Row& row) const;
+  void SetValue(const Row& row, float value);
+  bool GetVoiceOn(const Row& row) const;
+  void SetVoiceOn(const Row& row, bool on);
+
+  void ChangePage(int target, int direction);
+  void RenderPage(size_t page, float offsetX, float alpha);
+  float KnobPosition(const Row& row, float value) const;
+
+  int ScriptAlpha() const;
+
+  std::vector<int> Cursor;                     // per page, -1 = none
+  std::vector<std::vector<float>> OpenValues;  // per page / row: value when the screen opened
+  int HoveredTab = -1;
+  int TargetPage = 0;
+  float SlideCounter = 0.0f;  // 0 = no slide; > 0 to the next page, < 0 to the previous one
+  int DraggedRow = -1;
+  glm::vec2 LastPointer{-1.0f, -1.0f};
+};
+
+}  // namespace SGHD
+}  // namespace UI
+}  // namespace Impacto
diff --git a/src/profile/games/sghd/optionsmenu.cpp b/src/profile/games/sghd/optionsmenu.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1269c7ffaab77f36c2597ebdd3dfc9576272f47f
--- /dev/null
+++ b/src/profile/games/sghd/optionsmenu.cpp
@@ -0,0 +1,105 @@
+#include "optionsmenu.h"
+#include "../../profile_internal.h"
+#include "../../../ui/ui.h"
+#include "../../../game.h"
+#include "../../../games/sghd/optionsmenu.h"
+
+namespace Impacto {
+namespace Profile {
+namespace SGHD {
+namespace OptionsMenu {
+
+namespace {
+
+RowType ParseType(const std::string& name) {
+  if (name == "Slider") return RowType::Slider;
+  if (name == "Choice") return RowType::Choice;
+  if (name == "Radio") return RowType::Radio;
+  if (name == "Voice") return RowType::Voice;
+  return RowType::Toggle;
+}
+
+std::vector<glm::vec2> GetPositions(char const* name) {
+  std::vector<glm::vec2> out;
+  if (!TryPushMember(name)) return out;
+  ForEachProfileArray([&](uint32_t) { out.push_back(EnsureGetArrayElement<glm::vec2>()); });
+  Pop();
+  return out;
+}
+
+Row ReadRow() {
+  Row row;
+  row.Type = ParseType(EnsureGetMember<std::string>("Type"));
+  TryGetMember<std::string>("Setting", row.Setting);
+  TryGetMember<int>("CharacterId", row.CharacterId);
+  TryGetMember<RectF>("Underline", row.Underline);
+  TryGetMember<RectF>("HitArea", row.HitArea);
+  TryGetMember<glm::vec2>("Position", row.Position);
+  TryGetMember<Sprite>("TrueSprite", row.TrueSprite);
+  TryGetMember<Sprite>("FalseSprite", row.FalseSprite);
+  TryGetMember<float>("KnobX", row.KnobX);
+  TryGetMember<float>("KnobY", row.KnobY);
+  TryGetMember<float>("KnobRange", row.KnobRange);
+  TryGetMember<float>("Min", row.Min);
+  TryGetMember<float>("Max", row.Max);
+  TryGetMember<float>("Step", row.Step);
+  TryGetMember<RectF>("DragArea", row.DragArea);
+  TryGetMember<float>("DragInset", row.DragInset);
+  TryGetMember<Sprite>("Sprite", row.Sprite_);
+  row.Positions = GetPositions("Positions");
+  TryGetMember<int>("FixedValue", row.FixedValue);
+  TryGetMember<Sprite>("CursorSprite", row.CursorSprite);
+  TryGetMember<glm::vec2>("CursorPosition", row.CursorPosition);
+  TryGetMember<Sprite>("OnSprite", row.OnSprite);
+  TryGetMember<glm::vec2>("OnPosition", row.OnPosition);
+  TryGetMember<RectF>("ToggleArea", row.ToggleArea);
+  return row;
+}
+
+}  // namespace
+
+void Configure() {
+  BackgroundSprite = EnsureGetMember<Sprite>("BackgroundSprite");
+  UnderlineSprite = EnsureGetMember<Sprite>("UnderlineSprite");
+  KnobSprite = EnsureGetMember<Sprite>("KnobSprite");
+  TabCheckSprite = EnsureGetMember<Sprite>("TabCheckSprite");
+  TryGetMember<float>("PageSlideFrames", PageSlideFrames);
+  TryGetMember<float>("PageSlideDistance", PageSlideDistance);
+
+  Pages.clear();
+  EnsurePushMemberOfType("Pages", LUA_TTABLE);
+  ForEachProfileArray([&](uint32_t) {
+    Page page;
+    page.Paper = EnsureGetMember<Sprite>("PaperSprite");
+    page.PaperPosition = EnsureGetMember<glm::vec2>("PaperPosition");
+    page.Guide = EnsureGetMember<Sprite>("GuideSprite");
+    page.GuidePosition = EnsureGetMember<glm::vec2>("GuidePosition");
+    EnsurePushMemberOfType("Rows", LUA_TTABLE);
+    ForEachProfileArray([&](uint32_t) { page.Rows.push_back(ReadRow()); });
+    Pop();
+    Pages.push_back(std::move(page));
+  });
+  Pop();
+
+  Tabs.clear();
+  EnsurePushMemberOfType("Tabs", LUA_TTABLE);
+  ForEachProfileArray([&](uint32_t) {
+    Tab tab;
+    tab.Normal = EnsureGetMember<Sprite>("Sprite");
+    tab.Highlighted = EnsureGetMember<Sprite>("HighlightedSprite");
+    tab.Position = EnsureGetMember<glm::vec2>("Position");
+    tab.CheckPosition = EnsureGetMember<glm::vec2>("CheckPosition");
+    tab.HitArea = EnsureGetMember<RectF>("HitArea");
+    Tabs.push_back(tab);
+  });
+  Pop();
+
+  auto drawType = EnsureGetMember<Game::DrawComponentType>("DrawType");
+  UI::OptionsMenuPtr = new UI::SGHD::OptionsMenu();
+  UI::Menus[drawType].push_back(UI::OptionsMenuPtr);
+}
+
+}  // namespace OptionsMenu
+}  // namespace SGHD
+}  // namespace Profile
+}  // namespace Impacto
