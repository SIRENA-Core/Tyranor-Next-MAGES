+static void dc_integer(unsigned char *dst, int stride, const int val[9])
+{
+    static const int row_base[3] = { N_U, N_C, N_D };
+    int h[3][8];
+    int i, j, k;
+
+    /* Horizontal pass over the rows above, through and below X. */
+    for (k = 0; k < 3; k++) {
+        int base = val[row_base[k]];
+        int dl = val[row_base[k] - 1] - base;
+        int dr = val[row_base[k] + 1] - base;
+
+        for (j = 0; j < 8; j++)
+            h[k][j] = base + 4 + dc_weight(j, dl) + dc_weight(7 - j, dr);
+    }
+    for (j = 0; j < 8; j++) {
+        int du = h[0][j] - h[1][j];
+        int dd = h[2][j] - h[1][j];
+
+        for (i = 0; i < 8; i++)
+            dst[(size_t)i * stride + j] = clamp255(floor_div(
+                h[1][j] + dc_weight(i, du) + dc_weight(7 - i, dd), 8));
+    }
+}
+
+static void dc_float(unsigned char *dst, int stride, const int val[9])
+{
+    float fv[9];
+    int i, k;
+
+    for (k = 0; k < 9; k++)
+        fv[k] = (float)val[k];
+    for (i = 0; i < 64; i++) {
+        const Bink2DcPixel *px = &dc_float_weights[i];
+        float s = fv[px->term[0].n] * px->term[0].w;
+
+        /* Every product and sum is rounded to single precision, in the
+         * table's order. */
+        for (k = 1; k < px->count; k++) {
+            float t = fv[px->term[k].n] * px->term[k].w;
+
+            s = s + t;
+        }
+        s = s + 0.49999991f;
+        dst[(size_t)(i >> 3) * stride + (i & 7)] = clamp255((int)s);
+    }
+}
+
+void bink2_filter_dc_block(unsigned char *dst, int stride,
+                           const unsigned words[9], int threshold,
+                           int integer_form)
+{
+    int x = wrap16((int)words[N_C]);
+    int use[9];
+    int dc[9];
+    int val[9];
+    int k;
+
+    for (k = 0; k < 9; k++) {
+        int d = wrap16(wrap16((int)words[k]) - x);
+
+        use[k] = threshold > (d < 0 ? -d : d);
+        dc[k] = (int)(words[k] & BINK2_INFO_DC_MASK);
+    }
+    val[N_C] = dc[N_C];
+    val[N_L] = use[N_L] ? dc[N_L] : dc[N_C];
+    val[N_R] = use[N_R] ? dc[N_R] : dc[N_C];
+    val[N_U] = use[N_U] ? dc[N_U] : dc[N_C];
+    val[N_D] = use[N_D] ? dc[N_D] : dc[N_C];
+    /* Each diagonal is tested against X and falls back to its row's side
+     * neighbour value. */
+    val[N_UL] = use[N_UL] ? dc[N_UL] : val[N_L];
+    val[N_DL] = use[N_DL] ? dc[N_DL] : val[N_L];
+    val[N_UR] = use[N_UR] ? dc[N_UR] : val[N_R];
+    val[N_DR] = use[N_DR] ? dc[N_DR] : val[N_R];
+
+    if (integer_form)
+        dc_integer(dst, stride, val);
+    else
+        dc_float(dst, stride, val);
+}
+
+void bink2_filter_dcrecon(Bink2Video *v)
+{
+    int threshold = 8 * (int)(v->frame_flags & 0xFF);
+    int integer_form = (v->frame_flags & 0x2000) != 0;
+    int h16 = (int)((v->height + 15) & ~15UL);
+    int p;
+
+    for (p = 0; p < 4; p++) {
+        int s = p == 1 || p == 2;
+        int cols = v->blk_stride[p];
+        int last = ((int)(v->aligned_h >> 3) >> s) - 1;
+        int rows = (h16 >> 3) >> s;
+        int stride = v->stride[p];
+        const uint16_t *info = v->blk_info[p];
+        int i, j, k;
+
+        if (info == NULL || v->cur[p] == NULL)
+            continue;
+        for (i = 0; i < rows; i++) {
+            /* The top block row is its own row above, and the bottom
+             * block row of the plane its own row below. */
+            const uint16_t *row[3];
+
+            row[0] = info + (size_t)(i > 0 ? i - 1 : 0) * cols;
+            row[1] = info + (size_t)i * cols;
+            row[2] = info + (size_t)(i < last ? i + 1 : last) * cols;
+            for (j = 0; j < cols; j++) {
+                unsigned words[9];
+
+                if (row[1][j] < BINK2_INFO_DC_ONLY)
+                    continue;
+                /* Outside the first and last columns a word is 0. */
+                for (k = 0; k < 9; k++) {
+                    int c = j + k % 3 - 1;
+
+                    words[k] = c < 0 || c >= cols ? 0u : row[k / 3][c];
+                }
+                bink2_filter_dc_block(v->cur[p] + (size_t)(8 * i) * stride +
+                                      8 * j, stride, words, threshold,
+                                      integer_form);
+            }
+        }
+    }
+}
diff --git a/vendor/libbink2/src/bink2_filter.h b/vendor/libbink2/src/bink2_filter.h
new file mode 100644
index 0000000000000000000000000000000000000000..0682244f83e729bfd799aab9caf043bbce811ad6
--- /dev/null
+++ b/vendor/libbink2/src/bink2_filter.h
@@ -0,0 +1,99 @@
+#ifndef LIBBINK2_FILTER_H
+#define LIBBINK2_FILTER_H
+
+/* Post-reconstruction stages that RAD's decoder runs and FFmpeg's does not:
+ * pixel deblocking (DB), DC-only block reconstruction (DC) and the inter
+ * residual edge filter (R). See docs/rad-filter-design.md. */
+
+#include <stdint.h>
+
+#define BINK2_STAGE_DEBLOCK  0
+#define BINK2_STAGE_DCRECON  1
+#define BINK2_STAGE_RESIDUAL 2
+
+/* Returns 1 when libbink2 reproduces RAD's behaviour for this stage on this
+ * revision. `version` is the fourcc's last character, as in
+ * Bink2Video.version ('f' for KB2f). Any other stage returns 0. */
+int bink2_filter_covers(int version, int stage);
+
+/* Deblocking taps across an edge, p1 p0 | q0 q1. */
+#define BINK2_DB_TAP_P1 1u
+#define BINK2_DB_TAP_P0 2u
+#define BINK2_DB_TAP_Q0 4u
+#define BINK2_DB_TAP_Q1 8u
+#define BINK2_DB_TAPS_ALL 15u
+
+/* Tap mask for an edge where at least one side is an intra macroblock,
+ * from the AC-count classes (0..3) of block P (left or top) and block Q
+ * (right or bottom). Two class-3 blocks give 0. */
+unsigned bink2_filter_db_class_mask(int class_p, int class_q);
+
+/* 1 when two motion vectors differ by 2 or more in either component, which
+ * makes an edge between two non-intra macroblocks full strength. */
+int bink2_filter_mv_differ(int ax, int ay, int bx, int by);
+
+/* Filters one 8-line deblocking edge segment in place. `q0` is the first
+ * pixel on the Q side of line 0. `across` is the distance from one pixel to
+ * the next across the edge (1 for a vertical edge, the plane stride for a
+ * horizontal one) and `along` the distance between lines. The footprint is
+ * two pixels on each side; `mask` picks the taps that are written. */
+void bink2_filter_db_edge(unsigned char *q0, int across, int along,
+                          unsigned mask);
+
+struct Bink2Video;
+
+/* Deblocks the frame in cur in place: every enabled vertical edge of Y, U
+ * and V, then every enabled horizontal edge, from the block info words,
+ * motion vectors, frame flags and edge arrays of the frame just decoded.
+ * Rows from the 16-aligned height on and the alpha plane are not touched. */
+void bink2_filter_deblock(struct Bink2Video *v);
+
+/* ---- Stage DC: reconstruction of DC-only intra blocks ---- */
+
+/* Rewrites one DC-only 8x8 block at dst as a surface interpolated from the
+ * DCs of its 3x3 neighbourhood of info words, words[] = UL U UR / L X R /
+ * DL D DR, X the block itself. A neighbour is used only when
+ * threshold > |N - X| with both words read as int16; threshold is
+ * 8 * (frame flags & 0xFF). integer_form selects the integer arithmetic of
+ * frame flag 0x2000; 0 selects KB2f's single-precision form. */
+void bink2_filter_dc_block(unsigned char *dst, int stride,
+                           const unsigned words[9], int threshold,
+                           int integer_form);
+
+/* Runs the primitive over every DC-only block of Y, U, V and alpha of the
+ * frame in cur, from its block info words and frame flags. Rows from the
+ * 16-aligned height on are not touched. */
+void bink2_filter_dcrecon(struct Bink2Video *v);
+
+/* ---- Stage R: the residual edge filter of motion+residual macroblocks ---- */
+
+#define BINK2_RES_VERTICAL   1u
+#define BINK2_RES_HORIZONTAL 2u
+
+/* The edge directions stage R filters in the frame v is decoding: none
+ * unless filters are on, the revision is covered, frame flag 0x2000 is set
+ * and 0x40000 is clear; 0x4000 removes the vertical edges and 0x8000 the
+ * horizontal ones. */
+unsigned bink2_filter_residual_dirs(const struct Bink2Video *v);
+
+/* The word stage R uses for an inter block: the class from its number of
+ * decoded AC symbols, shifted by BINK2_INFO_CLASS_SHIFT, over its DC value
+ * (the v for which coefficient 0 is v * 8 + 32) in 13-bit two's
+ * complement. */
+unsigned bink2_filter_residual_word(int dc, int symbols);
+
+/* Filters one 8-line edge of an int16 residual in place. `r2` is the first
+ * sample on the B (right or bottom) side of line 0; `across` and `along`
+ * are as for bink2_filter_db_edge. wa and wb are the words of blocks A and
+ * B. Arithmetic is 16-bit two's complement with no clamping. */
+void bink2_filter_residual_edge(int16_t *r2, int across, int along,
+                                unsigned wa, unsigned wb);
+
+/* Filters the internal 8x8 edges of an n x n block residual (n = 4 for
+ * luma, 2 for chroma) in the directions `dirs`: every vertical edge, then
+ * every horizontal one. words[by * n + bx] belongs to block (bx, by). The
+ * macroblock's outer edges are never touched. */
+void bink2_filter_residual(int16_t *res, int stride, int n,
+                           const unsigned *words, unsigned dirs);
+
+#endif
diff --git a/vendor/libbink2/src/bink2_internal.h b/vendor/libbink2/src/bink2_internal.h
new file mode 100644
index 0000000000000000000000000000000000000000..711728bff5b80613c9a7fcba0b454101d9fb12c0
--- /dev/null
+++ b/vendor/libbink2/src/bink2_internal.h
@@ -0,0 +1,72 @@
+#ifndef LIBBINK2_INTERNAL_H
+#define LIBBINK2_INTERNAL_H
+
+#include "bink2.h"
+
+#define BINK2_MAX_AUDIO_TRACKS 7
+#define BINK2_MAX_FRAMES 1000000UL
+#define BINK2_MAX_WIDTH 7680UL
+#define BINK2_MAX_HEIGHT 4800UL
+
+struct Bink2Audio;
+struct Bink2Video;
+
+typedef struct {
+    unsigned long rate;
+    unsigned char channels;
+    unsigned char bitdepth;
+    unsigned char flags;
+    unsigned char enabled;
+    unsigned long max_decoded;
+    struct Bink2Audio *decoder;
+    const unsigned char *payload;
+    unsigned long payload_size;
+} Bink2AudioTrack;
+
+struct bink2_t {
+    /* input source */
+    FILE *file;
+    unsigned char *mem;
+    unsigned long mem_size;
+    unsigned char mode;
+    unsigned char owns_file;
+
+    /* container metadata */
+    unsigned long file_size;
+    unsigned long actual_size;
+    int version; /* 'f' .. 'n' */
+    unsigned long width;
+    unsigned long height;
+    unsigned long frame_count;
+    unsigned long largest_frame;
+    unsigned long fps_num;
+    unsigned long fps_den;
+    unsigned long flags;
+    int audio_tracks;
+    Bink2AudioTrack audio[BINK2_MAX_AUDIO_TRACKS];
+
+    /* frame index */
+    unsigned long *frame_offsets;
+    unsigned long *frame_sizes;
+    unsigned char *frame_keyframes;
+
+    /* current frame packet */
+    unsigned char *frame_data;
+    unsigned long frame_data_size;
+    const unsigned char *video_data;
+    unsigned long video_size;
+
+    /* playback state */
+    unsigned long current_frame;
+    unsigned char video_enabled;
+    unsigned char filters_requested;    /* latched at each keyframe */
+    struct Bink2Video *video;
+    int thread_limit;   /* see bink2_internal_set_threads */
+};
+
+int bink2_internal_load_frame(bink2 object, unsigned long frame);
+/* Slice threads per frame: 0 = automatic (BINK2_THREADS, else the CPU
+ * count), 1 = serial, n > 1 = up to n. For tests and tools. */
+void bink2_internal_set_threads(bink2 object, int n);
+
+#endif
