+// 0x457310 mode 28: answer with the chosen word or open the attachment
+void ModeTriggerActions() {
+  const int mail = SW(0x6a5c);
+  bool canReply = false;
+  uint32_t entries = 0;
+  if (GetFlag(0xa29) && GetFlag(0xa35) && mail == SW(0x6aa0) && S.Mails[mail][MailReply] != 999 &&
+      !MailBit(mail, 4) && S.LinkSel != 0xff) {
+    canReply = true;
+    entries = 1;
+  }
+  if (S.Mails[mail][MailAttach] != 999) entries++;
+  if (Cancel()) {
+    ClearLinkHitAreas();
+    SetMode(0x1b);
+    if (MouseMode()) S.LinkSel = 0xff;
+    return;
+  }
+  S.Hover = 0;
+  if (MouseMode()) {
+    SW(0x6a80) = 0xff;
+    if (Hit(10, 1)) S.Hover = 1, SW(0x6a80) = 0;
+    if (entries > 1 && Hit(0xb, 1)) S.Hover = 1, SW(0x6a80) = 1;
+    if (Hit(10, 8)) ClickDecide();
+    if (entries > 1 && Hit(0xb, 8)) ClickDecide();
+  }
+  if (!Decide()) {
+    for (bool pressed : {Up(), Down()}) {
+      if (!pressed) continue;
+      if ((uint32_t)SW(0x6a80) == 0xff)
+        SW(0x6a80) = 0;
+      else if (entries > 1)
+        SW(0x6a80) ^= 1;
+    }
+    return;
+  }
+  if (SW(0x6a80) == 0xff) return;
+  if (canReply && SW(0x6a80) == 0) {
+    const int reply = S.Mails[mail][MailReply + S.LinkSel];
+    SW(0x6b30) = mail;
+    SW(0x6b34) = reply;
+    StartReply(mail, reply, 0x1b);
+    return;
+  }
+  S.AttachIdx = S.Mails[mail][MailAttach];
+  OpenAttachment(0x1b);
+}
