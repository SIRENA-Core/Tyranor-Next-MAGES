+// what an attachment does, shared by 0x455470 (mode 19) and 0x457310 (mode 28)
+void OpenAttachment(int returnMode) {
+  const auto& a = S.Attach[S.AttachIdx];
+  if (a[0] == 5 && returnMode == 0x1b) return;  // not offered after a word was chosen (0x457310)
+  switch (a[0]) {
+    case 0:
+    case 4:  // picture
+      SetFlag(0xa3a, a[0] == 4);
+      SetMode(200);
+      SW(0x62e8) = SW(0x6ae8);
+      S.ReturnMode = returnMode;
+      S.SavedFlag9c6 = GetFlag(0x9c6);
+      S.SavedFlagA38 = GetFlag(0xa38);
+      SetFlag(0xa38, 0);
+      SetFlag(0x9c6, 0);
+      return;
+    case 1:  // a conversation with pictures
+      SetMode(0xca);
+      S.ReturnMode = returnMode;
+      break;
+    case 2: {  // music
+      SetMode(0xce);
+      S.ReturnMode = returnMode;
+      const uint32_t r = a[2];
+      S.AttachPos = 1;
+      PlayBgm(S.Ringtones[r][0], true);
+      SetFlag(S.Ringtones[r][3], 1);
+      S.PlayingId = S.Ringtones[r][0];
+      S.PlayTime = 0;
+      S.Unk_6f54 = 0;
+      S.Unk_6f58 = 0x78;
+      S.PlayingIdx = r;
+      Achievement(3);
+      return;
+    }
+    case 3: {  // text pages
+      SetMode(0xcc);
+      S.ReturnMode = returnMode;
+      S.SavedFlag9c6 = GetFlag(0x9c6);
+      S.SavedFlagA38 = GetFlag(0xa38);
+      SetFlag(0xa38, 0);
+      SetFlag(0x9c6, 0);
+      SetFlag(0x645, 1);
+      SW(0x6acc) = SW(0x6ae8);
+      SW(0x6ad4) = 0;
+      S.AttachPos = 0;
+      SW(0x6ad0) = a[2];
+      S.PageLines = a[3];
+      SW(0x6adc) = S.PageLines < 0x21 ? 0 : S.PageLines - 0x20;
+      SetFlag(a[4], 1);
+      S.AttachPos = 1;
+      Achievement(3);
+      return;
+    }
+    case 5:
+      SetMode(0xcf);
+      SW(0x2ef0) = 0;
+      S.ReturnMode = returnMode;
+      break;
+    default:
+      return;
+  }
+  if (a[0] == 1 || a[0] == 5) {
+    if (returnMode == 5) S.ReturnMode = 5 - (SW(0x6a4c) != 0);
+    S.SavedFlag9c6 = GetFlag(0x9c6);
+    S.SavedFlagA38 = GetFlag(0xa38);
+    SetFlag(0xa38, 0);
+    SetFlag(0x9c6, 0);
+    SetFlag(0x645, 1);
+    S.AttachPos = 2;
+    const uint32_t w = a[3];
+    SW(0x6b14) = a[2];
+    if (w != 999 && w < S.WallpaperCount && S.Wallpapers[w][2] != 0) SetFlag(S.Wallpapers[w][2], 1);
+    S.AttachPos += 2;
+    S.AttachToggle = 0;
+    SetFlag(0x647, 0);
+  }
+  Achievement(3);
+}
+
+void StartReply(int mail, int reply, int returnMode) {  // shared by 0x455470 and 0x457310
+  SetMode(0x16);
+  S.ReturnMode = returnMode;
+  SW(0x6a84) = reply;
+  SW(0x6a88) = 0;
+  const int n = LineCount(S.Mails[reply][MailText] + 2, 0x116, 0x18) + 1;
+  const int t = LineCount(S.Mails[reply][MailText], 0xfe, 0x18);
+  SW(0x6a8c) = n + (t == 0 ? 1 : t);
+  (void)mail;
+}
