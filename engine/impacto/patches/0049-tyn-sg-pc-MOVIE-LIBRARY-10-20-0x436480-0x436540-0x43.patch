--- /dev/null
+++ b/src/games/sghd/movielibrary.h
@@ -0,0 +1,15 @@
+#pragma once
+
+// MOVIE LIBRARY of STEINS;GATE (Steam), see movielibrary.cpp.
+
+namespace Impacto {
+namespace SGHD {
+namespace MovieLibrary {
+
+void Init();    // 10:20 type 0 (0x436480)
+void Update();  // 10:20 type 1 (0x436540)
+void Render();  // 0x436170, while GlobalVars[2148] is 9
+
+}  // namespace MovieLibrary
+}  // namespace SGHD
+}  // namespace Impacto
diff --git a/src/vm/inst_sghd.h b/src/vm/inst_sghd.h
index f04043836986da45f2e7109bc4a0a1819f7105e5..89c4d458025db5ef5baa39fa812155e85d2b8a9e 100644
--- a/src/vm/inst_sghd.h
+++ b/src/vm/inst_sghd.h
@@ -12,6 +12,7 @@
 #include "../profile/ui/helpmenu.h"
 #include "../games/sghd/phone.h"
 #include "../games/sghd/timeleap.h"
+#include "../games/sghd/movielibrary.h"
 
 namespace Impacto {
 
@@ -139,6 +140,25 @@ inline void InstSghdTimeLeapDates(Sc3VmThread* thread, float dt) {
   SGHD::TimeLeap::Start(v);
 }
 
+// 10:1D (SOUND LIBRARY, 0x4673b0) / 10:1F (CG LIBRARY, 0x467410): not ported yet. Their screens would stay
+// invisible while the script waits for them, so the first frame answers like the player leaving (flag 1805):
+// the script goes back to the title.
+inline void InstSghdLibraryNotPorted(Sc3VmThread* thread, float dt) {
+  thread->IpOffset += 2;
+  const uint8_t type = *thread->GetIp();
+  thread->IpOffset += 1;
+  if (type == 1) SetFlag(1805, true);
+}
+
+// 10:20 (0x467450): MOVIE LIBRARY, type 0 opens it, type 1 runs it for a frame (CC: MovieMenu).
+inline void InstSghdMovieLibrary(Sc3VmThread* thread, float dt) {
+  thread->IpOffset += 2;
+  const uint8_t type = *thread->GetIp();
+  thread->IpOffset += 1;
+  if (type == 0) SGHD::MovieLibrary::Init();
+  if (type == 1) SGHD::MovieLibrary::Update();
+}
+
 // 10:38: text pages of the phone's attachments (type byte, a label when the type is 0).
 inline void InstSghdGroup1038(Sc3VmThread* thread, float dt) { SGHD::Phone::Instruction1038(thread); }
 
