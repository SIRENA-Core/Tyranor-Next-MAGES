+// 0x4568a0 mode 22: the answer (shown before sending)
+void ModeReply() {
+  const int mail = SW(0x6a5c), reply = SW(0x6a84);
+  if (Cancel() && S.ReturnMode == 0x1b) {
+    SW(0x6b30) = 999;
+    SW(0x6b34) = 999;
+    ClearLinkHitAreas();
+    SetMode(0x1b);
+    if (MouseMode()) S.LinkSel = 0xff;
+    return;
+  }
+  S.ScrollHover = 0;
+  S.Hover = 0;
+  MailScroll(0, 0x6a8c, 0x6a88);
+  if (!Decide()) {
+    MailScrollKeys(0x6a8c, 0x6a88);
+    return;
+  }
+  if (S.ReturnMode != 0x1b) {
+    SendReply(mail, reply);
+    return;
+  }
+  SetMode(0x28);  // confirm the answer chosen by a word
+  if (MouseMode()) SW(0x6afc) = 0xff;
+}
