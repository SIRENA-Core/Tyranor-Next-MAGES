diff --git a/src/games/sghd/sysmesbox.cpp b/src/games/sghd/sysmesbox.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e67cf67d1c60e288e2ff7302e679fa8c9dacda00
--- /dev/null
+++ b/src/games/sghd/sysmesbox.cpp
@@ -0,0 +1,197 @@
+#include "sysmesbox.h"
+
+#include <algorithm>
+
+#include "../../profile/ui/sysmesbox.h"
+#include "../../profile/games/sghd/sysmesbox.h"
+#include "../../profile/dialogue.h"
+#include "../../profile/game.h"
+#include "../../profile/scriptvars.h"
+#include "../../renderer/renderer.h"
+#include "../../ui/ui.h"
+#include "../../mem.h"
+#include "../../inputsystem.h"
+#include "../../vm/interface/input.h"
+#include "../../vm/thread.h"
+#include "../../audio/audiosystem.h"
+
+namespace Impacto {
+namespace UI {
+namespace SGHD {
+
+using namespace Impacto::Profile::ScriptVars;
+using namespace Impacto::Profile::SGHD::SysMesBox;
+using namespace Impacto::Vm::Interface;
+namespace Common = Impacto::Profile::SysMesBox;
+
+namespace {
+constexpr DialogueColorPair White{0xFFFFFF, 0x000000};
+
+void PlaySe(int id) { Audio::PlayInGroup(Audio::ACG_SE, "sysse", id, false, 0.0f); }
+
+std::vector<ProcessedTextGlyph> LayoutLine(Vm::BufferOffsetContext ctx) {
+  Impacto::Vm::Sc3VmThread dummy;
+  dummy.SetStringIp(ctx);
+  return TextLayoutPlainLine(&dummy, 255, *Profile::Dialogue::DialogueFont, Common::TextFontSize, White, 1.0f,
+                             glm::vec2(0.0f), TextAlignment::Left);
+}
+
+void MoveLine(std::vector<ProcessedTextGlyph>& line, glm::vec2 pos) {
+  if (line.empty()) return;
+  const glm::vec2 offset = pos - line[0].Position;
+  for (ProcessedTextGlyph& glyph : line) glyph.Move(offset);
+}
+}  // namespace
+
+void SysMesBox::Init() {
+  ChoiceMade = false;
+  MessageCount = 0;
+  ChoiceCount = 0;
+  Selection = -1;  // the original starts without a chosen choice
+  FadeAnimation.DurationIn = Common::FadeInDuration;
+  FadeAnimation.DurationOut = Common::FadeOutDuration;
+  FadeAnimation.Direction = AnimationDirection::In;
+  FadeAnimation.LoopMode = AnimationLoopMode::Stop;
+}
+
+void SysMesBox::AddMessage(Vm::BufferOffsetContext str) {
+  if (MessageCount >= (int)Messages.size()) return;
+  Messages[MessageCount] = LayoutLine(str);
+  MessageWidths[MessageCount] = GetTextWidth(Messages[MessageCount]);
+  MessageCount++;
+}
+
+void SysMesBox::AddChoice(Vm::BufferOffsetContext str) {
+  if (ChoiceCount >= (int)Choices.size()) return;
+  Choices[ChoiceCount] = LayoutLine(str);
+  ChoiceWidths[ChoiceCount] = GetTextWidth(Choices[ChoiceCount]);
+  ChoiceCount++;
+}
+
+// The content width is the widest message, the choices with their spacing or the minimum; messages are left
+// aligned from the box's left text edge, the choices end at the right one.
+void SysMesBox::Layout() {
+  float choicesWidth = 0.0f;
+  for (int i = 0; i < ChoiceCount; i++) choicesWidth += ChoiceWidths[i] + ChoiceSpacing;
+  Width = std::max(MinWidth, choicesWidth);
+  for (int i = 0; i < MessageCount; i++) Width = std::max(Width, MessageWidths[i]);
+
+  for (int i = 0; i < MessageCount; i++)
+    MoveLine(Messages[i], glm::vec2(Common::TextX - Width / 2.0f, Common::TextMiddleY + i * Common::TextLineHeight));
+  float x = Width / 2.0f - choicesWidth + ChoiceRightX;
+  for (int i = 0; i < ChoiceCount; i++) {
+    ChoiceXs[i] = x;
+    MoveLine(Choices[i], glm::vec2(x, ChoiceY));
+    x += ChoiceWidths[i] + ChoiceSpacing;
+  }
+}
+
+void SysMesBox::Show() {
+  Layout();
+  FadeAnimation.StartIn();
+  State = Showing;
+  if (UI::FocusedMenu != nullptr && UI::FocusedMenu != this) {
+    LastFocusedMenu = UI::FocusedMenu;
+    LastFocusedMenu->IsFocused = false;
+  }
+  IsFocused = true;
+  UI::FocusedMenu = this;
+}
+
+void SysMesBox::Hide() {
+  FadeAnimation.StartOut();
+  State = Hiding;
+  if (UI::FocusedMenu == this) UI::FocusedMenu = LastFocusedMenu;
+  if (UI::FocusedMenu != nullptr) UI::FocusedMenu->IsFocused = true;
+  LastFocusedMenu = nullptr;
+  IsFocused = false;
+}
+
+void SysMesBox::Update(float dt) {
+  FadeAnimation.Update(dt);
+  if (State == Showing && FadeAnimation.IsIn()) State = Shown;
+  if (State == Hiding && FadeAnimation.IsOut()) State = Hidden;
+  if (State == Shown && IsFocused && !ChoiceMade) UpdateInput(dt);
+}
+
+void SysMesBox::UpdateInput(float dt) {
+  if (ChoiceCount == 0) return;  // a message without choices is closed by the script on the next press
+  const bool mouse =
+      Input::CurrentInputDevice == Input::Device::Mouse || Input::CurrentInputDevice == Input::Device::Touch;
+  bool decide = (PADinputButtonWentDown & PAD1A) != 0;
+  if (mouse) {
+    Selection = -1;
+    const glm::vec2 pos = Input::CurMousePos;
+    for (int i = 0; i < ChoiceCount; i++) {
+      if (RectF(ChoiceXs[i], ChoiceHitY, ChoiceWidths[i], ChoiceHitHeight).ContainsPoint(pos)) {
+        Selection = i;
+        if (PADinputMouseWentDown & PAD1A) decide = true;
+      }
+    }
+  }
+  if (PADinputButtonRepeatDown & PAD1LEFT) {
+    PlaySe(1);
+    Selection = Selection < 0 ? 0 : (Selection == 0 ? ChoiceCount - 1 : Selection - 1);
+  }
+  if (PADinputButtonRepeatDown & PAD1RIGHT) {
+    PlaySe(1);
+    Selection = Selection < 0 ? ChoiceCount - 1 : (Selection + 1 < ChoiceCount ? Selection + 1 : 0);
+  }
+  if (decide) {
+    PlaySe(2);
+    if (Selection >= 0) {
+      ScrWork[SW_SYSSEL + (Global ? 1 : 0)] = Selection;
+      ChoiceMade = true;
+    } else {
+      Selection = 0;  // the original only picks the first choice
+    }
+  } else if ((PADinputButtonWentDown | PADinputMouseWentDown) & PAD1B) {
+    PlaySe(3);
+    Selection = ChoiceCount != 1 ? 1 : 0;  // Back moves to "no", it does not close the box
+  }
+  PADinputButtonWentDown &= ~(PAD1A | PAD1B);
+  PADinputMouseWentDown &= ~(PAD1A | PAD1B);
+}
+
+void SysMesBox::DrawText(std::span<const ProcessedTextGlyph> text, float alpha) {
+  if (text.empty()) return;
+  if (ShadowOffset != 0.0f) {
+    std::vector<ProcessedTextGlyph> shadow(text.begin(), text.end());
+    for (ProcessedTextGlyph& glyph : shadow) {
+      glyph.Colors.TextColor = 0x000000;
+      glyph.Move(glm::vec2(-ShadowOffset));
+    }
+    Profile::Dialogue::DialogueFont->DrawProcessedText(shadow, alpha, RendererOutlineMode::None);
+    for (ProcessedTextGlyph& glyph : shadow) glyph.Move(glm::vec2(2.0f * ShadowOffset));
+    Profile::Dialogue::DialogueFont->DrawProcessedText(shadow, alpha, RendererOutlineMode::None);
+  }
+  Profile::Dialogue::DialogueFont->DrawProcessedText(text, alpha, RendererOutlineMode::None);
+}
+
+void SysMesBox::Render() {
+  if (State == Hidden) return;
+  const float alpha = FadeAnimation.Progress;
+  const glm::vec4 col(glm::vec3(1.0f), alpha);
+  // the global box dims the screen (black at 3 / 4 of its opacity)
+  if (Global)
+    Renderer->DrawQuad(RectF(0.0f, 0.0f, Profile::Game::DesignWidth, Profile::Game::DesignHeight),
+                       glm::vec4(0.0f, 0.0f, 0.0f, alpha * GlobalDim));
+
+  const float left = BoxLeftX - Width / 2.0f;
+  const float right = BoxRightX + Width / 2.0f;
+  const float middle = left + BoxLeft.Bounds.Width;
+  Renderer->DrawSprite(BoxLeft, glm::vec2(left, BoxY), col);
+  Renderer->DrawSprite(BoxMiddle, RectF(middle, BoxY, right - middle, BoxMiddle.Bounds.Height), col);
+  Renderer->DrawSprite(BoxRight, glm::vec2(right, BoxY), col);
+
+  if (Selection >= 0 && Selection < ChoiceCount)
+    Renderer->DrawSprite(Highlight, RectF(ChoiceXs[Selection], HighlightY, ChoiceWidths[Selection], HighlightHeight),
+                         col);
+
+  for (int i = 0; i < MessageCount; i++) DrawText(Messages[i], alpha);
+  for (int i = 0; i < ChoiceCount; i++) DrawText(Choices[i], alpha);
+}
+
+}  // namespace SGHD
+}  // namespace UI
+}  // namespace Impacto
