+++ b/src/hud/nametagdisplay.h
@@ -47,4 +47,11 @@ class ThreePieceNametagDisplay : public NametagDisplay {
   void Reset() override {}
 };
 
+class CenteredTwoPieceNametagDisplay : public NametagDisplay {
+ public:
+  void Render(const NameInfo& nameInfo, glm::vec4 tint) override;
+  void Update(float dt) override {}
+  void Reset() override {}
+};
+
 }  // namespace Impacto
