+sv.SF_SYSTEMMENUCAPTURE=1378;
+
+-- Movie flags of Game.exe PlayMovie (0x460d00): it sets flag 0x73b (1851) while a movie plays and stores the
+-- cancel argument in 0x9bc (2492); the common table has 1823 / 2493. MACROSYS2 (world line change, label 375)
+-- loops on 1851 until the movie ends, so with the common value it stopped every movie on its first frame.
+sv.SF_MOVIEPLAY = 1851;
+sv.SF_MOVIEFL = 2492;
+
+-- The common table puts SW_MESWIN0TYPE at 4422, which is the second mask priority in STEINS;GATE (the scripts write 34 / 100
+-- there). The scripts never set a window type, so read an unused block instead (draw window and text).
+sv.SW_MESWIN0TYPE = 7970;
