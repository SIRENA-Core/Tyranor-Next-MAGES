+      OpcodeTableSystem = OpcodeTableSystem_SGHD;
+      OpcodeTableGraph = OpcodeTableGraph_SGHD;
+      OpcodeTableUser1 = OpcodeTableUser1_SGHD;
+      break;
+    }
     case InstructionSet::LCCSwitch: {
       OpcodeTableSystem = OpcodeTableSystem_LCCSwitch;
       OpcodeTableGraph = OpcodeTableGraph_LCCSwitch;
diff --git a/src/vm/vm.h b/src/vm/vm.h
