+// The whole thread state of the VM, for the debug tools (snapshots, rewind): the pool with its links as indices
+// (-1 for none), the thread groups and which script each buffer holds.
+struct VmState {
+  struct Thread {
+    Sc3VmThread Data;  // its link pointers are not used
+    int Previous, Next, NextFree;
+  };
+  std::vector<Thread> Pool;
+  std::array<int, MaxThreadGroups> Heads{}, Tails{};
+  std::array<uint32_t, MaxThreadGroups> Counts{}, States{};
+  int NextFree = -1;
+  std::array<int, MaxLoadedScripts> ScriptIds{};  // -1: the buffer is empty
+};
+void SaveVmState(VmState& out);
+// reloads the scripts whose buffer held another one
+void RestoreVmState(const VmState& in);
+
 inline std::span<uint8_t> ScriptBuffers[MaxLoadedScripts];
