index 0000000000000000000000000000000000000000..f107cdac107a1b53bd7fd5c1566b4a0beef4afde
--- /dev/null
+++ b/src/games/sghd/phonerender.cpp
@@ -0,0 +1,382 @@
+// Drawing of the STEINS;GATE phone, translated from the original draw routines (0x453800 and the screens it calls).
+// The original works in 1280x720 units and draws its 1920x1080 textures with the coordinates multiplied by 1.5;
+// destinations below are in 1280x720 units (Spr / Rect / Text scale them), texture sources are texture pixels.
+#include "phonerender.h"
+
+#include <cstdio>
+#include <string>
+
+#include "phonestate.h"
+#include "../../profile/dialogue.h"
+#include "../../profile/sprites.h"
+#include "../../renderer/renderer.h"
+#include "../../text/text.h"
+#include "../../vm/vm.h"
+#include "../../vm/sc3stream.h"
+
+namespace Impacto {
+namespace SGHD {
+namespace Phone {
+
+using namespace Impacto::Vm;
+
+namespace {
+
+constexpr float Scale = 1.5f;
+uint32_t Blink = 0;
+// DAT_0052e9c0: per screen title, the string (StrBaseA +) and the row of the title bar sprite
+constexpr uint8_t TitleBars[] = {0, 0, 1, 0, 40, 0, 39, 0, 41, 2, 4, 1, 5, 1, 6, 1, 7, 1, 8, 1, 44, 0};  // DAT_018eb090: blink clock of the "new" marks, advanced by every mark drawn
+
+// The phone textures are loaded by the scripts (LoadTexture into surfaces 170..179); the profile lists them as script
+// handled sheets, so a surface is drawn from the sheet whose file the script put there.
+const SpriteSheet* SurfaceSheet(int surf) {
+  auto surfIt = Renderer->SurfToId.find(surf);
+  if (surfIt == Renderer->SurfToId.end()) return nullptr;
+  for (auto const& [name, sheet] : Profile::SpriteSheets) {
+    if (!sheet.ScriptHandled) continue;
+    auto idIt = Renderer->SheetPathToId.find(sheet.Path);
+    if (idIt == Renderer->SheetPathToId.end()) continue;
+    auto keyIt = Renderer->SheetPathToId.find(Io::AssetPathKey::KeyToAssetPath(surfIt->second));
+    if (keyIt != Renderer->SheetPathToId.end() && keyIt->second == idIt->second) return &sheet;
+  }
+  return nullptr;
+}
+
+glm::vec4 Tint(uint32_t rgb, int alpha) {
+  return glm::vec4(((rgb >> 16) & 0xff) / 255.0f, ((rgb >> 8) & 0xff) / 255.0f, (rgb & 0xff) / 255.0f,
+                   std::clamp(alpha, 0, 256) / 256.0f);
+}
+
+}  // namespace
+
+int PhoneSurface() { return SW(0x6b20) + 0xaf; }
+
+// 0x432230: part (sx, sy, w, h) of a surface at (dx, dy); w / h are drawn 1:1
+void Spr(int surf, float sx, float sy, float w, float h, float dx, float dy, int alpha, uint32_t rgb) {
+  const SpriteSheet* sheet = SurfaceSheet(surf);
+  if (!sheet || alpha <= 0) return;
+  Sprite sprite(*sheet, sx, sy, w, h);
+  Renderer->DrawSprite(sprite, RectF(dx * Scale, dy * Scale, w, h), Tint(rgb, alpha));
+}
+
+// 0x432710: part of a surface stretched over a rectangle (screen pixels)
+void SprStretch(int surf, float sx, float sy, float w, float h, float x0, float y0, float x1, float y1, int alpha) {
+  const SpriteSheet* sheet = SurfaceSheet(surf);
+  if (!sheet || alpha <= 0) return;
+  Sprite sprite(*sheet, sx, sy, w, h);
+  Renderer->DrawSprite(sprite, RectF(x0, y0, x1 - x0, y1 - y0), Tint(0xffffff, alpha));
+}
+
+// 0x42f890: filled rectangle (screen pixels)
+void Rect(float x, float y, float w, float h, uint32_t rgb, int alpha) {
+  if (alpha <= 0) return;
+  Renderer->DrawQuad(RectF(x, y, w, h), Tint(rgb, alpha));
+}
+
+namespace {
+
+float Advance(int glyph, int size) {
+  const Font& font = *Profile::Dialogue::DialogueFont;
+  return font.GetAdvanceWidth(glyph) * size / font.BitmapEmWidth;
+}
+
+// Walks a script string like 0x444f70: glyphs wrapped at maxWidth, line breaks (0x00), colour tags (0x04 + expression)
+// and the skipped one byte tags. visit(glyph, x, line, color) for every glyph.
+template <typename F>
+void Layout(const uint8_t* str, int maxWidth, int size, uint32_t color, F&& visit) {
+  if (maxWidth == 0) maxWidth = 0x500;
+  float x = 0;
+  int line = 0;
+  int link = -1, links = 0;  // underlined words: 0x09 starts one, 0x0b ends it (numbered in order)
+  while (*str != 0xff) {
+    const uint8_t b = *str;
+    if (b & 0x80) {
+      const int glyph = ((b & 0x7f) << 8) | str[1];
+      const float w = Advance(glyph, size);
+      if (x + w > maxWidth) {
+        line++;
+        x = 0;
+        continue;  // the glyph goes to the next line
+      }
+      visit(glyph, x, line, color, link, w);
+      x += w;
+      str += 2;
+    } else if (b == 0x00) {
+      line++;
+      x = 0;
+      str++;
+    } else if (b == 0x04) {  // colour: an expression follows; the phone mails do not change colour, skip it
+      Sc3Stream stream(const_cast<uint8_t*>(str + 1));
+      StringToken token;
+      str++;
+      while (*str != 0xff && !(*str & 0x80) && *str != 0x00) str++;
+      (void)stream;
+      (void)token;
+    } else if (b == 0x09) {
+      link = links;
+      str++;
+    } else if (b == 0x0b) {
+      link = -1;
+      links++;
+      str++;
+    } else {
+      str++;
+    }
+  }
+}
+
+}  // namespace
+
+int LineCountOf(const uint8_t* str, int maxWidth, int size) {
+  int lines = 0;
+  bool any = false;
+  Layout(str, maxWidth, size, 0, [&](int, float, int line, uint32_t, int, float) {
+    any = true;
+    lines = std::max(lines, line + 1);
+  });
+  // explicit line breaks after the last glyph count too
+  int breaks = 0;
+  for (const uint8_t* p = str; *p != 0xff; p += (*p & 0x80) ? 2 : 1)
+    if (*p == 0) breaks++;
+  return any ? std::max(lines, 1) : breaks;
+}
+
+int TextWidth(const uint8_t* str, int size) {  // 0x4462e0 (first line)
+  float w = 0;
+  for (; *str != 0xff && *str != 0; str += (*str & 0x80) ? 2 : 1)
+    if (*str & 0x80) w += Advance(((*str & 0x7f) << 8) | str[1], size);
+  return (int)w;
+}
+
+// 0x444f70: a script string from line `skip` on, at most `lines` lines
+void Text(int x, int y, int maxWidth, const uint8_t* str, int skip, int lines, uint32_t color, int size, int alpha) {
+  if (alpha <= 0) return;
+  const Font& font = *Profile::Dialogue::DialogueFont;
+  std::vector<ProcessedTextGlyph> glyphs;
+  Layout(str, maxWidth, size, color, [&](int glyph, float gx, int line, uint32_t c, int, float) {
+    if (line < skip || line >= skip + lines) return;
+    glm::vec2 pos((x + gx) * Scale, (y + (line - skip) * size) * Scale);
+    glyphs.push_back(font.PlaceGlyph(glyph, pos, size * Scale, DialogueColorPair{c, 0}, 1.0f));
+  });
+  Profile::Dialogue::DialogueFont->DrawProcessedText(glyphs, std::clamp(alpha, 0, 256) / 256.0f);
+}
+
+// 0x444b90 + 0x4453d0: a mail text whose words can be chosen: words blue and underlined, the chosen word white on
+// blue
+void TextLinks(int x, int y, int maxWidth, const uint8_t* str, int skip, int lines, int size, int alpha, int sel) {
+  if (alpha <= 0) return;
+  const Font& font = *Profile::Dialogue::DialogueFont;
+  std::vector<ProcessedTextGlyph> glyphs;
+  Layout(str, maxWidth, size, 0, [&](int glyph, float gx, int line, uint32_t, int link, float w) {
+    if (line < skip || line >= skip + lines) return;
+    const float px = (x + gx) * Scale, py = (y + (line - skip) * size) * Scale;
+    uint32_t c = 0;
+    if (link >= 0) {
+      c = link == sel ? 0xffffff : 0x0000ff;
+      if (link == sel) Rect(px, py, w * Scale, size * Scale, 0x0000ff, alpha);
+      Rect(px, py + size * Scale - 3, w * Scale, 1.5f, c, alpha);  // underline
+    }
+    glyphs.push_back(font.PlaceGlyph(glyph, glm::vec2(px, py), size * Scale, DialogueColorPair{c, 0}, 1.0f));
+  });
+  Profile::Dialogue::DialogueFont->DrawProcessedText(glyphs, std::clamp(alpha, 0, 256) / 256.0f);
+}
+
+// 0x445ca0: an ASCII string
+void TextAscii(int x, int y, const std::string& str, uint32_t color, int size, int alpha) {
+  if (alpha <= 0) return;
+  auto glyphs = TextLayoutPlainString(str, *Profile::Dialogue::DialogueFont, size * Scale, DialogueColorPair{color, 0},
+                                      1.0f, glm::vec2(x * Scale, y * Scale), TextAlignment::Left);
+  Profile::Dialogue::DialogueFont->DrawProcessedText(glyphs, std::clamp(alpha, 0, 256) / 256.0f);
+}
+
+const uint8_t* Str(uint32_t strNo) { return &ScriptBuffers[S.ScriptBuffer][ScriptGetStrAddress(S.ScriptBuffer, strNo)]; }
+
+std::string Num2(uint32_t v) {  // 0x46dfd0 with width 2: right aligned with spaces
+  char buf[16];
+  std::snprintf(buf, sizeof(buf), "%2u", v);
+  return buf;
+}
+
+// ------------------------------------------------------------------------------------------------ common parts
+
+// 0x44d520: antenna / battery bar (out of range unless flag 2601)
+void DrawStatusBar(int x, int y, int alpha) {
+  Spr(PhoneSurface(), 2656.5f, GetFlag(0xa29) ? 1.5f : 49.5f, 414, 45, x, y, alpha);
+}
+
+// 0x45a3e0: blinking mark (0 = call, 1 = mail)
+void DrawMark(int kind, int x, int y, int alpha) {
+  Blink = (Blink + 1) & 0x3f;
+  if (kind == 0)
+    Spr(PhoneSurface(), (float)((Blink > 0x1f ? 0x60c : 0x5d4) + 1) * Scale, 1422, 81, 112.5f, x, y, alpha);
+  else
+    Spr(PhoneSurface(), (float)((Blink > 0x1f ? 0x614 : 0x5d4) + 1) * Scale, 1320, 93, 99, x, y, alpha);
+}
+
+// 0x45c150: wallpaper GlobalVars[2875] (9 per row of the wallpaper sheet)
+void DrawWallpaper(int x, int y, int alpha) {
+  const uint32_t w = SW(0x2eec);
+  if (w == 0xffff) return;
+  Spr(0xaa, (float)((w % 9) * 0x19f), (float)((w / 9) * 0x1dd), 414, 476, x, y, alpha);
+}
+
+// 0x45bbd0: screen title bar
+void DrawTitleBar(int which, int x, int y, int alpha) {
+  const uint8_t strOffset = TitleBars[which * 2], row = TitleBars[which * 2 + 1];
+  Spr(PhoneSurface(), 2656.5f, (float)(row * 0x1f + 0x41) * Scale, 414, 43.5f, x, y, alpha);
+  Text(x + 0x20, y + 2, 0xf4, Str(S.StrBaseA + strOffset), 0, 1, 0xffffff, 0x18, alpha);
+}
+
+// 0x45a530: message panel
+void DrawPanel(int strOffset, int x, int y, uint32_t color, int alpha) {
+  Spr(PhoneSurface(), 2239.5f, 252, 414, 210, x, y + 0x54, alpha);
+  Text(x + 0x1d, y + 100, 0xdc, Str(S.StrBaseA + strOffset), 0, 4, color, 0x14, alpha);
+}
+
+// 0x45a620: two entry choice panel (sel 0xff = none)
+void DrawChoice(int str0, int str1, int sel, int x, int y, int alpha) {
+  Spr(PhoneSurface(), 2239.5f, 252, 414, 210, x, y + 0x54, alpha);
+  if (sel != 0xff) Spr(PhoneSurface(), 2434.5f, 1012.5f, 21, 36, x + 0x1d, sel * 0x18 - 1 + y + 0x5c, alpha);
+  Text(x + 0x31, y + 0x5c, 0xdc, Str(S.StrBaseA + str0), 0, 1, sel == 0 ? Red : 0, 0x14, alpha);
+  if (str1 != 9999) Text(x + 0x31, y + 0x74, 0xdc, Str(S.StrBaseA + str1), 0, 1, sel == 1 ? Red : 0, 0x14, alpha);
+}
+
+// 0x45a320: the opening animation (PHONE3), the default phone only
+void DrawOpening() {
+  const uint32_t ct = SW(0x6a44);
+  SprStretch(0xae, (float)(((ct % 0xe) / 2) * 0x124 + 1) * Scale, (float)((ct / 0xe) * 0x1f9 + 1) * Scale, 436.5f, 756,
+             1248, 0, 1872, 1080, 0x100);
+}
+
+// ------------------------------------------------------------------------------------------------ screens
+
+// 0x44d8f0 mode 0: home (wallpaper, incoming call / new mail)
+void DrawHome(int x, int y, int alpha) {
+  const int surf = PhoneSurface();
+  DrawWallpaper(x, y, alpha);
+  if (!GetFlag(0xa2d)) {
+    if (GetFlag(0xa2c)) {  // new mail
+      Spr(surf, 2239.5f, 1.5f, 414, 247.5f, x, y + 0x4c, alpha);
+      DrawMark(1, x + 0x69, y + 0x50, alpha);
+      const uint8_t* s = Str(S.StrBaseA + 9);
+      const int w = std::min(TextWidth(s, 0x18), 0xfe);
+      Text(x - (w >> 1) + 0x8a, y + 0x96, 0xfe, s, 0, 2, Red, 0x18, alpha);
+    }
+    return;
+  }
+  // incoming call: number drawn with the digit sprites, name, "incoming call"
+  const int caller = SW(0x6a6c);
+  Spr(surf, 2239.5f, 1.5f, 414, 247.5f, x, y + 0x4c, alpha);
+  const uint8_t* digits = Str(S.StrBaseB);
+  const uint8_t* number = Str(S.StrBaseB + caller * 2 + 2);
+  int dx = x + 0x48;
+  for (; *number != 0xff; number += 2, dx += 0x10) {
+    int i = 0;
+    const uint8_t* d = digits;
+    for (; *d != 0xff; d += 2, i++)
+      if (((number[0] & 0x7f) << 8 | number[1]) == ((d[0] & 0x7f) << 8 | d[1])) break;
+    if (*d == 0xff) continue;
+    const int sx = i * 0x12 + 0x5d5;
+    Spr(surf, sx * Scale, 976.5f, 24, 33, dx, y + 0xbe, alpha);
+  }
+  DrawMark(0, x + 0x32, y + 0x50, alpha);
+  Text(x + 0x18, y + 0xa2, 0x108, Str(S.StrBaseB + caller * 2 + 1), 0, 2, 0, 0x14, alpha);
+  Text(x + 0x6a, y + 0x6e, 0xc0, Str(S.StrBaseA + 0xd), 0, 2, Red, 0x20, alpha);
+}
+
+// 0x44f5e0 mode 1: mail menu
+void DrawMailMenu(int x, int y, int alpha) {
+  const int surf = PhoneSurface(), sel = SW(0x6a4c);
+  Spr(surf, 2656.5f, 763.5f, 414, 294, x, y, alpha);
+  Spr(surf, 2656.5f, 579, 414, 181.5f, x, y + 0xc4, alpha);
+  if (sel != 0xff) Spr(surf, 2434.5f, 1012.5f, 21, 36, x + 0x10, sel * 0x18 - 1 + y + 0x3e, alpha);
+  Text(x + 0x24, y + 0x3e, 0x116, Str(S.StrBaseA), 0, 1, sel == 0 ? Red : 0, 0x14, alpha);
+  Text(x + 0x24, y + 0x56, 0x116, Str(S.StrBaseA + 1), 0, 1, sel == 1 ? Red : 0, 0x14, alpha);
+  if (sel != 0xff) Text(x + 0x12, y + 0xe0, 0xf0, Str(S.StrBaseA + 0x2a + sel), 0, 2, 0xffffff, 0x14, alpha);
+}
+
+// mail list (0x451340 sent, 0x451f10 inbox): 12 rows of date + subject, page numbers
+void DrawMailList(bool inbox, int x, int y, int alpha) {
+  const int surf = PhoneSurface();
+  const uint32_t count = inbox ? S.InboxCount : S.SentCount;
+  DrawTitleBar(inbox ? 0 : 1, x, y, alpha);
+  const int top = y + 0x1d;
+  Rect(x * Scale, top * Scale, 414, 432, 0xffffff, alpha);
+  if (count == 0) {
+    DrawPanel(2, x, y, 0, alpha);
+    return;
+  }
+  if (SW(0x6a58) != 0xff) Rect(x * Scale, (top + SW(0x6a58) * 0x18) * Scale, 414, 36, 0xffba95, alpha);
+  const uint32_t first = SW(0x6a54) * 12;
+  for (uint32_t i = 0; i < 12 && first + i < count; i++) {
+    const uint32_t mail = (inbox ? S.Inbox : S.Sent)[first + i];
+    const int ry = top + i * 0x18;
+    if (inbox) {
+      // unread / read / answered marks (0x451f10)
+      const int mark = MailBit(mail, 4) ? 0x19d : (MailBit(mail, 1) ? 0x183 : 0x169);
+      Spr(surf, (mark + 0x32) * Scale, 577.5f, 36, 36, x, ry, alpha);
+    } else {
+      Spr(surf, 616.5f, 577.5f, 36, 36, x, ry, alpha);
+    }
+    if (S.Mails[mail][MailAttach] != 999) Spr(surf, 733.5f, 577.5f, 36, 36, x + 0x60, ry, alpha);
+  }
+  TextAscii(0x470, 0x9a, Num2(SW(0x6a54) + 1) + "/" + Num2(SW(0x6a50) + 1), S.ArrowHover ? 0xffee88 : 0xffffff, 0x10,
+            alpha);
+  for (uint32_t i = 0; i < 12 && first + i < count; i++) {
+    const uint32_t mail = (inbox ? S.Inbox : S.Sent)[first + i];
+    const int ry = top + i * 0x18;
+    const uint32_t date = S.Mails[mail][MailDateHi];
+    TextAscii(x + 0x18, ry, Num2(date / 100) + "/" + Num2(date % 100), 0, 0x18, alpha);
+    const int tx = S.Mails[mail][MailAttach] != 999 ? x + 0x78 : x + 0x60;
+    Text(tx, ry, x - tx + 0x116, Str(S.Mails[mail][MailText] + 1), 0, 1, 0, 0x18, alpha);
+  }
+  Spr(surf, 2239.5f, 465, 414, 432, x, top, alpha);
+}
+
+void DrawScreen(int mode, int x, int y, int alpha) {
+  switch (mode) {
+    case 0: DrawHome(x, y, alpha); break;
+    case 1: DrawMailMenu(x, y, alpha); break;
+    case 2: DrawMailList(false, x, y, alpha); break;
+    case 3: DrawMailList(true, x, y, alpha); break;
+    case 0x14:
+    case 0x15: DrawMainMenu(x, y, alpha); break;
+    default: DrawMoreScreens(mode, x, y, alpha); break;
+  }
+}
+
+// 0x44fb80 modes 20/21: main menu (mail, address book, ..., settings)
+void DrawMainMenu(int x, int y, int alpha) {
+  const int surf = PhoneSurface(), sel = SW(0x6a70);
+  Spr(surf, 2656.5f, 285, 414, 475.5f, x, y, alpha);
+  const float iconSx[4] = {2656.5f, 2758.5f, 2860.5f, 2962.5f};
+  const int ix[4] = {x + 0x2e, x + 0x96, x + 0x2e, x + 0x96}, iy[4] = {y + 0x2f, y + 0x2f, y + 0x85, y + 0x85};
+  for (int i = 0; i < 4; i++)
+    Spr(surf, iconSx[i], (float)((sel == i ? 0x3b3 : 0x36f) + 1) * Scale, 99, 99, ix[i], iy[i], alpha);
+  if ((uint32_t)sel < 4) Text(x + 0x12, y + 0xe0, 0xf0, Str(S.StrBaseA + sel + 0x23), 0, 2, 0xffffff, 0x14, alpha);
+}
+
+// 0x453800: the phone on its layer
+void RenderPhone() {
+  const uint32_t ct = SW(0x6a44);
+  if (ct == 0) return;
+  if (SW(0x6b20) == 0 && ct < 0x14) {
+    DrawOpening();
+    return;
+  }
+  const int slide = ct * -0xe;
+  const int alpha = (ct << 8) / 0x14;
+  const int surf = PhoneSurface();
+  Spr(surf, 1.5f, 1.5f, 567, 1077, slide + 0x470, 2, alpha);
+  const int mode = SW(0x6a48);
+  DrawScreen(mode, slide + 0x4a3, 0x91, alpha);
+  if (mode != 99) {
+    DrawStatusBar(slide + 0x4a3, 0x73, alpha);
+    if (S.HasUnread) Spr(surf, 835.5f, 1291.5f, 40.5f, 28.5f, slide + 0x567, 0x77, alpha);
+  }
+  Spr(surf, 616.5f, 631.5f, 414, 447, slide + 0x4a3, 0x73, alpha);  // frame over the screen
+}
+
+}  // namespace Phone
+}  // namespace SGHD
+}  // namespace Impacto
