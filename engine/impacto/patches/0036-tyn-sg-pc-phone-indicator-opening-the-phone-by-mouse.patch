--- a/src/games/sghd/phonescreens3.cpp
+++ b/src/games/sghd/phonescreens3.cpp
@@ -5,6 +5,7 @@
 #include <cstdio>
 
 #include "../../mem.h"
+#include "../../vm/vm.h"
 
 namespace Impacto {
 namespace SGHD {
@@ -79,8 +80,64 @@ void DrawMusic(int x, int y, int alpha) {
   }
 }
 
+// the phone's big screen behind a picture or text attachment (PHONE2), with the status bar and unread mark
+void DrawBigScreen(int alpha) {
+  Spr(0xab, 0, 0, 1920, 1080, 0, 0, alpha);
+  Spr(0xab, 1.5f, GetFlag(0xa29) ? 1081.5f : 1155, 828, 70.5f, 546 / Scale, 0, alpha);
+  if (S.HasUnread) Spr(0xab, 832.5f, 1081.5f, 84, 48, 1134 / Scale, 0, alpha);
+}
+
 }  // namespace
 
+// 0x44f840: a picture attachment (the picture itself is shown by the script, flag 1602 / GlobalVars[6850])
+void RenderPicture() { DrawBigScreen(SW(0x6b0c)); }
+
+// 0x44f980: picture story (PACG, 6 per row), GlobalVars[6853] / [6855] by flag 1607. The petals of the special
+// attachment (mode 207..209, 0x45b6f0) are not drawn.
+void RenderPictureStory() {
+  const int alpha = SW(0x6b10);
+  DrawBigScreen(alpha);
+  const uint32_t pic = GetFlag(0x647) ? SW(0x6b1c) : SW(0x6b14);
+  SprStretch(0xac, (float)((pic % 6) * 0x2a9), (float)((pic / 6) * 0x302), 680, 768, 546, 70.5f, 1374, 1006.5f, alpha);
+}
+
+// 0x44d120: text pages of an attachment (page GlobalVars[6836]: below 1000 inside the phone, else full width),
+// scrolled by GlobalVars[6837], lines from the page table of 10:38:00
+void RenderTextPage() {
+  const int alpha = SW(0x6ac8);
+  if (alpha == 0 || S.TextPageTable == 0) return;
+  const uint32_t style = SW(0x6ad0) / 1000, page = SW(0x6ad0) % 1000;
+  int x, y, w, maxLines;
+  if (style == 0) {
+    DrawBigScreen(alpha);
+    Rect(546, 70.5f, 828, 936, 0xffffff, alpha);
+    x = 0x16d, y = 0x30, w = 0x228, maxLines = 0x1f;
+  } else {
+    x = 0xe8, y = 0x9e, w = 800, maxLines = 0x19;
+  }
+  const uint8_t* table = &Vm::ScriptBuffers[S.TextPageBuffer][S.TextPageTable];
+  const uint16_t label = table[page * 2] | (table[page * 2 + 1] << 8);
+  const int16_t* lines = (const int16_t*)&Vm::ScriptBuffers[S.TextPageBuffer][Vm::ScriptGetLabelAddress(
+      S.TextPageBuffer, label)];
+  int skip = SW(0x6ad4), shown = 0;
+  for (; *lines != -1 && shown < maxLines; lines++) {
+    if (skip > 0) {
+      skip--;
+      continue;
+    }
+    const uint8_t* str =
+        &Vm::ScriptBuffers[S.TextPageBuffer][Vm::ScriptGetStrAddress(S.TextPageBuffer, (uint16_t)*lines)];
+    TextLinks(x, y, w, str, 0, 1, 0x14, alpha, 99);
+    y += 0x14;
+    shown++;
+  }
+  if (style == 0) {
+    if (SW(0x6ad4) != 0) Spr(0xab, 2, 1228, 828, 24, 546 / Scale, 69.5f / Scale, alpha, S.ScrollHover == 1 ? 0xffee88 : 0xffffff);
+    if (SW(0x6ad4) < SW(0x6adc))
+      Spr(0xab, 2, 1254, 828, 24, 546 / Scale, 982.5f / Scale, alpha, S.ScrollHover == 2 ? 0xffee88 : 0xffffff);
+  }
+}
+
 void DrawLastScreens(int mode, int x, int y, int alpha) {
   switch (mode) {
     case 0x1b: DrawTriggerMail(x, y, alpha); break;
