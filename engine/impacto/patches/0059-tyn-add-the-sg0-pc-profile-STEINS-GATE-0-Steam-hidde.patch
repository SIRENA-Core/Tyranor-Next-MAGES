--- /dev/null
+++ b/profiles/sg0-pc/savedata.lua
@@ -0,0 +1,8 @@
+-- STEINS;GATE (Steam) speaks the Chaos;Child (PS4) style save protocol (Save 4/70/71/16/60/61/80/81, AutoSave
+-- 0xff/10/5 and the QuickSave/SaveState group, LoadData 0/1), which the MO6TWPC save system implements: it persists
+-- the CC layout ScrWork/flag ranges (see src/games/mo6twpc/savesystem.cpp). Own file format; compatibility with the
+-- Steam save files is a non-goal.
+root.SaveData = {
+    Type = SaveDataType.MO6TWPC,
+    SaveFilePath = root.BasePaths.RootSavesDir .. "/sg0-pc/SYSTEM.DAT",
+};
