From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tyn-patches <tyn-patches@users.noreply.github.com>
Date: Mon, 23 Nov 2026 03:17:07 -0800
Subject: [PATCH] tyn: sg0-pc writes its system data when going to the
 background

Only TYN.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/profiles/sg0-pc/savedata.lua b/profiles/sg0-pc/savedata.lua
index 94bf55a9470696de5fcc3f12e44686e6afc25600..1dc2fdbbe4e2458dc1ada06f1e2a2ee12d2d9cdb 100644
--- a/profiles/sg0-pc/savedata.lua
+++ b/profiles/sg0-pc/savedata.lua
@@ -5,4 +5,7 @@
 root.SaveData = {
     Type = SaveDataType.MO6TWPC,
     SaveFilePath = root.BasePaths.RootSavesDir .. "/sg0-pc/SYSTEM.DAT",
+    -- a phone app is often killed in the background without the game being quit: keep the system data (flags,
+    -- play time, settings, CG / BGM / TIPS) written when it goes there
+    WriteSystemDataOnBackground = true,
 };
