diff --git a/src/vm/inst_sghd.h b/src/vm/inst_sghd.h
new file mode 100644
index 0000000000000000000000000000000000000000..78916c34fa58c2df04f842fe2ae5e39b82ce3753
--- /dev/null
+++ b/src/vm/inst_sghd.h
@@ -0,0 +1,99 @@
+#pragma once
+// STEINS;GATE (Steam) instructions whose operands differ from the Chaos;Child PC dialect they otherwise share.
+// Header-only on purpose (like the opcode tables): vm.cpp is the only user.
+#include "vm.h"
+#include "thread.h"
+#include "expression.h"
+#include "../log.h"
+
+namespace Impacto {
+
+namespace Vm {
+
+namespace SghdDetail {
+
+// Operand kinds: b = u8, h = u16 (labels, return ids, strings), E = expression.
+inline void SkipOperands(Sc3VmThread* thread, const char* shape) {
+  for (; *shape; ++shape) {
+    switch (*shape) {
+      case 'b':
+        thread->IpOffset += 1;
+        break;
+      case 'h':
+        thread->IpOffset += 2;
+        break;
+      case 'E':
+        (void)ExpressionEval(thread);
+        break;
+    }
+  }
+}
+
+struct SubShape {
+  int type;
+  const char* shape;
+};
+
+// Group instructions: one type byte, then operands that depend on the type. Unknown types cannot be skipped safely
+// (the stream would desynchronize), so they are logged once and the operand-less form is assumed.
+template <size_t N>
+inline void RunGroup(Sc3VmThread* thread, const char* name, const SubShape (&shapes)[N]) {
+  [[maybe_unused]] const uint8_t group = *thread->GetIp() & 0x7F;
+  [[maybe_unused]] const uint8_t op = thread->GetIp()[1];
+  thread->IpOffset += 2;
+  const int type = *thread->GetIp();
+  thread->IpOffset += 1;
+  for (const SubShape& s : shapes) {
+    if (s.type == type) {
+      SkipOperands(thread, s.shape);
+      ImpLogSlow(LogLevel::Warning, LogChannel::VMStub, "STUB SGHD instruction {:s}(type: {:#x}) ({:02x}:{:02x})\n",
+                 name, type, group, op);
+      return;
+    }
+  }
+  ImpLogSlow(LogLevel::Error, LogChannel::VM, "SGHD instruction {:s} has unknown type {:#x} ({:02x}:{:02x})\n", name,
+             type, group, op);
+}
+
+}  // namespace SghdDetail
+
+// 10:37: phone / mail / @channel group.
+inline void InstSghdGroup1037(Sc3VmThread* thread, float dt) {
+  static constexpr SghdDetail::SubShape shapes[] = {
+      {0x00, "bE"},  {0x01, "bE"},  {0x02, "bEh"}, {0x03, "bEh"}, {0x04, "hhhhhh"}, {0x05, ""},    {0x06, ""},
+      {0x07, ""},    {0x08, ""},    {0x09, ""},    {0x0A, ""},    {0x0F, "E"},      {0x10, "E"},  {0x11, ""},
+      {0x12, "EE"},  {0x13, ""},    {0x14, "EEEE"}, {0x15, "EEEE"}, {0x16, ""},      {0x17, ""},   {0x18, ""},
+      {0x19, ""},    {0x1A, "E"},   {0x1E, ""},
+  };
+  SghdDetail::RunGroup(thread, "Group1037", shapes);
+}
+
+// Instructions that take one byte and have no other effect that is understood yet (10:1B, 10:3F).
+inline void InstSghdSkipByte(Sc3VmThread* thread, float dt) {
+  thread->IpOffset += 2;
+  [[maybe_unused]] const int arg = *thread->GetIp();
+  thread->IpOffset += 1;
+  ImpLogSlow(LogLevel::Warning, LogChannel::VMStub, "STUB SGHD one-byte instruction (arg: {:#x})\n", arg);
+}
+
+// 00:4C: type byte, one expression when the type is 0.
+inline void InstSghdUnk004C(Sc3VmThread* thread, float dt) {
+  thread->IpOffset += 2;
+  const int type = *thread->GetIp();
+  thread->IpOffset += 1;
+  if (type == 0) (void)ExpressionEval(thread);
+  ImpLogSlow(LogLevel::Warning, LogChannel::VMStub, "STUB SGHD instruction 00:4C(type: {:#x})\n", type);
+}
+
+// 10:38: type byte, a label when the type is 0.
+inline void InstSghdGroup1038(Sc3VmThread* thread, float dt) {
+  thread->IpOffset += 2;
+  const int type = *thread->GetIp();
+  thread->IpOffset += 1;
+  if (type == 0) thread->IpOffset += 2;
+  ImpLogSlow(LogLevel::Warning, LogChannel::VMStub, "STUB SGHD instruction Group1038(type: {:#x})\n", type);
+}
+
+}  // namespace Vm
+
+}  // namespace Impacto
